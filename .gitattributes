# The vendored validator is generated by scripts/vendor-bids-validator.ts (ADR 0028). GitHub folds
# it in a pull request, and git does not print its 10 MB bundle and licence text as a diff.
public/vendor/** linguist-generated=true -diff
# What a re-vendor is reviewed by stays readable: the versions and hashes it records.
public/vendor/**/provenance.json diff
public/vendor/**/SHA256SUMS diff
# The quality-view parity vectors are copied byte for byte from nemar-cli by
# scripts/copy-quality-views-vocabulary.mjs (website ADR 0035); what a re-copy is reviewed by is
# src/lib/quality-views/vocabulary/pin.json, which stays readable.
test/fixtures/quality-views/vectors/** linguist-generated=true -diff
# The montages are copied the same way, and shipped; PROVENANCE.json, which names their sources and
# licenses, stays readable.
src/lib/quality-views/vocabulary/montages/** linguist-generated=true -diff
src/lib/quality-views/vocabulary/montages/PROVENANCE.json -linguist-generated diff
