    {
      "dataset_id": "nm000287",
      "id": "nm000287",
      "name": "Muse Sleep-Onset EEG — EEG/EMG Foundation Challenge 2026, Track 03",
      "description": "This dataset comprises 540 at-home EEG recordings from 203 participants collected using Muse S family headbands, provided for Track 03 (Sleep onset) of the EEG/EMG Foundation Challenge 2026. Recordings, totaling approximately 157.52 hours, contain four EEG channels (TP9, AF7, AF8, TP10) sampled at 128 Hz, each annotated with the time of first N2 sleep epoch onset. The task associated with this dataset is to predict the time remaining until first N2 sleep onset using only EEG recorded up to the prediction time.",
