  "refused_not_requested_grant": {
    "status": 409,
    "body": {
      "error": "That account has no open compute access request to decide.",
      "code": "not_requested"
    }
  },
  "refused_not_requested_deny": {
    "status": 409,
    "body": {
      "error": "That account has no open compute access request to decide.",
      "code": "not_requested"
    }
  },
  "refused_already_active": {
    "status": 409,
    "body": {
      "error": "That account already holds compute access.",
      "code": "already_active"
    }
  },
  "refused_not_active": {
    "status": 409,
    "body": {
      "error": "That account does not hold compute access.",
      "code": "not_active"
    }
  },
  "refused_account_not_found": {
    "status": 404,
    "body": {
      "error": "There is no such account.",
      "code": "account_not_found"
    }
  },
  "refused_invalid_id": {
    "status": 400,
    "body": {
      "error": "That is not an account id (a whole number from 1).",
      "code": "invalid_query"
    }
  },
  "refused_invalid_body_reason": {
    "status": 400,
    "body": {
      "error": "The request body is not valid. reason: too_big",
      "code": "invalid_body",
      "fields": [
        {
          "path": "reason",
          "code": "too_big"
        }
      ]
    }
  },
  "refused_invalid_body_key": {
    "status": 400,
    "body": {
      "error": "The request body is not valid. body: unrecognized_keys",
      "code": "invalid_body",
      "fields": [
        {
          "path": "",
          "code": "unrecognized_keys"
        }
      ]
    }
  },
  "refused_not_in_good_standing": {
    "status": 409,
    "body": {
      "error": "That account is deleted, revoked or not verified, so compute access cannot be granted to it.",
      "code": "account_not_in_good_standing"
    }
  },
