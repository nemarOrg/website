{
  "name": "nemar-website",
  "type": "module",
  "version": "0.2.4-dev1",
  "private": true,
  "license": "CC-BY-NC-ND-4.0",
  "description": "nemar.org redesign on Astro + Cloudflare Pages",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run generate:og && bun run generate:site-og && astro build",
    "generate:og": "bun scripts/generate-og-images.mjs",
    "generate:site-og": "bun scripts/generate-site-og-image.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy:og-cron": "bun wrangler deploy -c wrangler.og-cron.toml",
    "bump": "./scripts/bump-version.sh",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.7",
    "@resvg/resvg-wasm": "2.6.2",
    "astro": "^6.3.3",
    "zarrita": "^0.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
