---
import Base from "../layouts/Base.astro";
---

<Base title="Citation Dashboard">
  <section class="container page">
    <h1>Citation Dashboard</h1>
    <p>
      The dashboard is being rebuilt on top of the citation aggregate that
      currently lives on <code>hallu</code> at
      <code>/data/qumulo/openneuro/processed/citation_dashboard/</code>. Phase 4
      of the website epic (<a href="https://github.com/nemarOrg/website/issues/5">issue #5</a>)
      will sync that aggregate to S3 and render it here.
    </p>
    <p>
      The legacy dashboard is still live at
      <a href="https://dashboard.nemar.org/citations">dashboard.nemar.org/citations</a>.
    </p>
  </section>
</Base>

<style>
  .page {
    padding-block: var(--space-12) var(--space-16);
    max-inline-size: var(--max-width-prose);
  }
  .page h1 {
    font-size: var(--fs-3xl);
    margin-block-end: var(--space-6);
  }
  .page p {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
    margin-block-end: var(--space-4);
  }
  .page code {
    background: var(--color-bg-elevated);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.95em;
  }
</style>
