---
import Base from "../layouts/Base.astro";
---

<Base title="Support">
  <section class="container page">
    <h1>Support</h1>
    <p>
      For questions, file an issue on the dataset's GitHub repository
      (linked from each <a href="/discover">dataset detail page</a>) or open a
      ticket on the
      <a href="https://nemar.org/feedback/report_problems">legacy support form</a>.
    </p>
  </section>
</Base>

<style>
  .page {
    padding-block: var(--space-12) var(--space-16);
    max-inline-size: var(--max-width-prose);
  }
  .page h1 {
    font-size: var(--fs-3xl);
    margin-block-end: var(--space-6);
  }
  .page p {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
  }
</style>
