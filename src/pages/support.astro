---
import ExternalLink from "../components/ExternalLink.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Support">
  <section class="container page">
    <h1>Support</h1>
    <p>
      NEMAR does not run a forum. For help using NEMAR, email
      <a href="mailto:support@nemar.org">support@nemar.org</a>.
    </p>
    <p>
      To report a bug or request a feature in the CLI, API, or backend, open
      an issue on <ExternalLink href="https://github.com/nemarOrg/nemar-cli/issues">nemarOrg/nemar-cli</ExternalLink>.
      For a problem with this site, open one on
      <ExternalLink href="https://github.com/nemarOrg/website/issues">nemarOrg/website</ExternalLink>.
    </p>
    <p>
      For a dataset-specific question, file an issue on that dataset's
      GitHub repository, linked from its
      <a href="/discover">dataset detail page</a>.
    </p>
  </section>
</Base>

<style>
  .page {
    padding-block: var(--space-12) var(--space-16);
    max-inline-size: var(--max-width-prose);
  }
  .page h1 {
    font-size: var(--fs-3xl);
    margin-block-end: var(--space-6);
  }
  .page p {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
    margin-block-end: var(--space-4);
  }
  .page p:last-child {
    margin-block-end: 0;
  }
</style>
