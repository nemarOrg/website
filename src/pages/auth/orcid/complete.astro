---
import Base from "../../../layouts/Base.astro";

// Brand-new ORCID signup, step 2: ORCID verified the iD but returns no email,
// and users.email is required, so we collect it here. The verified iD rides in
// the HttpOnly `nemar_orcid_pending` cookie (set by the api Worker on the
// callback) and is never exposed to this page; the form POSTs the email to
// /api/v1/auth/orcid/finalize, which reads + verifies that cookie server-side.
---

<Base
  title="Finish your NEMAR account"
  description="Add your email to finish creating your ORCID-verified NEMAR account."
>
  <section class="finish">
    <article class="finish__panel">
      <div class="finish__rail" aria-hidden="true"></div>

      <header class="finish__head">
        <span class="finish__badge">
          <svg width="18" height="18" viewBox="0 0 256 256" aria-hidden="true">
            <path fill="#A6CE39" d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0z"/>
            <path fill="#fff" d="M86.3 186.2H70.9V79.1h15.4v107.1zM78.6 56.8c-5.1 0-9.2-4.1-9.2-9.2 0-5.1 4.1-9.2 9.2-9.2s9.2 4.1 9.2 9.2c0 5.1-4.1 9.2-9.2 9.2zm17.6 22.3h41.6c39.6 0 57 28.3 57 53.5 0 27.4-21.4 53.5-56.8 53.5H96.2V79.1zm15.3 92.2h24.6c35 0 43-26.5 43-38.6 0-19.7-12.5-38.6-43.8-38.6h-23.8v77.2z"/>
          </svg>
          ORCID verified
        </span>
        <h1 class="finish__title">One more step</h1>
        <p class="finish__lede">
          Your ORCID iD is verified. NEMAR needs an email for sign-in codes and
          account notices. We don&rsquo;t share it.
        </p>
      </header>

      <form class="finish__form" data-finish-form>
        <label class="field">
          <span class="field__label">Email</span>
          <input
            class="field__input"
            type="email"
            name="email"
            autocomplete="email"
            inputmode="email"
            required
            spellcheck="false"
            autocapitalize="none"
            placeholder="you@institution.edu"
            data-finish-email
          />
        </label>
        <button class="finish__submit" type="submit" data-finish-submit>
          Create my account
        </button>
        <p class="finish__error" role="alert" data-finish-error hidden></p>
      </form>

      <p class="finish__foot">
        Your account goes into a short admin review before publishing unlocks.
        You can browse and explore right away.
      </p>
    </article>
  </section>
</Base>

<style>
  .finish {
    min-block-size: calc(100dvh - var(--header-height));
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--space-4);
  }
  .finish__panel {
    position: relative;
    inline-size: 100%;
    max-inline-size: 30rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8) var(--space-8);
    overflow: hidden;
    box-shadow: 0 24px 64px -32px rgb(15 23 42 / 25%);
  }
  .finish__rail {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 3px;
    background: linear-gradient(90deg, var(--brand-teal), var(--brand-purple));
  }
  .finish__head {
    margin-block-end: var(--space-6);
  }
  .finish__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    margin-block-end: var(--space-4);
  }
  .finish__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
  }
  .finish__lede {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: var(--lh-normal);
  }
  .finish__form {
    display: grid;
    gap: var(--space-4);
  }
  .field {
    display: grid;
    gap: var(--space-2);
  }
  .field__label {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .field__input {
    min-block-size: 48px;
    padding: 12px var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-base);
  }
  .field__input:focus-visible {
    outline: none;
    border-color: var(--brand-teal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand-teal) 22%, transparent);
  }
  .finish__submit {
    min-block-size: 48px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    border: none;
    background: var(--brand-navy);
    color: #f8fafc;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-base);
    cursor: pointer;
  }
  .finish__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .finish__error {
    margin: 0;
    color: var(--color-danger);
    font-size: var(--fs-sm);
  }
  .finish__error a {
    color: var(--color-link);
  }
  .finish__foot {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-finish-form]");
  const emailEl = document.querySelector<HTMLInputElement>("[data-finish-email]");
  const submitEl = document.querySelector<HTMLButtonElement>("[data-finish-submit]");
  const errorEl = document.querySelector<HTMLElement>("[data-finish-error]");

  const MESSAGES: Record<string, string> = {
    email_in_use:
      "That email already has a NEMAR account. Sign in with it first, then link ORCID from settings.",
    orcid_pending_expired:
      'Your ORCID session expired. <a href="/auth/orcid/start">Sign in with ORCID</a> again to retry.',
    orcid_already_linked: "This ORCID iD is already linked to an account. Try signing in instead.",
    invalid_email: "That doesn't look like an email address.",
  };

  if (form && emailEl && submitEl && errorEl) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = emailEl.value.trim().toLowerCase();
      if (!email) return;
      submitEl.disabled = true;
      errorEl.hidden = true;
      try {
        const res = await fetch("/api/v1/auth/orcid/finalize", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ email }),
        });
        if (res.ok) {
          location.href = "/welcome";
          return;
        }
        let code = "unknown";
        try {
          const data = (await res.json()) as { error?: string };
          if (data?.error) code = data.error;
        } catch {
          /* keep "unknown" */
        }
        errorEl.innerHTML =
          MESSAGES[code] ?? "We couldn't finish creating your account. Try again in a moment.";
        errorEl.hidden = false;
        submitEl.disabled = false;
      } catch {
        errorEl.textContent = "Network error. Check your connection and try again.";
        errorEl.hidden = false;
        submitEl.disabled = false;
      }
    });
  }
</script>
