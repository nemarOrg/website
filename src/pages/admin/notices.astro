---
import ConfirmDialog from "../../components/ConfirmDialog.astro";
import StatusIcon from "../../components/admin/StatusIcon.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { noticeLevelBadge } from "../../lib/admin-badges";
import { adminGate } from "../../lib/admin-guard";
import { getSession } from "../../lib/auth";
import { formatDate, formatRelativeTime } from "../../lib/format";
import {
  NOTICE_LEVELS,
  NOTICE_SCOPES,
  type Notice,
  isNoticeExpired,
  linkifyMessage,
  listAdminNotices,
} from "../../lib/notices-api";

const session = getSession(Astro.locals);
const redirectTo = adminGate(session, Astro.url.pathname);
if (redirectTo) {
  return Astro.redirect(redirectTo);
}
if (!session) {
  // adminGate(null, …) always returns a redirect above; this branch exists
  // only so TypeScript narrows `session` for AdminLayout's required prop.
  return Astro.redirect("/login");
}

const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
let notices: readonly Notice[] = [];
let listError: string | null = null;
try {
  notices = await listAdminNotices({ cookieHeader });
} catch (err) {
  // `DashboardApiError.message` already carries the backend's sentence.
  listError = err instanceof Error ? err.message : "Could not load notices.";
  console.warn("[admin/notices] list failed:", listError);
}

// Expiry computed here, not trusted from the server — see isNoticeExpired
// and nemar-cli#1024. The admin list is the one place it matters most: an
// admin needs to see that a notice has lapsed even while the public
// endpoint is still (wrongly) serving it.
const now = new Date();
// The badge draws the level the public banner renders it as, so production's
// legacy `info` gets the `tip` tint and icon instead of failing the page; the
// pill's text stays the raw stored level.
const rows = notices.map((notice) => ({
  notice,
  expired: isNoticeExpired(notice, now),
  badge: noticeLevelBadge(notice.level),
}));
const liveCount = rows.filter((r) => !r.expired).length;

const LEVEL_HINTS: Record<string, string> = {
  critical:
    "A live outage or data risk. Most prominent, and returns on the next visit even after being closed.",
  warning: "Something is degraded right now. Returns on the next visit even after being closed.",
  maintenance:
    "A planned or in-progress work window. Returns on the next visit even after being closed.",
  announcement:
    "Good news \u2014 a conference, a release, a milestone. Dismissed for good once a visitor closes it.",
  tip: "A hint or standing note. Dismissed for good once a visitor closes it.",
};
const SCOPE_HINTS: Record<string, string> = {
  all: "Everyone, including signed-out visitors.",
  members: "Signed-in members only.",
  admins: "Admins and owners only.",
};
---

<AdminLayout title="Notices" active="notices" session={session}>
  <Fragment slot="lede">
    Site-wide banners shown on every page and to CLI users on startup. Notices stack with the most
    urgent on top, so a maintenance banner sits above a long-running announcement. Each is dismissed
    per visitor; operational ones (critical, warning, maintenance) come back on the next visit while
    they're still live, while announcements and tips stay dismissed. There's no edit
    endpoint, so changing a notice means deleting it and creating a new one, which re-shows it to
    everyone who had dismissed it.
  </Fragment>

  <section class="notice-form-card" aria-labelledby="new-notice-heading">
    <h2 class="notice-form-card__title" id="new-notice-heading">New notice</h2>
    <form class="notice-form" data-notice-form>
      <label class="notice-form__field">
        <span class="notice-form__label">Message</span>
        <textarea
          name="message"
          class="notice-form__textarea"
          rows="3"
          maxlength="1000"
          required
          placeholder="e.g. nemar.org has moved to its new home. The previous site stays available until 31 October."
        ></textarea>
        <span class="notice-form__hint" data-message-counter>0 / 1000</span>
      </label>

      <div class="notice-form__row">
        <label class="notice-form__field">
          <span class="notice-form__label">Level</span>
          <select name="level" class="notice-form__select" data-level-select>
            {NOTICE_LEVELS.map((level) => (
              <option value={level} selected={level === "tip"}>
                {level}
              </option>
            ))}
          </select>
        </label>

        <label class="notice-form__field">
          <span class="notice-form__label">Audience</span>
          <select name="scope" class="notice-form__select" data-scope-select>
            {NOTICE_SCOPES.map((scope) => (
              <option value={scope} selected={scope === "all"}>
                {scope}
              </option>
            ))}
          </select>
        </label>

        <label class="notice-form__field">
          <span class="notice-form__label">Expires (optional)</span>
          <input type="datetime-local" name="expires_at" class="notice-form__input" />
          <span class="notice-form__hint">Your local time. Leave empty for no expiry.</span>
        </label>
      </div>

      <p class="notice-form__hint notice-form__hint--block" data-level-hint>{LEVEL_HINTS.tip}</p>
      <p class="notice-form__hint notice-form__hint--block" data-scope-hint>{SCOPE_HINTS.all}</p>

      <p class="admin-action-error" role="alert" data-form-error hidden></p>

      <div class="notice-form__actions">
        <button type="submit" class="notice-btn notice-btn--primary" data-notice-submit>
          Publish notice
        </button>
      </div>
    </form>
  </section>

  {listError && <p class="admin-action-error" role="alert">{listError}</p>}

  <h2 class="notice-list-heading">
    Published{" "}
    <span class="notice-list-heading__count">
      {rows.length} total, {liveCount} live
    </span>
  </h2>

  {
    !listError && rows.length === 0 ? (
      <div class="admin-empty">
        <h3 class="admin-empty__title">No notices</h3>
        <p class="admin-empty__body">Nothing is being shown to visitors right now.</p>
      </div>
    ) : (
      <ul class="admin-list" role="list">
        {rows.map(({ notice, expired, badge }) => (
          <li>
            <article class:list={["notice-row", { "notice-row--expired": expired }]}>
              <div class="notice-row__head">
                <span class:list={["notice-badge", `notice-badge--${badge.level}`]}>
                  <StatusIcon name={badge.icon} size={14} />
                  <span class="notice-badge__text">{notice.level}</span>
                </span>
                <span class="notice-row__scope">
                  <span class="visually-hidden">Audience: </span>{notice.scope}
                </span>
                {expired && <span class="notice-row__expired-flag">Expired</span>}
              </div>

              {/* Same linkification the banner applies, so an admin sees
                  what a visitor will. Rendered as Astro expressions, never
                  set:html — the escaping is what keeps an admin-authored
                  message from becoming markup. */}
              <p class="notice-row__message">
                {linkifyMessage(notice.message).map((segment) =>
                  segment.type === "link" ? (
                    <a href={segment.value} target="_blank" rel="noopener noreferrer">
                      {segment.value}
                    </a>
                  ) : (
                    segment.value
                  ),
                )}
              </p>

              <dl class="notice-row__meta">
                <div>
                  <dt>Created</dt>
                  <dd>{formatRelativeTime(notice.created_at) || formatDate(notice.created_at) || "—"}</dd>
                </div>
                <div>
                  <dt>Expires</dt>
                  <dd>
                    {notice.expires_at
                      ? formatDate(notice.expires_at) || notice.expires_at
                      : "Never"}
                  </dd>
                </div>
              </dl>

              <footer class="notice-row__actions">
                <button
                  type="button"
                  class="notice-btn notice-btn--danger-ghost"
                  data-notice-delete
                  data-notice-id={notice.id}
                >
                  Delete
                </button>
              </footer>
            </article>
          </li>
        ))}
      </ul>
    )
  }

  <p class="admin-action-error" role="alert" data-admin-action-error hidden></p>

  <ConfirmDialog
    dialogId="admin-delete-notice"
    title="Delete this notice?"
    body="It stops showing to visitors and CLI users immediately. There's no undo — recreating it mints a new id, so anyone who had dismissed it will see it again."
    confirmLabel="Delete notice"
    confirmTone="danger"
  />
</AdminLayout>

<style>
  .admin-empty {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--admin-surface);
    color: var(--color-fg-muted);
  }
  /* A search-miss line ships [hidden] and the script reveals it; the grid
     display above would otherwise beat the UA [hidden] rule and show it on
     every load. */
  .admin-empty[hidden] {
    display: none;
  }
  .admin-empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .admin-empty__body {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .admin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  /* The dashboard's error state: a solid card with an error rule. */
  .admin-action-error {
    margin: 0;
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: inset 3px 0 0 var(--admin-error);
    color: var(--color-fg);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  @media (forced-colors: active) {
    .admin-action-error {
      border-inline-start: 3px solid CanvasText;
    }
  }
  .notice-form-card {
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--admin-shadow-sm);
    padding: var(--space-5);
  }
  .notice-form-card__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.005em;
  }
  .notice-form {
    display: grid;
    gap: var(--space-4);
  }
  .notice-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
  }
  /* The dashboard's field: a small label over an 8px-radius control. */
  .notice-form__field {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }
  .notice-form__label {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-fg-muted);
  }
  .notice-form__textarea,
  .notice-form__input,
  .notice-form__select {
    inline-size: 100%;
    min-block-size: 36px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--admin-control-border);
    background: var(--admin-surface);
    color: var(--color-fg);
    font: inherit;
    font-size: var(--fs-sm);
  }
  /* One height for the single-line controls, so a native select and a date
     input sit level in the same row. */
  .notice-form__input,
  .notice-form__select {
    block-size: 2.5rem;
    padding-block: 0;
  }
  .notice-form__textarea {
    resize: vertical;
    min-block-size: 4.5rem;
  }
  .notice-form__textarea::placeholder {
    color: var(--admin-text-3);
  }
  .notice-form__hint {
    font-size: var(--fs-xs);
    color: var(--admin-text-3);
  }
  .notice-form__hint--block {
    margin: 0;
  }
  .notice-form__actions {
    display: flex;
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .notice-list-heading {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.012em;
    display: flex;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    flex-wrap: wrap;
  }
  .notice-list-heading__count {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    letter-spacing: 0;
    color: var(--admin-text-3);
  }
  .notice-row {
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--admin-shadow-sm);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    min-inline-size: 0;
  }
  /* Lapsed, not live: a quieter card rather than a faded one, so its text
     keeps its contrast. The Expired pill says it in words. */
  .notice-row--expired {
    background: var(--admin-surface-2);
    border-style: dashed;
    box-shadow: none;
  }
  .notice-row--expired .notice-row__message {
    color: var(--color-fg-muted);
  }
  .notice-row__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  /* Same five tones as SiteNotices.astro, so what an admin picks here
     visibly matches what a visitor will see. Duplicated per the project's
     scoped-style convention (AGENTS.md); keep the two in sync. The tone
     tints the pill and colors its icon; the level name stays in the text
     color, so it reads at full contrast in every tone. */
  .notice-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-block-size: 1.5rem;
    padding: 0 var(--space-2) 0 7px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--notice-tone) 14%, var(--admin-surface));
    color: color-mix(in srgb, var(--notice-tone) 70%, var(--color-fg));
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    text-transform: capitalize;
  }
  .notice-badge__text {
    color: var(--color-fg);
  }
  .notice-badge--tip {
    --notice-tone: var(--color-info);
  }
  .notice-badge--announcement {
    --notice-tone: var(--color-success);
  }
  .notice-badge--maintenance {
    --notice-tone: var(--color-maintenance);
  }
  .notice-badge--warning {
    --notice-tone: var(--color-warning);
  }
  .notice-badge--critical {
    --notice-tone: var(--color-danger);
  }
  .notice-row__scope {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--admin-text-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .notice-row__expired-flag {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.375rem;
    padding: 0 var(--space-2);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-fg-muted);
    border: 1px dashed var(--admin-control-border);
    border-radius: var(--radius-pill);
  }
  .notice-row__message {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }
  .notice-row__message a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .notice-row__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--admin-surface-2);
  }
  .notice-row--expired .notice-row__meta {
    background: var(--admin-surface);
  }
  .notice-row__meta dt {
    font-size: var(--fs-xs);
    color: var(--admin-text-3);
    margin-block-end: 2px;
  }
  .notice-row__meta dd {
    margin: 0;
    font-size: var(--fs-sm);
  }
  .notice-row__actions {
    display: flex;
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .notice-btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--admin-surface);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .notice-btn:hover {
    background: var(--admin-surface-2);
    border-color: var(--admin-control-border);
  }
  .notice-btn[disabled] {
    opacity: 0.55;
    cursor: progress;
  }
  .notice-btn--primary {
    background: var(--color-link);
    color: var(--color-bg);
    border-color: var(--color-link);
  }
  .notice-btn--primary:hover {
    background: var(--color-link-hover);
    border-color: var(--color-link-hover);
  }
  .notice-btn--danger-ghost {
    color: var(--admin-error-text);
    border-color: color-mix(in srgb, var(--admin-error) 45%, transparent);
  }
  .notice-btn--danger-ghost:hover {
    background: var(--admin-error-soft);
    border-color: var(--admin-error-text);
  }
  @media (max-width: 640px) {
    .notice-form-card,
    .notice-row {
      padding: var(--space-4);
    }
  }
  @media (forced-colors: active) {
    .notice-badge {
      border: 1px solid CanvasText;
    }
  }
</style>

<script>
  import { DashboardApiError } from "../../lib/dashboard-api";
  import {
    type NoticeLevel,
    type NoticeScope,
    createNotice,
    deleteNotice,
    toRfc3339,
  } from "../../lib/notices-api";

  const FRIENDLY: Record<string, string> = {
    upstream_unreachable: "Can't reach the notices service. Try again in a moment.",
    unauthenticated: "Sign in again to continue.",
  };

  function friendly(err: unknown): string {
    if (err instanceof DashboardApiError) {
      if (err.code && FRIENDLY[err.code]) return FRIENDLY[err.code];
      if (err.code) return err.code;
      return err.message;
    }
    return err instanceof Error ? err.message : "Action failed.";
  }

  function show(el: HTMLElement | null, msg: string): void {
    if (!el) return;
    el.hidden = false;
    el.textContent = msg;
  }
  function hide(el: HTMLElement | null): void {
    if (!el) return;
    el.hidden = true;
    el.textContent = "";
  }

  const formError = document.querySelector<HTMLElement>("[data-form-error]");
  const actionError = document.querySelector<HTMLElement>("[data-admin-action-error]");

  // Live hints, so the level/scope choice explains its consequence at the
  // moment it's made rather than only in the lede.
  const LEVEL_HINTS: Record<string, string> = {
    critical: "A live outage or data risk. Most prominent, and returns on the next visit even after being closed.",
    warning: "Something is degraded right now. Returns on the next visit even after being closed.",
    maintenance: "A planned or in-progress work window. Returns on the next visit even after being closed.",
    announcement: "Good news \u2014 a conference, a release, a milestone. Dismissed for good once a visitor closes it.",
    tip: "A hint or standing note. Dismissed for good once a visitor closes it.",
  };
  const SCOPE_HINTS: Record<string, string> = {
    all: "Everyone, including signed-out visitors.",
    members: "Signed-in members only.",
    admins: "Admins and owners only.",
  };
  const levelSelect = document.querySelector<HTMLSelectElement>("[data-level-select]");
  const scopeSelect = document.querySelector<HTMLSelectElement>("[data-scope-select]");
  const levelHint = document.querySelector<HTMLElement>("[data-level-hint]");
  const scopeHint = document.querySelector<HTMLElement>("[data-scope-hint]");
  levelSelect?.addEventListener("change", () => {
    if (levelHint) levelHint.textContent = LEVEL_HINTS[levelSelect.value] ?? "";
  });
  scopeSelect?.addEventListener("change", () => {
    if (scopeHint) scopeHint.textContent = SCOPE_HINTS[scopeSelect.value] ?? "";
  });

  const form = document.querySelector<HTMLFormElement>("[data-notice-form]");
  const textarea = form?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  const counter = document.querySelector<HTMLElement>("[data-message-counter]");
  // The backend caps `message` at 1000 (z.string().max(1000)); showing the
  // count avoids a 400 that would otherwise arrive only after publishing.
  function updateCounter(): void {
    if (counter && textarea) counter.textContent = `${textarea.value.length} / 1000`;
  }
  textarea?.addEventListener("input", updateCounter);
  updateCounter();

  let submitting = false;
  form?.addEventListener("submit", async (evt) => {
    evt.preventDefault();
    if (submitting) return;
    hide(formError);

    const message = textarea?.value.trim() ?? "";
    if (!message) {
      show(formError, "A notice needs a message.");
      return;
    }

    const rawExpiry =
      form.querySelector<HTMLInputElement>('input[name="expires_at"]')?.value ?? "";
    const expires_at = toRfc3339(rawExpiry);
    // toRfc3339 returns undefined both for "empty" and for "unparseable".
    // Only the second is an error, so distinguish before posting: sending
    // nothing would silently create a never-expiring notice.
    if (rawExpiry.trim() && !expires_at) {
      show(formError, "That expiry date couldn't be read. Pick it again.");
      return;
    }

    const submitBtn = document.querySelector<HTMLButtonElement>("[data-notice-submit]");
    submitting = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Publishing…";
    }
    try {
      await createNotice({
        message,
        level: (levelSelect?.value ?? "tip") as NoticeLevel,
        scope: (scopeSelect?.value ?? "all") as NoticeScope,
        ...(expires_at ? { expires_at } : {}),
      });
      location.reload();
    } catch (err) {
      show(formError, `Couldn't publish that notice: ${friendly(err)}`);
      submitting = false;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish notice";
      }
    }
  });

  let pendingDeleteId: number | null = null;
  document.querySelectorAll<HTMLButtonElement>("[data-notice-delete]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const raw = btn.dataset.noticeId;
      const id = raw ? Number.parseInt(raw, 10) : Number.NaN;
      if (!Number.isInteger(id)) return;
      pendingDeleteId = id;
      hide(actionError);
      document.dispatchEvent(
        new CustomEvent<{ dialogId: string }>("nemar:open-confirm-dialog", {
          detail: { dialogId: "admin-delete-notice" },
        }),
      );
    });
  });

  document.addEventListener("nemar:confirm-dialog-confirm", async (evt) => {
    const e = evt as CustomEvent<{ dialogId: string }>;
    if (e.detail.dialogId !== "admin-delete-notice" || pendingDeleteId === null) return;
    const id = pendingDeleteId;
    pendingDeleteId = null;
    // ConfirmDialog closes synchronously on confirm — it doesn't await this
    // handler — so without disabling the button an admin can fire a second
    // DELETE for the same id while the first is still in flight and get a
    // confusing 404 for a delete that actually succeeded.
    const btn = document.querySelector<HTMLButtonElement>(
      `[data-notice-delete][data-notice-id="${CSS.escape(String(id))}"]`,
    );
    if (btn) btn.disabled = true;
    try {
      await deleteNotice(id);
      location.reload();
    } catch (err) {
      if (btn) btn.disabled = false;
      show(actionError, `Couldn't delete that notice: ${friendly(err)}`);
    }
  });
</script>
