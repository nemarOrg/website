---
import ConfirmDialog from "../../components/ConfirmDialog.astro";
import UserAdminRow from "../../components/admin/UserAdminRow.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { adminGate } from "../../lib/admin-guard";
import { getSession } from "../../lib/auth";
import { DashboardApiError } from "../../lib/dashboard-api";
import {
  type AdminUserDetail,
  type AdminUserListRow,
  type AdminUserStatus,
  getAdminUser,
  isAwaitingUploadApproval,
  listAdminUsers,
} from "../../lib/users-admin-api";

const session = getSession(Astro.locals);
const redirectTo = adminGate(session, Astro.url.pathname);
if (redirectTo) {
  return Astro.redirect(redirectTo);
}
if (!session) {
  // adminGate(null, …) always returns a redirect above, so this branch is
  // unreachable — it's here only so TypeScript narrows `session` to
  // non-null for AdminLayout's required `session` prop below.
  return Astro.redirect("/login");
}
const isOwner = session.user.backend_role === "owner";

// Filter chips. Two website-only sentinels here, neither a `status` value:
// "awaiting" sends `?awaiting_approval=1` (a server-side predicate over two
// columns, not a status), and "all" sends nothing at all.
//
// The lifecycle labels changed with nemar-cli ADR 0040 because the statuses
// stopped meaning what they used to. `verified` is no longer "waiting for an
// admin" — it is the working base tier, and most of the catalog sits there
// permanently and happily. What an admin actually has a queue of is open
// UPLOAD-access requests, which is its own chip and the default view.
type ChipValue = AdminUserStatus | "all" | "awaiting";
const CHIPS: ReadonlyArray<{ value: ChipValue; label: string }> = [
  { value: "awaiting", label: "Awaiting approval" },
  { value: "pending", label: "Unverified email" },
  { value: "verified", label: "Base access" },
  { value: "approved", label: "Upload access" },
  { value: "revoked", label: "Revoked" },
  { value: "all", label: "All" },
];
const KNOWN_VALUES = new Set(CHIPS.map((c) => c.value));

const url = new URL(Astro.request.url);
const rawStatus = url.searchParams.get("status");
// The endpoint has no pagination and returns every matching row (~600 in
// the dev mirror) — defaulting to an unfiltered dump would be a
// multi-hundred-row unbounded fetch on every page load. The awaiting-approval
// queue is the working view, so it's the default both with no `status` param
// and with an unrecognized one.
const effectiveChip: ChipValue =
  rawStatus && KNOWN_VALUES.has(rawStatus as ChipValue) ? (rawStatus as ChipValue) : "awaiting";
const listQuery =
  effectiveChip === "awaiting"
    ? { awaitingApproval: true }
    : effectiveChip === "all"
      ? {}
      : { status: effectiveChip as AdminUserStatus };

const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
let users: readonly AdminUserListRow[] = [];
let listError: string | null = null;
try {
  const result = await listAdminUsers(listQuery, { cookieHeader });
  users = result.users;
} catch (err) {
  listError =
    err instanceof DashboardApiError
      ? `Could not load users (${err.status}).`
      : err instanceof Error
        ? err.message
        : "Could not load users.";
}

// The review card needs city, country, affiliation and the why text, and the
// listing does not carry them (`GET /admin/users` is an explicit column
// projection; only `GET /admin/users/:username` selects `u.*`). So each open
// request costs one detail fetch.
//
// Bounded and fail-soft, deliberately. Bounded because this fans out one HTTP
// call per row and the queue is small by construction — a request is answered
// once and never re-opened (nemar-cli ADR 0042) — but nothing in the API caps
// what comes back. Fail-soft because a detail that does not load must cost the
// admin the extra fields, not the Approve button: `UserAdminRow` renders every
// listed field regardless and only the enrichment goes missing.
const REVIEW_DETAIL_LIMIT = 25;
const details = new Map<number, AdminUserDetail>();
const reviewRows = users
  .filter((u) => isAwaitingUploadApproval(u) && typeof u.username === "string" && u.username)
  .slice(0, REVIEW_DETAIL_LIMIT);
let detailFetchFailures = 0;
await Promise.all(
  reviewRows.map(async (u) => {
    try {
      details.set(u.id, await getAdminUser(u.username as string, { cookieHeader }));
    } catch (err) {
      console.warn(`[admin/users] review detail failed for ${u.username}`, err);
      detailFetchFailures += 1;
    }
  }),
);
const reviewDetailTruncated = users.filter(isAwaitingUploadApproval).length > REVIEW_DETAIL_LIMIT;
---

<AdminLayout title="Users" active="users" session={session}>
  <Fragment slot="lede">
    Upload-access approvals and account management. The default view is the awaiting-approval
    queue: accounts that have asked for upload access and not yet been answered. Approving one
    grants upload access; revoking takes it away. This endpoint has no server-side pagination, so
    each chip fetches its whole matching set — use the search box below to narrow a large view
    client-side rather than picking "All" by default.
  </Fragment>

  <nav class="admin-filters" aria-label="Filter users">
    {
      CHIPS.map((chip) => {
        const href = chip.value === "awaiting" ? "/admin/users" : `/admin/users?status=${chip.value}`;
        const active = effectiveChip === chip.value;
        return (
          <a class:list={["admin-filters__chip", { "admin-filters__chip--active": active }]} href={href}>
            {chip.label}
          </a>
        );
      })
    }
  </nav>

  {detailFetchFailures > 0 && (
    <p class="admin-action-error" role="status">
      Review details didn&rsquo;t load for {detailFetchFailures} request{detailFetchFailures === 1 ? "" : "s"}.
      Those cards show what the listing carries; open the user page for the rest.
    </p>
  )}

  {reviewDetailTruncated && (
    <p class="admin-action-error" role="status">
      Showing full review details for the first {REVIEW_DETAIL_LIMIT} open requests. The rest are
      listed without their location and request text — open each user page to read those.
    </p>
  )}

  <input
    type="search"
    class="users-search"
    placeholder="Filter this view by email or username…"
    aria-label="Filter loaded users by email or username"
    data-user-search
  />

  {listError && <p class="admin-action-error" role="alert">{listError}</p>}

  {
    !listError && users.length === 0 ? (
      <div class="admin-empty">
        <h2 class="admin-empty__title">No users in this view</h2>
        <p class="admin-empty__body">
          {effectiveChip === "awaiting"
            ? "Nobody is waiting on an upload-access decision. Requests appear here as they come in."
            : "Try a different chip."}
        </p>
      </div>
    ) : (
      <ul class="admin-list" role="list" data-user-list>
        {users.map((u) => (
          <li
            data-user-list-item
            data-search-key={`${u.email} ${u.username ?? ""} ${u.given_name ?? ""} ${u.family_name ?? ""}`.toLowerCase()}
          >
            <UserAdminRow
              user={u}
              detail={details.get(u.id) ?? null}
              isOwner={isOwner}
              sessionUserId={session.user.id}
            />
          </li>
        ))}
      </ul>
    )
  }
  <p class="admin-empty admin-empty--search-hidden" data-user-search-empty hidden>
    No loaded users match that search.
  </p>

  <p class="admin-action-error" role="alert" data-admin-action-error hidden></p>

  <ConfirmDialog
    dialogId="admin-approve-user"
    title="Grant upload access?"
    body="This approves the account and grants upload access — the export-control review you just read. They get a notification email. It can be revoked later."
    confirmLabel="Approve"
    confirmTone="primary"
  />

  <ConfirmDialog
    dialogId="admin-revoke-user"
    title="Revoke this user's access?"
    body="Upload access is cleared, their API tokens are revoked, S3 access is removed, and they're pulled from every dataset repo they can reach. They get a notification email."
    confirmLabel="Revoke access"
    confirmTone="danger"
    requireTyping="REVOKE"
  />

  <ConfirmDialog
    dialogId="admin-change-role"
    title="Change this user's role?"
    body="Demoting from owner/admin revokes their existing API tokens, forcing re-authentication."
    confirmLabel="Change role"
    confirmTone="primary"
    requireTyping="CHANGE ROLE"
  />

  <ConfirmDialog
    dialogId="admin-delete-user"
    title="Delete this user?"
    body="This is a soft delete: their PII is masked and credentials revoked, but the account row is kept for audit history. Not reversible from this UI."
    confirmLabel="Delete user"
    confirmTone="danger"
    requireTyping="DELETE"
  />
</AdminLayout>

<style>
  .admin-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .admin-filters__chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .admin-filters__chip:hover {
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }
  .admin-filters__chip--active {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .users-search {
    min-block-size: 40px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
    width: 100%;
    max-inline-size: 26rem;
  }
  .users-search:focus-visible {
    outline: none;
    border-color: var(--color-focus);
    box-shadow: var(--shadow-focus);
  }
  .admin-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    text-align: center;
  }
  .admin-empty--search-hidden {
    padding: var(--space-6);
  }
  .admin-empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
  }
  .admin-empty__body {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .admin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .admin-action-error {
    margin: 0;
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
</style>

<script>
  import {
    approveUserById,
    changeUserRole,
    deleteUserById,
    revokeUser,
  } from "../../lib/users-admin-api";
  import { DashboardApiError } from "../../lib/dashboard-api";
  import type { AdminUserRole } from "../../lib/users-admin-api";

  const errorEl = document.querySelector<HTMLElement>("[data-admin-action-error]");

  // The `/admin/users*` backend routes put a human-readable sentence
  // directly in the error body (see users-admin-api.ts's file header) —
  // `.code` is usually already the right thing to show. This map only
  // covers proxy/transport-level codes, which aren't human text.
  const FRIENDLY: Record<string, string> = {
    upstream_unreachable: "Can't reach the user service. Try again in a moment.",
    unauthenticated: "Sign in again to continue.",
  };

  function friendly(err: unknown): string {
    if (err instanceof DashboardApiError) {
      if (err.code && FRIENDLY[err.code]) return FRIENDLY[err.code];
      if (err.code) return err.code;
      return err.message;
    }
    return err instanceof Error ? err.message : "Action failed.";
  }

  /**
   * Approve refusals are the exception to the rule above. `approveUserById`
   * already builds its message from BOTH halves of the body via
   * `adminActionMessage`, and the useful half is the second one: an
   * ineligible account answers `error: "User is not eligible for approval"`
   * plus `message: "User must verify their email address first; approval
   * cannot skip the inbox check"`. `friendly()` would return the code and
   * throw away the sentence that says what to do.
   */
  function friendlyApprove(err: unknown): string {
    if (err instanceof DashboardApiError) {
      if (err.code && FRIENDLY[err.code]) return FRIENDLY[err.code];
      return err.message;
    }
    return friendly(err);
  }

  function showError(msg: string): void {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }
  function clearError(): void {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  }

  // Client-side search over the already-fetched page (per-chip fetch, no
  // pagination — see the page frontmatter comment on `statusQuery`).
  const searchInput = document.querySelector<HTMLInputElement>("[data-user-search]");
  const listItems = Array.from(document.querySelectorAll<HTMLLIElement>("[data-user-list-item]"));
  const searchEmptyEl = document.querySelector<HTMLElement>("[data-user-search-empty]");
  function applySearch(): void {
    const q = (searchInput?.value ?? "").trim().toLowerCase();
    let visible = 0;
    for (const item of listItems) {
      const match = !q || (item.dataset.searchKey ?? "").includes(q);
      item.hidden = !match;
      if (match) visible++;
    }
    if (searchEmptyEl) searchEmptyEl.hidden = !(q && visible === 0);
  }
  searchInput?.addEventListener("input", applySearch);

  type PendingAction =
    // Approval is keyed by numeric id, not username: a web/ORCID account has
    // no username, and under nemar-cli ADR 0040 approval is what grants it
    // upload access, so the id-keyed route is the only one that reaches it.
    | { kind: "approve"; id: number }
    | { kind: "revoke"; username: string }
    | { kind: "role"; username: string; role: AdminUserRole }
    | { kind: "delete"; id: number };
  let pending: PendingAction | null = null;
  let inFlight = false;

  function openDialog(dialogId: string): void {
    document.dispatchEvent(
      new CustomEvent<{ dialogId: string }>("nemar:open-confirm-dialog", { detail: { dialogId } }),
    );
  }
  function queue(next: PendingAction): void {
    if (inFlight) return;
    if (pending) console.warn("[admin] overwriting un-confirmed pending action", pending);
    pending = next;
    clearError();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-user-approve]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const idRaw = btn.dataset.userId;
      const id = idRaw ? Number.parseInt(idRaw, 10) : Number.NaN;
      if (!Number.isInteger(id)) return;
      queue({ kind: "approve", id });
      openDialog("admin-approve-user");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-user-revoke]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const username = btn.dataset.username;
      if (!username) return;
      queue({ kind: "revoke", username });
      openDialog("admin-revoke-user");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-user-change-role]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const username = btn.dataset.username;
      const selectId = btn.dataset.roleSelectId;
      const select = selectId ? document.getElementById(selectId) : null;
      if (!username || !(select instanceof HTMLSelectElement)) return;
      queue({ kind: "role", username, role: select.value as AdminUserRole });
      openDialog("admin-change-role");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-user-delete]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const idRaw = btn.dataset.userId;
      const id = idRaw ? Number.parseInt(idRaw, 10) : Number.NaN;
      if (!Number.isInteger(id)) return;
      queue({ kind: "delete", id });
      openDialog("admin-delete-user");
    });
  });

  document.addEventListener("nemar:confirm-dialog-confirm", async (evt) => {
    const e = evt as CustomEvent<{ dialogId: string }>;
    if (!pending) return;
    const target = pending;
    pending = null;

    try {
      if (e.detail.dialogId === "admin-approve-user" && target.kind === "approve") {
        inFlight = true;
        try {
          await approveUserById(target.id);
        } catch (err) {
          // Its own catch so the refusal keeps the backend's second sentence
          // ("must verify their email address first"), which is the only part
          // that tells the admin what to do next.
          showError(`Couldn't approve: ${friendlyApprove(err)}`);
          inFlight = false;
          return;
        }
      } else if (e.detail.dialogId === "admin-revoke-user" && target.kind === "revoke") {
        inFlight = true;
        await revokeUser(target.username);
      } else if (e.detail.dialogId === "admin-change-role" && target.kind === "role") {
        inFlight = true;
        await changeUserRole(target.username, target.role);
      } else if (e.detail.dialogId === "admin-delete-user" && target.kind === "delete") {
        inFlight = true;
        await deleteUserById(target.id);
      } else {
        console.error("[admin] confirm-dialog event did not match queued pending action", e.detail.dialogId, target);
        return;
      }
      location.reload();
    } catch (err) {
      showError(`Couldn't complete that action: ${friendly(err)}`);
      inFlight = false;
    }
  });
</script>
