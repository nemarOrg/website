---
import ConfirmDialog from "../../components/ConfirmDialog.astro";
import PublicationRequestRow from "../../components/PublicationRequestRow.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { type PublicationRequest, listPublicationRequests } from "../../lib/admin-api";
import { adminGate } from "../../lib/admin-guard";
import { getSession } from "../../lib/auth";
import { DashboardApiError } from "../../lib/dashboard-api";
import {
  DEFAULT_QUEUE_TAB,
  QUEUE_TABS,
  bucketQueue,
  resolveQueueTab,
} from "../../lib/publication-queue";

const session = getSession(Astro.locals);
const redirectTo = adminGate(session, Astro.url.pathname);
if (redirectTo) {
  return Astro.redirect(redirectTo);
}
if (!session) {
  // adminGate(null, …) always returns a redirect above, so this branch is
  // unreachable — it's here only so TypeScript narrows `session` to
  // non-null for AdminLayout's required `session` prop below.
  return Astro.redirect("/login");
}

const url = new URL(Astro.request.url);
const activeTab = resolveQueueTab(url.searchParams.get("status"));

// One unfiltered read, bucketed here. The tabs need every dataset's latest
// request to be counted and to drop a denial a later request superseded, which
// a per-status fetch cannot see. See `lib/publication-queue.ts`.
const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
let buckets = bucketQueue([]);
let listError: string | null = null;
try {
  const result = await listPublicationRequests({}, { cookieHeader });
  buckets = bucketQueue(result.requests);
} catch (err) {
  listError =
    err instanceof DashboardApiError
      ? `Could not load publication requests (${err.status}).`
      : err instanceof Error
        ? err.message
        : "Could not load publication requests.";
}

const requests: readonly PublicationRequest[] = buckets[activeTab];
const activeMeta = QUEUE_TABS.find((t) => t.id === activeTab) ?? QUEUE_TABS[0];
---

<AdminLayout title="Publication requests" active="publications" session={session}>
  <Fragment slot="lede">
    Approve or deny dataset publication requests. Approving mints a DOI and makes the dataset
    publicly visible. Each dataset is listed once, under its most recent request.
  </Fragment>

  <nav class="admin-filters" aria-label="Filter by status">
    {QUEUE_TABS.map((tab) => {
      const href =
        tab.id === DEFAULT_QUEUE_TAB
          ? "/admin/publication-requests"
          : `/admin/publication-requests?status=${tab.id}`;
      const active = activeTab === tab.id;
      return (
        <a
          class:list={["admin-filters__chip", { "admin-filters__chip--active": active }]}
          href={href}
          aria-current={active ? "page" : undefined}
        >
          {tab.label}
          {!listError && <span class="admin-filters__count">{buckets[tab.id].length}</span>}
        </a>
      );
    })}
  </nav>

  {listError && <p class="admin-action-error" role="alert">{listError}</p>}

  {!listError && requests.length === 0 ? (
    <div class="admin-empty">
      <h2 class="admin-empty__title">{activeMeta.empty.title}</h2>
      <p class="admin-empty__body">{activeMeta.empty.body}</p>
    </div>
  ) : (
    <ul class="admin-list" role="list">
      {requests.map((r: PublicationRequest) => (
        <li>
          <PublicationRequestRow request={r} />
        </li>
      ))}
    </ul>
  )}

  <p class="admin-action-error" role="alert" data-admin-action-error hidden></p>

  <ConfirmDialog
    dialogId="admin-approve"
    title="Approve and publish?"
    body="This is irreversible. The dataset becomes public immediately and a DOI is minted."
    confirmLabel="Approve and publish"
    confirmTone="primary"
    requireTyping="PUBLISH"
  />

  <ConfirmDialog
    dialogId="admin-deny"
    title="Deny this publication request?"
    body="The requester gets an email with the reason and can fix the issue and re-request."
    confirmLabel="Send denial"
    confirmTone="danger"
  />
</AdminLayout>

<style>
  /* Shared admin page vocabulary, in the observability dashboard's family:
     filters are its segmented control; empty and error states are its
     dashed and error-ruled cards. Duplicated across the admin pages per the
     scoped-style convention (AGENTS.md); keep them in sync. */
  .admin-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    inline-size: fit-content;
    max-inline-size: 100%;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--admin-surface-3);
  }
  .admin-filters__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2rem;
    padding: var(--space-1) var(--space-3);
    border-radius: 6px;
    color: var(--color-fg-muted);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }
  .admin-filters__chip:hover {
    color: var(--color-fg);
  }
  .admin-filters__count {
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  .admin-filters__chip--active {
    background: var(--admin-surface);
    color: var(--color-fg);
    font-weight: var(--fw-semibold);
    box-shadow:
      inset 0 -2px 0 var(--admin-accent),
      var(--admin-shadow-sm),
      0 0 0 1px var(--color-border);
  }
  @media (forced-colors: active) {
    .admin-filters__chip--active {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }
  }
  .admin-empty {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--admin-surface);
    color: var(--color-fg-muted);
  }
  /* A search-miss line ships [hidden] and the script reveals it; the grid
     display above would otherwise beat the UA [hidden] rule and show it on
     every load. */
  .admin-empty[hidden] {
    display: none;
  }
  .admin-empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .admin-empty__body {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .admin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  /* The dashboard's error state: a solid card with an error rule. */
  .admin-action-error {
    margin: 0;
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: inset 3px 0 0 var(--admin-error);
    color: var(--color-fg);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  @media (forced-colors: active) {
    .admin-action-error {
      border-inline-start: 3px solid CanvasText;
    }
  }
</style>

<script>
  import { approvePublicationRequest, denyPublicationRequest } from "../../lib/admin-api";
  import { DashboardApiError } from "../../lib/dashboard-api";

  const errorEl = document.querySelector<HTMLElement>("[data-admin-action-error]");

  const FRIENDLY: Record<string, string> = {
    forbidden: "You no longer have admin access. Sign in again.",
    not_invitable: "This request is no longer pending.",
    not_found: "Request not found.",
    missing_field: "Provide a reason for denial.",
    internal_error: "Server error. Try again in a moment.",
  };

  function friendly(err: unknown): string {
    if (err instanceof DashboardApiError && err.code && FRIENDLY[err.code]) {
      return FRIENDLY[err.code];
    }
    return err instanceof Error ? err.message : "Action failed.";
  }
  function showError(msg: string): void {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }
  function clearError(): void {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  }

  type PendingAction =
    | { kind: "approve"; datasetId: string }
    | { kind: "deny"; datasetId: string; reason: string };
  let pending: PendingAction | null = null;
  let inFlight = false;

  function openDialog(dialogId: string): void {
    document.dispatchEvent(
      new CustomEvent<{ dialogId: string }>("nemar:open-confirm-dialog", {
        detail: { dialogId },
      }),
    );
  }

  function queue(next: PendingAction): void {
    if (inFlight) return;
    if (pending) console.warn("[admin] overwriting un-confirmed pending action", pending);
    pending = next;
    clearError();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-pubreq-approve]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      if (!id) return;
      queue({ kind: "approve", datasetId: id });
      openDialog("admin-approve");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-pubreq-deny]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      if (!id) return;
      const rawReason = window.prompt("Reason for denial?");
      if (rawReason === null) {
        pending = null;
        return;
      }
      const reason = rawReason.trim();
      if (reason.length === 0) {
        pending = null;
        showError("A denial reason is required. Click Deny again to retry.");
        return;
      }
      queue({ kind: "deny", datasetId: id, reason });
      openDialog("admin-deny");
    });
  });

  document.addEventListener("nemar:confirm-dialog-confirm", async (evt) => {
    const e = evt as CustomEvent<{ dialogId: string }>;
    if (!pending) return;

    if (e.detail.dialogId === "admin-approve" && pending.kind === "approve") {
      const target = pending;
      pending = null;
      inFlight = true;
      try {
        await approvePublicationRequest(target.datasetId);
        location.reload();
      } catch (err) {
        showError(`Couldn't approve: ${friendly(err)}`);
        inFlight = false;
      }
      return;
    }
    if (e.detail.dialogId === "admin-deny" && pending.kind === "deny") {
      const target = pending;
      pending = null;
      inFlight = true;
      try {
        await denyPublicationRequest(target.datasetId, target.reason);
        location.reload();
      } catch (err) {
        showError(`Couldn't deny: ${friendly(err)}`);
        inFlight = false;
      }
      return;
    }
    console.error(
      "[admin] confirm-dialog event did not match queued pending action",
      e.detail.dialogId,
      pending,
    );
  });
</script>
