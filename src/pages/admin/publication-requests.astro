---
import ConfirmDialog from "../../components/ConfirmDialog.astro";
import PublicationRequestRow from "../../components/PublicationRequestRow.astro";
import AdminPagination from "../../components/admin/AdminPagination.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { type PublicationRequest, listPublicationRequests } from "../../lib/admin-api";
import { adminGate } from "../../lib/admin-guard";
import { getSession } from "../../lib/auth";
import { DashboardApiError } from "../../lib/dashboard-api";
import { WEB_PUBLISH_APPROVE_ENABLED } from "../../lib/flags";
import {
  QUEUE_TABS,
  backendDispatches,
  bucketQueue,
  paginate,
  queueHref,
  resolveQueueTab,
  rowView,
} from "../../lib/publication-queue";
// The review panel is built at runtime by the script below, so its rules are global (a scoped
// <style> never reaches runtime-built nodes). See the header of the stylesheet.
import "../../styles/publication-review-panel.css";

const session = getSession(Astro.locals);
const redirectTo = adminGate(session, Astro.url.pathname);
if (redirectTo) {
  return Astro.redirect(redirectTo);
}
if (!session) {
  // adminGate(null, …) always returns a redirect above, so this branch is
  // unreachable — it's here only so TypeScript narrows `session` to
  // non-null for AdminLayout's required `session` prop below.
  return Astro.redirect("/login");
}

const url = new URL(Astro.request.url);
const activeTab = resolveQueueTab(url.searchParams.get("status"));

// One unfiltered read, bucketed here. The tabs need every dataset's latest
// request to be counted and to drop a denial a later request superseded, which
// a per-status fetch cannot see. See `lib/publication-queue.ts`.
const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
let buckets = bucketQueue([]);
// Whether the backend can start an approval at all. A site deployed ahead of
// its backend must not promise that approval keeps going without the page.
let webApproval = false;
let listError: string | null = null;
try {
  const result = await listPublicationRequests({}, { cookieHeader });
  buckets = bucketQueue(result.requests);
  webApproval = WEB_PUBLISH_APPROVE_ENABLED && backendDispatches(result.requests);
} catch (err) {
  listError =
    err instanceof DashboardApiError
      ? `Could not load publication requests (${err.status}).`
      : err instanceof Error
        ? err.message
        : "Could not load publication requests.";
}

// One page of the tab. The Published tab alone holds hundreds of datasets, and
// the counts on the tabs stay totals.
const paged = paginate(buckets[activeTab], url.searchParams.get("page"));
const requests: readonly PublicationRequest[] = paged.items;
const prevHref = paged.page > 1 ? queueHref(activeTab, paged.page - 1) : null;
const nextHref = paged.page < paged.pageCount ? queueHref(activeTab, paged.page + 1) : null;
// A run reports through the request's own status, so the page watches while the
// backend holds a lease on any row in view.
const refreshing = requests.some(
  (r) => rowView(r, WEB_PUBLISH_APPROVE_ENABLED).progress?.active === true,
);
const activeMeta = QUEUE_TABS.find((t) => t.id === activeTab) ?? QUEUE_TABS[0];
---

<AdminLayout title="Publication requests" active="publications" session={session}>
  <Fragment slot="lede">
    {webApproval ? (
      <>
        Approve or deny dataset publication requests. Approving mints a DOI and makes the dataset
        publicly visible. It runs in GitHub Actions, so it continues if you close this page. Each
        dataset is listed once, under its most recent request.
      </>
    ) : (
      <>
        Deny dataset publication requests here. Approving mints a DOI and makes the dataset
        publicly visible, and for now it runs from a terminal because it needs more than one call
        to finish. Each dataset is listed once, under its most recent request.
      </>
    )}
  </Fragment>

  <nav class="admin-filters" aria-label="Filter by status">
    {QUEUE_TABS.map((tab) => {
      const href = queueHref(tab.id);
      const active = activeTab === tab.id;
      return (
        <a
          class:list={["admin-filters__chip", { "admin-filters__chip--active": active }]}
          href={href}
          aria-current={active ? "page" : undefined}
        >
          {tab.label}
          {!listError && <span class="admin-filters__count">{buckets[tab.id].length}</span>}
        </a>
      );
    })}
  </nav>

  {refreshing && (
    <p class="admin-refresh-note" data-refresh-note>
      This page refreshes every 20 seconds while an approval is active.
      <button type="button" class="admin-refresh-note__toggle" data-refresh-toggle>Pause</button>
    </p>
  )}

  {listError && <p class="admin-action-error" role="alert">{listError}</p>}

  {!listError && (
    <AdminPagination {...paged} label="Pages, top" prevHref={prevHref} nextHref={nextHref} />
  )}

  {!listError && requests.length === 0 ? (
    <div class="admin-empty">
      <h2 class="admin-empty__title">{activeMeta.empty.title}</h2>
      <p class="admin-empty__body">{activeMeta.empty.body}</p>
    </div>
  ) : (
    <ul class="admin-list" role="list">
      {requests.map((r: PublicationRequest) => (
        <li>
          <PublicationRequestRow request={r} />
        </li>
      ))}
    </ul>
  )}

  {!listError && (
    <AdminPagination {...paged} label="Pages, bottom" prevHref={prevHref} nextHref={nextHref} />
  )}

  <p class="admin-action-error" role="alert" data-admin-action-error hidden></p>

  {webApproval && (
    <>
      <ConfirmDialog
        dialogId="admin-approve"
        title="Approve and publish?"
        body="This is irreversible. The dataset becomes public and a DOI is minted. It runs in GitHub Actions and continues if you close this page."
        confirmLabel="Approve and publish"
        confirmTone="primary"
        requireTyping="PUBLISH"
      />
      <ConfirmDialog
        dialogId="admin-approve-anonymous"
        title="Approve this anonymous release?"
        body="This is irreversible. The data becomes public and the depositor is not named. The repository stays private and no DOI is published. It runs in GitHub Actions and continues if you close this page."
        confirmLabel="Approve anonymous release"
        confirmTone="primary"
        requireTyping="PUBLISH"
      />
      <ConfirmDialog
        dialogId="admin-resume"
        title="Continue this approval?"
        body="It continues from the last finished step in GitHub Actions. Steps already done are not repeated."
        confirmLabel="Continue approval"
        confirmTone="primary"
      />
    </>
  )}

  <ConfirmDialog
    dialogId="admin-deny"
    title="Deny this publication request?"
    body="The requester gets an email with the reason and can fix the issue and re-request."
    confirmLabel="Send denial"
    confirmTone="danger"
  />
</AdminLayout>

<style>
  /* Shared admin page vocabulary, in the observability dashboard's family:
     filters are its segmented control; empty and error states are its
     dashed and error-ruled cards. Duplicated across the admin pages per the
     scoped-style convention (AGENTS.md); keep them in sync. */
  .admin-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    inline-size: fit-content;
    max-inline-size: 100%;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--admin-surface-3);
  }
  .admin-filters__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2rem;
    padding: var(--space-1) var(--space-3);
    border-radius: 6px;
    color: var(--color-fg-muted);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }
  .admin-filters__chip:hover {
    color: var(--color-fg);
  }
  .admin-filters__count {
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  .admin-filters__chip--active {
    background: var(--admin-surface);
    color: var(--color-fg);
    font-weight: var(--fw-semibold);
    box-shadow:
      inset 0 -2px 0 var(--admin-accent),
      var(--admin-shadow-sm),
      0 0 0 1px var(--color-border);
  }
  @media (forced-colors: active) {
    .admin-filters__chip--active {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }
  }
  .admin-refresh-note {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  .admin-refresh-note__toggle {
    margin-inline-start: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-link);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .admin-empty {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--admin-surface);
    color: var(--color-fg-muted);
  }
  /* A search-miss line ships [hidden] and the script reveals it; the grid
     display above would otherwise beat the UA [hidden] rule and show it on
     every load. */
  .admin-empty[hidden] {
    display: none;
  }
  .admin-empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .admin-empty__body {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .admin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  /* The dashboard's error state: a solid card with an error rule. */
  .admin-action-error {
    margin: 0;
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: inset 3px 0 0 var(--admin-error);
    color: var(--color-fg);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  @media (forced-colors: active) {
    .admin-action-error {
      border-inline-start: 3px solid CanvasText;
    }
  }
</style>

<script>
  import {
    denyPublicationRequest,
    dispatchPublicationApproval,
    getPublicationReview,
    startPublicationReview,
  } from "../../lib/admin-api";
  import {
    ACK_MAX,
    type ApproveBody,
    DENIAL_MAX,
    FRIENDLY_WORDS,
    type FailureView,
    type OfferedControl,
    type PanelModel,
    UI_WORDS,
    approveBody,
    describeFailure,
    describeStartSuccess,
    panelModel,
  } from "../../lib/publication-review";

  // This script wires events, calls the client, hands what comes back to the pure functions in
  // `lib/publication-review.ts` and draws the `PanelModel` they return with createElement and
  // textContent. It decides nothing and words nothing: every sentence is the API's own, the mirrored
  // copy table's, or one of the lib's page-owned words.

  const errorEl = document.querySelector<HTMLElement>("[data-admin-action-error]");

  // `refresh` adds a link back to this page. After a failed start the outcome
  // may not be what the buttons on screen say (a timed-out request can still
  // have dispatched, a 409 means someone else already did), so the admin gets a
  // one-click way to see the real state. The auto-refresh stays off while the
  // message is up so it is not wiped within seconds.
  function showError(msg: string, opts: { refresh?: boolean } = {}): void {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = msg;
    if (opts.refresh) {
      const link = document.createElement("a");
      link.href = location.href;
      link.textContent = "Refresh to see the current state.";
      errorEl.append(" ", link);
    }
  }
  function clearError(): void {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  }

  type PendingAction =
    | {
        kind: "approve" | "resume";
        datasetId: string;
        dialogId: string;
        /** Built by `approveBody` from the control the panel was drawn with. */
        body: ApproveBody;
        panel: HTMLElement;
      }
    | { kind: "deny"; datasetId: string; reason: string; requestId: number };
  let pending: PendingAction | null = null;
  let inFlight = false;

  function openDialog(dialogId: string): void {
    document.dispatchEvent(
      new CustomEvent<{ dialogId: string }>("nemar:open-confirm-dialog", {
        detail: { dialogId },
      }),
    );
  }

  // True when the action was queued. A click during a call is refused, and its caller must not open
  // a dialog whose confirmation would find nothing pending.
  function queue(next: PendingAction): boolean {
    if (inFlight) return false;
    if (pending) console.warn("[admin] overwriting un-confirmed pending action", pending);
    pending = next;
    clearError();
    return true;
  }

  // ---------------------------------------------------------------------------------------------
  // The review panel
  // ---------------------------------------------------------------------------------------------

  interface PanelState {
    /** The offered control the panel was drawn with: the body names exactly what was shown. */
    control: OfferedControl | null;
    /** Bumped by every load and every close, so a slow answer never overwrites a newer panel. */
    token: number;
  }
  const states = new WeakMap<HTMLElement, PanelState>();
  function stateOf(panel: HTMLElement): PanelState {
    let state = states.get(panel);
    if (!state) {
      state = { control: null, token: 0 };
      states.set(panel, state);
    }
    return state;
  }

  interface DrawOptions {
    error?: FailureView | null;
    notice?: string | null;
    /** What the administrator had typed in the reason field, kept across a re-read. */
    acknowledgment?: string;
    focusAck?: boolean;
    focusPanel?: boolean;
  }

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }
  const toneClass = (tone: string): string => `pubreq-review-tone--${tone}`;
  const TEXT = "pubreq-review__text";
  const TEXT_MUTED = `${TEXT} ${TEXT}--muted`;
  const BUTTON = "pubreq-review__btn";
  const buttonClass = (primary: boolean): string => (primary ? `${BUTTON} ${BUTTON}--primary` : BUTTON);

  function section(heading: string | null, ...children: HTMLElement[]): HTMLElement {
    const node = el("section", "pubreq-review__section");
    if (heading) node.append(el("h5", "pubreq-review__heading", heading));
    node.append(...children);
    return node;
  }
  function list(items: readonly string[]): HTMLElement {
    const ul = el("ul", "pubreq-review__list");
    for (const item of items) ul.append(el("li", undefined, item));
    return ul;
  }

  function errorNode(failure: FailureView): HTMLElement {
    const node = el("p", "pubreq-review__error", failure.text);
    node.setAttribute("role", "alert");
    node.setAttribute("data-pubreq-review-error", "");
    if (failure.refreshLink) {
      const link = el("a", undefined, "Refresh to see the current state.");
      link.href = location.href;
      node.append(" ", link);
    }
    return node;
  }
  // Show a failure without redrawing: the panel keeps what the administrator is looking at.
  function setPanelError(panel: HTMLElement, failure: FailureView): void {
    panel.querySelector("[data-pubreq-review-error]")?.remove();
    const node = errorNode(failure);
    const title = panel.querySelector(".pubreq-review__title");
    if (title) title.after(node);
    else panel.prepend(node);
  }

  const RECHECK = "pubreq:recheck";
  // The panel's Approve is off for the length of a call; when the call ends without a redraw it
  // works out its own state again from the inputs, so a field the administrator emptied stays off.
  function setApproveBusy(panel: HTMLElement, busy: boolean): void {
    for (const button of panel.querySelectorAll<HTMLButtonElement>("[data-pubreq-panel-approve]")) {
      if (busy) button.disabled = true;
      else button.dispatchEvent(new Event(RECHECK));
    }
  }

  function rowStartOf(panel: HTMLElement): "approve" | "resume" | null {
    const start = panel.dataset.rowStart;
    return start === "approve" || start === "resume" ? start : null;
  }
  function panelOf(from: HTMLElement): HTMLElement | null {
    return (
      from
        .closest("[data-pubreq-row]")
        ?.querySelector<HTMLElement>("[data-pubreq-review-panel]") ?? null
    );
  }
  function setToggle(panel: HTMLElement, open: boolean): void {
    const toggle = panel
      .closest("[data-pubreq-row]")
      ?.querySelector<HTMLButtonElement>("[data-pubreq-review-toggle]");
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? UI_WORDS.buttons.hide : UI_WORDS.buttons.show;
  }

  function drawControls(panel: HTMLElement, model: PanelModel, opts: DrawOptions): HTMLElement {
    const controls = el("div", "pubreq-review__controls");
    const actions = el("div", "pubreq-review__actions");
    let focusTarget: HTMLElement | null = null;
    const control = stateOf(panel).control;

    if (model.approve.kind === "unavailable") {
      // `text` is the control's own sentence (the mirrored copy or the lib's out-of-step words).
      controls.append(el("p", "pubreq-review__text", model.approve.text));
    } else if (model.approve.kind !== "offered") {
      for (const text of model.approve.lines) controls.append(el("p", "pubreq-review__text", text));
    }

    if (control) {
      if (control.notice) controls.append(el("p", "pubreq-review__text", control.notice));
      let box: HTMLInputElement | null = null;
      let area: HTMLTextAreaElement | null = null;
      const count = el("span", "pubreq-review__count");

      if (model.overrideLabel) {
        const label = el("label", "pubreq-review__check");
        box = el("input");
        box.type = "checkbox";
        label.append(box, el("span", undefined, model.overrideLabel));
        controls.append(label);
      }
      if (model.ackPrompt) {
        const field = el("div", "pubreq-review__field");
        area = el("textarea");
        area.id = `${panel.id}-reason`;
        area.rows = 4;
        area.maxLength = ACK_MAX;
        area.value = opts.acknowledgment ?? "";
        const label = el("label", undefined, model.ackPrompt);
        label.htmlFor = area.id;
        field.append(label, area, count);
        controls.append(field);
        focusTarget = area;
      }

      const approve = el("button", buttonClass(true));
      approve.type = "button";
      approve.setAttribute("data-pubreq-panel-approve", "");
      approve.textContent =
        control.mode === "resume"
          ? UI_WORDS.buttons.resume
          : panel.dataset.rowLabel === UI_WORDS.buttons.retry
            ? UI_WORDS.buttons.retry
            : UI_WORDS.buttons.approve;
      const readInput = () => ({
        overrideConfirmed: box?.checked ?? false,
        acknowledgment: area?.value ?? "",
      });
      const refresh = () => {
        approve.disabled = !approveBody(control, readInput()).ok || inFlight;
        if (area) count.textContent = `${area.value.length} / ${ACK_MAX}`;
      };
      // `setApproveBusy(panel, false)` asks for this when a call ends without a redraw.
      approve.addEventListener(RECHECK, refresh);
      box?.addEventListener("change", refresh);
      area?.addEventListener("input", refresh);
      refresh();
      approve.addEventListener("click", () => {
        const built = approveBody(control, readInput());
        const datasetId = panel.dataset.datasetId;
        if (!built.ok || !datasetId) return;
        const queued = queue({
          kind: control.mode,
          datasetId,
          dialogId: control.dialogId,
          body: built.body,
          panel,
        });
        if (!queued) return;
        openDialog(control.dialogId);
      });
      actions.append(approve);
    }

    if (model.start.offered) {
      const start = el("button", buttonClass(false), UI_WORDS.buttons.start);
      start.type = "button";
      start.addEventListener("click", () => void startReview(panel, start));
      actions.append(start);
    }
    const refreshButton = el("button", buttonClass(false), UI_WORDS.buttons.refresh);
    refreshButton.type = "button";
    refreshButton.addEventListener("click", () => void loadPanel(panel));
    actions.append(refreshButton);
    controls.append(actions);

    if (opts.focusAck && focusTarget) queueMicrotask(() => focusTarget?.focus());
    return controls;
  }

  function drawPanel(panel: HTMLElement, model: PanelModel, opts: DrawOptions): void {
    const state = stateOf(panel);
    state.control = model.approve.kind === "offered" ? model.approve : null;

    const nodes: HTMLElement[] = [el("h4", "pubreq-review__title", UI_WORDS.headings.review)];
    if (opts.error) nodes.push(errorNode(opts.error));
    if (opts.notice) {
      const notice = el("p", "pubreq-review__notice", opts.notice);
      notice.setAttribute("role", "status");
      nodes.push(notice);
    }
    if (model.headline) {
      nodes.push(el("p", toneClass(model.headline.tone), model.headline.text));
    }
    if (model.screen) {
      nodes.push(
        section(
          UI_WORDS.headings.screen,
          el("p", toneClass(model.screen.tone), model.screen.headline),
          list(model.screen.lines),
        ),
      );
    }
    if (model.reasonsWithheld) {
      nodes.push(
        section(UI_WORDS.headings.reasons, el("p", "pubreq-review__text", model.reasonsWithheld)),
      );
    } else if (model.reasons.length > 0) {
      const cards = model.reasons.map((reason) => {
        const card = el("div", "pubreq-review__reason");
        const tags = el("div", "pubreq-review__reason-tags");
        tags.append(
          el("span", "pubreq-review__tag", reason.classLabel),
          el("span", "pubreq-review__tag", reason.clearedLabel),
        );
        card.append(
          tags,
          el("p", "pubreq-review__text", reason.statement),
          el("p", "pubreq-review__cure", reason.cure),
        );
        return card;
      });
      nodes.push(section(UI_WORDS.headings.reasons, ...cards));
    }
    if (model.factNotes.length > 0) {
      nodes.push(section(UI_WORDS.headings.checks, list(model.factNotes)));
    }
    if (model.model) {
      const written = el("div", "pubreq-review__model");
      if (model.model.summary !== null) {
        written.append(
          section(
            model.model.summaryLabel,
            el("p", "pubreq-review__text", model.model.summary),
          ),
        );
      }
      if (model.model.findings.length > 0) {
        const findings = model.model.findings.map((finding) => {
          const item = el("div", "pubreq-review__finding");
          item.append(el("span", "pubreq-review__finding-label", finding.label));
          if (finding.documentLabel) {
            item.append(el("span", "pubreq-review__finding-document", finding.documentLabel));
          }
          item.append(el("p", "pubreq-review__text", finding.note));
          return item;
        });
        written.append(section(model.model.findingsLabel, ...findings));
      }
      nodes.push(written);
    }
    if (model.standing) {
      nodes.push(el("p", TEXT_MUTED, model.standing));
    }
    nodes.push(drawControls(panel, model, opts));
    panel.replaceChildren(...nodes);
    if (opts.focusPanel) panel.focus();
  }

  // Every open reads the detail again: there is no cache, so what is on screen is what the API
  // said a moment ago, and the control is computed from exactly that answer.
  async function loadPanel(panel: HTMLElement, opts: DrawOptions = {}): Promise<void> {
    const datasetId = panel.dataset.datasetId;
    if (!datasetId) return;
    const state = stateOf(panel);
    state.control = null;
    const token = ++state.token;
    panel.setAttribute("aria-busy", "true");
    panel.replaceChildren(el("p", "pubreq-review__text", UI_WORDS.buttons.loading));
    try {
      const detail = await getPublicationReview(datasetId);
      if (token !== state.token) return;
      drawPanel(panel, panelModel(detail, { rowStart: rowStartOf(panel) }), opts);
    } catch (err) {
      if (token !== state.token) return;
      const retry = el("button", buttonClass(false), UI_WORDS.buttons.refresh);
      retry.type = "button";
      retry.addEventListener("click", () => void loadPanel(panel));
      panel.replaceChildren(
        el("h4", "pubreq-review__title", UI_WORDS.headings.review),
        errorNode(describeFailure("detail", err)),
        retry,
      );
    } finally {
      if (token === state.token) panel.removeAttribute("aria-busy");
    }
  }

  async function openPanel(panel: HTMLElement, opts: DrawOptions = {}): Promise<void> {
    panel.hidden = false;
    setToggle(panel, true);
    await loadPanel(panel, opts);
  }

  function closePanel(panel: HTMLElement): void {
    stateOf(panel).token++;
    stateOf(panel).control = null;
    panel.hidden = true;
    panel.replaceChildren();
    setToggle(panel, false);
  }

  // Where a failure is shown. A panel that was closed while the call ran has nowhere to draw it, so
  // the page's own error region says it instead; an open panel re-reads when the failure asks for
  // that and otherwise keeps what the administrator is looking at.
  async function reportFailure(
    panel: HTMLElement,
    failure: FailureView,
    extra: DrawOptions = {},
  ): Promise<void> {
    if (panel.hidden) {
      showError(failure.text, { refresh: failure.refreshLink });
      return;
    }
    if (failure.refetch) await loadPanel(panel, { ...extra, error: failure });
    else setPanelError(panel, failure);
  }

  async function startReview(panel: HTMLElement, button: HTMLButtonElement): Promise<void> {
    const datasetId = panel.dataset.datasetId;
    if (!datasetId) return;
    button.disabled = true;
    try {
      const started = await startPublicationReview(datasetId);
      // Closed meanwhile: the review has started, and opening the panel reads it fresh.
      if (!panel.hidden) await loadPanel(panel, { notice: describeStartSuccess(started) });
    } catch (err) {
      await reportFailure(panel, describeFailure("start", err));
      button.disabled = false;
    }
  }

  // After a refused Approve the page reads the detail again, the one authoritative answer: the
  // refusal's own body is not drawn. The override box comes back unticked (the panel is redrawn
  // from the new answer) and the reason the administrator typed is kept.
  async function afterApproveFailure(panel: HTMLElement, err: unknown): Promise<void> {
    const failure = describeFailure("approve", err);
    const typed = panel.querySelector<HTMLTextAreaElement>("textarea")?.value;
    setApproveBusy(panel, false);
    await reportFailure(panel, failure, { acknowledgment: typed, focusAck: failure.focusAck });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-pubreq-review-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = panelOf(btn);
      if (!panel) return;
      if (panel.hidden) void openPanel(panel);
      else closePanel(panel);
    });
  });

  // The row's Approve and Resume open the panel (which then offers the dialog), never the dialog:
  // the dialog cannot hold the confirmation box or the reason field the API may require first.
  document.querySelectorAll<HTMLButtonElement>("[data-pubreq-approve]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = panelOf(btn);
      if (!panel) return showError(FRIENDLY_WORDS.generic);
      void openPanel(panel, { focusPanel: true });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-pubreq-resume]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = panelOf(btn);
      if (!panel) return showError(FRIENDLY_WORDS.generic);
      void openPanel(panel, { focusPanel: true });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-pubreq-deny]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      const requestId = Number(btn.dataset.requestId);
      if (!id) return;
      if (!Number.isInteger(requestId)) return showError(FRIENDLY_WORDS.generic);
      const rawReason = window.prompt("Reason for denial?");
      if (rawReason === null) {
        pending = null;
        return;
      }
      const reason = rawReason.trim();
      if (reason.length === 0 || reason.length > DENIAL_MAX) {
        pending = null;
        showError(reason.length === 0 ? FRIENDLY_WORDS.missing_field : FRIENDLY_WORDS.deny_rejected);
        return;
      }
      if (!queue({ kind: "deny", datasetId: id, reason, requestId })) return;
      openDialog("admin-deny");
    });
  });

  // While an approval is active the page refreshes itself. It waits for a quiet
  // moment: a hidden tab, an open dialog, a click in flight, an error message
  // on screen, an open review panel (a typed reason must survive) or the admin's
  // own pause must not be reloaded out from under them.
  // The dialog check reads the DOM rather than `pending`: cancelling a dialog
  // never reaches this script, so `pending` can stay set for good.
  let paused = false;
  const toggle = document.querySelector<HTMLButtonElement>("[data-refresh-toggle]");
  toggle?.addEventListener("click", () => {
    paused = !paused;
    toggle.textContent = paused ? "Resume refreshing" : "Pause";
  });
  if (document.querySelector("[data-pubreq-running]")) {
    window.setInterval(() => {
      const quiet =
        document.visibilityState === "visible" &&
        !inFlight &&
        !paused &&
        !document.querySelector("dialog[open]") &&
        !document.querySelector("[data-pubreq-review-panel]:not([hidden])") &&
        (errorEl?.hidden ?? true);
      if (quiet) location.reload();
    }, 20_000);
  }

  document.addEventListener("nemar:confirm-dialog-confirm", async (evt) => {
    const e = evt as CustomEvent<{ dialogId: string }>;
    if (!pending) return;

    if (
      (pending.kind === "approve" || pending.kind === "resume") &&
      e.detail.dialogId === pending.dialogId
    ) {
      const target = pending;
      pending = null;
      inFlight = true;
      setApproveBusy(target.panel, true);
      try {
        await dispatchPublicationApproval(target.datasetId, { body: target.body });
        location.reload();
      } catch (err) {
        inFlight = false;
        await afterApproveFailure(target.panel, err);
      }
      return;
    }
    if (e.detail.dialogId === "admin-deny" && pending.kind === "deny") {
      const target = pending;
      pending = null;
      inFlight = true;
      try {
        await denyPublicationRequest(target.datasetId, target.reason, {
          requestId: target.requestId,
        });
        location.reload();
      } catch (err) {
        const failure = describeFailure("deny", err);
        showError(failure.text, { refresh: failure.refreshLink });
        inFlight = false;
      }
      return;
    }
    console.error(
      "[admin] confirm-dialog event did not match queued pending action",
      e.detail.dialogId,
      pending,
    );
  });
</script>
