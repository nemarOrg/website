<script>
  import { ACCOUNT_COPY } from "../../lib/account-copy";
  import { decideComputeAccess, getComputeAccount } from "../../lib/compute-admin-api";
  import type { ComputeAccessDecision } from "../../lib/compute-admin-contract";
  import { createDecideFlow } from "../../lib/compute-decide-flow";
  import { requestRowModel } from "../../lib/compute-admin-view";
  import {
    applyRowModel,
    markRowStale,
    setRowNote,
    setRowWorking,
  } from "../../lib/compute-row-dom";

  const page = document.querySelector<HTMLElement>("[data-compute-page]");
  if (page) {
    const viewer = { userId: page.dataset.viewerId ?? "", isOwner: page.dataset.viewerOwner === "1" };
    const flow = createDecideFlow({
      decide: (id, decision, reason) => decideComputeAccess(id, decision, reason),
      reread: (id) => getComputeAccount(id),
    });

    const rowOf = (id: number): HTMLElement | null =>
      page.querySelector<HTMLElement>(`[data-compute-row][data-account-id="${id}"]`);
    const text = (row: HTMLElement, field: string): string =>
      row.querySelector<HTMLElement>(`[data-field="${field}"]`)?.textContent?.trim() ?? "";

    // One decision in flight page-wide: every decision button is locked while one is out, and
    // goes back to what it was afterwards.
    function lockPage(locked: boolean): void {
      for (const b of page?.querySelectorAll<HTMLButtonElement>("[data-decision]") ?? []) {
        if (locked) {
          b.dataset.lockPrior = b.disabled ? "1" : "0";
          b.disabled = true;
        } else if (b.dataset.lockPrior !== undefined) {
          b.disabled = b.dataset.lockPrior === "1";
          delete b.dataset.lockPrior;
        }
      }
    }

    // A click opens the dialog; it never sends anything.
    page.addEventListener("click", (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-decision]");
      if (!button || button.disabled || flow.busy) return;
      const id = Number(button.dataset.accountId);
      const row = rowOf(id);
      if (!row || !Number.isSafeInteger(id)) return;
      document.dispatchEvent(
        new CustomEvent("nemar:compute-decision-open", {
          detail: {
            id,
            decision: button.dataset.decision,
            label: button.textContent ?? "",
            subject: {
              account: `${text(row, "name")} ${text(row, "username")} #${id}`,
              country: text(row, "country"),
              affiliation: text(row, "affiliation"),
            },
          },
        }),
      );
    });

    document.addEventListener("nemar:compute-decision-confirm", async (event) => {
      const { id, decision, reason } = (
        event as CustomEvent<{ id: number; decision: ComputeAccessDecision; reason: string }>
      ).detail;
      const row = rowOf(id);
      if (!row || flow.busy) return;
      lockPage(true);
      setRowWorking(row, true, ACCOUNT_COPY["compute_admin.result.working"]);
      const out = await flow.submit({ id, decision, reason });
      lockPage(false);
      setRowWorking(row, false, "");
      if (out.outcome === "ignored") return;
      if (out.outcome === "done") {
        applyRowModel(row, requestRowModel(out.row, viewer));
        setRowNote(row, [out.note.text, out.note.emailNote ?? ""], "ok");
      } else {
        if (out.row) applyRowModel(row, requestRowModel(out.row, viewer));
        setRowNote(row, [out.note.text], "error");
        if (out.note.stale || out.rereadFailed || (out.note.reread && out.row === null)) {
          markRowStale(row);
        }
      }
      row.focus();
    });
  }
</script>
