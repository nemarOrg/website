---
import Base from "../layouts/Base.astro";
import { appUrl } from "../lib/host";

const loginHref = appUrl("/login", new URL(Astro.request.url).hostname);
---

<Base
  title="Sign up for NEMAR"
  description="Create a NEMAR account with your ORCID iD. Takes about a minute, no install required."
>
  <section class="signup">
    <div class="signup__atmosphere" aria-hidden="true"></div>

    <article class="signup__panel">
      <div class="signup__rail" aria-hidden="true"></div>

      <header class="signup__head">
        <p class="signup__eyebrow">Creating a NEMAR account</p>
        <h1 class="signup__title">Sign up with your <em>ORCID</em></h1>
        <p class="signup__lede">
          Your ORCID iD is the only credential you need. Sign in with it and, if
          you don&rsquo;t have a NEMAR account yet, we create one on the spot &mdash;
          nothing to install, no waiting on approval to start browsing.
        </p>
      </header>

      <ol class="signup__steps">
        <li class="signup__step">
          <span class="signup__step-num" aria-hidden="true">1</span>
          <div>
            <h2 class="signup__step-title">Authorize with ORCID</h2>
            <p class="signup__step-body">
              Head to <a href={loginHref}>sign in</a> and press
              &ldquo;Sign in with ORCID&rdquo;. It&rsquo;s the same button
              whether or not you already have a NEMAR account &mdash; we work out
              which from your iD. No ORCID yet? They&rsquo;re free at
              <a href="https://orcid.org" rel="external noopener">orcid.org</a>.
            </p>
          </div>
        </li>

        <li class="signup__step">
          <span class="signup__step-num" aria-hidden="true">2</span>
          <div>
            <h2 class="signup__step-title">Tell us where to reach you</h2>
            <p class="signup__step-body">
              First-time visitors get a short form: email, city, and country.
              City and country are required for export-control screening, not
              analytics. Affiliation is optional.
            </p>
          </div>
        </li>

        <li class="signup__step">
          <span class="signup__step-num" aria-hidden="true">3</span>
          <div>
            <h2 class="signup__step-title">You&rsquo;re in</h2>
            <p class="signup__step-body">
              Your account is active as soon as you submit &mdash; browse,
              search, and use your dashboard right away. There&rsquo;s no
              approval queue standing between you and the data.
            </p>
          </div>
        </li>
      </ol>

      <section class="signup__detail" aria-labelledby="signup-upload">
        <h2 id="signup-upload" class="signup__detail-title">Uploading is a separate step</h2>
        <p class="signup__step-body">
          Signing up gets you a reading account. Contributing data or running
          compute needs one additional grant from an admin, who checks your
          GitHub handle and location against export-control and local
          restrictions. That review happens when you ask for upload access, not
          when you sign up, so nothing blocks you in the meantime. Your GitHub
          handle is collected then rather than now &mdash; it&rsquo;s only needed
          once a dataset of yours is headed for publication.
        </p>
      </section>

      <section class="signup__detail" aria-labelledby="signup-need">
        <h2 id="signup-need" class="signup__detail-title">What sign-up asks you for</h2>
        <dl class="signup__list">
          <div class="signup__list-row">
            <dt>ORCID</dt>
            <dd>
              Your identity. It carries your name across, so there&rsquo;s no
              separate display-name field. Free to create at
              <a href="https://orcid.org" rel="external noopener">orcid.org</a>.
            </dd>
          </div>
          <div class="signup__list-row">
            <dt>Email</dt>
            <dd>
              How we reach you, and how the 6-digit code sign-in works if you
              ever want to sign in without ORCID. We don&rsquo;t share it.
            </dd>
          </div>
          <div class="signup__list-row">
            <dt>City and country</dt>
            <dd>
              Required. NEMAR&rsquo;s compute is subject to export-control and
              local-jurisdiction rules, so an admin needs to know where you are
              before granting upload access.
            </dd>
          </div>
          <div class="signup__list-row">
            <dt>Affiliation</dt>
            <dd>Your institution. Optional but appreciated for the citation graph.</dd>
          </div>
          <div class="signup__list-row">
            <dt>GitHub handle</dt>
            <dd>
              Not asked for at sign-up. Datasets get an underlying repository
              under <code>nemarDatasets</code>, so we collect this when you
              request upload access.
            </dd>
          </div>
        </dl>
      </section>

      <footer class="signup__foot">
        <a class="signup__cta signup__cta--primary" href={loginHref}>
          Sign up with ORCID
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="signup__cta signup__cta--ghost" href={loginHref}>
          I already have an account
        </a>
      </footer>

      <p class="signup__future" role="note">
        Prefer the terminal? <code>nemar auth signup</code> in the
        <a href="https://docs.nemar.org" rel="external noopener">NEMAR CLI</a>
        does the same thing and is still fully supported &mdash; it just
        isn&rsquo;t required any more.
      </p>
    </article>
  </section>
</Base>

<style>
  .signup {
    position: relative;
    isolation: isolate;
    min-block-size: calc(100dvh - var(--header-height));
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--space-4);

    --signup-bg-1: #eef3fb;
    --signup-bg-2: #f8fafc;
    --signup-glow: rgb(91 186 213 / 14%);
    --signup-glow-2: rgb(96 60 186 / 10%);
    --signup-panel-bg: var(--color-bg);
    --signup-panel-border: var(--color-border);
    --signup-code-bg: var(--color-bg-elevated);
    --signup-code-border: var(--color-border);

    background:
      radial-gradient(ellipse at 18% 8%, var(--signup-glow), transparent 55%),
      radial-gradient(ellipse at 92% 92%, var(--signup-glow-2), transparent 60%),
      linear-gradient(180deg, var(--signup-bg-1), var(--signup-bg-2));
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .signup {
      --signup-bg-1: #060d24;
      --signup-bg-2: #0a1638;
      --signup-glow: rgb(91 186 213 / 18%);
      --signup-glow-2: rgb(96 60 186 / 16%);
      --signup-panel-bg: rgb(255 255 255 / 4%);
      --signup-panel-border: rgb(255 255 255 / 10%);
      --signup-code-bg: rgb(255 255 255 / 6%);
      --signup-code-border: rgb(255 255 255 / 10%);
    }
  }
  :global(:root[data-theme="dark"]) .signup {
    --signup-bg-1: #060d24;
    --signup-bg-2: #0a1638;
    --signup-glow: rgb(91 186 213 / 18%);
    --signup-glow-2: rgb(96 60 186 / 16%);
    --signup-panel-bg: rgb(255 255 255 / 4%);
    --signup-panel-border: rgb(255 255 255 / 10%);
    --signup-code-bg: rgb(255 255 255 / 6%);
    --signup-code-border: rgb(255 255 255 / 10%);
  }

  .signup__atmosphere {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 14% 18%, rgb(91 186 213 / 22%) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 82% 24%, rgb(96 60 186 / 25%) 50%, transparent 51%),
      radial-gradient(1px 1px at 10% 78%, rgb(91 186 213 / 22%) 50%, transparent 51%);
    pointer-events: none;
    z-index: -1;
  }

  .signup__panel {
    position: relative;
    inline-size: 100%;
    max-inline-size: 44rem;
    background: var(--signup-panel-bg);
    border: 1px solid var(--signup-panel-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8) var(--space-8);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 6%) inset,
      0 24px 64px -32px rgb(15 23 42 / 25%),
      0 2px 4px rgb(15 23 42 / 4%);
    backdrop-filter: blur(12px);
    animation: signup-rise 480ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .signup__rail {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 3px;
    background: linear-gradient(90deg, var(--brand-teal), var(--brand-purple));
    opacity: 0.85;
  }

  .signup__head {
    margin-block-end: var(--space-8);
  }
  .signup__eyebrow {
    margin: 0 0 var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    color: var(--brand-teal);
    font-weight: var(--fw-semibold);
  }
  .signup__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(var(--fs-3xl), 4vw, var(--fs-4xl));
    font-weight: var(--fw-semibold);
    letter-spacing: -0.015em;
    line-height: var(--lh-tight);
  }
  .signup__title em {
    font-style: normal;
    background: linear-gradient(90deg, var(--brand-teal), var(--brand-purple));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .signup__lede {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
    max-inline-size: 42rem;
  }

  /* ---------- Steps ---------- */
  .signup__steps {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .signup__step {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .signup__step-num {
    inline-size: 32px;
    block-size: 32px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--brand-teal) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-teal) 40%, transparent);
    color: var(--brand-teal);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .signup__step-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
    line-height: var(--lh-snug);
  }
  .signup__step-body {
    margin: 0 0 var(--space-2);
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
    font-size: var(--fs-sm);
  }
  .signup__step-body a {
    color: var(--color-link);
  }
  .signup__code {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--signup-code-bg);
    border: 1px solid var(--signup-code-border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-fg);
    overflow-x: auto;
  }
  .signup__code code {
    color: inherit;
  }

  /* ---------- "What sign-up asks you for" ---------- */
  .signup__detail {
    margin: 0 0 var(--space-6);
    padding: var(--space-6);
    background: color-mix(in srgb, var(--brand-teal) 4%, var(--color-bg-subtle));
    border: 1px solid color-mix(in srgb, var(--brand-teal) 20%, var(--color-border));
    border-radius: var(--radius-lg);
  }
  .signup__detail-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
  }
  .signup__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .signup__list-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    align-items: start;
  }
  .signup__list-row dt {
    color: var(--color-fg);
    font-weight: var(--fw-semibold);
  }
  .signup__list-row dd {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: var(--lh-normal);
  }
  .signup__list-row a {
    color: var(--color-link);
  }
  .signup__list-row code {
    font-family: var(--font-mono);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0 6px;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }
  @media (max-width: 560px) {
    .signup__list-row { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  /* ---------- Footer CTAs ---------- */
  .signup__foot {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
    margin-block-end: var(--space-4);
  }
  .signup__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 48px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    font-size: var(--fs-base);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .signup__cta svg {
    transition: transform 0.2s ease;
  }
  .signup__cta--primary {
    background: var(--brand-navy);
    color: #f8fafc;
    box-shadow: 0 8px 24px -10px rgb(11 26 58 / 50%);
  }
  .signup__cta--primary:hover {
    background: color-mix(in srgb, var(--brand-navy) 84%, var(--brand-teal));
    box-shadow:
      0 8px 24px -10px rgb(11 26 58 / 50%),
      0 0 0 6px color-mix(in srgb, var(--brand-teal) 18%, transparent);
  }
  .signup__cta--primary:hover svg {
    transform: translateX(3px);
  }
  .signup__cta--ghost {
    background: transparent;
    color: var(--color-fg);
    border: 1px solid var(--color-border-strong);
  }
  .signup__cta--ghost:hover {
    background: var(--color-bg-subtle);
    border-color: var(--color-fg-muted);
  }

  .signup__future {
    margin: 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }
  .signup__future a {
    color: var(--color-link);
  }

  @keyframes signup-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .signup__panel { animation: none; }
  }
  @media (max-width: 560px) {
    .signup__panel { padding: var(--space-8) var(--space-5) var(--space-6); }
    .signup__step { grid-template-columns: 28px 1fr; gap: var(--space-3); }
    .signup__step-num { inline-size: 28px; block-size: 28px; font-size: var(--fs-xs); }
    .signup__detail { padding: var(--space-4); }
  }
</style>
