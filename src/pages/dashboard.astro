---
import ConfirmDialog from "../components/ConfirmDialog.astro";
import MyDatasetCard from "../components/MyDatasetCard.astro";
import Base from "../layouts/Base.astro";
import { getSession } from "../lib/auth";
import type { PublicationStatus, listMyDatasets } from "../lib/dashboard-api";
import { listForOwner } from "./api/datasets/_store";

const session = getSession(Astro.locals);
if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent("/dashboard")}`);
}

// Same-origin SSR shortcut: bypass the network and read the in-memory store
// directly. Phase 5 cutover swaps both this and the listMyDatasets HTTP path
// for a direct `api.nemar.org/datasets?mine=true` call.
const url = new URL(Astro.request.url);
const limit = 50;
const offset = Math.max(0, Number.parseInt(url.searchParams.get("offset") ?? "0", 10) || 0);

let datasets: Awaited<ReturnType<typeof listMyDatasets>>["datasets"] = [];
let total = 0;
let listError: string | null = null;
try {
  const result = listForOwner(session.user.email, { limit, offset });
  datasets = result.datasets;
  total = result.total;
} catch (err) {
  listError = err instanceof Error ? err.message : "Could not load your datasets.";
}

// Get publish status for each dataset to drive the badges + actions. The
// mock store is in-process so this is a synchronous map lookup; with the
// real backend, this becomes a fan-out fetch we'd batch.
import { getPublishStatus } from "./api/datasets/_store";
const statuses: Record<string, PublicationStatus | null> = {};
for (const d of datasets) {
  statuses[d.dataset_id] = getPublishStatus(session.user.email, d.dataset_id) ?? null;
}

const pendingNotice =
  session.user.status === "pending"
    ? "Your account is still under admin review. Most actions are locked until you're approved."
    : null;
---

<Base
  title="My datasets"
  description="Manage the datasets you've uploaded to NEMAR."
>
  <section class="dashboard-shell">
    <header class="dashboard-header">
      <div>
        <h1 class="dashboard-header__title">My datasets</h1>
        <p class="dashboard-header__lede">
          {total === 0
            ? "No datasets yet."
            : `${total} dataset${total === 1 ? "" : "s"} owned by you.`}
        </p>
      </div>
      <a class="dashboard-header__cta" href="/upload">Upload dataset</a>
    </header>

    {pendingNotice && (
      <p class="dashboard-notice" role="status">{pendingNotice}</p>
    )}

    {listError && (
      <p class="dashboard-error" role="alert">{listError}</p>
    )}

    {!listError && datasets.length === 0 ? (
      <div class="dashboard-empty">
        <h2 class="dashboard-empty__title">You haven&rsquo;t uploaded any datasets yet</h2>
        <p class="dashboard-empty__body">
          Drop a BIDS folder on the upload page and we&rsquo;ll create your first dataset.
        </p>
        <a class="dashboard-empty__cta" href="/upload">Upload your first dataset</a>
      </div>
    ) : (
      <ul class="dashboard-list" role="list">
        {datasets.map((d) => (
          <li>
            <MyDatasetCard dataset={d} publishStatus={statuses[d.dataset_id]} />
          </li>
        ))}
      </ul>
    )}

    <p class="dashboard-action-error" role="alert" data-dashboard-action-error hidden></p>
  </section>

  <ConfirmDialog
    dialogId="dashboard-request-publication"
    title="Request publication review?"
    body="An admin will review the dataset's BIDS validation and approve or block it. You'll get an email when there's a decision."
    confirmLabel="Request review"
    confirmTone="primary"
  />

  <ConfirmDialog
    dialogId="dashboard-delete-dataset"
    title="Delete this draft?"
    body="This removes the dataset and its files from NEMAR. The action can't be undone."
    confirmLabel="Delete dataset"
    confirmTone="danger"
    requireTyping="DELETE"
  />
</Base>

<style>
  .dashboard-shell {
    max-inline-size: 64rem;
    margin: 0 auto;
    padding: var(--space-10) var(--space-4) var(--space-16);
    display: grid;
    gap: var(--space-6);
  }
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .dashboard-header__title {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    margin: 0 0 var(--space-1);
  }
  .dashboard-header__lede {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .dashboard-header__cta {
    min-block-size: 44px;
    padding: 0 var(--space-5);
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }
  .dashboard-header__cta:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .dashboard-notice {
    margin: 0;
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .dashboard-error {
    margin: 0;
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .dashboard-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    text-align: center;
  }
  .dashboard-empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
  }
  .dashboard-empty__body {
    margin: 0;
    color: var(--color-fg-muted);
    max-inline-size: 32rem;
  }
  .dashboard-empty__cta {
    margin-block-start: var(--space-2);
    min-block-size: 44px;
    padding: 0 var(--space-5);
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }
  .dashboard-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .dashboard-action-error {
    margin: 0;
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
</style>

<script>
  import {
    DashboardApiError,
    deleteDraftDataset,
    requestPublication,
  } from "../lib/dashboard-api";

  const errorEl = document.querySelector<HTMLElement>("[data-dashboard-action-error]");
  function showError(msg: string): void {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }
  function clearError(): void {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  }

  let pending:
    | { kind: "request"; datasetId: string }
    | { kind: "delete"; datasetId: string; datasetName: string }
    | null = null;

  function openDialog(dialogId: string): void {
    document.dispatchEvent(
      new CustomEvent<{ dialogId: string }>("nemar:open-confirm-dialog", {
        detail: { dialogId },
      }),
    );
  }

  document.querySelectorAll<HTMLButtonElement>("[data-request-publication]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      if (!id) return;
      pending = { kind: "request", datasetId: id };
      clearError();
      openDialog("dashboard-request-publication");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-delete-dataset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      const name = btn.dataset.datasetName;
      if (!id || !name) return;
      pending = { kind: "delete", datasetId: id, datasetName: name };
      clearError();
      openDialog("dashboard-delete-dataset");
    });
  });

  document.addEventListener("nemar:confirm-dialog-confirm", async (evt) => {
    const e = evt as CustomEvent<{ dialogId: string }>;
    if (!pending) return;
    const current = pending;
    pending = null;

    if (e.detail.dialogId === "dashboard-request-publication" && current.kind === "request") {
      try {
        await requestPublication(current.datasetId);
        location.reload();
      } catch (err) {
        const msg =
          err instanceof DashboardApiError
            ? `Couldn't request publication: ${err.message}`
            : "Couldn't request publication. Try again.";
        showError(msg);
      }
      return;
    }
    if (e.detail.dialogId === "dashboard-delete-dataset" && current.kind === "delete") {
      try {
        await deleteDraftDataset(current.datasetId);
        location.reload();
      } catch (err) {
        const msg =
          err instanceof DashboardApiError
            ? `Couldn't delete: ${err.message}`
            : "Couldn't delete. Try again.";
        showError(msg);
      }
      return;
    }
  });
</script>
