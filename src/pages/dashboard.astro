---
import ConfirmDialog from "../components/ConfirmDialog.astro";
import DashboardTour from "../components/DashboardTour.astro";
import MyDatasetCard from "../components/MyDatasetCard.astro";
import ProfileNudge from "../components/ProfileNudge.astro";
import VerifyEmailStep from "../components/VerifyEmailStep.astro";
import Base from "../layouts/Base.astro";
import { fetchAccountIdentity } from "../lib/account-api";
import { deriveAccountTier, deriveUploadAccessState, needsOnboarding } from "../lib/account-tier";
import { getSession } from "../lib/auth";
import { isCollaboratorManager } from "../lib/collaborators-api";
import {
  DashboardApiError,
  type PublicationStatus,
  getPublishStatus,
  listMyDatasets,
} from "../lib/dashboard-api";
import { DOCS_UPLOAD_ACCESS_PATH, resolveDocsBase } from "../lib/docs-base";
import { formatDate } from "../lib/format";
import { missingProfileFields } from "../lib/profile";
import type { Dataset } from "../lib/types";

const session = getSession(Astro.locals);
if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent("/dashboard")}`);
}

const url = new URL(Astro.request.url);
const limit = 50;
const offset = Math.max(0, Number.parseInt(url.searchParams.get("offset") ?? "0", 10) || 0);

// SSR: forward the request's cookie so the backend resolves the session.
const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;

// Tier decides what this page IS, not just what banner sits on top of it
// (website#301). An unverified account cannot pass `authMiddleware` at all
// (nemar-cli services/account-tier.ts), so every call below would 403 —
// skipping them is both honest and cheaper than rendering a list of errors
// under a notice the user can act on.
const tier = deriveAccountTier(session.user);
const uploadAccess = deriveUploadAccessState(session.user);
const uploadAccessDocsUrl = `${resolveDocsBase()}${DOCS_UPLOAD_ACCESS_PATH}`;

let datasets: Dataset[] = [];
let total = 0;
let listError: string | null = null;
if (tier !== "unverified") {
  try {
    const result = await listMyDatasets({ limit, offset }, { cookieHeader });
    datasets = result.datasets;
    total = result.total_count;
  } catch (err) {
    listError =
      err instanceof DashboardApiError
        ? `Could not load your datasets (${err.status}). Try refreshing.`
        : err instanceof Error
          ? err.message
          : "Could not load your datasets.";
  }
}

// Fan-out publish-status lookups in parallel: one request per visible
// dataset. Acceptable while page limits cap this at 50 datasets per render.
const statuses: Record<string, PublicationStatus | null> = {};
let statusFetchFailures = 0;
let statusSessionExpired = false;
await Promise.all(
  datasets.map(async (d) => {
    try {
      statuses[d.dataset_id] = await getPublishStatus(d.dataset_id, { cookieHeader });
    } catch (err) {
      console.warn(`[dashboard] getPublishStatus failed for ${d.dataset_id}`, err);
      statuses[d.dataset_id] = null;
      // A 401 means the cookie is dead, not that the network blipped. The
      // correct action is signing in again, not refreshing the same dashboard.
      if (err instanceof DashboardApiError && err.status === 401) {
        statusSessionExpired = true;
      } else {
        statusFetchFailures += 1;
      }
    }
  }),
);

// #226: nudge, never a gate. The city/country requirement is enforced by the
// upload-access request endpoint itself, so dismissing the banner cannot get
// anyone past it.
const missingProfile = tier === "unverified" ? [] : missingProfileFields(session.user);

// One extra call, and only for a tier that can make it: `/auth/me` does not
// carry `username`, and without it the setup prompt cannot tell a brand-new
// ORCID account from a finished one. Fail-soft — `fetchAccountIdentity`
// answers `undefined` on any failure and `onboardingSteps` treats that as
// "cannot say", never as "missing".
const identity =
  tier === "unverified"
    ? { username: undefined }
    : await fetchAccountIdentity(session.user.username, { cookieHeader });
const showSetupPrompt =
  tier !== "unverified" &&
  needsOnboarding({
    username: identity.username,
    given_name: session.user.given_name,
    family_name: session.user.family_name,
    city: session.user.city,
    country: session.user.country,
    orcid_verified: session.user.orcid_verified,
  });

const requestedDate = uploadAccess.kind === "requested" ? formatDate(uploadAccess.at) : "";
---

<Base
  title="My datasets"
  description="Manage the datasets you've uploaded to NEMAR."
>
  <section class="dashboard-shell">
    <header class="dashboard-header">
      <div>
        <h1 class="dashboard-header__title">My datasets</h1>
        <p class="dashboard-header__lede">
          {tier === "unverified"
            ? "Verify your email address to activate your account."
            : total === 0
              ? "No datasets yet."
              : `${total} dataset${total === 1 ? "" : "s"} owned by you.`}
        </p>
      </div>
      {tier === "upload" && (
        <a class="dashboard-header__cta" href="/upload" data-tour-target="upload">Upload dataset</a>
      )}
    </header>

    {tier === "unverified" ? (
      <VerifyEmailStep email={session.user.email} context="dashboard" />
    ) : (
    <>
    {showSetupPrompt && (
      <p class="dashboard-notice" role="status">
        Your account setup isn&rsquo;t finished &mdash; NEMAR still needs a username, your
        name, or where you&rsquo;re based. <a href="/onboarding?next=%2Fdashboard">Finish setting up</a>.
      </p>
    )}

    {/* Tier-aware, and deliberately not a warning: the base tier is a
        working account, not a degraded one. Nothing here mentions sandbox
        training — that is CLI-only (nemar-cli ADR 0040) and naming it would
        send a browser user to a terminal for a step the web upload gate does
        not check. */}
    {tier === "base" && uploadAccess.kind === "not_requested" && (
      <div class="dashboard-tier" role="note">
        <h2 class="dashboard-tier__title">Want to contribute a dataset?</h2>
        <p class="dashboard-tier__body">
          Browsing, searching and downloading are open to your account already. Uploading
          needs one extra grant: an admin checks your GitHub handle and location against
          export-control and local-jurisdiction rules, once.
        </p>
        <p class="dashboard-tier__actions">
          <a class="dashboard-tier__cta" href="/settings#upload-access">Request upload access</a>
          <a class="dashboard-tier__link" href={uploadAccessDocsUrl} rel="external noopener">
            How upload access works
          </a>
        </p>
      </div>
    )}

    {tier === "base" && uploadAccess.kind === "requested" && (
      <div class="dashboard-tier" role="note">
        <h2 class="dashboard-tier__title">Upload access requested</h2>
        <p class="dashboard-tier__body">
          {requestedDate
            ? `An admin is reviewing your request from ${requestedDate}. `
            : "An admin is reviewing your request. "}
          We&rsquo;ll email you when there&rsquo;s a decision. Everything else on your account
          keeps working in the meantime.
        </p>
        <p class="dashboard-tier__actions">
          <a class="dashboard-tier__link" href="/settings#upload-access">See the request</a>
        </p>
      </div>
    )}

    <ProfileNudge missing={missingProfile} userId={session.user.id} />

    {listError && (
      <p class="dashboard-error" role="alert">{listError}</p>
    )}

    {statusSessionExpired && (
      <p class="dashboard-error" role="alert">
        Your session expired while loading. <a href={`/login?next=${encodeURIComponent("/dashboard")}`}>Sign in again</a> to refresh.
      </p>
    )}

    {statusFetchFailures > 0 && !statusSessionExpired && (
      <p class="dashboard-notice" role="status">
        Publication status didn&rsquo;t load for {statusFetchFailures} dataset{statusFetchFailures === 1 ? "" : "s"}. Badges may be stale; refresh to retry.
      </p>
    )}

    {!listError && datasets.length === 0 ? (
      <div class="dashboard-empty">
        <h2 class="dashboard-empty__title">You haven&rsquo;t uploaded any datasets yet</h2>
        {tier === "upload" ? (
          <>
            <p class="dashboard-empty__body">
              Drop a BIDS folder on the upload page and we&rsquo;ll create your first dataset.
            </p>
            <a class="dashboard-empty__cta" href="/upload">Upload your first dataset</a>
          </>
        ) : (
          <p class="dashboard-empty__body">
            Datasets you upload will appear here once an admin grants your account upload
            access.
          </p>
        )}
      </div>
    ) : (
      <ul class="dashboard-list" role="list">
        {datasets.map((d: Dataset, i: number) => (
          <li>
            <MyDatasetCard
              dataset={d}
              publishStatus={statuses[d.dataset_id]}
              canManage={isCollaboratorManager(session, d)}
              {...(i === 0 ? { "data-tour-target": "first-card" } : {})}
            />
          </li>
        ))}
      </ul>
    )}

    <p class="dashboard-action-error" role="alert" data-dashboard-action-error hidden></p>
    </>
    )}
  </section>

  <ConfirmDialog
    dialogId="dashboard-request-publication"
    title="Request publication review?"
    body="An admin will review the dataset's BIDS validation and approve or block it. You'll get an email when there's a decision."
    confirmLabel="Request review"
    confirmTone="primary"
  />

  <ConfirmDialog
    dialogId="dashboard-delete-dataset"
    title="Delete this draft?"
    body="This removes the dataset and its files from NEMAR. The action can't be undone."
    confirmLabel="Delete dataset"
    confirmTone="danger"
    requireTyping="DELETE"
  />

  {datasets.length > 0 && <DashboardTour />}
</Base>

<style>
  .dashboard-shell {
    max-inline-size: 64rem;
    margin: 0 auto;
    padding: var(--space-10) var(--space-4) var(--space-16);
    display: grid;
    gap: var(--space-6);
  }
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .dashboard-header__title {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    margin: 0 0 var(--space-1);
  }
  /* ProfileNudge parks focus here when its banner is dismissed (the button
     the user activated disappears). Programmatic focus only, so no ring:
     a visible outline on a heading nobody tabbed to reads as a rendering
     glitch. Screen readers still announce it. */
  .dashboard-header__title:focus {
    outline: none;
  }
  .dashboard-header__lede {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .dashboard-header__cta {
    min-block-size: 44px;
    padding: 0 var(--space-5);
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }
  .dashboard-header__cta:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .dashboard-notice {
    margin: 0;
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .dashboard-notice a {
    color: var(--color-link);
    font-weight: var(--fw-semibold);
  }
  /* Tier card: informational, not a warning. Neutral surface with the brand
     rail rather than the amber notice treatment, because the base tier is a
     working account and amber would read as "something is wrong". */
  .dashboard-tier {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--brand-teal);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: grid;
    gap: var(--space-2);
  }
  .dashboard-tier__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
  }
  .dashboard-tier__body {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    max-inline-size: 56ch;
  }
  .dashboard-tier__actions {
    margin: var(--space-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .dashboard-tier__cta {
    min-block-size: 40px;
    padding: 0 var(--space-5);
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .dashboard-tier__cta:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .dashboard-tier__link {
    color: var(--color-link);
    font-size: var(--fs-sm);
  }
  .dashboard-error {
    margin: 0;
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .dashboard-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    text-align: center;
  }
  .dashboard-empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
  }
  .dashboard-empty__body {
    margin: 0;
    color: var(--color-fg-muted);
    max-inline-size: 32rem;
  }
  .dashboard-empty__cta {
    margin-block-start: var(--space-2);
    min-block-size: 44px;
    padding: 0 var(--space-5);
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }
  .dashboard-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .dashboard-action-error {
    margin: 0;
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
</style>

<script>
  import {
    DashboardApiError,
    deleteDraftDataset,
    requestPublication,
  } from "../lib/dashboard-api";

  const errorEl = document.querySelector<HTMLElement>("[data-dashboard-action-error]");

  const ERROR_MESSAGES: Record<string, string> = {
    already_in_flight: "A review request is already in progress for this dataset.",
    already_published: "This dataset is already published.",
    not_deletable: "This dataset can't be deleted in its current state.",
    not_found: "Dataset not found.",
    bad_content_type: "Couldn't process the request. Refresh and try again.",
    unauthenticated: "Sign in again to continue.",
    internal_error: "Server error. Try again in a moment.",
    // Returned by /api/v1/* when the upstream api.nemar.org fetch throws
    // (network failure, DNS, Worker-to-backend disruption). Distinct from
    // a backend 502 — this one is the worker → backend hop failing.
    upstream_unreachable: "Can't reach the dataset service. Try again in a moment.",
  };

  function friendlyError(err: unknown): string {
    if (err instanceof DashboardApiError && err.code && ERROR_MESSAGES[err.code]) {
      return ERROR_MESSAGES[err.code];
    }
    return err instanceof Error ? err.message : "Something went wrong.";
  }

  function showError(msg: string): void {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }
  function clearError(): void {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  }

  let pending:
    | { kind: "request"; datasetId: string }
    | { kind: "delete"; datasetId: string; datasetName: string }
    | null = null;
  let actionInFlight = false;

  function openDialog(dialogId: string): void {
    document.dispatchEvent(
      new CustomEvent<{ dialogId: string }>("nemar:open-confirm-dialog", {
        detail: { dialogId },
      }),
    );
  }

  function queueAction(next: NonNullable<typeof pending>): void {
    if (actionInFlight) return;
    if (pending) {
      console.warn("[dashboard] overwriting un-confirmed pending action", pending);
    }
    pending = next;
    clearError();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-request-publication]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      if (!id) return;
      queueAction({ kind: "request", datasetId: id });
      openDialog("dashboard-request-publication");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-delete-dataset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.datasetId;
      const name = btn.dataset.datasetName;
      if (!id || !name) return;
      queueAction({ kind: "delete", datasetId: id, datasetName: name });
      openDialog("dashboard-delete-dataset");
    });
  });

  document.addEventListener("nemar:confirm-dialog-confirm", async (evt) => {
    const e = evt as CustomEvent<{ dialogId: string }>;
    if (!pending) return;

    if (e.detail.dialogId === "dashboard-request-publication" && pending.kind === "request") {
      const target = pending;
      pending = null;
      actionInFlight = true;
      try {
        await requestPublication(target.datasetId);
        location.reload();
      } catch (err) {
        showError(`Couldn't request publication: ${friendlyError(err)}`);
        actionInFlight = false;
      }
      return;
    }
    if (e.detail.dialogId === "dashboard-delete-dataset" && pending.kind === "delete") {
      const target = pending;
      pending = null;
      actionInFlight = true;
      try {
        await deleteDraftDataset(target.datasetId);
        location.reload();
      } catch (err) {
        showError(`Couldn't delete: ${friendlyError(err)}`);
        actionInFlight = false;
      }
      return;
    }
    console.error(
      "[dashboard] confirm-dialog event did not match queued pending action",
      e.detail.dialogId,
      pending,
    );
  });
</script>
