---
/**
 * Legacy landing for an unverified account.
 *
 * Nothing routes here any more (website#301): an account that has not
 * redeemed its emailed code lands on `/dashboard`, where the verify step
 * lives. The page is kept because browsers and bookmarks still hold the URL
 * from before, and its copy is corrected rather than left saying an admin is
 * reviewing something — under nemar-cli ADR 0040 nobody is. Admin approval
 * exists, but it grants UPLOAD access and is asked for from Settings, long
 * after this point.
 */
import Base from "../../layouts/Base.astro";
---

<Base title="Verify your email" description="Confirm your email address to activate your NEMAR account.">
  <section class="login-shell">
    <div class="login-card">
      <h1 class="login-card__heading">Verify your email address</h1>
      <p class="login-card__lede">
        Thanks for signing up. One step left: enter the 6-digit code we emailed you. That
        activates your account on the spot &mdash; there is no approval queue to wait in.
      </p>
      <p class="login-card__lede">
        <a href="/dashboard">Go to your dashboard</a> to enter the code, or ask for a new
        one there if it never arrived.
      </p>
      <p class="login-card__fineprint">
        Stuck? Write to <a href="mailto:admin@nemar.org">admin@nemar.org</a>, or
        <a href="/login">sign in again</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .login-shell {
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--space-4);
    min-block-size: calc(100dvh - var(--header-height) - 4rem);
  }
  .login-card {
    inline-size: 100%;
    max-inline-size: 32rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
  }
  .login-card__heading {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    margin-block-end: var(--space-3);
  }
  .login-card__lede {
    color: var(--color-fg-muted);
    margin-block-end: var(--space-4);
    line-height: var(--lh-normal);
  }
  .login-card__fineprint {
    margin-block-start: var(--space-4);
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
  }
  .login-card__fineprint a,
  .login-card__lede a {
    color: var(--color-link);
  }
</style>
