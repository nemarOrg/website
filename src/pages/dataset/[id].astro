---
import ActionBar from "../../components/ActionBar.astro";
import BidsTree from "../../components/BidsTree.astro";
import DatasetTabs from "../../components/DatasetTabs.astro";
import DetailRail from "../../components/DetailRail.astro";
import DoiBadge from "../../components/DoiBadge.astro";
import ProvenanceToggle from "../../components/ProvenanceToggle.astro";
import Readme from "../../components/Readme.astro";
import Tag from "../../components/Tag.astro";
import VersionSwitcher from "../../components/VersionSwitcher.astro";
import Base from "../../layouts/Base.astro";
import { resolveCanonical } from "../../lib/api";
import { ORG_DATASETS } from "../../lib/constants";
import {
  archiveZipUrl,
  getLandingOutcome,
  getMetadataOutcome,
  isUnpublished,
  outcomeValue,
  resolveDatasetPageStatus,
} from "../../lib/data-api";
import { splitModalities } from "../../lib/format";
import { detectProvenance } from "../../lib/provenance";
import { modalityHref } from "../../lib/tags";

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/discover");
}

const url = new URL(Astro.request.url);

// OpenNeuro source ids (ds*) redirect to their NEMAR canonical (on*) when a
// mirror exists. Preserves the query string so deep links survive the hop.
if (/^ds\d{6}$/.test(id)) {
  const canonical = await resolveCanonical(id).catch(() => null);
  if (canonical) {
    return Astro.redirect(`/dataset/${canonical}${url.search}`, 301);
  }
}

const versionParam = url.searchParams.get("v");

// SSR fan-out: landing + metadata only. The qa/ tree walk used to run here
// but burned 5–28 s on HBN-sized datasets (see #81). Demographics now
// hydrates client-side from participants.tsv, and the Data quality tab is
// a "coming soon" placeholder until nemar-cli#511 ships a precomputed
// static aggregate JSON we can fetch cheaply on tab click.
const [landingOut, metadataOut] = await Promise.all([
  getLandingOutcome(id),
  getMetadataOutcome(id),
]);

// 404 only when BOTH signals independently report missing — a single not_found
// could be a partial publish or a transient data-layer hiccup. Anything else
// non-ok is degraded (503) so monitoring distinguishes "typo'd URL" from "data
// layer down." Cache-Control is on the actual Response, not Astro.response,
// because Astro returns the inner object verbatim and the header set on the
// outer one never reaches the edge — Cloudflare would otherwise cache the
// transient 404/503 stickily.
const status = resolveDatasetPageStatus(landingOut, metadataOut);
if (status.kind === "not_found") {
  return new Response(null, { status: 404, headers: { "Cache-Control": "no-store" } });
}
if (status.kind === "degraded") {
  console.warn(`[dataset/${id}] ${status.signal} fetch failed: ${status.outcome}`);
  return new Response(null, { status: 503, headers: { "Cache-Control": "no-store" } });
}

const landing = outcomeValue(landingOut);
const metadata = outcomeValue(metadataOut);
if (!landing || !metadata) {
  // Type-narrowing safety net: resolveDatasetPageStatus already returned
  // above for every non-ok combination, but TypeScript can't see through
  // the discriminant. Log loudly if it ever fires — it shouldn't.
  console.error(
    `[dataset/${id}] safety-net 500: landing=${landingOut.kind} metadata=${metadataOut.kind}`,
  );
  return new Response(null, { status: 500, headers: { "Cache-Control": "no-store" } });
}

// `metadata.json` is the single source of truth for license, modalities,
// tasks, and authors post-#78. Null-coalesce so DetailRail can render its
// existing empty states without each consumer re-checking for undefined.
const enrichedMetadata = {
  ...metadata,
  license: metadata.license || null,
  recording_modality: metadata.recording_modality ?? [],
  tasks: metadata.tasks ?? [],
  authors: metadata.authors ?? [],
};

const unpublished = isUnpublished(landing);

const selectedVersion =
  versionParam && landing.versions.some((v) => v.version === versionParam)
    ? versionParam
    : (landing.latest ?? landing.versions[0]?.version ?? null);

// README and BIDS tree hydrate client-side (see the <script> block at the
// bottom of this file): README from raw.githubusercontent.com directly,
// tree from data.nemar.org/<id>/<v>/?format=json (nemar-cli#636). SSR
// critical path only awaits landing + metadata + catalog row + QA.

const provenance = detectProvenance(metadata, landing);
const modalities = enrichedMetadata.recording_modality.length
  ? enrichedMetadata.recording_modality
  : splitModalities("");

const githubUrl = metadata.external_links.github_url ?? `https://github.com/${ORG_DATASETS}/${id}`;
// Owner/repo slug for the client-side GitHub raw fetch. Strips the
// `https://github.com/` prefix + any trailing slash + any `.git` suffix
// so raw.githubusercontent.com/<slug>/<version>/README.md resolves.
// Falls back to `${ORG_DATASETS}/${id}` (the same default used for
// githubUrl) when metadata doesn't specify a repo.
// Trailing-slash strip MUST run before the `.git` strip — a URL ending in
// `.git/` would otherwise leave `.git` in the slug because the `$` anchor
// requires the literal to be the final char.
const githubRepoSlug = githubUrl
  .replace(/^https?:\/\/github\.com\//, "")
  .replace(/\/$/, "")
  .replace(/\.git$/, "");
const issuesUrl = `${githubUrl}/issues`;
const openneuroId = provenance.kind === "derived" ? (provenance.originalDatasetId ?? null) : null;
const archiveUrl = selectedVersion ? archiveZipUrl(id, selectedVersion) : null;

// Edge-cache aggressively: dataset detail rarely changes within a window. Cloudflare
// honors s-maxage at the edge; max-age stays short so browsers re-validate on nav.
// stale-while-revalidate keeps the edge serving last-good response while it refreshes.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=86400",
);
---

<Base
  title={metadata.name}
  description={metadata.description ?? `${id} dataset on NEMAR`}
  ogType="article"
>
  <article class="detail">
    <header class="detail__header container">
      <div class="detail__id-row">
        <span class="detail__id">{id}</span>
        {provenance.kind === "derived" ? (
          <ProvenanceToggle
            datasetId={id}
            nemarDoi={metadata.external_links.dataset_doi}
            currentVersion={selectedVersion}
            provenance={provenance}
          />
        ) : (
          <span class="detail__lineage">NEMAR-native dataset</span>
        )}
      </div>
      <h1 class="detail__title">{metadata.name}</h1>
      {metadata.description && metadata.description !== metadata.name && (
        <section class="detail__lede-card" data-detail-lede>
          <p class="detail__lede">{metadata.description}</p>
          <span
            class="detail__lede-ai"
            role="img"
            aria-label="AI-generated description, may include mistakes"
            title="AI-generated description, may include mistakes"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <span class="visually-hidden">AI-generated description, may include mistakes</span>
          </span>
        </section>
      )}
      <div class="detail__chips">
        {modalities.map((m) => <Tag kind="modality" value={m} href={modalityHref(m)} size="md" />)}
      </div>
      <div class="detail__actions">
        <ActionBar
          datasetId={id}
          version={selectedVersion}
          archiveUrl={archiveUrl}
          issuesUrl={issuesUrl}
          githubUrl={githubUrl}
          openneuroId={openneuroId}
        />
        {metadata.external_links.dataset_doi && (
          <DoiBadge doi={metadata.external_links.dataset_doi} />
        )}
      </div>
    </header>

    <div class="container">
      <VersionSwitcher
        versions={landing.versions}
        current={selectedVersion ?? ""}
        mirrorVersions={provenance.kind === "derived" ? provenance.allMirrorVersions : []}
      />
    </div>

    <div class="container detail__body">
      <div class="detail__main">
        {unpublished ? (
          <div class="detail__unpublished">
            <h2>Not yet published</h2>
            <p>This dataset has been registered but no published version is available yet. Check back later or visit the <a href={githubUrl} rel="external">dataset repository</a> for curation progress.</p>
          </div>
        ) : (
          <>
            <Readme
              defer
              datasetId={id}
              version={selectedVersion}
              githubRepo={githubRepoSlug}
              fallbackDescription={
                metadata.description && metadata.description !== metadata.name
                  ? metadata.description
                  : null
              }
            />
            <DatasetTabs datasetId={id} version={selectedVersion} />
            {selectedVersion && (
              <BidsTree datasetId={id} version={selectedVersion} />
            )}
          </>
        )}
      </div>
      <DetailRail metadata={enrichedMetadata} />
    </div>
  </article>
</Base>

<script>
  import { renderMarkdown } from "../../lib/markdown";
  import type { DirListing } from "../../lib/dir-listing";
  import { fetchDirListing, fileDownloadUrl } from "../../lib/dir-listing";
  import { formatBytes } from "../../lib/format";
  import {
    renderDirChunkRows,
    renderSubdir,
    renderTopLevel,
  } from "../../lib/render-dir-listing";
  // The preview renderers are dynamic-imported on first click (one bundle
  // per format, code-split by Vite) so a user who never opens a TSV
  // doesn't pay for parsing the TSV renderer's bundle.

  // The fetched listing held per tree section. The "Show next" click handler
  // re-emits rows from this without re-fetching. WeakMap keys by element so
  // the entry is garbage-collected when the section detaches (SPA-style
  // navigation isn't used here today, but it's the cheap-correct default).
  const listingBySection = new WeakMap<HTMLElement, DirListing>();

  /**
   * Client-side hydration for the README and BIDS tree panels. Pre-#76 these
   * were SSR'd by /api/dataset/<id>/{readme,tree} partial endpoints which
   * fetched summary.json + manifest.json on every request, hit cold-isolate
   * timeouts on HBN-sized datasets, and required several refresh cycles to
   * warm. The pipeline was the actual failure surface for the user-visible
   * "No description available" / "Manifest unavailable" placeholders.
   *
   * Now: README comes from raw.githubusercontent.com via GitHub's CDN;
   * tree comes from data.nemar.org/<id>/<v>/?format=json (nemar-cli#636 /
   * v0.8.37 — typically a small top-level JSON with real per-file sizes
   * and native lazy-per-directory). No website worker in the chain.
   */

  async function hydrateReadme(article: HTMLElement): Promise<void> {
    const datasetId = article.dataset.id;
    const version = article.dataset.version;
    const repo = article.dataset.githubRepo;
    const fallbackDesc = article.dataset.fallbackDesc ?? "";
    if (!datasetId || !version) return;

    let markdown: string | null = null;
    if (repo) {
      // Tagged version first. README content is per-version; the dataset
      // repo's tag matches the published version label.
      const rawUrl = `https://raw.githubusercontent.com/${repo}/${encodeURIComponent(version)}/README.md`;
      try {
        const res = await fetch(rawUrl);
        if (res.ok) {
          const text = await res.text();
          if (text.trim().length > 0) markdown = text;
        }
      } catch (err) {
        console.warn(`[readme/${datasetId}] GitHub raw fetch failed:`, err);
      }
    }

    article.removeAttribute("aria-busy");
    if (markdown) {
      article.innerHTML = renderReadmeWrap(renderMarkdown(markdown));
      const wrap = article.querySelector<HTMLElement>("[data-readme-wrap]");
      const sync = (
        window as typeof window & { __nemarSyncReadme?: (w: HTMLElement) => void }
      ).__nemarSyncReadme;
      if (wrap && sync) sync(wrap);
      return;
    }

    // No README at this version. Use metadata.description if present and
    // meaningful (the SSR-passed fallback), else show the empty state.
    if (fallbackDesc.length > 0) {
      article.innerHTML = `<div class="readme__fallback-note" role="note"><strong>Description (from dataset metadata)</strong><span>This dataset doesn't ship a README. Showing the BIDS description instead.</span></div>${renderReadmeWrap(renderMarkdown(fallbackDesc))}`;
      const wrap = article.querySelector<HTMLElement>("[data-readme-wrap]");
      const sync = (
        window as typeof window & { __nemarSyncReadme?: (w: HTMLElement) => void }
      ).__nemarSyncReadme;
      if (wrap && sync) sync(wrap);
      return;
    }

    article.innerHTML = `<div class="readme__empty"><h2>No description available</h2><p>This dataset doesn't ship a README and the BIDS metadata has no description either. The file tree below and the metadata panel on the right are the authoritative description for now. The dataset's GitHub repository may have curation notes added later.</p></div>`;
  }

  /** The expand/collapse shell the Readme.astro non-defer branch uses,
   *  emitted in JS so injected README HTML matches the SSR path's markup
   *  and the existing .readme__toggle delegated click handler works. */
  function renderReadmeWrap(innerHtml: string): string {
    return `<div class="readme__wrap" data-readme-wrap><div class="readme__body">${innerHtml}</div><div class="readme__fade" aria-hidden="true"></div><div class="readme__toolbar"><button class="readme__toggle" type="button" data-readme-toggle aria-expanded="false" aria-controls="readme-body"><span class="readme__toggle-label">Expand README</span></button></div></div>`;
  }

  async function hydrateTree(section: HTMLElement): Promise<void> {
    const datasetId = section.dataset.id;
    const version = section.dataset.version;
    if (!datasetId || !version) return;
    const listing = await fetchDirListing(datasetId, version, "");
    section.removeAttribute("aria-busy");
    if (!listing) {
      // Parity with the subdir-toggle handler: both null paths log so a
      // developer with devtools open can distinguish "this specific dataset
      // is broken" from "the whole endpoint is down."
      console.warn(`[tree/${datasetId}] top-level dir listing returned null (v=${version})`);
      section.innerHTML = `<section class="detail__no-manifest" role="alert"><h2>File index unavailable</h2><p>The file index for <code>${escapeHtml(version)}</code> couldn't be loaded right now. Try refreshing in a few seconds, or use the <a href="/discover">Discover page</a> to pick another dataset or version.</p></section>`;
      return;
    }
    listingBySection.set(section, listing);
    section.innerHTML = renderTopLevel(listing);
  }

  // Delegated click for the "Show next N" footer. Single document-level
  // listener (cheap, fires only when a tree__more-btn ancestor is hit) so
  // we don't have to re-bind after each chunk reveal. Mirrors the toggle
  // capture-phase delegate above.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>(".tree__more-btn");
    if (!button) return;
    const footer = button.closest<HTMLElement>("[data-tree-more]");
    const section = button.closest<HTMLElement>("[data-tree-defer]");
    if (!footer || !section) return;
    const listing = listingBySection.get(section);
    const list = section.querySelector<HTMLElement>("[data-dir-list]");
    // No cached listing means the tree never finished hydrating (or was
    // rewritten with an error). The footer shouldn't exist in that case;
    // surface loudly + remove it so the user isn't left with a dead button.
    if (!listing || !list) {
      console.error(
        `[tree] show-more clicked but cached listing missing (section=${section.dataset.id ?? "?"})`,
      );
      footer.remove();
      return;
    }

    const rendered = Number(footer.dataset.rendered ?? "0");
    const total = Number(footer.dataset.total ?? "0");
    const chunk = Number(footer.dataset.chunk ?? "50");
    const result = renderDirChunkRows(listing, rendered, chunk);
    // Defensive: if the slice returns zero rows the data-rendered counter
    // is out of sync with the cached listing (shouldn't be reachable via
    // the happy path, but a stale counter would leave the button looping
    // with no visible effect). Remove the footer to avoid a stuck button.
    if (result.rendered === 0) {
      console.warn(
        `[tree] show-more produced 0 rows (rendered=${rendered} total=${total} listingDirs=${result.total})`,
      );
      footer.remove();
      return;
    }
    list.insertAdjacentHTML("beforeend", result.html);

    const newRendered = rendered + result.rendered;
    if (newRendered >= total) {
      footer.remove();
      return;
    }
    footer.dataset.rendered = String(newRendered);
    const nextCount = Math.min(chunk, total - newRendered);
    const counter = footer.querySelector(".tree__more-counter");
    // The button's text node sits before the counter <span>; updating
    // nodeValue avoids clobbering the nested element + its event paths.
    const label = button.firstChild;
    if (label && label.nodeType === Node.TEXT_NODE) {
      label.nodeValue = `Show next ${nextCount} `;
    } else {
      // Extension or DOM mutation displaced the text node. Counter still
      // updates below; warn so a developer reading devtools can correlate
      // the visual mismatch ("button label stuck at 50 but counter ticks").
      console.warn("[tree] show-more button first child isn't a text node; label not updated");
    }
    if (counter) counter.textContent = `(${newRendered} of ${total} shown)`;
  });

  // Inline file-preview delegate. Mirrors the show-more click delegate
  // above. Fires when the user clicks a `.tree__preview-btn` (the name of
  // a previewable file). First click fetches + renders the inline panel
  // under the row; subsequent clicks toggle visibility without re-fetching.
  // The download icon (`.tree__dl`) is a separate `<a download>` and not
  // intercepted here — the browser's default click handling triggers the
  // byte download as before.
  const MAX_PREVIEW_BYTES = 512 * 1024;
  // Cache of fetched-and-parsed TSV text per slot. Used by the "Show all"
  // re-reveal so we re-render from memory instead of re-fetching.
  const tsvCacheBySlot = new WeakMap<HTMLElement, string>();

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // "Show all N rows" inside an open TSV preview. Handled first so it
    // doesn't fall into the preview-toggle branch below.
    if (target.closest("[data-tsv-show-all]")) {
      const btn = target.closest<HTMLButtonElement>("[data-tsv-show-all]");
      const slot = btn?.closest<HTMLElement>("[data-preview-slot]");
      if (!btn || !slot) return;
      const cached = tsvCacheBySlot.get(slot);
      if (!cached) {
        // The slot is still in the DOM so the WeakMap entry can't have
        // been GC'd — this means a code path rendered a TSV preview
        // without going through the fetch branch. Surface so the user
        // isn't left with an inert button.
        console.warn("[preview] tsv-show-all clicked but cache missing");
        slot.innerHTML = `<p class="preview__error" role="alert">Couldn't expand the table — its source isn't cached. Collapse and reopen the preview to retry.</p>`;
        return;
      }
      const { renderTsvPreview } = await import("../../lib/render-file-preview-tsv");
      slot.innerHTML = renderTsvPreview(cached, Number.POSITIVE_INFINITY);
      return;
    }

    const btn = target.closest<HTMLButtonElement>("[data-preview-path]");
    if (!btn) return;

    const wrap = btn.closest<HTMLElement>("[data-preview-wrap]");
    const slot = wrap?.querySelector<HTMLElement>("[data-preview-slot]");
    if (!wrap || !slot) return;

    const isExpanded = btn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      slot.hidden = true;
      btn.setAttribute("aria-expanded", "false");
      return;
    }

    btn.setAttribute("aria-expanded", "true");
    slot.hidden = false;

    // Already rendered or already in flight — bail. `loaded` carries one of
    // three states: undefined (never touched), "loading" (fetch in flight),
    // or "true" (rendered). Without the "loading" sentinel, a rapid
    // collapse + re-expand during the network round-trip would fire a
    // second concurrent fetch; the late-arriving response would overwrite
    // the slot content non-deterministically.
    if (slot.dataset.loaded === "true" || slot.dataset.loaded === "loading") return;

    const previewType = btn.dataset.previewType ?? "";
    const fileSizeBytes = Number(btn.dataset.fileSize ?? "0");
    const fileName = btn.dataset.fileName ?? "";
    const filePath = btn.dataset.previewPath ?? "";
    const section = btn.closest<HTMLElement>("[data-tree-defer]");
    const treeId = section?.dataset.id;
    const treeVersion = section?.dataset.version;
    if (!treeId || !treeVersion) {
      // The button is somehow outside a `[data-tree-defer]` section. The
      // slot is already visible from the flip above — surface an error so
      // the user isn't staring at an empty panel.
      console.warn("[preview] missing tree id/version on btn", btn);
      slot.innerHTML = `<p class="preview__error" role="alert">Couldn't load preview: missing dataset context. Try refreshing the page.</p>`;
      slot.dataset.loaded = "true";
      return;
    }
    const fileUrl = fileDownloadUrl(treeId, treeVersion, filePath);

    // EEG: future-compatible stub, no fetch needed.
    if (previewType === "eeg") {
      slot.innerHTML = `<p class="preview__soon">EEG visualizer coming soon. <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download ${escapeHtml(fileName)}</a> in the meantime.</p>`;
      slot.dataset.loaded = "true";
      return;
    }

    // Oversized: skip the fetch and surface a download fallback. Threshold
    // picked so a 30 KB participants.tsv previews fine but a multi-MB
    // sourcedata file doesn't lock up the browser.
    if (fileSizeBytes > MAX_PREVIEW_BYTES) {
      slot.innerHTML = `<p class="preview__too-large">File too large to preview (${escapeHtml(formatBytes(fileSizeBytes))}). <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download instead</a>.</p>`;
      slot.dataset.loaded = "true";
      return;
    }

    // Claim the slot before the await: rapid double-clicks will short-
    // circuit on the "loading" check above instead of firing parallel
    // fetches. The success/failure paths below transition this to "true".
    slot.dataset.loaded = "loading";
    slot.setAttribute("aria-busy", "true");
    slot.innerHTML = `<p class="preview__loading">Loading…</p>`;
    try {
      const res = await fetch(fileUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      slot.removeAttribute("aria-busy");

      if (previewType === "md") {
        const { renderMarkdownPreview } = await import("../../lib/render-file-preview-md");
        slot.innerHTML = renderMarkdownPreview(text);
      } else if (previewType === "json") {
        const { renderJsonPreview } = await import("../../lib/render-file-preview-json");
        slot.innerHTML = renderJsonPreview(text);
      } else if (previewType === "tsv") {
        const { renderTsvPreview } = await import("../../lib/render-file-preview-tsv");
        tsvCacheBySlot.set(slot, text);
        slot.innerHTML = renderTsvPreview(text);
      } else {
        // Defensive: unknown previewType (the renderer guards against
        // emitting one). Show a generic error so the user can still
        // download.
        slot.innerHTML = `<p class="preview__error" role="alert">No preview available for this format. <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download instead</a>.</p>`;
      }
      slot.dataset.loaded = "true";
    } catch (err) {
      console.error(`[preview/${treeId}] failed for ${filePath}:`, err);
      slot.removeAttribute("aria-busy");
      slot.innerHTML = `<p class="preview__error" role="alert">Preview failed. <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download instead</a>, or collapse + reopen to retry.</p>`;
      // Clear the loading sentinel so collapse+reopen can retry the fetch.
      delete slot.dataset.loaded;
      // Roll aria-expanded back so the next click is treated as expand,
      // not collapse (matters when the user collapses immediately to retry).
    }
  });

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  // Capture-phase toggle listener for lazy per-directory expansion. The
  // toggle event on <details> does NOT bubble (HTML spec), so capture is
  // the only way to delegate. Matches the pre-#76 Phase 3 pattern but for
  // arbitrary directories rather than just subject-level dirs.
  document.addEventListener(
    "toggle",
    (event) => {
      const details = event.target;
      if (!(details instanceof HTMLDetailsElement)) return;
      if (!details.open) return;
      const dirPath = details.dataset.dirPath;
      if (!dirPath) return;
      const slot = details.querySelector<HTMLElement>("[data-dir-target]");
      if (!slot || slot.dataset.loaded === "true") return;
      const section = details.closest<HTMLElement>("[data-tree-defer]");
      const treeId = section?.dataset.id;
      const treeVersion = section?.dataset.version;
      if (!treeId || !treeVersion) return;
      const depthAttr = Number(details.dataset.depth ?? "0");
      const childDepth = Number.isFinite(depthAttr) ? depthAttr + 1 : 1;
      slot.setAttribute("aria-busy", "true");
      fetchDirListing(treeId, treeVersion, dirPath)
        .then((listing) => {
          slot.removeAttribute("aria-busy");
          if (!listing) {
            slot.innerHTML = `<p class="tree__error" role="alert">Couldn't load files. Collapse and re-open to retry.</p>`;
            return;
          }
          slot.innerHTML = renderSubdir(listing, childDepth);
          slot.dataset.loaded = "true";
        })
        .catch((err) => {
          console.warn(`[tree/${treeId}] dir expand failed:`, err);
          slot.removeAttribute("aria-busy");
          slot.innerHTML = `<p class="tree__error" role="alert">Couldn't load files. Collapse and re-open to retry.</p>`;
        });
    },
    true,
  );

  // Kick off hydration on every defer slot present at first paint.
  document
    .querySelectorAll<HTMLElement>("[data-readme-defer]")
    .forEach((el) => void hydrateReadme(el));
  document
    .querySelectorAll<HTMLElement>("[data-tree-defer]")
    .forEach((el) => void hydrateTree(el));
</script>

