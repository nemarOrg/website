---
import ActionBar from "../../components/ActionBar.astro";
import BidsTree from "../../components/BidsTree.astro";
import DatasetTabs from "../../components/DatasetTabs.astro";
import DetailRail from "../../components/DetailRail.astro";
import EegViewerDialog from "../../components/EegViewerDialog.astro";
import ProvenanceToggle from "../../components/ProvenanceToggle.astro";
import Readme from "../../components/Readme.astro";
import Tag from "../../components/Tag.astro";
import VersionSwitcher from "../../components/VersionSwitcher.astro";
import Base from "../../layouts/Base.astro";
import { getDataset, isManagedDatasetId, resolveCanonical } from "../../lib/api";
import { datasetCitation } from "../../lib/cite";
import { ORG_DATASETS } from "../../lib/constants";
import {
  archiveZipUrl,
  getLandingOutcome,
  getMetadataOutcome,
  isUnpublished,
  outcomeValue,
  resolveDatasetPageStatus,
} from "../../lib/data-api";
import { resolveDataBase } from "../../lib/data-base";
import { splitModalities } from "../../lib/format";
import { canonicalOriginFor } from "../../lib/host";
import { datasetJsonLdScript } from "../../lib/jsonld";
import { detectProvenance } from "../../lib/provenance";
import { modalityHref } from "../../lib/tags";

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/discover");
}

const url = new URL(Astro.request.url);

// OpenNeuro source ids (ds*) redirect to their NEMAR canonical (on*) when a
// mirror exists. Preserves the query string so deep links survive the hop.
if (/^ds\d{6}$/.test(id)) {
  const canonical = await resolveCanonical(id).catch(() => null);
  if (canonical) {
    return Astro.redirect(`/dataset/${canonical}${url.search}`, 301);
  }
}

const versionParam = url.searchParams.get("v");

// SSR fan-out: landing + metadata only. The qa/ tree walk used to run here
// but burned 5–28 s on HBN-sized datasets (see #81). Demographics now
// hydrates client-side from participants.tsv, and the Data quality tab is
// a "coming soon" placeholder until nemar-cli#511 ships a precomputed
// static aggregate JSON we can fetch cheaply on tab click.
const [landingOut, metadataOut, catalogRow] = await Promise.all([
  getLandingOutcome(id),
  getMetadataOutcome(id),
  // The catalog row carries the recording channel count (nemar-cli#854), which
  // metadata.json does not. Only managed ids (nm*/on*) resolve here; ds* returns
  // 400 and is reached via the canonical redirect above. A failed lookup degrades
  // to null so the channel stat is simply omitted — it never blocks the page.
  isManagedDatasetId(id)
    ? getDataset(id).catch((err) => {
        // Degrade to null (the channel stat is optional and never blocks the
        // page), but log so a catalog-API regression that silently drops the
        // Channels row site-wide has a signal — mirrors this file's other
        // fetch-failure logs and resolveCanonical's convention in api.ts.
        console.warn(
          `[dataset/${id}] catalog row fetch failed, omitting channel stat: ${err instanceof Error ? err.message : String(err)}`,
        );
        return null;
      })
    : Promise.resolve(null),
]);

// 404 only when BOTH signals independently report missing — a single not_found
// could be a partial publish or a transient data-layer hiccup. Anything else
// non-ok is degraded (503) so monitoring distinguishes "typo'd URL" from "data
// layer down." Cache-Control is on the actual Response, not Astro.response,
// because Astro returns the inner object verbatim and the header set on the
// outer one never reaches the edge — Cloudflare would otherwise cache the
// transient 404/503 stickily.
const status = resolveDatasetPageStatus(landingOut, metadataOut);
if (status.kind === "not_found") {
  return new Response(null, { status: 404, headers: { "Cache-Control": "no-store" } });
}
if (status.kind === "degraded") {
  console.warn(`[dataset/${id}] ${status.signal} fetch failed: ${status.outcome}`);
  return new Response(null, { status: 503, headers: { "Cache-Control": "no-store" } });
}

const landing = outcomeValue(landingOut);
const metadata = outcomeValue(metadataOut);
if (!landing || !metadata) {
  // Type-narrowing safety net: resolveDatasetPageStatus already returned
  // above for every non-ok combination, but TypeScript can't see through
  // the discriminant. Log loudly if it ever fires — it shouldn't.
  console.error(
    `[dataset/${id}] safety-net 500: landing=${landingOut.kind} metadata=${metadataOut.kind}`,
  );
  return new Response(null, { status: 500, headers: { "Cache-Control": "no-store" } });
}

// `metadata.json` is the single source of truth for license, modalities,
// tasks, and authors post-#78. Null-coalesce so DetailRail can render its
// existing empty states without each consumer re-checking for undefined.
const enrichedMetadata = {
  ...metadata,
  license: metadata.license || null,
  recording_modality: metadata.recording_modality ?? [],
  tasks: metadata.tasks ?? [],
  authors: metadata.authors ?? [],
};

const unpublished = isUnpublished(landing);

const selectedVersion =
  versionParam && landing.versions.some((v) => v.version === versionParam)
    ? versionParam
    : (landing.latest ?? landing.versions[0]?.version ?? null);

// Dataset DOI + citation (APA/BibTeX) for the rail. The DOI moved off the
// action row into the rail so the buttons stay on one line (#126).
const datasetDoi = metadata.external_links.dataset_doi;
const cite = datasetDoi
  ? {
      doi: datasetDoi,
      ...datasetCitation({
        authors: enrichedMetadata.authors.map((a) => a.name).filter(Boolean),
        name: metadata.name,
        version: selectedVersion,
        date: metadata.provenance.publish_date,
        doi: datasetDoi,
        id,
      }),
    }
  : null;

// README and BIDS tree hydrate client-side (see the <script> block at the
// bottom of this file): README from raw.githubusercontent.com directly,
// tree from data.nemar.org/<id>/<v>/?format=json (nemar-cli#636). SSR
// critical path only awaits landing + metadata + catalog row + QA.

const provenance = detectProvenance(metadata, landing);
const modalities = enrichedMetadata.recording_modality.length
  ? enrichedMetadata.recording_modality
  : splitModalities("");

// Server-rendered schema.org Dataset JSON-LD (website#156). Shares
// `canonicalOriginFor` with Base.astro's `<link rel="canonical">` rather than
// re-deriving the origin, so the two cannot drift: this page is a marketing
// route, and since website#210 the app host renders it for signed-in users.
// Host-derived logic would then emit `app.nemar.org` here while the canonical
// tag in the same <head> said `nemar.org` — structured data contradicting the
// page it describes. Excludes the `?v=` query string so the identifier stays
// stable across version switches, matching the canonical URL.
const jsonLdOrigin = canonicalOriginFor(url.pathname, url.hostname);
const jsonLdPageUrl = new URL(url.pathname, jsonLdOrigin).toString();
const jsonLdScript = datasetJsonLdScript({
  id,
  metadata,
  catalogRow,
  selectedVersion,
  provenance,
  pageUrl: jsonLdPageUrl,
  dataBase: resolveDataBase(),
});

const githubUrl = metadata.external_links.github_url ?? `https://github.com/${ORG_DATASETS}/${id}`;
// Owner/repo slug for the client-side GitHub raw fetch. Strips the
// `https://github.com/` prefix + any trailing slash + any `.git` suffix
// so raw.githubusercontent.com/<slug>/<version>/README.md resolves.
// Falls back to `${ORG_DATASETS}/${id}` (the same default used for
// githubUrl) when metadata doesn't specify a repo.
// Trailing-slash strip MUST run before the `.git` strip — a URL ending in
// `.git/` would otherwise leave `.git` in the slug because the `$` anchor
// requires the literal to be the final char.
const githubRepoSlug = githubUrl
  .replace(/^https?:\/\/github\.com\//, "")
  .replace(/\/$/, "")
  .replace(/\.git$/, "");
const issuesUrl = `${githubUrl}/issues`;
const openneuroId = provenance.kind === "derived" ? (provenance.originalDatasetId ?? null) : null;
const archiveUrl = selectedVersion ? archiveZipUrl(id, selectedVersion) : null;
const ogImageVersion = String(import.meta.env.CF_PAGES_COMMIT_SHA ?? "static-v1").slice(0, 12);

// Edge-cache aggressively: dataset detail rarely changes within a window. Cloudflare
// honors s-maxage at the edge; max-age stays short so browsers re-validate on nav.
// stale-while-revalidate keeps the edge serving last-good response while it refreshes.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=86400",
);
---

<Base
  title={metadata.name}
  description={metadata.description ?? `${id} dataset on NEMAR`}
  image={`/og/dataset-card/${encodeURIComponent(id)}.png?v=${encodeURIComponent(ogImageVersion)}`}
  imageType="image/png"
  imageWidth={1200}
  imageHeight={800}
  imageAlt={`${metadata.name} dataset summary card on NEMAR.`}
  ogType="article"
  jsonLdScript={jsonLdScript}
>
  <article class="detail">
    <header class="detail__header container">
      <div class="detail__id-row">
        <span class="detail__id">{id}</span>
        {provenance.kind === "derived" ? (
          <ProvenanceToggle
            datasetId={id}
            nemarDoi={metadata.external_links.dataset_doi}
            currentVersion={selectedVersion}
            provenance={provenance}
          />
        ) : (
          <span class="detail__lineage">NEMAR-native dataset</span>
        )}
      </div>
      <h1 class="detail__title">{metadata.name}</h1>
      {metadata.description && metadata.description !== metadata.name && (
        <section class="detail__lede-card" data-detail-lede>
          <p class="detail__lede">{metadata.description}</p>
          <span
            class="detail__lede-ai"
            role="img"
            aria-label="AI-generated description, may include mistakes"
            title="AI-generated description, may include mistakes"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <span class="visually-hidden">AI-generated description, may include mistakes</span>
          </span>
        </section>
      )}
      <div class="detail__chips">
        {modalities.map((m) => <Tag kind="modality" value={m} href={modalityHref(m)} size="md" />)}
      </div>
      <div class="detail__actions">
        <ActionBar
          datasetId={id}
          version={selectedVersion}
          archiveUrl={archiveUrl}
          archive={landing.archive ?? null}
          issuesUrl={issuesUrl}
          githubUrl={githubUrl}
          openneuroId={openneuroId}
        />
      </div>
    </header>

    <div class="container">
      <VersionSwitcher
        versions={landing.versions}
        current={selectedVersion ?? ""}
        mirrorVersions={provenance.kind === "derived" ? provenance.allMirrorVersions : []}
      />
    </div>

    <div class="container detail__body">
      <div class="detail__main">
        {unpublished ? (
          <div class="detail__unpublished">
            <h2>Not yet published</h2>
            <p>This dataset has been registered but no published version is available yet. Check back later or visit the <a href={githubUrl} rel="external">dataset repository</a> for curation progress.</p>
          </div>
        ) : (
          <>
            <Readme
              defer
              datasetId={id}
              version={selectedVersion}
              githubRepo={githubRepoSlug}
              fallbackDescription={
                metadata.description && metadata.description !== metadata.name
                  ? metadata.description
                  : null
              }
            />
            <DatasetTabs datasetId={id} version={selectedVersion} />
            {selectedVersion && (
              <>
                <BidsTree datasetId={id} version={selectedVersion} />
                <EegViewerDialog />
              </>
            )}
          </>
        )}
      </div>
      <DetailRail
        metadata={enrichedMetadata}
        cite={cite}
        nChannels={catalogRow?.n_channels ?? null}
        electrodeSystem={catalogRow?.electrode_system ?? null}
      />
    </div>
  </article>
</Base>

<script>
  import { renderMarkdown } from "../../lib/markdown";
  import { isDirRecordingName } from "../../lib/bids-tree";
  import type { DirListing } from "../../lib/dir-listing";
  import { fetchDirListing, fileDownloadUrl } from "../../lib/dir-listing";
  import { formatBytes } from "../../lib/format";
  import {
    renderDirChunkRows,
    renderSubdir,
    renderTopLevel,
  } from "../../lib/render-dir-listing";
  import {
    type ZarrIndexStore,
    fetchZarrIndex,
    prefetchZarrStoreMetadata,
    zarrAvailablePaths,
    zarrFailureReasonByPath,
    zarrStoreByPath,
  } from "../../lib/zarr-index";
  import {
    NAV_ORDER_CHANGED_EVENT,
    type RecordingEntry,
    buildRecordingList,
    firstRecording,
    orderedRecordings,
    readNavOrder,
    recordingPosition,
    selectRecording,
    stepRecording,
    subjectValues,
    taskValues,
  } from "../../lib/eeg-viewer/recording-nav";
  // Type-only, so this does not pull the (WebGL-carrying) viewer module into
  // the page bundle; the mount itself stays behind the dynamic import below.
  import type {
    ViewerAnnotationHandle,
    ViewerTransferState,
  } from "../../lib/eeg-viewer/viewer";
  // The preview renderers are dynamic-imported on first click (one bundle
  // per format, code-split by Vite) so a user who never opens a TSV
  // doesn't pay for parsing the TSV renderer's bundle.

  // The fetched listing held per tree section. The "Show next" click handler
  // re-emits rows from this without re-fetching. WeakMap keys by element so
  // the entry is garbage-collected when the section detaches (SPA-style
  // navigation isn't used here today, but it's the cheap-correct default).
  const listingBySection = new WeakMap<HTMLElement, DirListing>();
  /**
   * Settles when a section's Zarr index has been fetched AND applied to its rows
   * (#240). Never rejects — `fetchZarrIndex` resolves null on failure — so an
   * awaiting opener always proceeds.
   */
  const zarrReadyBySection = new WeakMap<HTMLElement, Promise<void>>();
  /** Longest a viewer open will wait on the Zarr index before opening without it. */
  const ZARR_INDEX_WAIT_MS = 3000;
  const zarrBySection = new WeakMap<
    HTMLElement,
    {
      paths: Set<string>;
      stores: Map<string, ZarrIndexStore>;
      /** BIDS path (or store-rel path) -> reason it has no viewer, when known. */
      failureReasons: Map<string, string>;
      /** Cache-busting token for this conversion (index `updated_utc`; #240). */
      token: string;
      prefetched: Set<string>;
      firstPrefetched: boolean;
    }
  >();

  // Signal viewer state (website#217). The viewer opens inline, in the
  // clicked row's own preview panel; the page-level dialog
  // (EegViewerDialog.astro) is a second step behind that panel's "Enlarge"
  // control, and it receives the already-mounted host rather than hosting a
  // mount of its own.
  //
  // At most one viewer is live page-wide. That constraint arrived with the
  // modal in website#199 but is not about the modal: each mount holds a WebGL
  // context and browsers cap those (~16), so opening a second signal file
  // releases the first instead of accumulating one per row.
  //
  // `eegSeq` is bumped on every open *and* every release; a mount attempt
  // whose captured `seq` no longer matches by the time it resolves was
  // superseded and tears itself down instead of touching the DOM. `eegLive`
  // holds the row, the portable host element, and the teardown handle
  // `mountEegViewer` returns, so a new open, a collapse, and a dialog close
  // can each find the current instance and its DOM.
  let eegSeq = 0;
  let eegLive: {
    /**
     * Null when the viewer was opened directly into the dialog with no
     * originating tree row (the "View data" action-bar button, website#260)
     * — `detached` is always true in that case, so nothing here ever reads
     * `btn`/`slot` for it. Non-null for every row-opened viewer.
     */
    btn: HTMLButtonElement | null;
    /** The row's `[data-preview-slot]` — the viewer's home. Null; see `btn`. */
    slot: HTMLElement | null;
    /** The element `mountEegViewer` owns; moves between `slot` and the dialog. */
    host: HTMLElement;
    fileName: string;
    destroy: (() => void) | null;
    /**
     * Dataset context (website#253). Held here rather than re-read from the
     * row, because a navigation remounts the viewer after the row it came from
     * has been collapsed — and the recording it swaps to may have no row in the
     * tree at all, since directories load lazily.
     */
    datasetId: string;
    version: string;
    zarrToken: string;
    /** BIDS path of the recording on screen; changes on every navigation. */
    path: string;
    /** Every viewable recording in this dataset, in Zarr index order. */
    recordings: RecordingEntry[];
    /** The section's Zarr state, for warming the next recording's metadata. */
    zarr: {
      stores: Map<string, ZarrIndexStore>;
      prefetched: Set<string>;
      token: string;
    } | null;
    /**
     * True once the user has navigated within the dialog. The viewer then no
     * longer shows the row it was opened from, so that row has been collapsed
     * and the dialog owns the instance outright.
     */
    detached: boolean;
    /** Settings to carry into the next recording (website#253). */
    snapshot: (() => ViewerTransferState) | null;
    /**
     * The instance's annotation layer, for asking whether an unsaved draft is
     * open before a navigation destroys it. Null until the mount reports one
     * (and for a mount that produced no viewer, which has no drafts to lose).
     */
    annotations: ViewerAnnotationHandle | null;
  } | null = null;

  /**
   * Client-side hydration for the README and BIDS tree panels. Pre-#76 these
   * were SSR'd by /api/dataset/<id>/{readme,tree} partial endpoints which
   * fetched summary.json + manifest.json on every request, hit cold-isolate
   * timeouts on HBN-sized datasets, and required several refresh cycles to
   * warm. The pipeline was the actual failure surface for the user-visible
   * "No description available" / "Manifest unavailable" placeholders.
   *
   * Now: README comes from raw.githubusercontent.com via GitHub's CDN;
   * tree comes from data.nemar.org/<id>/<v>/?format=json (nemar-cli#636 /
   * v0.8.37 — typically a small top-level JSON with real per-file sizes
   * and native lazy-per-directory). No website worker in the chain.
   */

  async function hydrateReadme(article: HTMLElement): Promise<void> {
    const datasetId = article.dataset.id;
    const version = article.dataset.version;
    const repo = article.dataset.githubRepo;
    const fallbackDesc = article.dataset.fallbackDesc ?? "";
    if (!datasetId || !version) return;

    let markdown: string | null = null;
    if (repo) {
      // Tagged version first. README content is per-version; the dataset
      // repo's tag matches the published version label.
      const rawUrl = `https://raw.githubusercontent.com/${repo}/${encodeURIComponent(version)}/README.md`;
      try {
        const res = await fetch(rawUrl);
        if (res.ok) {
          const text = await res.text();
          if (text.trim().length > 0) markdown = text;
        }
      } catch (err) {
        console.warn(`[readme/${datasetId}] GitHub raw fetch failed:`, err);
      }
    }

    article.removeAttribute("aria-busy");
    if (markdown) {
      article.innerHTML = renderReadmeWrap(renderMarkdown(markdown));
      const wrap = article.querySelector<HTMLElement>("[data-readme-wrap]");
      const sync = (
        window as typeof window & { __nemarSyncReadme?: (w: HTMLElement) => void }
      ).__nemarSyncReadme;
      if (wrap && sync) sync(wrap);
      return;
    }

    // No README at this version. Use metadata.description if present and
    // meaningful (the SSR-passed fallback), else show the empty state.
    if (fallbackDesc.length > 0) {
      article.innerHTML = `<div class="readme__fallback-note" role="note"><strong>Description (from dataset metadata)</strong><span>This dataset doesn't ship a README. Showing the BIDS description instead.</span></div>${renderReadmeWrap(renderMarkdown(fallbackDesc))}`;
      const wrap = article.querySelector<HTMLElement>("[data-readme-wrap]");
      const sync = (
        window as typeof window & { __nemarSyncReadme?: (w: HTMLElement) => void }
      ).__nemarSyncReadme;
      if (wrap && sync) sync(wrap);
      return;
    }

    article.innerHTML = `<div class="readme__empty"><h2>No description available</h2><p>This dataset doesn't ship a README and the BIDS metadata has no description either. The file tree below and the metadata panel on the right are the authoritative description for now. The dataset's GitHub repository may have curation notes added later.</p></div>`;
  }

  /** The expand/collapse shell the Readme.astro non-defer branch uses,
   *  emitted in JS so injected README HTML matches the SSR path's markup
   *  and the existing .readme__toggle delegated click handler works. */
  function renderReadmeWrap(innerHtml: string): string {
    return `<div class="readme__wrap" data-readme-wrap><div class="readme__body">${innerHtml}</div><div class="readme__fade" aria-hidden="true"></div><div class="readme__toolbar"><button class="readme__toggle" type="button" data-readme-toggle aria-expanded="false" aria-controls="readme-body"><span class="readme__toggle-label">Expand README</span></button></div></div>`;
  }

  async function hydrateTree(section: HTMLElement): Promise<void> {
    const datasetId = section.dataset.id;
    const version = section.dataset.version;
    if (!datasetId || !version) return;
    // Registered BEFORE the await below, so a row rendered by the dir listing can
    // never be clicked without an index promise to wait on (#240).
    const zarrReady = fetchZarrIndex(datasetId)
      .then((index) => {
        if (!index) {
          // Parity with the dir-listing paths below, which both log. Now that the
          // cache-busting token rides on this index, a silent failure also means
          // stale chunks can be served for this whole page view -- worth a trail.
          console.warn(`[zarr/${datasetId}] index unavailable; viewer cache-busting disabled`);
          return;
        }
        const state = {
          paths: zarrAvailablePaths(index),
          stores: zarrStoreByPath(index),
          failureReasons: zarrFailureReasonByPath(index),
          token: index.updated_utc,
          prefetched: new Set<string>(),
          firstPrefetched: false,
        };
        zarrBySection.set(section, state);
        annotateZarrRows(section);
        // "View data" action-bar button (website#260): revealed only once the
        // index resolves with at least one store, so a dataset with none
        // (pre-backfill, e.g. on004696) never advertises a dead button. Left
        // hidden (its SSR default) when the index fetch fails or throws —
        // neither of those runs this callback.
        const viewDataBtn = document.querySelector<HTMLButtonElement>("[data-view-data-btn]");
        if (viewDataBtn) viewDataBtn.hidden = state.paths.size === 0;
      })
      .catch((err) => {
        console.warn(`[zarr/${datasetId}] index fetch threw:`, err);
      });
    zarrReadyBySection.set(section, zarrReady);
    const listing = await fetchDirListing(datasetId, version, "");
    section.removeAttribute("aria-busy");
    if (!listing) {
      // Parity with the subdir-toggle handler: both null paths log so a
      // developer with devtools open can distinguish "this specific dataset
      // is broken" from "the whole endpoint is down."
      console.warn(`[tree/${datasetId}] top-level dir listing returned null (v=${version})`);
      section.innerHTML = `<section class="detail__no-manifest" role="alert"><h2>File index unavailable</h2><p>The file index for <code>${escapeHtml(version)}</code> couldn't be loaded right now. Try refreshing in a few seconds, or use the <a href="/discover">Discover page</a> to pick another dataset or version.</p></section>`;
      return;
    }
    listingBySection.set(section, listing);
    section.innerHTML = renderTopLevel(listing);
    annotateZarrRows(section);
  }

  // Mirrors the renderer's CHEVRON_SVG in `render-dir-listing.ts` (sync
  // comment there) — the upgraded row must look identical to an SSR'd one.
  const DIR_CHEVRON_SVG = `<svg class="tree__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>`;

  /**
   * Rebuild an ordinary `<details>` directory row into the hybrid
   * signal-recording row shape `renderSignalDirRow` emits (website#252):
   * sibling expand-toggle + viewer buttons instead of a button nested in
   * `<summary>` (inconsistent AT exposure). `.mefd`/`.ds` rows come out of
   * the renderer already shaped this way; this covers directory recordings
   * the renderer cannot recognize by name — 4D/BTi carries no extension at
   * all — using the zarr index as the authority (its `stores`/`failures` are
   * keyed by the recording DIRECTORY path, mirroring the producer's
   * content-keyed detection). Preserves already-fetched children and the
   * open/closed state. Idempotent per row.
   */
  function upgradeDirRecordingRow(details: HTMLElement): void {
    const summary = details.querySelector<HTMLElement>(":scope > summary");
    const target = details.querySelector<HTMLElement>(":scope > [data-dir-target]");
    const li = details.parentElement;
    const path = details.dataset.dirPath ?? "";
    if (!summary || !target || li?.tagName !== "LI" || !path) {
      // Matches this file's idiom elsewhere: a structural-assumption break
      // must leave a console trail, or BTi recognition silently dies the
      // next time the tree markup changes shape.
      console.warn("[tree] can't upgrade dir row to recording (markup changed?)", details);
      return;
    }
    const name = path.split("/").pop() ?? path;
    const depth = details.dataset.depth ?? "0";
    const wasOpen = (details as HTMLDetailsElement).open === true;

    const row = document.createElement("div");
    row.className = "tree__row tree__row--dir";
    // Carry the renderer-computed indent over from the summary it replaces.
    const indent = summary.getAttribute("style");
    if (indent) row.setAttribute("style", indent);

    const toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "tree__dir-toggle";
    toggle.setAttribute("data-dir-toggle", "");
    toggle.dataset.dirPath = path;
    toggle.dataset.depth = depth;
    toggle.setAttribute("aria-expanded", wasOpen ? "true" : "false");
    toggle.setAttribute("aria-label", `Browse files in ${name}`);
    toggle.innerHTML = DIR_CHEVRON_SVG;

    const icon = document.createElement("span");
    icon.className = "tree__icon";
    icon.setAttribute("aria-hidden", "true");
    icon.textContent = "▸";

    const viewBtn = document.createElement("button");
    viewBtn.type = "button";
    viewBtn.className = "tree__preview-btn";
    viewBtn.dataset.previewPath = path;
    viewBtn.dataset.previewType = "eeg";
    viewBtn.dataset.dirRecording = "true";
    viewBtn.dataset.fileName = name;
    viewBtn.setAttribute("aria-expanded", "false");
    const nameSpan = document.createElement("span");
    nameSpan.className = "tree__name";
    nameSpan.textContent = `${name}/`;
    viewBtn.appendChild(nameSpan);
    // No format badge here, deliberately: unlike `.mefd`/`.ds` there is no
    // name-derived format string for a content-keyed (BTi) recording, and
    // the index doesn't carry one either.

    row.append(toggle, icon, viewBtn);
    target.hidden = !wasOpen;

    const slot = document.createElement("div");
    slot.className = "tree__preview tree__preview--signal";
    slot.setAttribute("data-preview-slot", "");
    slot.hidden = true;

    li.classList.add("tree__file-wrap");
    li.setAttribute("data-preview-wrap", "");
    li.replaceChildren(row, target, slot);
  }

  function annotateZarrRows(section: HTMLElement): void {
    const state = zarrBySection.get(section);
    if (!state) return;
    // Upgrade index-listed directory recordings BEFORE the availability loop,
    // so the buttons this creates are annotated by the same pass. A path in
    // `failureReasons` is upgraded too: the recording exists but can't be
    // converted, and the row must be able to SAY that (disabled-with-reason,
    // like a `.mefd` row) rather than pose as an ordinary folder.
    for (const details of section.querySelectorAll<HTMLElement>("details[data-dir-path]")) {
      const path = details.dataset.dirPath ?? "";
      if (!path) continue;
      if (!state.paths.has(path) && !state.failureReasons.has(path)) continue;
      upgradeDirRecordingRow(details);
    }
    for (const btn of section.querySelectorAll<HTMLButtonElement>(
      '[data-preview-type="eeg"][data-preview-path]',
    )) {
      const path = btn.dataset.previewPath ?? "";
      const available = state.paths.has(path);
      btn.dataset.zarrAvailable = available ? "true" : "false";
      // A recorded data failure (derivative, corrupt, unsupported) carries a
      // specific reason; attach it so the click handler explains *why* instead of
      // a generic "not available". Absent => still generating / will retry.
      const reason = state.failureReasons.get(path);
      if (reason) {
        btn.dataset.zarrFailureReason = reason;
      } else {
        delete btn.dataset.zarrFailureReason;
      }
      if (available) {
        btn.title = `Open signal viewer for ${btn.dataset.fileName ?? path}`;
      } else {
        btn.title = reason ?? "No interactive Zarr viewer is available for this recording yet";
      }
    }
    prefetchFirstZarrRow(section, state);
  }

  function prefetchFirstZarrRow(
    section: HTMLElement,
    state = zarrBySection.get(section),
  ): void {
    if (!state || state.firstPrefetched) return;
    const btn = section.querySelector<HTMLButtonElement>(
      '[data-preview-type="eeg"][data-zarr-available="true"][data-preview-path]',
    );
    if (!btn) return;
    state.firstPrefetched = true;
    prefetchZarrButton(btn, state);
  }

  function prefetchZarrButton(
    btn: HTMLButtonElement,
    state?: {
      paths: Set<string>;
      stores: Map<string, ZarrIndexStore>;
      token: string;
      prefetched: Set<string>;
      firstPrefetched: boolean;
    },
  ): void {
    const section = btn.closest<HTMLElement>("[data-tree-defer]");
    state ??= section ? zarrBySection.get(section) : undefined;
    const datasetId = section?.dataset.id;
    const path = btn.dataset.previewPath ?? "";
    if (!state || !datasetId || !path || state.prefetched.has(path)) return;
    state.prefetched.add(path);
    prefetchZarrStoreMetadata(datasetId, path, state.stores.get(path), state.token);
  }

  /**
   * Cache-busting token for the section owning `btn` (#240). Callers must
   * `await zarrIndexReady(btn)` first; without that this returns "" whenever the
   * index is still in flight, silently restoring the pre-#240 un-busted URL.
   */
  function zarrTokenForButton(btn: HTMLElement): string {
    const section = btn.closest<HTMLElement>("[data-tree-defer]");
    return (section ? zarrBySection.get(section)?.token : undefined) ?? "";
  }

  /**
   * Settle once the section's Zarr index has been applied to its rows, so
   * availability and the cache-busting token are both readable. Resolves
   * immediately when the index already landed (the common case: the user has to
   * expand directories and click, which takes far longer than the fetch).
   *
   * Capped by `ZARR_INDEX_WAIT_MS` so this can only ever delay opening a viewer,
   * never prevent it — a hung index fetch costs the token, not the feature.
   */
  function zarrIndexReady(btn: HTMLElement): Promise<void> {
    const section = btn.closest<HTMLElement>("[data-tree-defer]");
    const ready = section ? zarrReadyBySection.get(section) : undefined;
    if (!ready) return Promise.resolve();
    return Promise.race([
      ready,
      new Promise<void>((resolve) => setTimeout(resolve, ZARR_INDEX_WAIT_MS)),
    ]);
  }

  // Delegated click for the "Show next N" footer. Single document-level
  // listener (cheap, fires only when a tree__more-btn ancestor is hit) so
  // we don't have to re-bind after each chunk reveal. Mirrors the toggle
  // capture-phase delegate above.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>(".tree__more-btn");
    if (!button) return;
    const footer = button.closest<HTMLElement>("[data-tree-more]");
    const section = button.closest<HTMLElement>("[data-tree-defer]");
    if (!footer || !section) return;
    const listing = listingBySection.get(section);
    const list = section.querySelector<HTMLElement>("[data-dir-list]");
    // No cached listing means the tree never finished hydrating (or was
    // rewritten with an error). The footer shouldn't exist in that case;
    // surface loudly + remove it so the user isn't left with a dead button.
    if (!listing || !list) {
      console.error(
        `[tree] show-more clicked but cached listing missing (section=${section.dataset.id ?? "?"})`,
      );
      footer.remove();
      return;
    }

    const rendered = Number(footer.dataset.rendered ?? "0");
    const total = Number(footer.dataset.total ?? "0");
    const chunk = Number(footer.dataset.chunk ?? "50");
    const result = renderDirChunkRows(listing, rendered, chunk);
    // Defensive: if the slice returns zero rows the data-rendered counter
    // is out of sync with the cached listing (shouldn't be reachable via
    // the happy path, but a stale counter would leave the button looping
    // with no visible effect). Remove the footer to avoid a stuck button.
    if (result.rendered === 0) {
      console.warn(
        `[tree] show-more produced 0 rows (rendered=${rendered} total=${total} listingDirs=${result.total})`,
      );
      footer.remove();
      return;
    }
    list.insertAdjacentHTML("beforeend", result.html);
    annotateZarrRows(section);

    const newRendered = rendered + result.rendered;
    if (newRendered >= total) {
      footer.remove();
      return;
    }
    footer.dataset.rendered = String(newRendered);
    const nextCount = Math.min(chunk, total - newRendered);
    const counter = footer.querySelector(".tree__more-counter");
    // The button's text node sits before the counter <span>; updating
    // nodeValue avoids clobbering the nested element + its event paths.
    const label = button.firstChild;
    if (label && label.nodeType === Node.TEXT_NODE) {
      label.nodeValue = `Show next ${nextCount} `;
    } else {
      // Extension or DOM mutation displaced the text node. Counter still
      // updates below; warn so a developer reading devtools can correlate
      // the visual mismatch ("button label stuck at 50 but counter ticks").
      console.warn("[tree] show-more button first child isn't a text node; label not updated");
    }
    if (counter) counter.textContent = `(${newRendered} of ${total} shown)`;
  });

  // Inline file-preview delegate. Mirrors the show-more click delegate
  // above. Fires when the user clicks a `.tree__preview-btn` (the name of
  // a previewable file). First click fetches + renders the inline panel
  // under the row; subsequent clicks toggle visibility without re-fetching.
  // The download icon (`.tree__dl`) is a separate `<a download>` and not
  // intercepted here — the browser's default click handling triggers the
  // byte download as before.
  const MAX_PREVIEW_BYTES = 512 * 1024;
  // Cache of fetched-and-parsed TSV text per slot. Used by the "Show all"
  // re-reveal so we re-render from memory instead of re-fetching.
  const tsvCacheBySlot = new WeakMap<HTMLElement, string>();

  function maybePrefetchZarrFromTarget(target: EventTarget | null): void {
    if (!(target instanceof Element)) return;
    const btn = target.closest<HTMLButtonElement>(
      '[data-preview-type="eeg"][data-zarr-available="true"][data-preview-path]',
    );
    if (btn) prefetchZarrButton(btn);
  }

  document.addEventListener("mouseover", (event) => maybePrefetchZarrFromTarget(event.target));
  document.addEventListener("focusin", (event) => maybePrefetchZarrFromTarget(event.target));

  // Four corner brackets pointing outward — the conventional "expand to a
  // larger surface" glyph, and distinct from the download arrow the same row
  // already carries.
  const ENLARGE_ICON_SVG =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>' +
    "</svg>";

  /**
   * Put a signal row back in its collapsed, empty state. Idempotent. A no-op
   * for a detached-from-birth viewer (website#260), which has no row.
   */
  function resetEegRow(btn: HTMLButtonElement | null, slot: HTMLElement | null): void {
    if (!btn || !slot) return;
    slot.innerHTML = "";
    slot.hidden = true;
    delete slot.dataset.loaded;
    slot.removeAttribute("aria-busy");
    btn.setAttribute("aria-expanded", "false");
  }

  /**
   * Tear down the live viewer (if any), return the dialog to a clean state,
   * and collapse the row that owned it. Two call sites, both of which are
   * about to make some other recording the single live instance:
   * `openEegViewerInline` (another signal row opened, or the open one
   * collapsed) and `openRecordingInDialog` (the action bar's "View data",
   * website#260).
   */
  function releaseEegViewer(): void {
    eegSeq++; // invalidate any mount still in flight
    const live = eegLive;
    eegLive = null;
    live?.destroy?.();
    const dialog = document.querySelector<HTMLDialogElement>("[data-eeg-dialog]");
    if (dialog?.open) {
      // Empty the dialog here rather than leaving it to the close handler.
      // `close()` only *queues* the close event, and `openEegViewerInline`
      // (this function's only caller) assigns a new `eegLive` synchronously
      // before its first await — so by the time that handler runs it can
      // already be looking at a different row, and would not recognise this
      // host as something to clear. Doing it synchronously means a released
      // host can never be stranded inside a closed dialog.
      //
      // Unreachable today: a modal <dialog> makes the rest of the document
      // inert, so no tree row can be clicked while it is open. That is a
      // guarantee about the dialog being modal, though, not about this
      // function, and it costs one line not to depend on it.
      document.querySelector<HTMLElement>("[data-eegv-slot]")?.replaceChildren();
      dialog.close();
    }
    // A detached viewer's row was already collapsed when the user navigated
    // away from it (see `navigateEegViewer`); resetting it again could clobber
    // a panel the user has since reopened.
    if (live && !live.detached) resetEegRow(live.btn, live.slot);
  }

  /**
   * Open the EEG/MEG/iEEG/EMG signal viewer inline, in the clicked row's own
   * preview panel (website#217). Keeps every failure path the modal version
   * had — `zarrAvailable === "false"` with its recorded reason, the
   * mount-failure catch, both with a download fallback — plus the aria-busy /
   * data-loaded markers and the code-split dynamic import.
   *
   * `eegSeq` supersedes rather than merely bails: a second file opened before
   * the first finishes loading must actively tear the first one down, since
   * by then it may already hold a store and a GL context.
   */
  async function openEegViewerInline(btn: HTMLButtonElement): Promise<void> {
    const wrap = btn.closest<HTMLElement>("[data-preview-wrap]");
    const slot = wrap?.querySelector<HTMLElement>("[data-preview-slot]");
    if (!wrap || !slot) {
      console.error("[eeg-viewer] preview slot missing for row", btn);
      return;
    }

    // Second click on the already-open row collapses it. `releaseEegViewer`
    // covers the case where this row holds the live viewer; the unconditional
    // reset also covers the rows that are expanded *without* one (a recorded
    // "unavailable", or a mount that failed).
    const wasExpanded = btn.getAttribute("aria-expanded") === "true";
    releaseEegViewer();
    resetEegRow(btn, slot);
    if (wasExpanded) return;

    const fileName = btn.dataset.fileName ?? "";
    const filePath = btn.dataset.previewPath ?? "";
    const section = btn.closest<HTMLElement>("[data-tree-defer]");
    const treeId = section?.dataset.id;
    const treeVersion = section?.dataset.version;

    btn.setAttribute("aria-expanded", "true");
    slot.hidden = false;

    if (!treeId || !treeVersion || !filePath) {
      // The button is somehow outside a `[data-tree-defer]` section. The panel
      // is already open from the flip above — surface an error rather than
      // leave the user staring at an empty box.
      console.warn("[eeg-viewer] missing dataset context on btn", btn);
      slot.innerHTML = `<p class="preview__error" role="alert">Couldn't load the viewer: missing dataset context. Try refreshing the page.</p>`;
      slot.dataset.loaded = "true";
      return;
    }
    const fileUrl = fileDownloadUrl(treeId, treeVersion, filePath);
    // A directory recording (`.mefd`/`.ds`/BTi, website#252) has no single
    // file to download, and linking its data.nemar.org path would land the
    // user on raw listing JSON — so point at the row's own expand arrow,
    // which browses the member files right here in the tree.
    const isDirRecording = btn.dataset.dirRecording === "true";
    const fallbackActionHtml = isDirRecording
      ? "Use the expand arrow next to its name to browse the recording's files"
      : `<a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download the file</a>`;

    // The Zarr index races the dir listing, and the listing usually wins: it is
    // the smaller payload off the already-warm data plane. Until the index lands,
    // `annotateZarrRows` has not run, so `data-zarr-available` is UNSET — which
    // the gate below reads as "available" — and `zarrTokenForButton` returns "",
    // i.e. the un-busted URL #240 exists to avoid. Waiting here makes both reads
    // meaningful. Bounded, so a wedged index fetch degrades to opening without a
    // token rather than a row that never opens.
    //
    // This is the first await in the function, and it lands BEFORE the mount
    // registers this row in `eegLive` — so a second click during the wait cannot
    // be collapsed by `releaseEegViewer` (it sees no live viewer yet). Claim a
    // sequence number up front and stand down if a newer open took it, undoing
    // the row expansion above rather than leaving a row stuck on "Loading".
    const openSeq = ++eegSeq;
    await zarrIndexReady(btn);
    if (openSeq !== eegSeq) {
      resetEegRow(btn, slot);
      return;
    }

    if (btn.dataset.zarrAvailable === "false") {
      // A recorded data failure has a specific, permanent reason; show it.
      // Otherwise the store is just missing (still generating / will retry).
      const reason = btn.dataset.zarrFailureReason;
      const lead = reason
        ? escapeHtml(reason)
        : "No interactive viewer is available for this recording yet.";
      slot.innerHTML = `<p class="preview__empty" role="status">${lead} ${fallbackActionHtml} instead.</p>`;
      slot.dataset.loaded = "true";
      return;
    }

    prefetchZarrButton(btn);
    slot.dataset.loaded = "loading";
    slot.setAttribute("aria-busy", "true");
    // The host is a dedicated child, not the slot itself, precisely so it can
    // be moved into the dialog without taking the row's chrome with it.
    slot.innerHTML = [
      `<div class="eegv-inline__bar">`,
      `<span class="eegv-inline__name" title="${escapeHtml(fileName)}">${escapeHtml(fileName)}</span>`,
      `<button type="button" class="eegv-inline__btn" data-eegv-enlarge aria-haspopup="dialog">${ENLARGE_ICON_SVG}Enlarge</button>`,
      `</div>`,
      `<div data-eegv-host><p class="preview__loading" role="status">Loading viewer…</p></div>`,
    ].join("");
    const host = slot.querySelector<HTMLElement>("[data-eegv-host]");
    if (!host) {
      // Unreachable short of the shell markup above being edited out of sync
      // with this query — there is no await between writing it and reading it
      // back. Handled fully anyway, because this return sits *before*
      // `eegSeq`/`eegLive` are assigned and so is the one path the try/finally
      // below can never clean up: a bare return would leave the row spinning
      // on "Loading viewer…" behind a stuck `aria-busy` forever, with an
      // Enlarge control that silently no-ops (`enlargeEegViewer` would find no
      // live viewer). Replacing the whole panel clears all three at once.
      console.error("[eeg-viewer] host element missing after shell render");
      slot.innerHTML = `<p class="preview__error" role="alert">Couldn't open the viewer. ${fallbackActionHtml} instead.</p>`;
      slot.removeAttribute("aria-busy");
      slot.dataset.loaded = "true";
      return;
    }

    const seq = ++eegSeq;
    const zarr = section ? (zarrBySection.get(section) ?? null) : null;
    eegLive = {
      btn,
      slot,
      host,
      fileName,
      destroy: null,
      datasetId: treeId,
      version: treeVersion,
      zarrToken: zarrTokenForButton(btn),
      path: filePath,
      // Built from the index, not from the DOM: the tree only holds the
      // directories the user has expanded, while the index lists every
      // viewable recording in the dataset (website#253).
      recordings: zarr ? buildRecordingList(zarr.paths) : [],
      zarr,
      detached: false,
      snapshot: null,
      annotations: null,
    };
    try {
      const { mountEegViewer } = await import("../../lib/eeg-viewer/viewer");
      if (seq !== eegSeq) return; // superseded by a newer open, or released
      const destroy = await mountEegViewer(host, {
        datasetId: treeId,
        version: treeVersion,
        filePath,
        zarrToken: zarrTokenForButton(btn),
        downloadUrl: fileUrl,
        // So the mount's own "unavailable" message offers the same fallback
        // this function does for a directory recording (website#252), instead
        // of a download link onto raw directory listing JSON.
        dirRecording: isDirRecording,
        // Checked *inside* the mount, right after its own async gap, so a
        // superseded attempt returns before it writes into the host. The
        // check below only runs once the mount has already written its DOM,
        // too late to protect whatever got there first.
        isStale: () => seq !== eegSeq,
        onTransfer: (snapshot) => {
          if (seq === eegSeq && eegLive) eegLive.snapshot = snapshot;
        },
        onAnnotations: (handle) => {
          if (seq === eegSeq && eegLive) eegLive.annotations = handle;
        },
      });
      if (seq !== eegSeq) {
        // Superseded while mounting. Tear it down rather than let it keep
        // rendering and streaming unseen; whoever superseded us already owns
        // the DOM (`releaseEegViewer` cleared this row, or a newer open
        // rebuilt it), so there is nothing here to clean up beyond the
        // instance's own side effects.
        destroy?.();
        return;
      }
      if (!destroy) {
        // `mountEegViewer` returns no disposer precisely when it mounted no
        // viewer — the store wouldn't open, it has no channel groups, or
        // there is no canvas context — and left a static "unavailable"
        // message in the host instead. Two consequences. There is nothing to
        // enlarge, so drop the bar: otherwise the row offers a control that
        // opens a full-screen modal onto a single line of text. And there is
        // nothing to release (that path registers no observers and no GL
        // context), so this row must stop counting as the live instance,
        // or the next open would "release" a viewer that never existed.
        slot.querySelector(".eegv-inline__bar")?.remove();
        eegLive = null;
        return;
      }
      if (eegLive) eegLive.destroy = destroy;
    } catch (err) {
      console.error("[eeg-viewer] mount failed:", err);
      if (seq !== eegSeq) return;
      eegLive = null;
      slot.innerHTML = `<p class="preview__error" role="alert">Viewer failed to load. ${fallbackActionHtml} instead.</p>`;
    } finally {
      if (seq === eegSeq) {
        slot.removeAttribute("aria-busy");
        slot.dataset.loaded = "true";
      }
    }
  }

  /**
   * Promote the live inline viewer into the page-level dialog by *moving* its
   * host element, leaving a marker behind in the inline panel.
   *
   * Moving rather than remounting is the point of the feature: the montage,
   * filter, gain, channel page and time window are closure state inside one
   * mount, and re-running `mountEegViewer` would reset exactly the state the
   * user enlarged in order to see better. The move is safe because the
   * instance's MutationObserver watches `document.documentElement` (theme
   * flips) rather than its host, and its ResizeObserver watches the viewer
   * root *inside* the moved subtree — so the relocation triggers a repaint at
   * the new width and nothing else. It also works mid-mount: `mountEegViewer`
   * holds a reference to the host element, which the move does not invalidate.
   */
  function enlargeEegViewer(): void {
    const live = eegLive;
    const dialog = document.querySelector<HTMLDialogElement>("[data-eeg-dialog]");
    const dialogSlot = document.querySelector<HTMLElement>("[data-eegv-slot]");
    if (!dialog || !dialogSlot) {
      console.error("[eeg-viewer] dialog markup missing");
      return;
    }
    if (!live || dialog.open) return;

    const anchor = document.createElement("p");
    anchor.className = "eegv-inline__moved";
    anchor.dataset.eegvInlineAnchor = "";
    anchor.textContent = "Showing in the enlarged viewer.";
    live.host.replaceWith(anchor);
    dialogSlot.replaceChildren(live.host);
    setEegDialogTitle(live.fileName);
    dialog.showModal();
    // Recording navigation is a dialog-only affordance (website#253) — the
    // controls only exist here, so they are populated on the way in.
    syncEegNavControls();
    prefetchAdjacentRecordings();
  }

  /**
   * Open a recording straight into the enlarge dialog, with no originating
   * tree row — the "View data" action-bar button (website#260), which
   * reaches a recording through the Zarr index rather than a tree click.
   *
   * Starts `detached: true` from birth (ADR 0012): there is no inline row to
   * hand the viewer back to, so closing the dialog always destroys the
   * instance, the same as navigating away from a row-opened viewer already
   * does. Reuses the same `eegLive`/`eegSeq` machinery as
   * `openEegViewerInline`/`navigateEegViewer` — the single-live-viewer
   * invariant, the recording-nav dropdowns, prev/next — so nothing else in
   * this file has to special-case a button-opened viewer.
   *
   * Callable only while the eeg dialog is closed: every dialog on this page
   * is modal, which makes the rest of the document (the action bar
   * included) inert while one is open, so the button this calls from can
   * never be clicked mid-dialog. `releaseEegViewer`'s `dialog.close()` path
   * is therefore unreachable here, same as the "Unreachable today" case it
   * already documents for the row-open path.
   */
  async function openRecordingInDialog(
    target: RecordingEntry,
    ctx: {
      datasetId: string;
      version: string;
      recordings: RecordingEntry[];
      zarrToken: string;
      zarr: { stores: Map<string, ZarrIndexStore>; prefetched: Set<string>; token: string } | null;
    },
  ): Promise<void> {
    const dialog = document.querySelector<HTMLDialogElement>("[data-eeg-dialog]");
    const dialogSlot = document.querySelector<HTMLElement>("[data-eegv-slot]");
    if (!dialog || !dialogSlot) {
      console.error("[eeg-viewer] dialog markup missing");
      return;
    }
    // At most one viewer instance is ever live page-wide (website#199). Not a
    // no-op: the action bar sits outside the dialog and outside the tree, so
    // "View data" is perfectly clickable while an INLINE viewer is open in a
    // row below. That instance is released (and its row collapsed) here.
    // `releaseEegViewer`'s `dialog.close()` branch is what cannot be reached
    // from here — every dialog on this page is modal, so the button could not
    // have been clicked with one open.
    releaseEegViewer();

    const fileUrl = fileDownloadUrl(ctx.datasetId, ctx.version, target.path);
    const isDirRecording = isDirRecordingName(target.name);
    const fallbackActionHtml = isDirRecording
      ? "Use the file tree's expand arrow to browse the recording's files"
      : `<a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(target.name)}">Download the file</a>`;

    const host = document.createElement("div");
    host.setAttribute("data-eegv-host", "");
    host.innerHTML = `<p class="preview__loading" role="status">Loading viewer…</p>`;
    dialogSlot.replaceChildren(host);
    host.setAttribute("aria-busy", "true");
    setEegDialogTitle(target.name);
    dialog.showModal();

    const seq = ++eegSeq;
    eegLive = {
      btn: null,
      slot: null,
      host,
      fileName: target.name,
      destroy: null,
      datasetId: ctx.datasetId,
      version: ctx.version,
      zarrToken: ctx.zarrToken,
      path: target.path,
      recordings: ctx.recordings,
      zarr: ctx.zarr,
      detached: true,
      snapshot: null,
      annotations: null,
    };
    // The target itself has had no chance to warm (unlike a tree-row open,
    // which prefetches on hover/focus before the click) — mirror what
    // `prefetchZarrButton` does for a row, so the mount below hits a warm
    // cache the same as every other entry point does.
    if (ctx.zarr && !ctx.zarr.prefetched.has(target.path)) {
      ctx.zarr.prefetched.add(target.path);
      prefetchZarrStoreMetadata(
        ctx.datasetId,
        target.path,
        ctx.zarr.stores.get(target.path),
        ctx.zarrToken,
      );
    }
    // Nav controls and neighbour prefetch depend only on `recordings`/`path`,
    // both already final — populate them now rather than waiting on the
    // mount, the same as `navigateEegViewer` does for an in-dialog swap.
    syncEegNavControls();
    prefetchAdjacentRecordings();

    try {
      const { mountEegViewer } = await import("../../lib/eeg-viewer/viewer");
      if (seq !== eegSeq || !eegLive) return; // superseded while importing
      const destroy = await mountEegViewer(host, {
        datasetId: ctx.datasetId,
        version: ctx.version,
        filePath: target.path,
        zarrToken: ctx.zarrToken,
        downloadUrl: fileUrl,
        dirRecording: isDirRecording,
        isStale: () => seq !== eegSeq,
        onTransfer: (snapshot) => {
          if (seq === eegSeq && eegLive) eegLive.snapshot = snapshot;
        },
        onAnnotations: (handle) => {
          if (seq === eegSeq && eegLive) eegLive.annotations = handle;
        },
      });
      if (seq !== eegSeq) {
        // Superseded mid-mount by a faster click elsewhere; whoever
        // superseded us owns the dialog now.
        destroy?.();
        return;
      }
      if (!destroy) {
        // Mount rendered its own explanation (unavailable / no channel
        // groups) — nothing to release and nothing to navigate from.
        eegLive = null;
        syncEegNavControls();
        return;
      }
      if (eegLive) eegLive.destroy = destroy;
    } catch (err) {
      // Mirrors `navigateEegViewer`'s failure state: an explicit error in
      // the dialog, never a blank one (website#260).
      console.error("[eeg-viewer] view-data open failed:", err);
      if (seq !== eegSeq) return;
      eegLive = null;
      host.innerHTML = `<p class="preview__error" role="alert">Couldn't open ${escapeHtml(target.name)}. ${fallbackActionHtml} instead.</p>`;
      syncEegNavControls(); // nothing to navigate from; hide the now-dead controls
    } finally {
      if (seq === eegSeq) host.removeAttribute("aria-busy");
    }
  }

  /**
   * Click handler for the action bar's "View data" button (website#260).
   * Picks the first recording in the user's current nav order from the same
   * Zarr-index state the tree rows use, then hands it to
   * `openRecordingInDialog`. There is exactly one `[data-tree-defer]`
   * section per dataset page.
   */
  async function openViewDataButton(): Promise<void> {
    const section = document.querySelector<HTMLElement>("[data-tree-defer]");
    const state = section ? zarrBySection.get(section) : undefined;
    const datasetId = section?.dataset.id;
    const version = section?.dataset.version;
    if (!state || !datasetId || !version || state.paths.size === 0) {
      // The button is only ever revealed once `hydrateTree` has recorded at
      // least one store for this section (see below); reaching here means
      // that state was since cleared, which should not happen.
      console.warn("[eeg-viewer] view-data button clicked with no viewable recordings");
      return;
    }
    const recordings = buildRecordingList(state.paths);
    const target = firstRecording(recordings, readNavOrder());
    if (!target) return;
    await openRecordingInDialog(target, {
      datasetId,
      version,
      recordings,
      zarrToken: state.token,
      zarr: state,
    });
  }

  // --- Recording navigation (website#253) ----------------------------------
  // The dialog's subject/task dropdowns and prev/next buttons swap the mounted
  // recording in place. The list comes from the Zarr index (every viewable
  // recording), the order from the gear setting, and the swap reuses the same
  // `eegSeq` supersession the tree-click path uses, so a fast next/next/next
  // cannot strand a mount, a store fetch, or a WebGL context (website#208).

  function eegNavEl<T extends HTMLElement>(selector: string): T | null {
    return document.querySelector<T>(selector);
  }

  /**
   * Refuse a recording swap while the live viewer holds an unsaved annotation
   * draft, and point at the thing doing the refusing.
   *
   * Deliberately NOT a `window.confirm`. A confirm blocks the whole page on a
   * dialog that cannot be styled or dismissed by Escape-then-save, and it asks
   * a question ("discard your half-written annotation?") whose answer is almost
   * always no — so it costs every annotator a modal in exchange for a mistake
   * they were not going to make. Refusing the navigation and flashing the
   * popover already on screen says the same thing without stealing control:
   * Escape or Save, then the same click works.
   *
   * Every caller returns on true; each is responsible for re-syncing its own
   * chrome (the dropdowns in particular, which have already moved to the value
   * the user picked).
   */
  function eegDraftBlocksNavigation(): boolean {
    const handle = eegLive?.annotations;
    if (!handle?.isPopoverOpen()) return false;
    handle.focusPopover();
    return true;
  }

  /** The entry for the recording currently on screen, if it parsed. */
  function currentEegRecording(): RecordingEntry | null {
    const live = eegLive;
    if (!live) return null;
    return live.recordings.find((e) => e.path === live.path) ?? null;
  }

  /**
   * Fill one of the entity dropdowns. A current value that is not among the
   * options — the recording on screen has no `task` while its siblings do —
   * gets a leading placeholder entry rather than silently displaying some
   * other recording's label.
   */
  function fillEegNavSelect(
    sel: HTMLSelectElement,
    values: string[],
    prefix: string,
    current: string | null,
  ): void {
    sel.replaceChildren();
    if (current === null) {
      const none = document.createElement("option");
      none.value = "";
      none.textContent = "—";
      sel.append(none);
    }
    for (const value of values) {
      const option = document.createElement("option");
      option.value = value;
      option.textContent = `${prefix}${value}`;
      sel.append(option);
    }
    sel.value = current ?? "";
  }

  /**
   * Reflect the live viewer's position in the dialog's navigation controls.
   * Safe to call at any time: with no live viewer, fewer than two recordings,
   * or a dataset whose paths do not parse into entities, it just hides what
   * cannot be driven.
   */
  function syncEegNavControls(): void {
    const nav = eegNavEl("[data-eegv-nav]");
    const subSel = eegNavEl<HTMLSelectElement>("[data-eegv-nav-sub]");
    const taskSel = eegNavEl<HTMLSelectElement>("[data-eegv-nav-task]");
    const subField = eegNavEl("[data-eegv-nav-sub-field]");
    const taskField = eegNavEl("[data-eegv-nav-task-field]");
    const pos = eegNavEl("[data-eegv-nav-pos]");
    const prev = eegNavEl<HTMLButtonElement>("[data-eegv-nav-prev]");
    const next = eegNavEl<HTMLButtonElement>("[data-eegv-nav-next]");
    if (!nav || !subSel || !taskSel || !subField || !taskField || !pos || !prev || !next) {
      // The dialog markup and this script ship together; a mismatch means the
      // component was edited without its driver.
      console.warn("[eeg-viewer] navigation controls missing from the dialog");
      return;
    }
    const live = eegLive;
    if (!live || live.recordings.length < 2) {
      nav.hidden = true;
      return;
    }
    const current = currentEegRecording();
    const subs = subjectValues(live.recordings);
    // Tasks are scoped to the subject on screen, so every option the dropdown
    // offers resolves to a real recording for that subject.
    const tasks = taskValues(live.recordings, current?.sub ?? null);
    fillEegNavSelect(subSel, subs, "sub-", current?.sub ?? null);
    fillEegNavSelect(taskSel, tasks, "task-", current?.task ?? null);
    // A dataset that names no subjects (or no tasks) gets no dropdown for them
    // rather than an empty one; prev/next still walks every recording.
    subField.hidden = subs.length === 0;
    taskField.hidden = tasks.length === 0;

    const ordered = orderedRecordings(live.recordings, readNavOrder());
    const at = recordingPosition(ordered, live.path);
    pos.textContent = at >= 0 ? `${at + 1} of ${ordered.length}` : `${ordered.length} recordings`;
    const before = at > 0 ? ordered[at - 1] : null;
    const after = at >= 0 ? (ordered[at + 1] ?? null) : null;
    // Stepping onto the last recording disables the button the user is holding
    // focus on, which would drop focus to the document body mid-task. Hand it
    // to the opposite button instead, which by construction is now enabled.
    const focused = document.activeElement;
    prev.disabled = !before;
    next.disabled = !after;
    if (focused === next && next.disabled && !prev.disabled) prev.focus();
    else if (focused === prev && prev.disabled && !next.disabled) next.focus();
    // `aria-label`, not just `title`: an element with both takes its accessible
    // name from the label, so a screen reader would otherwise be stuck with the
    // markup's generic "Next recording" and never hear which recording that is.
    const prevLabel = before ? `Previous recording: ${before.name}` : "No previous recording";
    const nextLabel = after ? `Next recording: ${after.name}` : "No next recording";
    prev.title = prevLabel;
    next.title = nextLabel;
    prev.setAttribute("aria-label", prevLabel);
    next.setAttribute("aria-label", nextLabel);
    nav.hidden = false;
  }

  /** Warm the neighbours' store metadata, the same warmup a hovered tree row
   *  gets. Best-effort: a miss costs one extra request at navigation time. */
  function prefetchAdjacentRecordings(): void {
    const live = eegLive;
    if (!live?.zarr) return;
    const order = readNavOrder();
    for (const delta of [1, -1]) {
      const target = stepRecording(live.recordings, live.path, order, delta);
      if (!target || live.zarr.prefetched.has(target.path)) continue;
      live.zarr.prefetched.add(target.path);
      prefetchZarrStoreMetadata(
        live.datasetId,
        target.path,
        live.zarr.stores.get(target.path),
        live.zarr.token,
      );
    }
  }

  /**
   * Swap the enlarged viewer to another recording, in place.
   *
   * The first navigation **collapses the tree row the viewer was opened from**
   * and hands ownership to the dialog. The alternative — re-anchoring the
   * viewer under the new recording's row — cannot be done honestly: the
   * recording list comes from the Zarr index, so the target may sit in a
   * directory the user never expanded and therefore have no row to anchor to.
   * Leaving the viewer anchored under a row that names a different file would
   * be worse still. Closing the dialog therefore ends a navigated viewer's
   * life instead of returning it inline (see the `close` handler).
   */
  async function navigateEegViewer(target: RecordingEntry): Promise<void> {
    const live = eegLive;
    const dialog = document.querySelector<HTMLDialogElement>("[data-eeg-dialog]");
    if (!live || !dialog?.open) return;
    if (target.path === live.path) {
      // The pick resolved to what is already on screen; nothing to swap, but
      // the dropdowns may be showing the request rather than the reality.
      syncEegNavControls();
      return;
    }
    // The swap destroys this instance, and an open annotation popover holds a
    // draft that exists nowhere else yet. Refuse rather than discard it.
    if (eegDraftBlocksNavigation()) return;

    if (!live.detached) {
      resetEegRow(live.btn, live.slot);
      live.detached = true;
    }

    // Read the outgoing instance's settings BEFORE anything supersedes it;
    // `mountEegViewer` tears down whatever is in the host as its first act, so
    // there is no later chance to ask.
    const transfer = live.snapshot?.();
    const seq = ++eegSeq;
    // Kept for the failure path below, which puts the chrome back rather than
    // leaving it naming a recording that never opened.
    const fromPath = live.path;
    const fromName = live.fileName;
    live.path = target.path;
    live.fileName = target.name;
    live.snapshot = null;
    live.annotations = null; // belongs to the instance the mount below replaces
    // The title and controls move immediately: the mount can take a moment,
    // and chrome that still names the previous recording reads as a no-op.
    setEegDialogTitle(target.name);
    syncEegNavControls();
    const host = live.host;
    host.setAttribute("aria-busy", "true");
    try {
      const { mountEegViewer } = await import("../../lib/eeg-viewer/viewer");
      if (seq !== eegSeq || !eegLive) return;
      // The mount disposes the instance currently in this host, so drop our
      // handle to it rather than risk destroying it twice. Done here and not
      // before the await: until the mount actually starts, the old instance is
      // still the one on screen and a dialog close must still be able to
      // release it.
      eegLive.destroy = null;
      const destroy = await mountEegViewer(host, {
        datasetId: live.datasetId,
        version: live.version,
        filePath: target.path,
        zarrToken: live.zarrToken,
        downloadUrl: fileDownloadUrl(live.datasetId, live.version, target.path),
        // The target may be a `.mefd`/`.ds`/BTi directory recording
        // (website#252) with no row in the tree to read `data-dir-recording`
        // from, so it is decided from the name — see `isDirRecordingName`.
        dirRecording: isDirRecordingName(target.name),
        isStale: () => seq !== eegSeq,
        transfer,
        onTransfer: (snapshot) => {
          if (seq === eegSeq && eegLive) eegLive.snapshot = snapshot;
        },
        onAnnotations: (handle) => {
          if (seq === eegSeq && eegLive) eegLive.annotations = handle;
        },
      });
      if (seq !== eegSeq) {
        // Superseded mid-mount by a faster click: whoever superseded us owns
        // the host now, so this instance only has itself to clean up.
        destroy?.();
        return;
      }
      if (eegLive) eegLive.destroy = destroy ?? null;
      prefetchAdjacentRecordings();
    } catch (err) {
      // Reaching here means the mount threw somewhere its own try/catch does
      // not cover — that only wraps `openRecording`, so a failure in the DOM
      // build, the WebGL setup or the transfer lands here. By then the previous
      // instance has already been torn down (the mount's first act), so there
      // is nothing on screen to keep: without this branch the dialog would name
      // the target while the host held a half-built viewer and no explanation.
      console.error("[eeg-viewer] navigation failed:", err);
      if (seq !== eegSeq || !eegLive) return;
      const fallback = isDirRecordingName(target.name)
        ? "Use the expand arrow next to its name to browse the recording's files"
        : `<a href="${escapeHtml(fileDownloadUrl(live.datasetId, live.version, target.path))}" rel="external" download="${escapeHtml(target.name)}">Download the file</a>`;
      host.innerHTML = `<p class="preview__error" role="alert">Couldn't open ${escapeHtml(target.name)}. ${fallback} instead.</p>`;
      // Put the chrome back on the recording the user came from: it is the one
      // they can still navigate relative to, and the message above already
      // names the one that failed.
      eegLive.path = fromPath;
      eegLive.fileName = fromName;
      setEegDialogTitle(fromName);
      syncEegNavControls();
    } finally {
      if (seq === eegSeq) host.removeAttribute("aria-busy");
    }
  }

  /**
   * The dialog heading, which follows the recording the chrome is describing.
   *
   * Also updates the dialog's own `aria-label`, which otherwise stays the
   * static "Signal viewer" from `EegViewerDialog.astro` markup — a screen
   * reader never hears which recording is open (a pre-existing gap across
   * every entry point, fixed here in the one place all three converge).
   */
  function setEegDialogTitle(name: string): void {
    const titleEl = document.querySelector<HTMLElement>("[data-eegv-title]");
    if (!titleEl) return;
    titleEl.textContent = name || "Signal viewer";
    const dialog = titleEl.closest<HTMLDialogElement>("[data-eeg-dialog]");
    if (dialog) {
      dialog.setAttribute("aria-label", name ? `Signal viewer: ${name}` : "Signal viewer");
    }
  }

  function stepEegViewer(delta: number): void {
    const live = eegLive;
    if (!live) return;
    // Checked here as well as inside `navigateEegViewer` so prev/next refuses
    // without any of the chrome having moved first.
    if (eegDraftBlocksNavigation()) return;
    const target = stepRecording(live.recordings, live.path, readNavOrder(), delta);
    if (target) void navigateEegViewer(target);
    else syncEegNavControls(); // at an end; make sure the button reads disabled
  }

  // Wired once — the dialog markup is static and outside the tree section that
  // hydration replaces.
  eegNavEl<HTMLButtonElement>("[data-eegv-nav-prev]")?.addEventListener("click", () =>
    stepEegViewer(-1),
  );
  eegNavEl<HTMLButtonElement>("[data-eegv-nav-next]")?.addEventListener("click", () =>
    stepEegViewer(1),
  );
  eegNavEl<HTMLSelectElement>("[data-eegv-nav-sub]")?.addEventListener("change", (event) => {
    const live = eegLive;
    const sel = event.currentTarget as HTMLSelectElement;
    if (!live) return;
    // The `<select>` has already moved to the picked value, so a refusal has to
    // put it back — otherwise the dropdown names a subject the viewer is not on.
    if (eegDraftBlocksNavigation()) {
      syncEegNavControls();
      return;
    }
    // `prefer: "sub"` keeps the subject the user just picked when it has no
    // recording of the current task.
    const target = selectRecording(
      live.recordings,
      { sub: sel.value || null, task: currentEegRecording()?.task ?? null },
      readNavOrder(),
      "sub",
    );
    // `navigateEegViewer` re-syncs the controls itself; the else branch covers
    // a pick that resolved to nothing, which must not leave the dropdown
    // displaying a subject the viewer is not on.
    if (target) void navigateEegViewer(target);
    else syncEegNavControls();
  });
  eegNavEl<HTMLSelectElement>("[data-eegv-nav-task]")?.addEventListener("change", (event) => {
    const live = eegLive;
    const sel = event.currentTarget as HTMLSelectElement;
    if (!live) return;
    // As above: the dropdown has moved, so a refusal has to move it back.
    if (eegDraftBlocksNavigation()) {
      syncEegNavControls();
      return;
    }
    const target = selectRecording(
      live.recordings,
      { sub: currentEegRecording()?.sub ?? null, task: sel.value || null },
      readNavOrder(),
      "task",
    );
    if (target) void navigateEegViewer(target);
    else syncEegNavControls();
  });
  // The gear setting lives inside the viewer instance; it announces a change
  // rather than reaching into this chrome (the two are separately mounted).
  document.addEventListener(NAV_ORDER_CHANGED_EVENT, () => syncEegNavControls());

  // Closing the dialog (Esc or the corner X, both native `dialog.close()`)
  // hands the viewer back to the inline panel it came from — the instance is
  // never torn down by an enlarge/return round trip, so the user returns to
  // the same montage and time window they left with.
  document.querySelector<HTMLDialogElement>("[data-eeg-dialog]")?.addEventListener("close", () => {
    const dialogSlot = document.querySelector<HTMLElement>("[data-eegv-slot]");
    const live = eegLive;
    const nav = document.querySelector<HTMLElement>("[data-eegv-nav]");
    if (nav) nav.hidden = true; // the controls only make sense in the dialog
    if (live?.detached) {
      // The user navigated away from the row this viewer came from, so there
      // is nothing to hand back to (see `navigateEegViewer`): closing the
      // dialog is the end of this instance. Bump the sequence first so any
      // mount still in flight stands down instead of writing into a host that
      // is about to be discarded.
      eegSeq++;
      eegLive = null;
      // `navigateEegViewer` nulls `live.destroy` before awaiting the new mount,
      // so between the mount publishing its own `_eegvCleanup` on the host and
      // returning the disposer to us there is a window where closing the dialog
      // has no handle to call — the instance would keep its observers, GL
      // context and background reads alive until the post-await staleness check
      // happened to run. The host's own cleanup is the backstop for exactly
      // that window; taking it first (and clearing it) means one teardown
      // whichever handle exists, never two.
      const host = live.host as HTMLElement & { _eegvCleanup?: () => void };
      const cleanup = live.destroy ?? host._eegvCleanup;
      host._eegvCleanup = undefined;
      cleanup?.();
      dialogSlot?.replaceChildren();
      return;
    }
    const anchor = live?.slot?.querySelector<HTMLElement>("[data-eegv-inline-anchor]");
    if (live && anchor) {
      anchor.replaceWith(live.host);
      return;
    }
    if (live && dialogSlot?.contains(live.host)) {
      // The live viewer is in the dialog but its row has no marker to put it
      // back into, so something mutated that row while it was enlarged.
      // Recover to the end of the panel rather than strand it in a closed
      // dialog holding a GL context — but say so, because the recovery is
      // patching over a broken invariant, not handling an expected state.
      // (Unreachable for a detached-from-birth viewer, website#260: that
      // branch above always returns first since `detached` is true from
      // the start, so `live.slot` here is only ever null in a case this
      // code never actually reaches.)
      console.warn("[eeg-viewer] inline anchor missing; returning viewer to the end of its panel");
      live.slot?.append(live.host);
      return;
    }
    // Nothing of ours is in the dialog: either it was released while enlarged
    // (already torn down, no row to go back to) or `eegLive` has since moved
    // on to a row that was never enlarged. Drop whatever is left so the next
    // enlarge doesn't flash a dead viewer.
    dialogSlot?.replaceChildren();
  });

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // "Enlarge" inside an open signal preview. Handled before the
    // preview-toggle branch below for the same reason as show-all: it lives
    // inside a preview panel, and must not be read as a row click.
    if (target.closest("[data-eegv-enlarge]")) {
      enlargeEegViewer();
      return;
    }

    // Action-bar "View data" button (website#260): opens the enlarge dialog
    // directly on the dataset's first viewable recording. Lives outside the
    // tree section entirely, so it is not reachable through any of the
    // branches below.
    if (target.closest("[data-view-data-btn]")) {
      await openViewDataButton();
      return;
    }

    // "Show all N rows" inside an open TSV preview. Handled first so it
    // doesn't fall into the preview-toggle branch below.
    if (target.closest("[data-tsv-show-all]")) {
      const btn = target.closest<HTMLButtonElement>("[data-tsv-show-all]");
      const slot = btn?.closest<HTMLElement>("[data-preview-slot]");
      if (!btn || !slot) return;
      const cached = tsvCacheBySlot.get(slot);
      if (!cached) {
        // The slot is still in the DOM so the WeakMap entry can't have
        // been GC'd — this means a code path rendered a TSV preview
        // without going through the fetch branch. Surface so the user
        // isn't left with an inert button.
        console.warn("[preview] tsv-show-all clicked but cache missing");
        slot.innerHTML = `<p class="preview__error" role="alert">Couldn't expand the table — its source isn't cached. Collapse and reopen the preview to retry.</p>`;
        return;
      }
      const { renderTsvPreview } = await import("../../lib/render-file-preview-tsv");
      slot.innerHTML = renderTsvPreview(cached, Number.POSITIVE_INFINITY);
      return;
    }

    const btn = target.closest<HTMLButtonElement>("[data-preview-path]");
    if (!btn) return;

    // EEG/MEG/iEEG/EMG: the interactive Zarr signal viewer. Same expand /
    // collapse gesture as the text previews below, but its own open path —
    // it mounts a live instance rather than fetching and rendering once, so
    // it owns teardown, the one-instance-page-wide rule, and the enlarge
    // handoff (website#217).
    if (btn.dataset.previewType === "eeg") {
      // A directory recording's button lives inside a <details>/<summary>
      // (website#252); without this the same click would also toggle the
      // member-file expansion. Inert for plain file rows (buttons have no
      // click default to cancel).
      event.preventDefault();
      await openEegViewerInline(btn);
      return;
    }

    const wrap = btn.closest<HTMLElement>("[data-preview-wrap]");
    const slot = wrap?.querySelector<HTMLElement>("[data-preview-slot]");
    if (!wrap || !slot) return;

    const isExpanded = btn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      slot.hidden = true;
      btn.setAttribute("aria-expanded", "false");
      return;
    }

    btn.setAttribute("aria-expanded", "true");
    slot.hidden = false;

    // Already rendered or already in flight — bail. `loaded` carries one of
    // three states: undefined (never touched), "loading" (fetch in flight),
    // or "true" (rendered). Without the "loading" sentinel, a rapid
    // collapse + re-expand during the network round-trip would fire a
    // second concurrent fetch; the late-arriving response would overwrite
    // the slot content non-deterministically.
    if (slot.dataset.loaded === "true" || slot.dataset.loaded === "loading") return;

    const previewType = btn.dataset.previewType ?? "";
    const fileSizeBytes = Number(btn.dataset.fileSize ?? "0");
    const fileName = btn.dataset.fileName ?? "";
    const filePath = btn.dataset.previewPath ?? "";
    const section = btn.closest<HTMLElement>("[data-tree-defer]");
    const treeId = section?.dataset.id;
    const treeVersion = section?.dataset.version;
    if (!treeId || !treeVersion) {
      // The button is somehow outside a `[data-tree-defer]` section. The
      // slot is already visible from the flip above — surface an error so
      // the user isn't staring at an empty panel.
      console.warn("[preview] missing tree id/version on btn", btn);
      slot.innerHTML = `<p class="preview__error" role="alert">Couldn't load preview: missing dataset context. Try refreshing the page.</p>`;
      slot.dataset.loaded = "true";
      return;
    }
    const fileUrl = fileDownloadUrl(treeId, treeVersion, filePath);

    // Oversized: skip the fetch and surface a download fallback. Threshold
    // picked so a 30 KB participants.tsv previews fine but a multi-MB
    // sourcedata file doesn't lock up the browser.
    if (fileSizeBytes > MAX_PREVIEW_BYTES) {
      slot.innerHTML = `<p class="preview__too-large">File too large to preview (${escapeHtml(formatBytes(fileSizeBytes))}). <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download instead</a>.</p>`;
      slot.dataset.loaded = "true";
      return;
    }

    // Claim the slot before the await: rapid double-clicks will short-
    // circuit on the "loading" check above instead of firing parallel
    // fetches. The success/failure paths below transition this to "true".
    slot.dataset.loaded = "loading";
    slot.setAttribute("aria-busy", "true");
    slot.innerHTML = `<p class="preview__loading">Loading…</p>`;
    try {
      const res = await fetch(fileUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      slot.removeAttribute("aria-busy");

      if (previewType === "md") {
        const { renderMarkdownPreview } = await import("../../lib/render-file-preview-md");
        slot.innerHTML = renderMarkdownPreview(text);
      } else if (previewType === "json") {
        const { renderJsonPreview } = await import("../../lib/render-file-preview-json");
        slot.innerHTML = renderJsonPreview(text);
      } else if (previewType === "tsv") {
        const { renderTsvPreview } = await import("../../lib/render-file-preview-tsv");
        tsvCacheBySlot.set(slot, text);
        slot.innerHTML = renderTsvPreview(text);
      } else {
        // Defensive: unknown previewType (the renderer guards against
        // emitting one). Show a generic error so the user can still
        // download.
        slot.innerHTML = `<p class="preview__error" role="alert">No preview available for this format. <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download instead</a>.</p>`;
      }
      slot.dataset.loaded = "true";
    } catch (err) {
      console.error(`[preview/${treeId}] failed for ${filePath}:`, err);
      slot.removeAttribute("aria-busy");
      slot.innerHTML = `<p class="preview__error" role="alert">Preview failed. <a href="${escapeHtml(fileUrl)}" rel="external" download="${escapeHtml(fileName)}">Download instead</a>, or collapse + reopen to retry.</p>`;
      // Clear the loading sentinel so collapse+reopen can retry the fetch.
      delete slot.dataset.loaded;
      // Roll aria-expanded back so the next click is treated as expand,
      // not collapse (matters when the user collapses immediately to retry).
    }
  });

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  /**
   * Fetch + render a directory's children into its lazy slot. Shared by the
   * native `<details>` toggle path (ordinary dirs) and the `[data-dir-toggle]`
   * button path (hybrid signal-recording rows, website#252). `data-loaded`
   * guards against re-fetches across collapse/expand cycles.
   */
  function loadDirChildren(slot: HTMLElement, dirPath: string, depthRaw: string | undefined): void {
    if (slot.dataset.loaded === "true") return;
    const section = slot.closest<HTMLElement>("[data-tree-defer]");
    const treeId = section?.dataset.id;
    const treeVersion = section?.dataset.version;
    if (!treeId || !treeVersion) return;
    const depthAttr = Number(depthRaw ?? "0");
    const childDepth = Number.isFinite(depthAttr) ? depthAttr + 1 : 1;
    slot.setAttribute("aria-busy", "true");
    fetchDirListing(treeId, treeVersion, dirPath)
      .then((listing) => {
        slot.removeAttribute("aria-busy");
        if (!listing) {
          slot.innerHTML = `<p class="tree__error" role="alert">Couldn't load files. Collapse and re-open to retry.</p>`;
          return;
        }
        slot.innerHTML = renderSubdir(listing, childDepth);
        slot.dataset.loaded = "true";
        if (section) annotateZarrRows(section);
      })
      .catch((err) => {
        console.warn(`[tree/${treeId}] dir expand failed:`, err);
        slot.removeAttribute("aria-busy");
        slot.innerHTML = `<p class="tree__error" role="alert">Couldn't load files. Collapse and re-open to retry.</p>`;
      });
  }

  // Capture-phase toggle listener for lazy per-directory expansion. The
  // toggle event on <details> does NOT bubble (HTML spec), so capture is
  // the only way to delegate. Matches the pre-#76 Phase 3 pattern but for
  // arbitrary directories rather than just subject-level dirs.
  document.addEventListener(
    "toggle",
    (event) => {
      const details = event.target;
      if (!(details instanceof HTMLDetailsElement)) return;
      if (!details.open) return;
      const dirPath = details.dataset.dirPath;
      if (!dirPath) return;
      const slot = details.querySelector<HTMLElement>("[data-dir-target]");
      if (!slot) return;
      loadDirChildren(slot, dirPath, details.dataset.depth);
    },
    true,
  );

  // Expand/collapse for hybrid signal-recording dir rows (website#252). Their
  // chevron is a real sibling <button> (not a <summary>), so expansion is
  // delegated here: flip the adjacent lazy container, then lazy-load once.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const toggle = target.closest<HTMLButtonElement>("[data-dir-toggle]");
    if (!toggle) return;
    const li = toggle.closest<HTMLElement>("li");
    const slot = li?.querySelector<HTMLElement>(":scope > [data-dir-target]");
    const dirPath = toggle.dataset.dirPath;
    if (!li || !slot || !dirPath) {
      console.warn("[tree] dir-toggle clicked but row shape unexpected", toggle);
      return;
    }
    const expand = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", expand ? "true" : "false");
    slot.hidden = !expand;
    if (expand) loadDirChildren(slot, dirPath, toggle.dataset.depth);
  });

  // Kick off hydration on every defer slot present at first paint.
  document
    .querySelectorAll<HTMLElement>("[data-readme-defer]")
    .forEach((el) => void hydrateReadme(el));
  document
    .querySelectorAll<HTMLElement>("[data-tree-defer]")
    .forEach((el) => void hydrateTree(el));
</script>

