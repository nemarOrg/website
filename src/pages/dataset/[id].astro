---
import Base from "../../layouts/Base.astro";
import ActionBar from "../../components/ActionBar.astro";
import DoiBadge from "../../components/DoiBadge.astro";
import ModalityBadge from "../../components/ModalityBadge.astro";
import ProvenanceCard from "../../components/ProvenanceCard.astro";
import VersionSwitcher from "../../components/VersionSwitcher.astro";
import Readme from "../../components/Readme.astro";
import BidsTree from "../../components/BidsTree.astro";
import DetailRail from "../../components/DetailRail.astro";
import {
  archiveZipUrl,
  fetchManifestEntryText,
  findReadmeEntry,
  getLanding,
  getManifest,
  getMetadata,
} from "../../lib/data-api";
import { buildTree } from "../../lib/bids-tree";
import { detectProvenance } from "../../lib/provenance";
import { splitModalities } from "../../lib/format";
import { ORG_DATASETS } from "../../lib/constants";

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/discover");
}

const url = new URL(Astro.request.url);
const versionParam = url.searchParams.get("v");

// Fan out the landing and metadata fetches in parallel.
const [landing, metadata] = await Promise.all([
  getLanding(id),
  getMetadata(id),
]);

if (!landing || !metadata) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  return new Response(null, { status: 404 });
}

const selectedVersion =
  versionParam && landing.versions.some((v) => v.version === versionParam)
    ? versionParam
    : landing.latest ?? landing.versions[0]?.version ?? null;

const manifest = selectedVersion ? await getManifest(id, selectedVersion) : null;

// README is the first README* in the manifest. Fetch its bytes once at SSR
// time and pass markdown source to the Readme component.
let readmeSource: string | null = null;
if (manifest) {
  const readmeEntry = findReadmeEntry(manifest);
  if (readmeEntry?.url) {
    readmeSource = await fetchManifestEntryText(readmeEntry.url, { timeoutMs: 2_500 });
  }
}

const provenance = detectProvenance(metadata, landing);
const modalities = metadata.recording_modality.length
  ? metadata.recording_modality
  : splitModalities("");

const githubUrl = metadata.external_links.github_url ?? `https://github.com/${ORG_DATASETS}/${id}`;
const issuesUrl = `${githubUrl}/issues`;
const openneuroId =
  provenance.kind === "derived" ? provenance.originalDatasetId ?? null : null;
const archiveUrl = selectedVersion ? archiveZipUrl(id, selectedVersion) : null;

const tree = manifest ? buildTree(manifest) : null;
const basePath = selectedVersion
  ? `https://data.nemar.org/${encodeURIComponent(id)}/${encodeURIComponent(selectedVersion)}`
  : "";

Astro.response.headers.set("Cache-Control", "public, max-age=60");
---

<Base title={metadata.name} description={metadata.description ?? `${id} dataset on NEMAR`}>
  <article class="detail">
    <header class="detail__header container">
      <div class="detail__id-row">
        <span class="detail__id">{id}</span>
        {provenance.kind === "derived" && <span class="detail__lineage">NEMAR · OpenNeuro mirror</span>}
        {provenance.kind === "native" && <span class="detail__lineage">NEMAR-native dataset</span>}
      </div>
      <h1 class="detail__title">{metadata.name}</h1>
      {metadata.description && metadata.description !== metadata.name && (
        <p class="detail__lede">{metadata.description}</p>
      )}
      <div class="detail__chips">
        {modalities.map((m) => <ModalityBadge modality={m} size="md" />)}
      </div>
      <div class="detail__actions">
        <ActionBar
          datasetId={id}
          version={selectedVersion}
          archiveUrl={archiveUrl}
          issuesUrl={issuesUrl}
          githubUrl={githubUrl}
          openneuroId={openneuroId}
        />
        {metadata.external_links.dataset_doi && (
          <DoiBadge doi={metadata.external_links.dataset_doi} />
        )}
      </div>
    </header>

    <div class="container">
      {provenance.kind === "derived" && (
        <ProvenanceCard
          datasetId={id}
          nemarDoi={metadata.external_links.dataset_doi}
          provenance={provenance}
        />
      )}

      <VersionSwitcher
        versions={landing.versions}
        current={selectedVersion ?? ""}
        mirrorVersions={provenance.kind === "derived" ? provenance.allMirrorVersions : []}
      />
    </div>

    <div class="container detail__body">
      <div class="detail__main">
        <Readme source={readmeSource} />
        {tree && <BidsTree root={tree} basePath={basePath} />}
        {!tree && (
          <section class="detail__no-manifest" role="alert">
            <h2>Manifest unavailable</h2>
            <p>
              The file index for <code>{selectedVersion ?? "this version"}</code> could not be loaded.
              The version may not yet be published, or the underlying S3 lookup failed.
              Use the
              <a href="/discover">Discover page</a> to pick another dataset or try a different version above.
            </p>
          </section>
        )}
      </div>
      <DetailRail metadata={metadata} />
    </div>
  </article>
</Base>

<style>
  .detail {
    padding-block: var(--space-8) var(--space-16);
  }
  .detail__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block-end: var(--space-6);
  }
  .detail__id-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .detail__id {
    color: var(--color-fg-muted);
  }
  .detail__lineage {
    color: var(--color-fg-subtle);
  }
  .detail__title {
    font-size: clamp(var(--fs-3xl), 4vw, var(--fs-5xl));
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
    line-height: var(--lh-tight);
    text-wrap: balance;
    max-inline-size: 28ch;
  }
  .detail__lede {
    color: var(--color-fg-muted);
    font-size: var(--fs-lg);
    line-height: var(--lh-relaxed);
    max-inline-size: 60ch;
  }
  .detail__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-block-start: var(--space-2);
  }
  .detail__body {
    margin-block-start: var(--space-8);
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) 320px;
    gap: var(--space-8);
    align-items: flex-start;
  }
  @media (max-width: 980px) {
    .detail__body {
      grid-template-columns: 1fr;
    }
  }
  .detail__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-inline-size: 0;
  }
  .detail__no-manifest {
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-warning) 30%, transparent);
    background: color-mix(in srgb, var(--color-warning) 5%, var(--color-bg));
    border-radius: var(--radius-lg);
  }
  .detail__no-manifest h2 {
    font-size: var(--fs-lg);
    margin-block-end: var(--space-2);
  }
  .detail__no-manifest p {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
  }
  .detail__no-manifest code {
    background: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }
</style>
