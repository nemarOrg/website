---
import DatasetCard from "../components/DatasetCard.astro";
import FilterSidebar from "../components/FilterSidebar.astro";
import Pagination from "../components/Pagination.astro";
import SearchBar from "../components/SearchBar.astro";
import Base from "../layouts/Base.astro";
import {
  backfillSearchHit,
  getDataset,
  isManagedDatasetId,
  listAllDatasets,
  listDatasets,
  searchDatasets,
  searchResultToDataset,
} from "../lib/api";
import { isRateLimited } from "../lib/api-cache";
import { pageSearch, planSearch } from "../lib/discover-search";
import {
  applyClientFilters,
  filterStateFromURL,
  filterStateToAPIQuery,
  filterStateToURL,
  hasClientOnlyFilters,
} from "../lib/filters";
import { discoverCacheControl, discoverRetryAfter } from "../lib/response-cache-policy";
import { type Dataset, SORT_OPTIONS } from "../lib/types";

const url = new URL(Astro.request.url);
const state = filterStateFromURL(url.searchParams);
const PAGE_SIZE = state.pageSize;
// A freetext query routes through the hybrid lexical+semantic endpoint
// (nemar-cli#646, closes website#12); an empty box keeps the browse flow.
const isSearch = state.q.trim().length > 0;

// Each rendered card pairs a full Dataset with an optional FTS5 snippet.
let cards: Array<{ dataset: Dataset; snippet?: string }> = [];
let totalReturned = 0;
// How many rows the pager can reach. Equal to `totalReturned` except when a
// search has more matches than the endpoint can page through.
let pageableTotal = 0;
// Appended to the result count when the list is a window onto more matches.
let countNote = "";
let fetchError: string | null = null;
// The API answered 429: its anonymous budget is shared by every visitor this
// site serves, so "busy, try again in a minute" is more useful than a generic
// failure, and it tells a crawler to back off (see the 503 below).
let rateLimited = false;
// Cards that fell back to the reduced search projection because their dataset
// could not be fetched. A page with any is degraded and must not be cached long.
let hydrationFailures = 0;

// Cap every backend hop so a stalled upstream fails fast (and falls back)
// instead of holding the SSR response until the Worker CPU limit kills it.
const signal = AbortSignal.timeout(8000);

try {
  if (isSearch) {
    // Which way to read the search (the endpoint's own paging, or one best-100
    // window the page filters and pages) and what its answer means for the count
    // and the pager are decided in lib/discover-search.ts, where they are tested.
    const plan = planSearch(state);
    const res = await searchDatasets(state.q, { ...plan.params, signal });
    const result = pageSearch(plan, res, state);
    totalReturned = result.totalReturned;
    pageableTotal = result.pageableTotal;
    countNote = result.countNote;
    const slice = result.slice;
    // Hydrate the visible page to full rows (parallel) for the richer card.
    // Only managed ids (nm*/on*/xx*) are addressable at /datasets/:id; ds* legacy
    // rows 400 there, so they render straight from the reduced search
    // projection (name/modalities/participants/authors/snippet). If a managed
    // fetch blips we log it and fall back to the projection too — and if EVERY
    // attempted hydration failed, surface an outage instead of degrading
    // silently.
    let attempted = 0;
    let hydrationRateLimited = false;
    cards = await Promise.all(
      slice.map(async (r) => {
        if (!isManagedDatasetId(r.id)) {
          return { dataset: searchResultToDataset(r), snippet: r.snippet };
        }
        attempted++;
        try {
          // Hydrate for the detail-only facts (description, size, citations),
          // but backfill participants/version from the search projection: the
          // /datasets/:id endpoint returns those as null even when the catalog
          // has them, which otherwise blanks the subject count on search cards.
          return {
            dataset: backfillSearchHit(await getDataset(r.id, { signal }), r),
            snippet: r.snippet,
          };
        } catch (err) {
          hydrationFailures++;
          if (isRateLimited(err)) hydrationRateLimited = true;
          console.warn(
            `[discover] hydration failed for ${r.id}: ${err instanceof Error ? err.message : String(err)}`,
          );
          return { dataset: searchResultToDataset(r), snippet: r.snippet };
        }
      }),
    );
    if (attempted > 0 && hydrationFailures === attempted) {
      // Every card failed. A 429 from any of them is the cause worth naming.
      rateLimited = hydrationRateLimited;
      fetchError = rateLimited
        ? "The dataset service is busy right now. Please try again in a minute."
        : "Search is temporarily unavailable. Please try again in a moment.";
    } else if (hydrationFailures > 0) {
      console.error(
        `[discover] ${hydrationFailures} of ${attempted} cards rendered from the search projection after hydration failures; not caching the page for long`,
      );
    }
  } else {
    const baseQuery = filterStateToAPIQuery(state);
    // Participant/channel ranges and multi-modality AND/OR can only run
    // client-side (the catalog API has no range params, and `modality` is a
    // single-value LIKE). With plain offset pagination those filters pruned
    // only the current 10-row page while the count + pager still spanned the
    // server total — so selecting "min 100 participants" showed "642 datasets,
    // 65 pages" with most pages empty. When a client-only filter is active we
    // pull the whole server-prefiltered set, filter it as a unit, and paginate
    // client-side so the count and pager are honest.
    if (hasClientOnlyFilters(state)) {
      const all = await listAllDatasets(baseQuery, { signal });
      const filtered = applyClientFilters(all, state);
      totalReturned = filtered.length;
      pageableTotal = filtered.length;
      cards = filtered
        .slice((state.page - 1) * PAGE_SIZE, state.page * PAGE_SIZE)
        .map((d) => ({ dataset: d }));
    } else {
      // No client-only filter: efficient single-page server offset pagination.
      // License + single modality are already enforced server-side via
      // filterStateToAPIQuery, so the count and pager stay accurate.
      const page = await listDatasets(
        { ...baseQuery, limit: PAGE_SIZE, offset: (state.page - 1) * PAGE_SIZE },
        { signal },
      );
      cards = page.datasets.map((d) => ({ dataset: d }));
      totalReturned = page.total_count ?? page.count ?? page.datasets.length;
      pageableTotal = totalReturned;
    }
  }
} catch (err) {
  // Log the raw detail to Worker logs; show users a sanitized message rather
  // than leaking internal service names / status codes. Not the search text:
  // what someone searched for is theirs, and a failure is logged on every try.
  console.error(
    `[discover] load failed (${isSearch ? `a search of ${state.q.length} characters` : "browse"}): ${err instanceof Error ? err.message : String(err)}`,
  );
  rateLimited = isRateLimited(err);
  fetchError = rateLimited
    ? "The dataset service is busy right now. Please try again in a minute."
    : isSearch
      ? "Search is temporarily unavailable. Please try again in a moment."
      : "Please try again in a moment.";
}

const pageCount = Math.max(1, Math.ceil(pageableTotal / PAGE_SIZE));

// Re-serialize the canonical filter state to drop unknown params.
const canonicalParams = filterStateToURL(state);
canonicalParams.delete("page");

// While searching, sort doesn't apply (the hybrid endpoint ranks by relevance
// and ignores it), so keep it out of pagination links rather than implying it
// is active. License is enforced server-side since nemar-cli#683.
if (isSearch) {
  canonicalParams.delete("sort");
}

// A page past the last one used to answer 200 with "6 results" over "No
// datasets match", and the page cache kept it for an hour; a crawler or a stale
// bookmark can mint any number. Send it to the last page that has results.
if (!fetchError && totalReturned > 0 && state.page > pageCount) {
  const last = new URLSearchParams(canonicalParams);
  if (pageCount > 1) last.set("page", String(pageCount));
  const query = last.toString();
  return new Response(null, {
    status: 302,
    headers: { Location: query ? `/discover?${query}` : "/discover", "Cache-Control": "no-store" },
  });
}

// Cache keyed on the full URL (query params) so each filter+page+query combo
// gets its own edge entry. On error, never cache: a brief upstream hiccup must
// not pin an error page at the edge. The catalog changes slowly and robots and
// people alike should find it, so a page lives an hour at the edge (half that
// for a search, whose ranking moves with the index). The data behind it is
// itself cached for ten minutes (lib/api-cache.ts), so a new dataset reaches a
// page within about an hour and ten minutes. Two things shorten that, because
// an hour-long page would otherwise pin them: a page with cards that failed to
// hydrate is kept a minute, and so is any page the middleware finds was built
// from stale data (lib/response-cache-policy.ts). The browser's own
// stale-while-revalidate stays short for the same reason.
Astro.response.headers.set(
  "Cache-Control",
  discoverCacheControl({
    failed: fetchError !== null,
    degraded: hydrationFailures > 0,
    search: isSearch,
  }),
);
if (fetchError) {
  // A failed load is not a successful page: answering 200 let crawlers index
  // the error and gave a retrying client no signal to wait.
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", discoverRetryAfter(rateLimited));
}
---

<Base title="Discover datasets">
  <section class="discover container">
    <header class="discover__head">
      <h1>Discover datasets</h1>
      <SearchBar
        value={state.q}
        size="md"
        form="discover-filters"
        placeholder="Search by dataset name, ID, or description..."
      />
    </header>
    <div class="discover__layout">
      <aside class="discover__rail" aria-label="Filters">
        <FilterSidebar state={state} searchActive={isSearch} />
      </aside>
      <div class="discover__results">
        {fetchError && (
          <div class="discover__error" role="alert">
            <strong>Could not load datasets.</strong>
            <span>{fetchError}</span>
          </div>
        )}
        <div class="discover__toolbar">
          {!fetchError && (
            <p class="discover__count">
              {isSearch
                ? `${totalReturned.toLocaleString()} ${totalReturned === 1 ? "result" : "results"} for "${state.q}"`
                : `Showing ${cards.length} of ${totalReturned.toLocaleString()} datasets`}
              {countNote && ` · ${countNote}`}
              {pageCount > 1 && ` · page ${state.page} of ${pageCount}`}
            </p>
          )}
          {/* Not a form of its own: the select joins the sidebar's filter form
              through `form=`, so sorting submits the filters as they stand in
              the sidebar (applied or not) and drops `page`. Rendered even with
              zero results so that form never loses the current sort. */}
          <div class="discover__sort">
            <label for="discover-sort">Sort by</label>
            {isSearch ? (
              // The hybrid search endpoint ranks by relevance and takes no
              // sort, so say so instead of offering orders it would ignore.
              <select
                id="discover-sort"
                disabled
                title="Search results are ranked by relevance. Clear the search to sort."
              >
                <option selected>Relevance</option>
              </select>
            ) : (
              <select id="discover-sort" name="sort" form="discover-filters" data-sort-select>
                {SORT_OPTIONS.map((opt) => (
                  <option value={opt.value} selected={state.sort === opt.value}>
                    {opt.label}
                  </option>
                ))}
              </select>
            )}
            {!isSearch && (
              <noscript>
                <button type="submit" form="discover-filters" class="discover__sort-go">Sort</button>
              </noscript>
            )}
          </div>
        </div>
        {!fetchError && cards.length === 0 && (
          <div class="discover__empty">
            {isSearch ? (
              <>
                <h2>No datasets match "{state.q}".</h2>
                <p>Try a different term, fewer filters, or
                  <a href="/discover">browse all datasets</a>.
                </p>
                {countNote && <p>Only the best matches were checked: {countNote}.</p>}
              </>
            ) : (
              <>
                <h2>No datasets match these filters.</h2>
                <p>Try removing a filter or
                  <a href="/discover">resetting all filters</a>.
                </p>
              </>
            )}
          </div>
        )}
        <ul class="discover__list" role="list">
          {cards.map((c) => (
            <li>
              <DatasetCard dataset={c.dataset} snippet={c.snippet} />
            </li>
          ))}
        </ul>
        <Pagination
          page={state.page}
          pageCount={pageCount}
          baseParams={canonicalParams}
        />
      </div>
    </div>
  </section>
</Base>

<script>
  // Sort applies the moment it changes, like a shop's "Sort by" (website#346).
  // `select.form` is the sidebar's filter form (the select's `form=`
  // attribute); without JS the <noscript> button submits that same form.
  const sortSelect = document.querySelector<HTMLSelectElement>("[data-sort-select]");
  sortSelect?.addEventListener("change", () => sortSelect.form?.requestSubmit());
</script>

<style>
  .discover {
    padding-block: var(--space-12) var(--space-16);
  }
  .discover__head {
    margin-block-end: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .discover__head h1 {
    font-size: var(--fs-3xl);
  }
  .discover__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    flex-wrap: wrap;
    margin-block-end: var(--space-4);
  }
  .discover__count {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
  }
  .discover__sort {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }
  .discover__sort label {
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .discover__sort select {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .discover__sort select:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .discover__sort-go {
    padding: var(--space-2) var(--space-3);
    background: var(--color-fg);
    color: var(--color-bg);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
  }
  .discover__layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--space-8);
    align-items: flex-start;
  }
  @media (max-width: 880px) {
    .discover__layout {
      grid-template-columns: 1fr;
    }
    .discover__rail {
      position: static !important;
    }
  }
  .discover__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .discover__empty {
    padding: var(--space-12) var(--space-6);
    text-align: center;
    color: var(--color-fg-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
  }
  .discover__empty h2 {
    font-size: var(--fs-xl);
    color: var(--color-fg);
    margin-block-end: var(--space-2);
  }
  .discover__error {
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-danger) 40%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    color: var(--color-fg);
    margin-block-end: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
</style>
