---
import DatasetCard from "../components/DatasetCard.astro";
import FilterSidebar from "../components/FilterSidebar.astro";
import Pagination from "../components/Pagination.astro";
import SearchBar from "../components/SearchBar.astro";
import Base from "../layouts/Base.astro";
import {
  getDataset,
  isManagedDatasetId,
  listDatasets,
  searchDatasets,
  searchResultToDataset,
} from "../lib/api";
import {
  applyClientFilters,
  filterStateFromURL,
  filterStateToAPIQuery,
  filterStateToURL,
} from "../lib/filters";
import type { Dataset } from "../lib/types";

const url = new URL(Astro.request.url);
const state = filterStateFromURL(url.searchParams);
const PAGE_SIZE = state.pageSize;
// A freetext query routes through the hybrid lexical+semantic endpoint
// (nemar-cli#646, closes website#12); an empty box keeps the browse flow.
const isSearch = state.q.trim().length > 0;

// Max ranked hits to pull from the hybrid endpoint in one shot. It has no
// `offset`, so we fetch the full ranked list once and paginate client-side.
const SEARCH_FETCH_LIMIT = 240;

// Each rendered card pairs a full Dataset with an optional FTS5 snippet.
let cards: Array<{ dataset: Dataset; snippet?: string }> = [];
let totalReturned = 0;
let fetchError: string | null = null;
// Which path served a search ("semantic" | "exact_id" | "text_fallback"),
// surfaced subtly so the relevance-ranked (not date-sorted) order reads as
// intentional. Null in browse mode.
let searchMethod: string | null = null;

// Cap every backend hop so a stalled upstream fails fast (and falls back)
// instead of holding the SSR response until the Worker CPU limit kills it.
const signal = AbortSignal.timeout(8000);

try {
  if (isSearch) {
    const res = await searchDatasets(state.q, { limit: SEARCH_FETCH_LIMIT, signal });
    searchMethod = res.method;
    // The hybrid endpoint doesn't filter by modality/range, so every
    // selection is enforced client-side over the full ranked list (relevance
    // order preserved; the `sort` control is a no-op while searching).
    const ranked = applyClientFilters(res.results, state, { allModalitiesClientSide: true });
    totalReturned = ranked.length;
    const slice = ranked.slice((state.page - 1) * PAGE_SIZE, state.page * PAGE_SIZE);
    // Hydrate the visible page to full rows (parallel) for the richer card.
    // Only managed ids (nm*/on*) are addressable at /datasets/:id; ds* legacy
    // rows 400 there, so they render straight from the reduced search
    // projection (name/modalities/participants/authors/snippet). If a managed
    // fetch blips we log it and fall back to the projection too — and if EVERY
    // attempted hydration failed, surface an outage instead of degrading
    // silently.
    let attempted = 0;
    let hydrationFailures = 0;
    cards = await Promise.all(
      slice.map(async (r) => {
        if (!isManagedDatasetId(r.id)) {
          return { dataset: searchResultToDataset(r), snippet: r.snippet };
        }
        attempted++;
        try {
          return { dataset: await getDataset(r.id, { signal }), snippet: r.snippet };
        } catch (err) {
          hydrationFailures++;
          console.warn(
            `[discover] hydration failed for ${r.id}: ${err instanceof Error ? err.message : String(err)}`,
          );
          return { dataset: searchResultToDataset(r), snippet: r.snippet };
        }
      }),
    );
    if (attempted > 0 && hydrationFailures === attempted) {
      fetchError = "Search is temporarily unavailable. Please try again in a moment.";
    }
  } else {
    // Server-side offset pagination across the full catalog. Client-side
    // filtering (multi-modality AND/OR, range sliders) still runs per page.
    const baseQuery = filterStateToAPIQuery(state);
    const page = await listDatasets(
      {
        ...baseQuery,
        limit: PAGE_SIZE,
        offset: (state.page - 1) * PAGE_SIZE,
      },
      { signal },
    );
    // Note: multi-modality AND/OR and range filters reduce the visible count
    // for the *current page* only — pagination still spans the server total.
    // License IS server-side now (via filterStateToAPIQuery), so the count
    // and pagination stay accurate for license filtering.
    cards = applyClientFilters(page.datasets, state).map((d) => ({ dataset: d }));
    totalReturned = page.total_count ?? page.count ?? page.datasets.length;
  }
} catch (err) {
  // Log the raw detail to Worker logs; show users a sanitized message rather
  // than leaking internal service names / status codes.
  console.error(
    `[discover] load failed (q="${state.q}"): ${err instanceof Error ? err.message : String(err)}`,
  );
  fetchError = isSearch
    ? "Search is temporarily unavailable. Please try again in a moment."
    : "Could not load datasets. Please try again.";
}

const pageCount = Math.max(1, Math.ceil(totalReturned / PAGE_SIZE));

// Re-serialize the canonical filter state to drop unknown params.
const canonicalParams = filterStateToURL(state);
canonicalParams.delete("page");
// While searching, license + sort don't apply (the hybrid endpoint ignores
// them), so keep them out of pagination links rather than implying they're
// active. Re-enable once nemar-cli#683 lands server-side support.
if (isSearch) {
  canonicalParams.delete("license");
  canonicalParams.delete("sort");
}

// Cache keyed on the full URL (query params) so each filter+page+query combo
// gets its own edge entry. On error, never cache — a brief upstream hiccup
// must not pin an error page at the edge for the SWR window. Search responses
// use a short SWR so newly relevant datasets surface promptly; browse pages
// (stable "newest" ordering) keep the long SWR.
Astro.response.headers.set(
  "Cache-Control",
  fetchError
    ? "no-store"
    : isSearch
      ? "public, max-age=30, s-maxage=120, stale-while-revalidate=300"
      : "public, max-age=30, s-maxage=120, stale-while-revalidate=3600",
);
---

<Base title="Discover datasets">
  <section class="discover container">
    <header class="discover__head">
      <div class="discover__head-row">
        <h1>Discover datasets</h1>
        {!fetchError && (
          <p class="discover__count">
            {isSearch
              ? `${totalReturned.toLocaleString()} ${totalReturned === 1 ? "result" : "results"} for "${state.q}"`
              : `Showing ${cards.length} of ${totalReturned.toLocaleString()} datasets`}
            {pageCount > 1 && ` · page ${state.page} of ${pageCount}`}
            {isSearch && searchMethod && totalReturned > 0 && (
              <span class="discover__rank-note"> · ranked by relevance</span>
            )}
          </p>
        )}
      </div>
      <SearchBar value={state.q} size="md" placeholder="Search by dataset name, ID, or description..." />
    </header>
    <div class="discover__layout">
      <aside class="discover__rail" aria-label="Filters">
        <FilterSidebar state={state} searchActive={isSearch} />
      </aside>
      <div class="discover__results">
        {fetchError && (
          <div class="discover__error" role="alert">
            <strong>Could not load datasets.</strong>
            <span>{fetchError}</span>
          </div>
        )}
        {!fetchError && cards.length === 0 && (
          <div class="discover__empty">
            {isSearch ? (
              <>
                <h2>No datasets match "{state.q}".</h2>
                <p>Try a different term, fewer filters, or
                  <a href="/discover">browse all datasets</a>.
                </p>
              </>
            ) : (
              <>
                <h2>No datasets match these filters.</h2>
                <p>Try removing a filter or
                  <a href="/discover">resetting all filters</a>.
                </p>
              </>
            )}
          </div>
        )}
        <ul class="discover__list" role="list">
          {cards.map((c) => (
            <li>
              <DatasetCard dataset={c.dataset} snippet={c.snippet} />
            </li>
          ))}
        </ul>
        <Pagination
          page={state.page}
          pageCount={pageCount}
          baseParams={canonicalParams}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .discover {
    padding-block: var(--space-12) var(--space-16);
  }
  .discover__head {
    margin-block-end: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .discover__head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .discover__head h1 {
    font-size: var(--fs-3xl);
  }
  .discover__count {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
  }
  .discover__rank-note {
    color: var(--color-fg-subtle);
  }
  .discover__layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--space-8);
    align-items: flex-start;
  }
  @media (max-width: 880px) {
    .discover__layout {
      grid-template-columns: 1fr;
    }
    .discover__rail {
      position: static !important;
    }
  }
  .discover__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .discover__empty {
    padding: var(--space-12) var(--space-6);
    text-align: center;
    color: var(--color-fg-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
  }
  .discover__empty h2 {
    font-size: var(--fs-xl);
    color: var(--color-fg);
    margin-block-end: var(--space-2);
  }
  .discover__error {
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-danger) 40%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    color: var(--color-fg);
    margin-block-end: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
</style>
