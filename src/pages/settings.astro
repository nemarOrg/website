---
import Base from "../layouts/Base.astro";
import { fetchAccountIdentity } from "../lib/account-api";
import { ACCOUNT_COPY, fillCopy } from "../lib/account-copy";
import {
  USERNAME_MAX_LENGTH,
  WHY_MAX_CHARS,
  WHY_MIN_CHARS,
  deriveAccountTier,
  deriveUploadAccessState,
} from "../lib/account-tier";
import { fullName, getSession, isValidOrcid, maskEmail } from "../lib/auth";
import {
  DOCS_ACCOUNT_SETTINGS_PATH,
  DOCS_UPLOAD_ACCESS_PATH,
  resolveDocsBase,
} from "../lib/docs-base";
import { formatDate } from "../lib/format";
import { IDENTITY_CONFLICT_MESSAGES } from "../lib/identity-errors";
import { gapTail, profileGaps } from "../lib/profile-gaps";

const session = getSession(Astro.locals);
if (!session) {
  return Astro.redirect("/login?next=%2Fsettings");
}

// ORCID flow errors bounce back here as ?error=<code> (the backend callback
// carries state.next=/settings). Only known ORCID codes render; anything else
// is ignored rather than shown as a generic scare banner.
const ORCID_ERROR_MESSAGES: Record<string, string> = {
  // orcid_in_use / its deprecated alias orcid_already_linked, orcid_linked_other,
  // email_in_use, and github_in_use share one sentence regardless of which
  // backend constraint noticed the collision (website#305).
  ...IDENTITY_CONFLICT_MESSAGES,
  orcid_already_have:
    "Your account already has a different ORCID iD linked. Use Change / re-link to replace it.",
  orcid_denied: "The ORCID sign-in was cancelled. Nothing was changed.",
  orcid_state: "The ORCID session expired. Try again.",
  orcid_exchange: "We couldn't complete the ORCID flow. Try again.",
  orcid_error: "Something went wrong during the ORCID flow. Try again.",
  orcid_unavailable: "ORCID is temporarily unavailable. Try again shortly.",
};
const orcidErrorParam = new URL(Astro.request.url).searchParams.get("error");
// Object.hasOwn: a plain-object lookup would resolve prototype keys
// (?error=constructor) to a function and render "[object Object]".
const orcidError =
  orcidErrorParam && Object.hasOwn(ORCID_ERROR_MESSAGES, orcidErrorParam)
    ? ORCID_ERROR_MESSAGES[orcidErrorParam]
    : null;

const { email, role } = session.user;
const name = fullName(session.user);
const orcid = session.user.orcid;
const orcidVerified = session.user.orcid_verified === true;
const githubUsername = session.user.github_username ?? "";
const city = session.user.city ?? "";
const country = session.user.country ?? "";
const affiliation = session.user.affiliation ?? "";
const profileComplete = city.length > 0 && country.length > 0;

// Tier, not "status" (website#301). `/auth/me` reports `verified` and
// `approved` alike as `"active"`, so the old three-value status row could
// only ever say "Active" for two very different accounts — one that may
// upload and one that may not. `service_access` is what separates them.
const tier = deriveAccountTier(session.user);
const uploadAccess = deriveUploadAccessState(session.user);
const grantedDate = uploadAccess.kind === "granted" ? formatDate(uploadAccess.at) : "";
const requestedDate = uploadAccess.kind === "requested" ? formatDate(uploadAccess.at) : "";

// `/auth/me` does not carry `username`; `fetchAccountIdentity` reads it from
// `GET /users/me` and answers `undefined` when it cannot be asked (an
// unverified session can't reach that route at all). Undefined renders as
// "not set yet" copy WITHOUT claiming the account has none.
const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
const identity =
  tier === "unverified"
    ? { username: undefined }
    : await fetchAccountIdentity(session.user.username, { cookieHeader });
const username = identity.username ?? "";
const usernameKnown = identity.username !== undefined;
// Fixed once an admin has approved the account (409 `username_locked` from
// PATCH /auth/profile). Under nemar-cli ADR 0040's invariant `approved` and
// `service_access = 1` are the same thing, and `service_access` is the half
// the session actually carries.
const usernameLocked = session.user.service_access === true;

const tierLabel: Record<typeof tier, string> = {
  unverified: ACCOUNT_COPY["tier.unverified.label"],
  base: ACCOUNT_COPY["tier.base.label"],
  upload: ACCOUNT_COPY["tier.upload.label"],
};
const roleLabel: Record<typeof role, string> = {
  admin: "Administrator",
  user: "Researcher",
};

// A verified ORCID iD owns the name (nemar-cli ADR 0042), so the fields below
// are not editable — but the record can publish no name at all, and then the
// account is stuck: it cannot publish (ADR 0041), and the upload-access
// request refuses with `missing: ["given_name", "family_name"]` naming two
// controls that do not exist for it. That was a dead end with no in-product
// exit, so this is the state that gets its own explanation and its own way
// out (re-link, or unlink and type one).
const nameMissingUnderOrcid = orcidVerified && name.length === 0;

const accountDocsUrl = `${resolveDocsBase()}${DOCS_ACCOUNT_SETTINGS_PATH}`;
const uploadAccessDocsUrl = `${resolveDocsBase()}${DOCS_UPLOAD_ACCESS_PATH}`;

// Everything this account is still missing, in one list at the top of the
// account card (website#309) — the same list the dashboard nudge shows, the
// same one an admin sees on the review card, and the same sentences a refused
// upload-access request comes back with. The point of putting it HERE is that
// Settings is where almost every one of them is fixed, so the list and the
// controls are on one screen.
const gaps = profileGaps({ ...session.user, username: identity.username });
const requestedLede = requestedDate
  ? fillCopy(ACCOUNT_COPY["upload_access.requested.lede_dated"], { date: requestedDate })
  : ACCOUNT_COPY["upload_access.requested.lede"];
---

<Base title="Settings" description="Your NEMAR account settings.">
  <section class="settings">
    <div class="settings__atmosphere" aria-hidden="true"></div>

    <header class="settings__head">
      <p class="settings__eyebrow">Account</p>
      <h1 class="settings__title">Settings</h1>
      <p class="settings__lede">
        Manage your username, name, email, ORCID iD, and upload access. Theme and
        privacy choices are stored on this device only.
        <a href={accountDocsUrl} rel="external noopener">What each setting does</a>.
      </p>
    </header>

    <div class="settings__grid">
      <!-- Account block (#132 name, #133 email, #301 username + name edit) -->
      <article class="card">
        <div class="card__rail" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">Your account</h2>
          <p class="card__lede">
            {orcidVerified
              ? "Your name is read-only and synced from ORCID."
              : "Your name is used to cite you on any DOI your datasets get."}
          </p>
        </header>

        {/* What is still missing, before anything else on the card: one line
            per gap, each naming what it blocks and where it is set. The label
            links at the control below (or at orcid.org, for a name the record
            owns); the rest of the line is the sentence `describeGap`
            composes, word for word.

            It renders when there is nothing outstanding too. A block that
            only ever appears while something is wrong makes its own absence
            ambiguous — "complete" and "this build does not check" look
            identical — and this is the page a user lands on to find out
            where they stand. */}
        <div class="gaps" data-account-gaps>
          <p class="gaps__title">{ACCOUNT_COPY["gaps.title"]}</p>
          {gaps.length === 0 ? (
            <p class="gaps__none" data-account-gaps-none>{ACCOUNT_COPY["gaps.none"]}</p>
          ) : (
            <ul class="gaps__list" role="list">
              {gaps.map((gap) => (
                <li>
                  {gap.href ? (
                    <a href={gap.href}>{gap.label}</a>
                  ) : (
                    <span class="gaps__field">{gap.label}</span>
                  )}{" "}{gapTail(gap)}
                </li>
              ))}
            </ul>
          )}
        </div>

        <dl class="kv">
          {/* `id="account-name"` is on the ROW, not on an input, and the row
              always renders. It is where `uploadAccessMissingFields` points
              `given_name`/`family_name`, and an input id could not be: the
              editable fields do not exist for a verified-ORCID account, which
              is exactly the account the backend names those fields to. */}
          <div class="kv__row" id="account-name">
            <dt>Name</dt>
            <dd>
              {name ? (
                <span class="kv__name">{name}</span>
              ) : (
                <span class="kv__muted">Not set</span>
              )}
              {orcidVerified ? (
                <p class="kv__note" data-name-orcid-note>
                  From your verified ORCID record, and re-read on every sign-in — so it
                  can&rsquo;t be edited here. Change it at
                  {" "}<a href="https://orcid.org/my-orcid" rel="external noopener">orcid.org</a>
                  {" "}and sign in again, or unlink the iD below.
                </p>
              ) : (
                <button type="button" class="linkbtn" data-name-toggle>Edit name</button>
              )}
            </dd>
          </div>
          <div class="kv__row">
            <dt>Username</dt>
            <dd>
              {usernameKnown ? (
                username ? (
                  <code>{username}</code>
                ) : (
                  <span class="kv__muted">Not set yet</span>
                )
              ) : (
                <span class="kv__muted">Couldn&rsquo;t load — refresh to try again.</span>
              )}
              {usernameKnown && (
                usernameLocked ? (
                  <p class="kv__note" data-username-locked-note>
                    Fixed now that your account is approved: it is what admins approve you
                    by, and what the dataset repositories you own are attributed to. Ask an
                    admin if it has to change.
                  </p>
                ) : (
                  <button type="button" class="linkbtn" data-username-toggle>
                    {username ? "Change" : "Choose a username"}
                  </button>
                )
              )}
            </dd>
          </div>
          <div class="kv__row">
            <dt>Email</dt>
            <dd class="kv__email">
              <span data-current-email>{maskEmail(email)}</span>
              <button type="button" class="linkbtn" data-email-toggle>Change</button>
            </dd>
          </div>
          <div class="kv__row">
            <dt>Role</dt>
            <dd>
              <span class:list={["badge", `badge--${role}`]}>{roleLabel[role]}</span>
            </dd>
          </div>
          <div class="kv__row">
            <dt>Access</dt>
            <dd>
              <span class:list={["badge", `badge--tier-${tier}`]}>{tierLabel[tier]}</span>
            </dd>
          </div>
        </dl>

        {/* The stuck state: a verified iD whose record publishes no name.
            Nothing else on this page addresses it — the fields are withheld
            (the backend would 409 `name_is_orcid_canonical`) and the ORCID
            card below explains linking, not this. Both exits are here:
            re-link, which re-reads the record, and unlink, which hands the
            account back its editable fields.

            The re-link control is a real form because it is one — an
            Origin-carrying POST, no JavaScript (nemar-cli ADR 0022). Unlink
            needs the ORCID card's handler, and duplicating its button would
            break it outright: the page's `$()` helper is `querySelector`, so
            a second `[data-orcid-unlink]` would never be wired. It is linked
            instead. */}
        {nameMissingUnderOrcid && (
          <div class="notice notice--warn" id="account-name-orcid" data-name-orcid-stuck>
            <p class="notice__title">Your ORCID record doesn&rsquo;t publish a name</p>
            <p class="notice__body">
              NEMAR cites the person who deposited a dataset by name, never by username, so
              your account needs one before it can publish or be granted upload access. Your
              name comes from your verified ORCID iD and is re-read on every sign-in, which
              is why it can&rsquo;t be typed here.
            </p>
            <p class="notice__body">
              Make your name public at
              {" "}<a href="https://orcid.org/my-orcid" rel="external noopener">orcid.org</a>
              {" "}(Names &rsaquo; visibility <strong>Everyone</strong>), then re-link below or
              sign in again. Or unlink the iD from the
              {" "}<a href="#orcid-card">ORCID iD card</a> to type a name yourself.
            </p>
            <div class="flow__actions">
              <form class="confirm__form" method="post" action="/auth/orcid/start?mode=relink&next=%2Fsettings">
                <button type="submit" class="btn btn--primary">Re-link ORCID</button>
              </form>
              <a class="btn btn--ghost" href="#orcid-card">Go to ORCID settings</a>
            </div>
          </div>
        )}

        <!-- Username edit (#301). Editable until an admin approves the
             account; the backend answers 409 `username_locked` after that,
             which this form renders even if the session flag is stale. -->
        {usernameKnown && !usernameLocked && (
          <div class="flow" data-username-flow hidden>
            <label class="field">
              <span class="field__label">Username</span>
              <input
                id="account-username"
                class="field__input"
                type="text"
                name="username"
                autocomplete="username"
                spellcheck="false"
                autocapitalize="none"
                maxlength={USERNAME_MAX_LENGTH}
                value={username}
                placeholder="alovelace"
                data-username-input
              />
            </label>
            <p class="flow__hint">
              Letters, numbers, underscores and hyphens; 3&ndash;{USERNAME_MAX_LENGTH}
              {" "}characters. You can change it until an admin grants you upload access,
              after which it is fixed.
            </p>
            <div class="flow__actions">
              <button type="button" class="btn btn--ghost" data-username-cancel>Cancel</button>
              <button type="button" class="btn btn--primary" data-username-save>Save username</button>
            </div>
            <p class="flow__msg" role="alert" data-username-msg hidden></p>
          </div>
        )}

        <!-- Name edit (#301). Only rendered without a verified ORCID iD: with
             one the backend refuses the edit (`name_is_orcid_canonical`)
             because the record is re-read on every sign-in and would
             overwrite it. -->
        {!orcidVerified && (
          <div class="flow" data-name-flow hidden>
            <div class="profile__grid2">
              <label class="field">
                <span class="field__label">Given name</span>
                <input
                  id="account-given-name"
                  class="field__input"
                  type="text"
                  name="given_name"
                  autocomplete="given-name"
                  maxlength="100"
                  value={session.user.given_name ?? ""}
                  data-name-given
                />
              </label>
              <label class="field">
                <span class="field__label">Family name</span>
                <input
                  id="account-family-name"
                  class="field__input"
                  type="text"
                  name="family_name"
                  autocomplete="family-name"
                  maxlength="100"
                  value={session.user.family_name ?? ""}
                  data-name-family
                />
              </label>
            </div>
            <p class="flow__hint">
              Publishing a dataset needs a real name: a DOI cites a person, never a
              username. Linking a verified ORCID iD later replaces this with the name on
              your ORCID record.
            </p>
            <div class="flow__actions">
              <button type="button" class="btn btn--ghost" data-name-cancel>Cancel</button>
              <button type="button" class="btn btn--primary" data-name-save>Save name</button>
            </div>
            <p class="flow__msg" role="alert" data-name-msg hidden></p>
          </div>
        )}

        <!-- Email change flow (#133) -->
        <div class="flow" data-email-flow hidden>
          <div class="flow__step" data-email-step="request">
            <label class="field">
              <span class="field__label">New email address</span>
              <input
                class="field__input"
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder="you@university.edu"
                data-email-input
              />
            </label>
            <p class="flow__hint">We'll email a 6-digit code to the new address to confirm it.</p>
            <div class="flow__actions">
              <button type="button" class="btn btn--ghost" data-email-cancel>Cancel</button>
              <button type="button" class="btn btn--primary" data-email-send>Send code</button>
            </div>
          </div>
          <div class="flow__step" data-email-step="verify" hidden>
            <label class="field">
              <span class="field__label">Enter the code sent to <strong data-email-target></strong></span>
              <input
                class="field__input field__input--code"
                type="text"
                inputmode="numeric"
                maxlength="6"
                autocomplete="one-time-code"
                placeholder="123456"
                data-email-code
              />
            </label>
            <div class="flow__actions">
              <button type="button" class="btn btn--ghost" data-email-back>Back</button>
              <button type="button" class="btn btn--primary" data-email-verify>Confirm change</button>
            </div>
          </div>
          <p class="flow__msg" role="alert" data-email-msg hidden></p>
        </div>
      </article>

      <!-- ORCID block (#132 surface, #134 manage) -->
      <article class="card" id="orcid-card">
        <div class="card__rail" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">ORCID iD</h2>
          <p class="card__lede">Your persistent researcher identifier.</p>
        </header>

        {orcidError && (
          <p class="flow__msg" role="alert" data-tone="error">{orcidError}</p>
        )}

        {orcid && isValidOrcid(orcid) ? (
          <>
            <div class="orcid">
              <a class="orcid__id" href={`https://orcid.org/${orcid}`} rel="external noopener" target="_blank">
                <svg class="orcid__icon" width="20" height="20" viewBox="0 0 256 256" aria-hidden="true">
                  <path fill="#A6CE39" d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0z"/>
                  <path fill="#fff" d="M86.3 186.2H70.9V79.1h15.4v107.1zM78.6 56.8c-5.1 0-9.2-4.1-9.2-9.2 0-5.1 4.1-9.2 9.2-9.2s9.2 4.1 9.2 9.2c0 5.1-4.1 9.2-9.2 9.2zm17.6 22.3h41.6c39.6 0 57 28.3 57 53.5 0 27.4-21.4 53.5-56.8 53.5H96.2V79.1zm15.3 92.2h24.6c35 0 43-26.5 43-38.6 0-19.7-12.5-38.6-43.8-38.6h-23.8v77.2z"/>
                </svg>
                <span class="orcid__url">orcid.org/{orcid}</span>
              </a>
              {orcidVerified && (
                <span class="orcid__verified" title="Ownership verified via ORCID sign-in">
                  <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M6.2 11.3 3.3 8.4l1.1-1.1 1.8 1.8 4.3-4.3 1.1 1.1z"/></svg>
                  Verified
                </span>
              )}
            </div>

            <div class="orcid__actions">
              <button type="button" class="linkbtn" data-orcid-relink>Change / re-link</button>
              <button type="button" class="linkbtn linkbtn--danger" data-orcid-unlink>Unlink</button>
            </div>

            <div class="confirm" data-orcid-relink-confirm hidden>
              <p class="confirm__text">Re-linking starts an ORCID sign-in and replaces the iD above with the one you authenticate. Continue?</p>
              <div class="flow__actions">
                <button type="button" class="btn btn--ghost" data-confirm-cancel>Cancel</button>
                <form class="confirm__form" method="post" action="/auth/orcid/start?mode=relink&next=%2Fsettings">
                  <button type="submit" class="btn btn--primary">Continue to ORCID</button>
                </form>
              </div>
            </div>

            <div class="confirm confirm--danger" data-orcid-unlink-confirm hidden>
              <p class="confirm__text">Unlink this ORCID iD? You can still sign in with your email code, so you won't be locked out.</p>
              <div class="flow__actions">
                <button type="button" class="btn btn--ghost" data-confirm-cancel>Cancel</button>
                <button type="button" class="btn btn--danger" data-orcid-unlink-do>Unlink ORCID</button>
              </div>
            </div>
            <p class="flow__msg" role="alert" data-orcid-msg hidden></p>
          </>
        ) : (
          <div class="orcid orcid--empty">
            <p class="orcid__prompt">No ORCID iD linked yet. Linking verifies your identity and keeps your name in sync.</p>
            <a class="btn btn--primary" href="/auth/orcid/start?next=%2Fsettings">Connect your ORCID</a>
          </div>
        )}
      </article>

      <!-- Profile block (#135) -->
      <article class="card">
        <div class="card__rail" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">Profile</h2>
          <p class="card__lede">Used for publishing and export-control screening.</p>
        </header>

        {!profileComplete && (
          <p class="notice notice--warn" data-profile-notice>
            City and country are required to access data. Add them below.
          </p>
        )}

        <form class="profile" data-profile-form>
          {/* The ids are load-bearing: `uploadAccessMissingFields` in
              lib/account-tier.ts links a refused upload-access request
              straight at the field it named, so a rename here without one
              there produces a link that scrolls nowhere. Guarded by
              test/account-tiers-ui.test.ts. */}
          <label class="field">
            <span class="field__label">GitHub handle <span class="field__req">required to publish</span></span>
            <div class="field__prefixed">
              <span class="field__prefix">@</span>
              <input
                id="profile-github"
                class="field__input"
                type="text"
                name="github_username"
                autocomplete="off"
                spellcheck="false"
                placeholder="octocat"
                value={githubUsername}
                data-profile-github
              />
            </div>
          </label>
          <div class="profile__grid2">
            <label class="field">
              <span class="field__label">City <span class="field__req">required</span></span>
              <input id="profile-city" class="field__input" type="text" name="city" autocomplete="address-level2" value={city} data-profile-city />
            </label>
            <label class="field">
              <span class="field__label">Country <span class="field__req">required</span></span>
              <input id="profile-country" class="field__input" type="text" name="country" autocomplete="country-name" value={country} data-profile-country />
            </label>
          </div>
          <label class="field">
            <span class="field__label">Affiliation <span class="field__opt">optional</span></span>
            <input class="field__input" type="text" name="affiliation" autocomplete="organization" placeholder="University or institute" value={affiliation} data-profile-affiliation />
          </label>
          <div class="flow__actions flow__actions--end">
            <p class="flow__msg" role="status" data-profile-msg hidden></p>
            <button type="submit" class="btn btn--primary" data-profile-save>Save profile</button>
          </div>
        </form>
      </article>

      <!-- Upload access (#301; nemar-cli ADRs 0040 + 0042). Deliberately its
           own card, and deliberately not phrased as a status the account
           "fails": browsing, downloading and the dashboard all work without
           it. What it gates is contributing data and, later, compute. -->
      <article class="card card--wide" id="upload-access">
        <div class="card__rail" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">{ACCOUNT_COPY["upload_access.section.title"]}</h2>
          <p class="card__lede">{ACCOUNT_COPY["upload_access.section.lede"]}</p>
        </header>

        <dl class="kv">
          <div class="kv__row">
            <dt>Status</dt>
            <dd data-upload-access-state={uploadAccess.kind}>
              {uploadAccess.kind === "granted" && (
                <>
                  <span class="badge badge--tier-upload">
                    {ACCOUNT_COPY["upload_access.state.granted"]}
                  </span>
                  {grantedDate && <span class="kv__muted"> on {grantedDate}</span>}
                </>
              )}
              {uploadAccess.kind === "requested" && (
                <>
                  <span class="badge badge--status-pending">
                    {ACCOUNT_COPY["upload_access.state.requested"]}
                  </span>
                  {requestedDate && <span class="kv__muted"> on {requestedDate}</span>}
                </>
              )}
              {uploadAccess.kind === "not_requested" && (
                <span class="badge">{ACCOUNT_COPY["upload_access.state.not_requested"]}</span>
              )}
            </dd>
          </div>
        </dl>

        {/* The link text is deliberately NOT "Go to the upload page": the
            copy sentence already names it, and repeating the noun after the
            publishing clause left the paragraph ending on a dangling
            duplicate. "Upload now" is the action, not the destination. */}
        {uploadAccess.kind === "granted" && (
          <p class="upload-access__body">
            {ACCOUNT_COPY["upload_access.granted.body"]}
            {" "}<a href="/upload">Upload now</a>.
          </p>
        )}

        {uploadAccess.kind === "requested" && (
          <p class="upload-access__body">
            {requestedLede} {ACCOUNT_COPY["upload_access.requested.body"]}
          </p>
        )}

        {tier === "unverified" && (
          <p class="upload-access__body">
            {ACCOUNT_COPY["upload_access.unverified.body"]}
            {" "}The verify step is on your <a href="/dashboard">dashboard</a>.
          </p>
        )}

        <!-- `data-orcid-verified` on the form is read by the refusal renderer
             in the script below: a verified iD moves the two name halves'
             "set it in" from Settings to the ORCID record, and a browser
             script has no session to ask. -->
        {tier === "base" && uploadAccess.kind === "not_requested" && (
          <form
            class="upload-access__form"
            data-upload-access-form
            data-orcid-verified={orcidVerified ? "true" : "false"}
          >
            <p class="upload-access__body">{ACCOUNT_COPY["upload_access.request.form_body"]}</p>
            <label class="field">
              <span class="field__label">
                {ACCOUNT_COPY["upload_access.request.why_label"]}
                <span class="field__req">{WHY_MIN_CHARS}&ndash;{WHY_MAX_CHARS} characters</span>
              </span>
              <textarea
                id="upload-access-why"
                class="field__input field__input--textarea"
                name="why"
                rows="4"
                maxlength={WHY_MAX_CHARS}
                placeholder="e.g. Resting-state EEG from 40 adults collected at our lab in 2025, already in BIDS."
                data-upload-access-why
              ></textarea>
            </label>
            <p class="flow__hint">
              <span data-upload-access-count>0</span> / {WHY_MAX_CHARS} characters
            </p>

            {/* Populated from the refusal's `missing` array: one link per
                field the request still needs, pointing at that field. */}
            <div class="upload-access__missing" data-upload-access-missing hidden>
              <p class="upload-access__missing-title">{ACCOUNT_COPY["gaps.request.title"]}</p>
              <ul class="upload-access__missing-list" data-upload-access-missing-list></ul>
            </div>

            <div class="flow__actions flow__actions--end">
              <button type="submit" class="btn btn--primary" data-upload-access-submit>
                {ACCOUNT_COPY["upload_access.request.cta"]}
              </button>
            </div>
            <p class="flow__msg" role="alert" data-upload-access-msg hidden></p>
          </form>
        )}

        <p class="upload-access__footnote">
          <a href={uploadAccessDocsUrl} rel="external noopener">
            {ACCOUNT_COPY["upload_access.docs_link"]}
          </a>
        </p>
      </article>

      <!-- Appearance block -->
      <article class="card">
        <div class="card__rail" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">Appearance</h2>
          <p class="card__lede">Theme is stored on this device only.</p>
        </header>
        <fieldset class="theme-picker">
          <legend class="visually-hidden">Theme</legend>
          <label class="theme-option">
            <input type="radio" name="theme" value="light" data-theme-radio />
            <span class="theme-option__swatch theme-option__swatch--light" aria-hidden="true"></span>
            <span class="theme-option__label">Light</span>
          </label>
          <label class="theme-option">
            <input type="radio" name="theme" value="dark" data-theme-radio />
            <span class="theme-option__swatch theme-option__swatch--dark" aria-hidden="true"></span>
            <span class="theme-option__label">Dark</span>
          </label>
          <label class="theme-option">
            <input type="radio" name="theme" value="system" data-theme-radio />
            <span class="theme-option__swatch theme-option__swatch--system" aria-hidden="true"></span>
            <span class="theme-option__label">Match system</span>
          </label>
        </fieldset>
      </article>

      <!-- Privacy block -->
      <article class="card">
        <div class="card__rail" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">Privacy</h2>
          <p class="card__lede">Cookie consent stored on this device.</p>
        </header>
        <div class="consent">
          <div class="consent__current">
            <span class="consent__label">Current choice</span>
            <span class="consent__value" data-consent-current>Loading...</span>
          </div>
          <div class="consent__actions">
            <button type="button" class="btn btn--ghost" data-consent-set="strict">
              Strictly necessary only
            </button>
            <button type="button" class="btn btn--primary" data-consent-set="accepted">
              Accept all
            </button>
          </div>
          <p class="consent__note" data-consent-note>
            Strictly necessary keeps your sign-in cookie. Accept all also enables
            anonymous analytics that help us understand which datasets researchers
            use most.
          </p>
          <p class="consent__note">
            What we store and why is described in the
            <a href="/privacy">privacy policy</a>. To export or delete your
            account data, email
            <a href="mailto:privacy@nemar.org">privacy@nemar.org</a>.
          </p>
        </div>
      </article>

      <!-- Sign out block -->
      <article class="card card--danger">
        <div class="card__rail card__rail--danger" aria-hidden="true"></div>
        <header class="card__head">
          <h2 class="card__title">Sign out</h2>
          <p class="card__lede">End this browser session on this device.</p>
        </header>
        <form method="POST" action="/api/auth/logout" class="signout-form">
          <button type="submit" class="btn btn--danger">Sign out of NEMAR</button>
        </form>
      </article>
    </div>
  </section>
</Base>

<style>
  .settings {
    position: relative;
    isolation: isolate;
    max-inline-size: 56rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4) var(--space-20);

    --settings-glow: rgb(91 186 213 / 10%);
    --card-bg: var(--color-bg);
    --card-border: var(--color-border);

    background:
      radial-gradient(ellipse at 18% 0%, var(--settings-glow), transparent 55%),
      var(--color-bg-elevated);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .settings {
      --settings-glow: rgb(91 186 213 / 16%);
      --card-bg: rgb(255 255 255 / 4%);
      --card-border: rgb(255 255 255 / 10%);
      background:
        radial-gradient(ellipse at 18% 0%, var(--settings-glow), transparent 55%),
        var(--color-bg);
    }
  }
  :global(:root[data-theme="dark"]) .settings {
    --settings-glow: rgb(91 186 213 / 16%);
    --card-bg: rgb(255 255 255 / 4%);
    --card-border: rgb(255 255 255 / 10%);
    background:
      radial-gradient(ellipse at 18% 0%, var(--settings-glow), transparent 55%),
      var(--color-bg);
  }

  .settings__atmosphere {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 14% 10%, rgb(91 186 213 / 22%) 50%, transparent 51%),
      radial-gradient(1px 1px at 86% 28%, rgb(96 60 186 / 22%) 50%, transparent 51%);
    pointer-events: none;
    z-index: -1;
  }

  .settings__head {
    margin-block-end: var(--space-8);
  }
  .settings__eyebrow {
    margin: 0 0 var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    color: var(--brand-teal);
    font-weight: var(--fw-semibold);
  }
  .settings__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(var(--fs-3xl), 4vw, var(--fs-4xl));
    font-weight: var(--fw-semibold);
    letter-spacing: -0.015em;
    line-height: var(--lh-tight);
  }
  .settings__lede {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
    max-inline-size: 52ch;
  }

  .settings__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 720px) {
    .settings__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Card ---------- */
  .card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--brand-teal) 30%, var(--card-border));
  }
  .card__rail {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    background: linear-gradient(90deg, var(--brand-teal), var(--brand-purple));
    opacity: 0.6;
  }
  .card__rail--danger {
    background: linear-gradient(90deg, var(--color-danger), color-mix(in srgb, var(--color-danger) 60%, var(--brand-purple)));
  }
  .card--danger:hover {
    border-color: color-mix(in srgb, var(--color-danger) 35%, var(--card-border));
  }
  /* The upload-access card carries a form and a linked field list, so it
     spans both columns rather than being squeezed into one. */
  @media (min-width: 720px) {
    .card--wide {
      grid-column: 1 / -1;
    }
  }
  .card__head {
    margin-block-end: var(--space-4);
  }
  .card__title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
  }
  .card__lede {
    margin: 0;
    color: var(--color-fg-subtle);
    font-size: var(--fs-sm);
  }

  /* ---------- Key/value pairs ---------- */
  .kv {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .kv__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
  }
  .kv__row dt {
    color: var(--color-fg-subtle);
    font-weight: var(--fw-medium);
  }
  .kv__row dd {
    margin: 0;
    color: var(--color-fg);
  }
  .kv__name {
    font-weight: var(--fw-medium);
  }
  .kv__muted {
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
  }
  .kv__note {
    margin: var(--space-1) 0 0;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }
  .kv__note a {
    color: var(--color-link);
  }
  .kv__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .kv__row code {
    font-family: var(--font-mono);
    background: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    color: var(--color-fg);
    font-size: 0.92em;
  }
  @media (max-width: 480px) {
    .kv__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  /* ---------- Inline link button ---------- */
  .linkbtn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-link);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .linkbtn:hover {
    color: color-mix(in srgb, var(--color-link) 80%, var(--color-fg));
  }
  .linkbtn--danger {
    color: var(--color-danger);
  }

  /* ---------- ORCID ---------- */
  .orcid {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .orcid__id {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
  .orcid__id:hover .orcid__url {
    text-decoration: underline;
  }
  .orcid__icon {
    flex-shrink: 0;
  }
  .orcid__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-success);
  }
  .orcid__actions {
    display: flex;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }
  .orcid--empty {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .orcid__prompt {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  /* ---------- Fields / forms ---------- */
  .field {
    display: grid;
    gap: var(--space-2);
  }
  .field__label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  .field__req,
  .field__opt {
    font-weight: var(--fw-regular);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .field__req {
    color: var(--color-warning);
  }
  .field__input {
    inline-size: 100%;
    min-block-size: 40px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
    font: inherit;
    font-size: var(--fs-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field__input:focus-visible {
    outline: none;
    border-color: var(--brand-teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-teal) 18%, transparent);
  }
  .field__input--code {
    font-family: var(--font-mono);
    letter-spacing: 0.4em;
    text-align: center;
  }
  .field__input--textarea {
    min-block-size: 6rem;
    padding: var(--space-3);
    resize: vertical;
    line-height: var(--lh-normal);
  }
  .field__input[aria-invalid="true"] {
    border-color: var(--color-danger);
  }
  .field__prefixed {
    display: flex;
    align-items: stretch;
  }
  .field__prefix {
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-inline-end: none;
    border-start-start-radius: var(--radius-md);
    border-end-start-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
  .field__prefixed .field__input {
    border-start-start-radius: 0;
    border-end-start-radius: 0;
  }
  .profile {
    display: grid;
    gap: var(--space-4);
  }
  .profile__grid2 {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 420px) {
    .profile__grid2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------- Inline flows / confirms ---------- */
  .flow {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-3);
  }
  .flow__hint {
    margin: 0;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
  }
  .flow__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    align-items: center;
  }
  .flow__actions--end {
    justify-content: flex-end;
  }
  .flow__msg {
    margin: 0;
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }
  .flow__msg[data-tone="error"] {
    color: var(--color-danger);
  }
  .flow__msg[data-tone="success"] {
    color: var(--color-success);
  }
  /* Relink confirm submits a real form POST (nemar-cli ADR 0022: relink
     intent must be minted by an Origin-carrying POST, not a link). Keep the
     button participating in .flow__actions' layout as before. */
  .confirm__form {
    display: contents;
  }
  .confirm {
    margin-block-start: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    display: grid;
    gap: var(--space-3);
  }
  .confirm--danger {
    border-color: color-mix(in srgb, var(--color-danger) 38%, transparent);
    background: color-mix(in srgb, var(--color-danger) 6%, var(--color-bg));
  }
  .confirm__text {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg);
    line-height: var(--lh-normal);
  }
  .notice {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  .notice--warn {
    background: color-mix(in srgb, var(--color-warning) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: color-mix(in srgb, var(--color-warning) 82%, var(--color-fg));
  }
  .notice__title {
    margin: 0 0 var(--space-2);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .notice__body {
    margin: 0 0 var(--space-3);
    color: var(--color-fg);
    line-height: var(--lh-relaxed);
  }
  .notice__body:last-of-type {
    margin-block-end: var(--space-4);
  }
  .notice__body a {
    color: var(--color-link);
  }

  /* ---------- Badges ---------- */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-fg);
  }
  .badge--admin {
    background: color-mix(in srgb, var(--brand-purple) 14%, transparent);
    border-color: color-mix(in srgb, var(--brand-purple) 35%, transparent);
    color: var(--brand-purple);
  }
  .badge--user {
    background: color-mix(in srgb, var(--brand-teal) 14%, transparent);
    border-color: color-mix(in srgb, var(--brand-teal) 35%, transparent);
    color: color-mix(in srgb, var(--brand-teal) 80%, var(--color-fg));
  }
  /* Tier pills (#301). Base access is a working account, so it reads as
     informational teal rather than the amber "something is pending" tone;
     only the unverified tier — the one with an action attached — is amber. */
  .badge--tier-upload {
    background: color-mix(in srgb, var(--color-success) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
    color: var(--color-success);
  }
  .badge--tier-base {
    background: color-mix(in srgb, var(--brand-teal) 14%, transparent);
    border-color: color-mix(in srgb, var(--brand-teal) 35%, transparent);
    color: color-mix(in srgb, var(--brand-teal) 80%, var(--color-fg));
  }
  .badge--tier-unverified {
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-warning);
  }

  /* ---------- Upload access ---------- */
  .upload-access__body {
    margin: var(--space-3) 0 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    max-inline-size: 62ch;
  }
  .upload-access__body a,
  .upload-access__footnote a {
    color: var(--color-link);
  }
  .upload-access__form {
    margin-block-start: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }
  /* The gap list at the top of the account card (website#309). Neutral, not
     amber: nothing has failed, and the same list renders for a brand-new
     account that has done nothing wrong. */
  .gaps {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--brand-teal);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
  }
  .gaps__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .gaps__list {
    margin: 0;
    padding: 0 0 0 var(--space-4);
    display: grid;
    gap: var(--space-1);
    list-style: disc;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    /* The sentences carry a backticked command, which has no break
       opportunity of its own on a narrow screen. */
    overflow-wrap: anywhere;
  }
  .gaps__list a {
    color: var(--color-link);
    font-weight: var(--fw-semibold);
  }
  .gaps__field {
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .gaps__none {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .upload-access__missing {
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }
  .upload-access__missing[hidden] {
    display: none;
  }
  .upload-access__missing-title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .upload-access__missing-list {
    margin: 0;
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    /* Full sentences since website#309, one carrying a backticked command:
       let them wrap anywhere rather than widening the card. */
    overflow-wrap: anywhere;
  }
  .upload-access__missing-list a {
    color: var(--color-link);
    font-weight: var(--fw-semibold);
  }
  .upload-access__footnote {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }

  .badge--status-active {
    background: color-mix(in srgb, var(--color-success) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
    color: var(--color-success);
  }
  .badge--status-pending {
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-warning);
  }
  .badge--status-disabled {
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-danger) 35%, transparent);
    color: var(--color-danger);
  }

  /* ---------- Theme picker ---------- */
  .theme-picker {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    border: none;
    padding: 0;
    margin: 0;
  }
  .theme-option {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    background: var(--color-bg);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .theme-option:hover {
    border-color: var(--brand-teal);
  }
  .theme-option:has(input:checked) {
    border-color: var(--brand-teal);
    background: color-mix(in srgb, var(--brand-teal) 8%, var(--color-bg));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-teal) 18%, transparent);
  }
  .theme-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .theme-option__swatch {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
  .theme-option__swatch--light {
    background: linear-gradient(135deg, #ffffff 0%, #eef3fb 100%);
  }
  .theme-option__swatch--dark {
    background: linear-gradient(135deg, #060d24 0%, #18254a 100%);
  }
  .theme-option__swatch--system {
    background:
      linear-gradient(135deg, #ffffff 0%, #ffffff 50%, #060d24 50%, #060d24 100%);
  }
  .theme-option__label {
    font-size: var(--fs-sm);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    text-align: center;
  }

  /* ---------- Consent ---------- */
  .consent {
    display: grid;
    gap: var(--space-4);
  }
  .consent__current {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
  }
  .consent__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    font-weight: var(--fw-semibold);
  }
  .consent__value {
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  .consent__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .consent__note {
    margin: 0;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  /* ---------- Buttons ---------- */
  .btn {
    min-block-size: 40px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .btn--primary {
    background: var(--brand-navy);
    color: #f8fafc;
    border-color: var(--brand-navy);
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--brand-navy) 84%, var(--brand-teal));
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand-teal) 18%, transparent);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }
  .btn--ghost:hover {
    border-color: var(--color-fg-muted);
    background: var(--color-bg-subtle);
  }
  .btn--danger {
    background: var(--color-bg);
    color: var(--color-danger);
    border-color: color-mix(in srgb, var(--color-danger) 38%, transparent);
  }
  .btn--danger:hover {
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border-color: var(--color-danger);
  }

  .signout-form {
    margin: 0;
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { AccountApiError, requestUploadAccess } from "../lib/account-api";
  import {
    profileErrorMessage,
    uploadAccessErrorMessage,
    validateUsername,
    validateWhy,
  } from "../lib/account-tier";
  import { describeGap, gapTail, gapsForFields } from "../lib/profile-gaps";

  // ---- Small helpers ----
  const $ = <T extends HTMLElement>(sel: string): T | null => document.querySelector<T>(sel);

  function setMsg(el: HTMLElement | null, text: string, tone: "error" | "success"): void {
    if (!el) return;
    el.textContent = text;
    el.dataset.tone = tone;
    el.hidden = false;
  }
  function clearMsg(el: HTMLElement | null): void {
    if (!el) return;
    el.hidden = true;
    el.textContent = "";
  }

  // Map a failed mutation response to human copy. A 404 means the backend
  // endpoint isn't deployed yet (these ship ahead of nemar-cli); say so plainly
  // rather than showing a raw error.
  function messageForStatus(status: number, code?: string): string {
    if (status === 404 || status === 501) return "This isn't available yet — check back soon.";
    if (status === 401) return "Your session expired. Sign in again.";
    if (status === 409 && code === "same_email") return "That's already your email address.";
    if (status === 409) return "That's already in use on another account.";
    if (status === 429) return "Too many attempts. Wait a few minutes and try again.";
    if (code === "invalid_github_username") return "That GitHub handle looks invalid.";
    if (status >= 500) return "The server had a problem. Try again in a moment.";
    return "Something went wrong. Please try again.";
  }

  async function readCode(res: Response): Promise<string | undefined> {
    try {
      const data = (await res.clone().json()) as { error?: string };
      return typeof data.error === "string" ? data.error : undefined;
    } catch {
      return undefined;
    }
  }

  /** The backend's `{ error, message }` pair off a failed PATCH. Both halves,
   *  because `profileErrorMessage` prefers the sentence the backend wrote
   *  (only it knows which handle was taken) and falls back to the code. */
  async function readProfileError(
    res: Response,
  ): Promise<{ code?: string; message?: string }> {
    try {
      const data = (await res.clone().json()) as { error?: string; message?: string };
      return {
        code: typeof data.error === "string" ? data.error : undefined,
        message: typeof data.message === "string" ? data.message : undefined,
      };
    } catch {
      return {};
    }
  }

  /** PATCH a sparse profile update and reload on success. Shared by the
   *  username and name flows so they cannot drift on error handling. */
  async function patchProfile(
    payload: Record<string, string>,
    msgEl: HTMLElement | null,
    onFieldError?: (code: string | undefined, text: string) => boolean,
  ): Promise<void> {
    const res = await fetch("/api/auth/profile", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      const { code, message } = await readProfileError(res);
      const text = profileErrorMessage(res.status, code, message);
      if (onFieldError?.(code, text)) return;
      setMsg(msgEl, text, "error");
      return;
    }
    setMsg(msgEl, "Saved. Reloading…", "success");
    setTimeout(() => location.reload(), 700);
  }

  // ================= Email change (#133) =================
  (() => {
    const toggle = $("[data-email-toggle]");
    const flow = $("[data-email-flow]");
    const stepReq = $<HTMLElement>('[data-email-step="request"]');
    const stepVerify = $<HTMLElement>('[data-email-step="verify"]');
    const input = $<HTMLInputElement>("[data-email-input]");
    const codeInput = $<HTMLInputElement>("[data-email-code]");
    const target = $("[data-email-target]");
    const msg = $("[data-email-msg]");
    if (!toggle || !flow || !stepReq || !stepVerify || !input || !codeInput) return;

    let pendingEmail = "";
    const emailRe = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

    const showStep = (which: "request" | "verify"): void => {
      stepReq.hidden = which !== "request";
      stepVerify.hidden = which !== "verify";
    };
    const openFlow = (): void => {
      flow.hidden = false;
      showStep("request");
      clearMsg(msg);
      input.focus();
    };
    const closeFlow = (): void => {
      flow.hidden = true;
      input.value = "";
      codeInput.value = "";
      clearMsg(msg);
    };

    toggle.addEventListener("click", () => (flow.hidden ? openFlow() : closeFlow()));
    $("[data-email-cancel]")?.addEventListener("click", closeFlow);
    $("[data-email-back]")?.addEventListener("click", () => {
      clearMsg(msg);
      showStep("request");
    });

    $("[data-email-send]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const value = input.value.trim().toLowerCase();
      if (!emailRe.test(value)) {
        setMsg(msg, "Enter a valid email address.", "error");
        return;
      }
      btn.disabled = true;
      clearMsg(msg);
      try {
        const res = await fetch("/api/auth/email/change/request", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ email: value }),
        });
        if (!res.ok) {
          setMsg(msg, messageForStatus(res.status, await readCode(res)), "error");
          return;
        }
        pendingEmail = value;
        if (target) target.textContent = value;
        showStep("verify");
        codeInput.focus();
      } catch {
        setMsg(msg, "Network error. Check your connection.", "error");
      } finally {
        btn.disabled = false;
      }
    });

    $("[data-email-verify]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const code = codeInput.value.replace(/\D/g, "");
      if (!/^\d{6}$/.test(code)) {
        setMsg(msg, "Enter the 6-digit code.", "error");
        return;
      }
      btn.disabled = true;
      clearMsg(msg);
      try {
        const res = await fetch("/api/auth/email/change/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ email: pendingEmail, code }),
        });
        if (!res.ok) {
          const codeErr = await readCode(res);
          const text =
            res.status === 401
              ? "That code didn't match, or it expired. Request a new one."
              : messageForStatus(res.status, codeErr);
          setMsg(msg, text, "error");
          return;
        }
        setMsg(msg, "Email updated. Reloading…", "success");
        setTimeout(() => location.reload(), 900);
      } catch {
        setMsg(msg, "Network error. Check your connection.", "error");
      } finally {
        btn.disabled = false;
      }
    });
  })();

  // ================= Username (#301) =================
  (() => {
    const toggle = $("[data-username-toggle]");
    const flow = $("[data-username-flow]");
    const input = $<HTMLInputElement>("[data-username-input]");
    const msg = $("[data-username-msg]");
    if (!toggle || !flow || !input) return;

    const original = input.value;
    toggle.addEventListener("click", () => {
      flow.hidden = !flow.hidden;
      clearMsg(msg);
      if (!flow.hidden) input.focus();
    });
    $("[data-username-cancel]")?.addEventListener("click", () => {
      input.value = original;
      input.removeAttribute("aria-invalid");
      flow.hidden = true;
      clearMsg(msg);
    });

    $("[data-username-save]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const value = input.value.trim();
      // Same rule the backend applies, so a malformed handle never costs a
      // round trip. Uniqueness is not checkable here — nothing reserves a
      // name — so `username_taken` still has to be handled below.
      const problem = validateUsername(value);
      if (problem) {
        input.setAttribute("aria-invalid", "true");
        setMsg(msg, problem.message, "error");
        return;
      }
      input.removeAttribute("aria-invalid");
      btn.disabled = true;
      clearMsg(msg);
      try {
        await patchProfile({ username: value }, msg, (code, text) => {
          if (code !== "username_taken" && code !== "username_locked") return false;
          input.setAttribute("aria-invalid", "true");
          setMsg(msg, text, "error");
          input.focus();
          input.select();
          return true;
        });
      } catch {
        setMsg(msg, "Network error. Check your connection.", "error");
      } finally {
        btn.disabled = false;
      }
    });
  })();

  // ================= Name (#301) =================
  // Only mounted when no verified ORCID iD is linked — with one the fields
  // are not rendered at all, because the backend refuses the edit and the
  // record would overwrite it on the next sign-in anyway.
  (() => {
    const toggle = $("[data-name-toggle]");
    const flow = $("[data-name-flow]");
    const given = $<HTMLInputElement>("[data-name-given]");
    const family = $<HTMLInputElement>("[data-name-family]");
    const msg = $("[data-name-msg]");
    if (!toggle || !flow || !given || !family) return;

    const originals = { given: given.value, family: family.value };
    toggle.addEventListener("click", () => {
      flow.hidden = !flow.hidden;
      clearMsg(msg);
      if (!flow.hidden) given.focus();
    });
    $("[data-name-cancel]")?.addEventListener("click", () => {
      given.value = originals.given;
      family.value = originals.family;
      flow.hidden = true;
      clearMsg(msg);
    });

    $("[data-name-save]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const g = given.value.trim();
      const f = family.value.trim();
      // Both halves or neither: the backend refuses an empty one field by
      // field, and a DOI needs the pair.
      if (g.length === 0 || f.length === 0) {
        setMsg(msg, "Enter both a given name and a family name.", "error");
        return;
      }
      btn.disabled = true;
      clearMsg(msg);
      try {
        await patchProfile({ given_name: g, family_name: f }, msg);
      } catch {
        setMsg(msg, "Network error. Check your connection.", "error");
      } finally {
        btn.disabled = false;
      }
    });
  })();

  // ================= Upload access request (#301) =================
  (() => {
    const form = $<HTMLFormElement>("[data-upload-access-form]");
    if (!form) return;
    const why = $<HTMLTextAreaElement>("[data-upload-access-why]");
    const count = $("[data-upload-access-count]");
    const msg = $("[data-upload-access-msg]");
    const missingBox = $("[data-upload-access-missing]");
    const missingList = $("[data-upload-access-missing-list]");
    const submit = $<HTMLButtonElement>("[data-upload-access-submit]");

    const updateCount = (): void => {
      if (count && why) count.textContent = String(why.value.trim().length);
    };
    why?.addEventListener("input", updateCount);
    updateCount();

    const clearMissing = (): void => {
      if (missingBox) missingBox.hidden = true;
      if (missingList) missingList.textContent = "";
    };

    // A verified ORCID iD owns the name, so a refusal naming `given_name` /
    // `family_name` must point at orcid.org rather than at fields this
    // account does not get. The server rendered the answer onto the form.
    const orcidVerified = form.dataset.orcidVerified === "true";

    /** Render the refusal's `missing` array as one line per field: the label
     *  linked at the control that owns it, then the rest of `describeGap`'s
     *  sentence — what the field blocks and where it is set. Word for word
     *  what the dashboard nudge, `/upload` and `nemar auth status` print, so
     *  a user who has already read this once does not have to re-parse it.
     *  Entries with no Settings field of their own (`why` is the textarea
     *  above; `email_verified` has its own surface) render as plain text
     *  rather than as a link to nowhere. */
    const showMissing = (missing: readonly string[]): void => {
      if (!missingBox || !missingList || missing.length === 0) return;
      missingList.textContent = "";
      for (const gap of gapsForFields(missing, { orcidVerified })) {
        const li = document.createElement("li");
        if (gap.href) {
          const a = document.createElement("a");
          a.href = gap.href;
          a.textContent = gap.label;
          li.appendChild(a);
          // textContent, never innerHTML: the tail is our own copy, but the
          // label beside it is keyed off a backend-supplied field name.
          li.appendChild(document.createTextNode(` ${gapTail(gap)}`));
        } else {
          li.textContent = describeGap(gap);
        }
        missingList.appendChild(li);
      }
      missingBox.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearMsg(msg);
      clearMissing();
      const text = (why?.value ?? "").trim();
      const problem = validateWhy(text);
      if (problem) {
        why?.setAttribute("aria-invalid", "true");
        setMsg(msg, problem, "error");
        why?.focus();
        return;
      }
      why?.removeAttribute("aria-invalid");
      if (submit) submit.disabled = true;
      try {
        const result = await requestUploadAccess(text);
        setMsg(
          msg,
          result.already_requested
            ? "You already have a request open — an admin has it. Reloading…"
            : "Request sent. An admin will review it and email you. Reloading…",
          "success",
        );
        // The card's state changes, so re-render the page rather than
        // patching one badge.
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        const status = err instanceof AccountApiError ? err.status : 0;
        const code = err instanceof AccountApiError ? err.code : undefined;
        const detail = err instanceof AccountApiError ? err.message : undefined;
        setMsg(msg, uploadAccessErrorMessage(status, code, detail), "error");
        if (err instanceof AccountApiError) showMissing(err.missing);
        if (submit) submit.disabled = false;
      }
    });
  })();

  // ================= ORCID manage (#134) =================
  (() => {
    const relinkBtn = $("[data-orcid-relink]");
    const unlinkBtn = $("[data-orcid-unlink]");
    const relinkConfirm = $("[data-orcid-relink-confirm]");
    const unlinkConfirm = $("[data-orcid-unlink-confirm]");
    const msg = $("[data-orcid-msg]");

    const hideAll = (): void => {
      if (relinkConfirm) relinkConfirm.hidden = true;
      if (unlinkConfirm) unlinkConfirm.hidden = true;
    };
    relinkBtn?.addEventListener("click", () => {
      clearMsg(msg);
      hideAll();
      if (relinkConfirm) relinkConfirm.hidden = false;
    });
    unlinkBtn?.addEventListener("click", () => {
      clearMsg(msg);
      hideAll();
      if (unlinkConfirm) unlinkConfirm.hidden = false;
    });
    for (const c of document.querySelectorAll<HTMLButtonElement>("[data-confirm-cancel]")) {
      c.addEventListener("click", hideAll);
    }

    $("[data-orcid-unlink-do]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      clearMsg(msg);
      try {
        const res = await fetch("/api/auth/orcid/unlink", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
        });
        if (!res.ok) {
          setMsg(msg, messageForStatus(res.status, await readCode(res)), "error");
          btn.disabled = false;
          return;
        }
        setMsg(msg, "ORCID unlinked. Reloading…", "success");
        setTimeout(() => location.reload(), 900);
      } catch {
        setMsg(msg, "Network error. Check your connection.", "error");
        btn.disabled = false;
      }
    });
  })();

  // ================= Profile (#135) =================
  (() => {
    const form = $<HTMLFormElement>("[data-profile-form]");
    const msg = $("[data-profile-msg]");
    if (!form) return;
    const gh = $<HTMLInputElement>("[data-profile-github]");
    const city = $<HTMLInputElement>("[data-profile-city]");
    const country = $<HTMLInputElement>("[data-profile-country]");
    const affiliation = $<HTMLInputElement>("[data-profile-affiliation]");
    // Same rule as the server-side isValidGithubUsername.
    const ghRe = /^[a-zA-Z\d](?:[a-zA-Z\d]|-(?=[a-zA-Z\d])){0,38}$/;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = $<HTMLButtonElement>("[data-profile-save]");
      const handle = (gh?.value ?? "").trim().replace(/^@/, "");
      if (handle.length > 0 && !ghRe.test(handle)) {
        setMsg(msg, "That GitHub handle looks invalid.", "error");
        return;
      }
      const payload = {
        github_username: handle,
        city: (city?.value ?? "").trim(),
        country: (country?.value ?? "").trim(),
        affiliation: (affiliation?.value ?? "").trim(),
      };
      if (btn) btn.disabled = true;
      clearMsg(msg);
      try {
        const res = await fetch("/api/auth/profile", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          // `profileErrorMessage`, not `messageForStatus`: this PATCH can now
          // come back with `city_required` / `country_required` /
          // `github_in_use`, which the generic status map renders as
          // "Something went wrong" and this one names.
          const { code, message } = await readProfileError(res);
          setMsg(msg, profileErrorMessage(res.status, code, message), "error");
          return;
        }
        setMsg(msg, "Profile saved.", "success");
        // Clear the "required" notice if city + country are now present.
        if (payload.city && payload.country) {
          $("[data-profile-notice]")?.remove();
        }
      } catch {
        setMsg(msg, "Network error. Check your connection.", "error");
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  })();

  // ---- Theme picker ----
  // Reads the same `nemar:theme` localStorage key + `[data-theme]` attribute
  // that ThemeToggle / Base.astro use, so this settings surface stays in sync
  // with the nav-bar toggle without coordination.
  const THEME_KEY = "nemar:theme";

  function currentThemeChoice(): "light" | "dark" | "system" {
    try {
      const stored = localStorage.getItem(THEME_KEY);
      if (stored === "light" || stored === "dark") return stored;
    } catch {
      /* unavailable; fall through */
    }
    return "system";
  }

  function applyTheme(choice: "light" | "dark" | "system"): void {
    const root = document.documentElement;
    try {
      if (choice === "system") {
        localStorage.removeItem(THEME_KEY);
        root.removeAttribute("data-theme");
      } else {
        localStorage.setItem(THEME_KEY, choice);
        root.setAttribute("data-theme", choice);
      }
    } catch {
      // localStorage unavailable; still update the attribute so the page
      // reflects the choice for this session.
      if (choice === "system") root.removeAttribute("data-theme");
      else root.setAttribute("data-theme", choice);
    }
  }

  document.querySelectorAll<HTMLInputElement>("[data-theme-radio]").forEach((radio) => {
    if (radio.value === currentThemeChoice()) radio.checked = true;
    radio.addEventListener("change", () => {
      if (radio.checked) applyTheme(radio.value as "light" | "dark" | "system");
    });
  });

  // ---- Cookie consent ----
  const CONSENT_KEY = "nemar:cookie-consent";
  const currentEl = document.querySelector<HTMLElement>("[data-consent-current]");

  const labelFor = (v: string | null): string => {
    if (v === "accepted") return "Accepted (analytics enabled)";
    if (v === "strict") return "Strictly necessary only";
    return "Not chosen yet";
  };

  function refreshConsent(): void {
    if (!currentEl) return;
    let value: string | null = null;
    try {
      value = localStorage.getItem(CONSENT_KEY);
    } catch {
      /* fall through */
    }
    currentEl.textContent = labelFor(value);
  }

  refreshConsent();

  document.querySelectorAll<HTMLButtonElement>("[data-consent-set]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = btn.dataset.consentSet;
      if (next !== "accepted" && next !== "strict") return;
      try {
        localStorage.setItem(CONSENT_KEY, next);
      } catch {
        /* localStorage unavailable; nothing persists, but the label still updates for clarity */
      }
      refreshConsent();
    });
  });
</script>
