---
import { escapeJsonLdForScript } from "../lib/jsonld";
/**
 * The AI overview above Discover's results (board D2, website#518). The server renders only the
 * frame, hidden, and the request the overview is written from, as a JSON data island: Discover's
 * HTML is cached at the edge for everyone, so it cannot know who has AI Mode on, and the browser
 * posts the request to OSA only when the reader's preference is on (src/lib/ai-mode-search-client.ts).
 * The island is rendered only when a search ran, nothing failed, the page is the first and cards
 * exist (`overviewRequestForPage`), so a page without it has no panel.
 *
 * The polite live region, `[data-ai-status]`, is a visually hidden sibling of the section, never
 * inside it: the section is `hidden` (display: none, so out of the accessibility tree) until the
 * client shows it and carries `aria-busy` while the overview is written, and a status set in the
 * same tick the section appears would not be announced from there. The sibling is in the page from
 * the first paint, so a change to it is announced, and it is emptied when the panel is off so the
 * same words are announced again on the next switch on. The line beside the heading is a drawn
 * copy for sighted readers, `aria-hidden` so nothing is read twice. The body is filled by the
 * client with `textContent`, never HTML.
 */
import type { OverviewRequest } from "../lib/osa-overview";

interface Props {
  /** The request the overview is written from; null on a page that has none. */
  request: OverviewRequest | null;
  /** Page 2 and later: no overview, and a note (shown while AI Mode is on) says why. */
  pageNote?: boolean;
}

const { request, pageNote = false } = Astro.props;
const island = request ? escapeJsonLdForScript(JSON.stringify(request)) : "";
---

{request && (
  <>
    <div class="visually-hidden" role="status" aria-live="polite" data-ai-status></div>
    <section class="ai-overview" aria-label="AI overview" aria-busy="false" data-ai-overview hidden>
      <div class="ai-overview__head">
        <svg class="ai-overview__mark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" fill="currentColor"></path>
        </svg>
        <h2 class="ai-overview__title" tabindex="-1" data-ai-heading>AI overview</h2>
        <span class="ai-overview__status ai-overview__status--quiet" aria-hidden="true" data-ai-status-text></span>
        <span class="ai-overview__badge" data-ai-badge hidden>Experimental</span>
      </div>
      <div class="ai-overview__body" data-ai-body></div>
    </section>
    <script type="application/json" data-ai-overview-request set:html={island} is:inline />
  </>
)}
{pageNote && (
  <p class="ai-overview-note" data-ai-note hidden>
    The AI overview reads the first page of results. Go to page 1 to see it.
  </p>
)}

<style is:global>
  /* Global on purpose: the body is built by script, and Astro's scoped styles would not reach
     what the script creates. Every rule is under .ai-overview. */
  .ai-overview {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--ai-panel-border);
    border-radius: var(--radius-xl);
    background: var(--ai-panel-bg);
    color: var(--ai-panel-fg);
    margin-block-end: var(--space-4);
  }
  .ai-overview[hidden] {
    display: none;
  }
  .ai-overview-note {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-sm);
    color: var(--ai-panel-muted);
  }
  .ai-overview-note[hidden] {
    display: none;
  }
  .ai-overview__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .ai-overview__mark {
    flex: none;
    inline-size: 20px;
    block-size: 20px;
    color: var(--ai-panel-accent);
  }
  .ai-overview__title {
    margin: 0;
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--ai-panel-title);
  }
  .ai-overview__title:focus {
    outline: none;
  }
  .ai-overview__title:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .ai-overview__status {
    font-size: var(--fs-sm);
    color: var(--ai-panel-muted);
  }
  /* An answer is announced by the live region and draws nothing beside the heading. */
  .ai-overview__status--quiet {
    display: none;
  }
  .ai-overview__badge {
    margin-inline-start: auto;
    padding: 2px 6px;
    border: 1px solid var(--ai-panel-border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ai-panel-badge);
  }
  .ai-overview__badge[hidden] {
    display: none;
  }
  .ai-overview__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ai-overview__skeleton {
    block-size: 12px;
    margin-block: var(--space-1);
    border-radius: 6px;
    background: var(--ai-panel-skeleton-a);
  }
  .ai-overview__skeleton:nth-child(2) {
    background: var(--ai-panel-skeleton-b);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ai-overview[aria-busy="true"] .ai-overview__skeleton {
      animation: ai-overview-pulse 1.4s ease-in-out infinite;
    }
  }
  @keyframes ai-overview-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .ai-overview__summary {
    margin: 0;
    font-size: 14.5px;
    line-height: var(--lh-relaxed);
    overflow-wrap: anywhere;
  }
  .ai-overview__link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .ai-overview__link:hover {
    color: var(--color-link-hover);
  }
  .ai-overview__picks {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ai-overview__picks li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: 13.5px;
    line-height: 1.5;
    min-inline-size: 0;
  }
  .ai-overview__picks li span {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
  /* A pick reads as its title, then how it relates to the search, beside the id chip; the chip
     lines up with the title. */
  .ai-overview__pick {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ai-overview__pick-title {
    font-weight: var(--fw-semibold);
    color: var(--ai-panel-title);
  }
  .ai-overview__id {
    flex: none;
    padding: 1px 6px;
    border: 1px solid var(--ai-panel-chip-border);
    border-radius: var(--radius-sm);
    background: var(--ai-panel-chip-bg);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-link);
    text-decoration: none;
  }
  .ai-overview__id:hover {
    text-decoration: underline;
  }
  .ai-overview__foot {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--ai-panel-divider);
  }
  .ai-overview__note {
    flex: 1 1 14rem;
    font-size: var(--fs-xs);
    color: var(--ai-panel-muted);
  }
  .ai-overview__button {
    min-block-size: 38px;
    padding-inline: var(--space-4);
    border: 1px solid var(--ai-panel-action-bg);
    border-radius: var(--radius-pill);
    background: var(--ai-panel-action-bg);
    color: var(--ai-panel-action-fg);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }
  .ai-overview__button--quiet {
    align-self: flex-start;
    background: transparent;
    color: var(--ai-panel-accent);
  }
  .ai-overview__button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .ai-overview__error {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-sm);
    color: var(--ai-panel-fg);
  }
  /* The follow-up's failure note is a live region that is in the page empty, so it takes no room
     until it has words. */
  .ai-overview__failed {
    margin: var(--space-3) 0 0;
  }
  .ai-overview__failed:empty {
    margin: 0;
  }
</style>
