---
/**
 * The badge on a dataset card and in the admin publication queue.
 *
 * Four of the eight states describe a blocked request (website#304), because
 * "Validation failed" was only ever right for the blocks that mean the
 * DATASET failed a gate. `owner_name_missing` is an account property,
 * `validation_pending` is validation that has not finished rather than
 * failed, and `blocked` is what an unrecognised reason gets — see
 * `src/lib/publication-block.ts` for the mapping.
 */
import type { DatasetPublishState } from "../lib/dashboard-api";

interface Props {
  state: DatasetPublishState;
}

const { state } = Astro.props;

const LABELS: Record<DatasetPublishState, string> = {
  draft: "Draft",
  awaiting_review: "Awaiting review",
  published: "Published",
  validation_failed: "Validation failed",
  validation_pending: "Validation pending",
  name_required: "Name required",
  blocked: "Blocked",
  denied: "Denied",
};
const label = LABELS[state];
---

<span class:list={["publish-state-badge", `publish-state-badge--${state}`]}>
  {label}
</span>

<style>
  .publish-state-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    line-height: 1.5;
    font-weight: var(--fw-medium);
  }
  .publish-state-badge--draft {
    color: var(--color-fg-muted);
    background: var(--color-bg-subtle);
    border-color: var(--color-border);
  }
  .publish-state-badge--awaiting_review {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
  }
  .publish-state-badge--published {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
  }
  .publish-state-badge--validation_failed {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-danger) 35%, transparent);
  }
  /* Amber, not red: CI has not finished, so nothing has failed and there is
     nothing for the owner to do but wait. */
  .publish-state-badge--validation_pending {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
  }
  /* Amber, not red: nothing is broken and nothing failed — the account is
     one field short, and the owner fixes it in Settings in a minute. */
  .publish-state-badge--name_required {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
  }
  /* The reason is unknown to this build, so the tone says "stopped" without
     claiming a cause. */
  .publish-state-badge--blocked {
    color: var(--color-fg);
    background: var(--color-bg-subtle);
    border-color: var(--color-border-strong);
  }
  .publish-state-badge--denied {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-danger) 30%, transparent);
  }
</style>
