---
/**
 * Status pill for an admin user row/detail view, adapted to the users
 * lifecycle: pending, then verified, then approved or revoked.
 * `revoked_iam_pending` is a real backend value (a revoke whose IAM cleanup partially failed) — it
 * reads as "Revoked" with the same danger tone since the account access is
 * already gone.
 *
 * The labels name TIERS, not queue positions (website#301; nemar-cli ADR
 * 0040). `verified` used to read "Awaiting approval", which was true only
 * while approval was the thing every account was waiting for; it is now the
 * working base tier and most of the catalog sits there permanently. What an
 * admin has a queue of is open upload-access requests, which is a predicate
 * over two other columns — see `isAwaitingUploadApproval`.
 *
 * Drawn in the admin portal's badge language: an icon for the tone beside
 * the words, so the state never rests on color.
 */
import type { AdminUserStatus } from "../lib/users-admin-api";
import StatusIcon from "./admin/StatusIcon.astro";

interface Props {
  status: AdminUserStatus;
}

const { status } = Astro.props;

const LABELS: Record<AdminUserStatus, string> = {
  pending: "Email not verified",
  verified: "Base access",
  approved: "Upload access",
  revoked: "Revoked",
  revoked_iam_pending: "Revoked",
};
const TONES: Record<AdminUserStatus, "neutral" | "warning" | "success" | "danger"> = {
  // Amber for the one state with an outstanding action (the user's own), and
  // neutral for the base tier, which is a finished account rather than a
  // half-finished one.
  pending: "warning",
  verified: "neutral",
  approved: "success",
  revoked: "danger",
  revoked_iam_pending: "danger",
};
const label = LABELS[status];
const tone = TONES[status];
const ICONS = { neutral: "neutral", warning: "warn", success: "ok", danger: "error" } as const;
---

<span class:list={["user-status-badge", `user-status-badge--${tone}`]}>
  <StatusIcon name={ICONS[tone]} size={14} />
  <span>{label}</span>
</span>

<style>
  /* Same shape as admin/StatusBadge.astro and ImportStatusBadge.astro,
     duplicated per the scoped-style convention; keep them in sync. */
  .user-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    min-block-size: 1.5rem;
    padding: 0 var(--space-2) 0 7px;
    border-radius: var(--radius-pill);
    background: var(--admin-neutral-soft);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    white-space: nowrap;
  }
  .user-status-badge--warning {
    background: var(--admin-warn-soft);
    color: var(--admin-warn-text);
  }
  .user-status-badge--success {
    background: var(--admin-ok-soft);
    color: var(--admin-ok-text);
  }
  .user-status-badge--danger {
    background: var(--admin-error-soft);
    color: var(--admin-error-text);
  }
  @media (forced-colors: active) {
    .user-status-badge {
      border: 1px solid CanvasText;
    }
  }
</style>
