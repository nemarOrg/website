---
import type { HedSummary, QaAggregates } from "../lib/qa";
import AgeGenderChart from "./AgeGenderChart.astro";
import HedWordcloud from "./HedWordcloud.astro";
import HistogramChart from "./HistogramChart.astro";
import PipelineSuccessChart from "./PipelineSuccessChart.astro";

interface Props {
  aggregates: QaAggregates | null;
  hedSummary: HedSummary | null;
}

const { aggregates, hedSummary } = Astro.props;
const hasAnything = aggregates != null || hedSummary != null;
const hasDemographics = (aggregates?.demographics?.ages.length ?? 0) > 0;
---

{hasAnything && (
  <section class="qa" aria-labelledby="qa-title">
    <header class="qa__head">
      <h2 id="qa-title">Data quality</h2>
      <p class="qa__hint">
        Computed by the NEMAR processing pipeline. Snapshots reflect the
        most recent run, not a specific dataset version.
      </p>
    </header>

    {aggregates && (
      <div class="qa__grid">
        <PipelineSuccessChart status={aggregates.pipelineStatus} total={aggregates.files} />
        <HistogramChart
          title="Data frames retained"
          values={aggregates.goodDataPercent}
          domain={[0, 100]}
          unit="%"
          fill="var(--modality-eeg)"
        />
        <HistogramChart
          title="Channels retained"
          values={aggregates.goodChansPercent}
          domain={[0, 100]}
          unit="%"
          fill="var(--brand-teal)"
        />
        <HistogramChart
          title="Line-noise magnitude"
          values={aggregates.linenoiseDb}
          unit=" dB"
          fill="var(--modality-meg)"
        />
        {hasDemographics && aggregates.demographics && (
          <div class="qa__wide">
            <AgeGenderChart ages={aggregates.demographics.ages} sexes={aggregates.demographics.sexes} />
          </div>
        )}
      </div>
    )}

    {hedSummary && (
      <div class="qa__hed">
        <HedWordcloud summary={hedSummary} />
      </div>
    )}
  </section>
)}

<style>
  .qa {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .qa__head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    color: var(--color-fg);
    margin: 0 0 var(--space-2);
  }
  .qa__hint {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    margin: 0;
    max-inline-size: 60ch;
    line-height: var(--lh-relaxed);
  }
  .qa__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .qa__wide {
    grid-column: 1 / -1;
  }
  @media (max-width: 640px) {
    .qa__grid {
      grid-template-columns: 1fr;
    }
  }
  .qa__hed {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-5);
  }
</style>
