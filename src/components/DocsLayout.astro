---
import Base from "../layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  /** The slug of the current page; matches the `slug` field in the doc index. */
  active?: string;
}

const { title, description, active } = Astro.props;

const docs: { slug: string; label: string; href: string }[] = [
  { slug: "getting-started", label: "Getting started", href: "/docs/getting-started" },
  { slug: "upload", label: "Uploading a dataset", href: "/docs/upload" },
  { slug: "managing-datasets", label: "Managing your datasets", href: "/docs/managing-datasets" },
  { slug: "publishing", label: "Publication review", href: "/docs/publishing" },
  { slug: "cli-vs-web", label: "CLI vs the web", href: "/docs/cli-vs-web" },
];
---

<Base title={title} description={description}>
  <section class="docs-shell">
    <aside class="docs-sidebar" aria-label="Docs navigation">
      <p class="docs-sidebar__heading">NEMAR docs</p>
      <ul class="docs-sidebar__list">
        {docs.map((d) => (
          <li>
            <a
              class:list={["docs-sidebar__link", { "docs-sidebar__link--active": d.slug === active }]}
              href={d.href}
            >
              {d.label}
            </a>
          </li>
        ))}
      </ul>
    </aside>
    <article class="docs-content">
      <header class="docs-content__header">
        <p class="docs-content__crumbs">
          <a href="/docs">Docs</a> / <span>{title.replace(/^Docs - /, "")}</span>
        </p>
        <h1 class="docs-content__title">{title.replace(/^Docs - /, "")}</h1>
      </header>
      <div class="docs-content__body">
        <slot />
      </div>
    </article>
  </section>
</Base>

<style>
  .docs-shell {
    max-inline-size: 72rem;
    margin: 0 auto;
    padding: var(--space-10) var(--space-4) var(--space-16);
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--space-8);
  }
  @media (max-width: 768px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }
  }
  .docs-sidebar {
    position: sticky;
    inset-block-start: var(--space-6);
    align-self: start;
    display: grid;
    gap: var(--space-2);
  }
  .docs-sidebar__heading {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
  }
  .docs-sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .docs-sidebar__link {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .docs-sidebar__link:hover {
    background: var(--color-bg-elevated);
    color: var(--color-fg);
  }
  .docs-sidebar__link--active {
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    font-weight: var(--fw-semibold);
  }
  .docs-content {
    min-inline-size: 0;
  }
  .docs-content__header {
    margin-block-end: var(--space-6);
  }
  .docs-content__crumbs {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .docs-content__crumbs a {
    color: var(--color-link);
  }
  .docs-content__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
  }
  .docs-content__body {
    max-inline-size: 42rem;
    line-height: var(--lh-relaxed);
  }
  .docs-content__body h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    margin-block: var(--space-6) var(--space-3);
  }
  .docs-content__body h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    margin-block: var(--space-5) var(--space-2);
  }
  .docs-content__body p {
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-4);
  }
  .docs-content__body a {
    color: var(--color-link);
  }
  .docs-content__body ul,
  .docs-content__body ol {
    color: var(--color-fg-muted);
    padding-inline-start: var(--space-5);
    margin: 0 0 var(--space-4);
  }
  .docs-content__body li {
    margin-block-end: var(--space-2);
  }
  .docs-content__body code {
    font-family: var(--font-mono);
    background: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.92em;
  }
  .docs-content__body pre {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-4);
  }
  .docs-content__body pre code {
    background: transparent;
    padding: 0;
  }
  .docs-content__body blockquote {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid var(--brand-teal);
    background: var(--color-bg-elevated);
    color: var(--color-fg-muted);
  }
</style>
