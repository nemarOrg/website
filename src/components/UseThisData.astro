---
/**
 * HTML renderer for the "Use this data" model (website#284 phase 2). Reads
 * only `model.sections` -- see src/lib/use-this-data.ts for the ONE MODEL,
 * TWO RENDERERS contract this and `renderUseThisDataMarkdown` both honor.
 * No hidden text, no display:none agent-only content: everything here also
 * appears in the `.md` mirror, and everything the mirror says is visible
 * here (OSCAR parity).
 *
 * COLLAPSED BY DEFAULT (`<details>`), and that is a placement fix rather than
 * a parity compromise. Expanded, this block runs to ten download and Zarr
 * steps, which on production pushed the README and the file tree roughly two
 * screens down and made the agent-facing material the first thing a human
 * read. A disclosure keeps every string in the server-rendered payload -- the
 * only thing agents fetch, and the reason this section exists -- while giving
 * a human one line to open. That is the opposite of the cloaking OSCAR's
 * principles forbid: nothing is shown to a crawler that a human cannot see by
 * clicking once, and nothing is hidden with `display: none` or off-screen
 * positioning. Do NOT switch this to `open` by default without re-checking
 * how far it pushes the README on a dataset with many references.
 *
 * SIZED AS AN ENDNOTE, NOT A CARD (website#300). #297 fixed placement
 * (collapsed, last in the content column) but left the summary line styled
 * like a headline -- `--fs-xl` semibold on an elevated card, the same visual
 * weight as the README card above it -- so even collapsed it still competed
 * with the human-facing content. The summary is now plain small text under a
 * hairline rule, sized with the same tokens the body already used
 * (`--fs-sm`/`--fs-xs`, both below `--fs-base`): a human notices it if they
 * look, an agent reads the identical server-rendered strings regardless of
 * font size.
 */
import type { UseThisData } from "../lib/use-this-data";

interface Props {
  model: UseThisData;
}

const { model } = Astro.props;
---

<details class="use-this-data">
  <summary class="use-this-data__summary">
    <span class="use-this-data__summary-title">How to use the data (for agentic research)</span>
    <span class="use-this-data__summary-hint">license, citation, download commands{
      model.sections.some((s) => s.heading.toLowerCase().includes("zarr")) ? ", Zarr access" : ""
    }</span>
  </summary>
  <div class="use-this-data__body">
    {model.sections.map((section) => (
      <div class="use-this-data__section">
        <h3>{section.heading}</h3>
        {section.intro?.map((p) => <p class="use-this-data__intro">{p}</p>)}
        <dl class="use-this-data__list">
          {section.items.map((item) => (
            <div class="use-this-data__row">
              <dt>{item.label}</dt>
              <dd>
                {item.href ? (
                  <a href={item.href} rel="external">{item.value}</a>
                ) : item.code ? (
                  <code>{item.value}</code>
                ) : (
                  item.value
                )}
                {item.note && <span class="use-this-data__note">{item.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
</details>

<style>
  /* Hairline rule instead of a bordered/elevated card -- an endnote reads as
     a footer to the content above it, not as another card competing on the
     same visual plane as the README/BidsTree cards. */
  .use-this-data {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
  }
  .use-this-data__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-1);
    cursor: pointer;
  }
  /* The marker is the only affordance that this opens, so keep it. */
  .use-this-data__summary::marker,
  .use-this-data__summary::-webkit-details-marker {
    color: var(--color-fg-subtle);
  }
  /* One and two steps below --fs-base (1rem) -- the body already used these
     two tokens; the summary now matches instead of outsizing it. */
  .use-this-data__summary-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-fg-muted);
  }
  .use-this-data__summary-hint {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .use-this-data[open] .use-this-data__summary {
    margin-block-end: var(--space-4);
  }
  .use-this-data__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .use-this-data__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .use-this-data__section h3 {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: var(--fw-semibold);
    color: var(--color-fg-subtle);
  }
  .use-this-data__intro {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }
  .use-this-data__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }
  .use-this-data__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--fs-sm);
  }
  @media (max-width: 640px) {
    .use-this-data__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
  .use-this-data__row dt {
    color: var(--color-fg-subtle);
    font-weight: var(--fw-medium);
  }
  .use-this-data__row dd {
    margin: 0;
    color: var(--color-fg);
    overflow-wrap: anywhere;
  }
  .use-this-data__row a {
    color: var(--color-link);
  }
  .use-this-data__row a:hover {
    color: var(--color-link-hover);
  }
  .use-this-data__row code {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    background: var(--color-bg-subtle);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .use-this-data__note {
    display: block;
    margin-block-start: var(--space-1);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    line-height: var(--lh-relaxed);
  }
</style>
