---
import type { Dataset } from "../lib/types";
import { formatBytes, formatDate, splitModalities } from "../lib/format";
import ModalityBadge from "./ModalityBadge.astro";

interface Props {
  dataset: Dataset;
}

const { dataset } = Astro.props;
const modalities = splitModalities(dataset.modalities);
const owner = dataset.owner_username ?? "NEMAR";
const openneuroId = dataset.source === "openneuro" ? dataset.source_id : null;
const detailHref = `/dataset/${encodeURIComponent(dataset.dataset_id)}`;
---

<article class="ds-card">
  <header class="ds-card__head">
    <a class="ds-card__title" href={detailHref}>
      <span class="ds-card__id">{dataset.dataset_id}</span>
      <h3 class="ds-card__name">{dataset.name}</h3>
    </a>
    {modalities.length > 0 && (
      <div class="ds-card__mods">
        {modalities.map((m) => <ModalityBadge modality={m} />)}
      </div>
    )}
  </header>

  {dataset.description && (
    <p class="ds-card__desc">{dataset.description}</p>
  )}

  <dl class="ds-card__facts">
    <div>
      <dt>Participants</dt>
      <dd>{dataset.participants || "—"}</dd>
    </div>
    <div>
      <dt>Size</dt>
      <dd>{dataset.file_size > 0 ? formatBytes(dataset.file_size) : "—"}</dd>
    </div>
    <div>
      <dt>Version</dt>
      <dd>{dataset.latest_version ?? "—"}</dd>
    </div>
    <div>
      <dt>Updated</dt>
      <dd>{formatDate(dataset.updated_at)}</dd>
    </div>
  </dl>

  <footer class="ds-card__foot">
    <span class="ds-card__owner">by {owner}</span>
    {openneuroId && (
      <span class="ds-card__source">
        <a href={`https://openneuro.org/datasets/${openneuroId}`} rel="external">OpenNeuro {openneuroId}</a>
      </span>
    )}
  </footer>
</article>

<style>
  .ds-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ds-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }
  .ds-card__head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
  }
  .ds-card__title {
    color: var(--color-fg);
    text-decoration: none;
  }
  .ds-card__title:hover {
    color: var(--color-fg);
    text-decoration: none;
  }
  .ds-card__title:hover .ds-card__name {
    color: var(--color-link);
  }
  .ds-card__id {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    letter-spacing: 0.04em;
  }
  .ds-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
    margin: 0;
    line-height: var(--lh-snug);
    transition: color 0.15s ease;
  }
  .ds-card__mods {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    justify-content: flex-end;
  }
  .ds-card__desc {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ds-card__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
  }
  .ds-card__facts dt {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ds-card__facts dd {
    margin: 0;
    margin-block-start: 2px;
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    color: var(--color-fg);
    font-size: var(--fs-sm);
  }
  .ds-card__foot {
    display: flex;
    justify-content: space-between;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    padding-block-start: var(--space-2);
  }
  @media (max-width: 540px) {
    .ds-card__head {
      grid-template-columns: 1fr;
    }
    .ds-card__mods {
      justify-content: flex-start;
    }
    .ds-card__facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
