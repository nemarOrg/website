---
/**
 * Full-screen modal host for the EEG/MEG/iEEG/EMG signal viewer
 * (website#199). Previously `mountEegViewer` mounted inline into a slot
 * inside the BIDS file tree row — cramped for a multi-channel scope with a
 * short time axis. This is a single, page-level dialog (one per dataset
 * page, sized ~70% of the viewport) that every "eeg" preview button opens;
 * the mount/teardown orchestration lives in dataset/[id].astro's script,
 * next to the click handler that already owns the rest of the file-preview
 * state machine.
 *
 * Deliberately outside `BidsTree.astro`'s `<section data-tree-defer>` — that
 * section's innerHTML is fully replaced during hydration and again on every
 * "show more" / subdirectory expand, which would destroy a dialog nested
 * inside it.
 *
 * No bottom "Close" button here (unlike ActionBar's dialogs): the viewer's
 * own toolbar already fills the available height, so a text button below it
 * would sit below the fold — exactly the discoverability problem the corner
 * X exists to fix. The corner X + Esc are the only exits, which is enough
 * for a full-viewport visualization surface.
 */
import DialogCloseButton from "./DialogCloseButton.astro";
---

<dialog class="eegv-dialog" data-eeg-dialog aria-label="Signal viewer">
  <DialogCloseButton />
  <div class="eegv-dialog__scroll">
    <h2 class="eegv-dialog__title" data-eegv-title>Signal viewer</h2>
    <div class="eegv-dialog__body" data-eegv-slot aria-live="polite"></div>
  </div>
</dialog>

<style>
  .eegv-dialog {
    inset: 0;
    margin: auto;
    /* "Roughly 70% of the viewport" (website#199), clamped so it never
       overflows a small screen and never balloons past a useful size on a
       huge one. Height is a cap, not a fixed size — a short "unavailable"
       message shouldn't leave a mostly-empty modal. */
    inline-size: min(70vw, 1400px);
    max-inline-size: calc(100vw - 2rem);
    min-inline-size: min(320px, calc(100vw - 2rem));
    /* `block-size: fit-content` is load-bearing, not decorative: a native
       <dialog> centered via `inset: 0` + `margin: auto` with `height: auto`
       (the default) stretches to fill all the way to max-block-size instead
       of shrinking to its content — confirmed by testing the "unavailable"
       fallback, which is short and otherwise left a big empty box under a
       two-line message. `fit-content` makes the box size to its content,
       still capped by max-block-size once the viewer is tall enough to hit it. */
    block-size: fit-content;
    max-block-size: min(70vh, 900px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    /* Same non-scrolling-shell + inner-scroll-wrapper split as ActionBar's
       dialogs, so the corner close button stays pinned regardless of how
       tall the mounted viewer (or its "unavailable" fallback) ends up. */
    padding: 0;
    overflow: hidden;
  }
  /* `display: flex` must be gated on `[open]`, not live on the bare
     `.eegv-dialog` selector — see ActionBar.astro's `.compute-dialog[open]`
     comment. A bare class-selector `display` value outranks the UA's
     plain-element `dialog { display: none }` and un-hides the dialog while
     closed. */
  .eegv-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .eegv-dialog::backdrop {
    background: rgb(15 23 42 / 55%);
  }
  .eegv-dialog__scroll {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    padding: var(--space-6);
  }
  .eegv-dialog__title {
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-4);
    padding-inline-end: var(--dialog-x-clearance);
  }
  /* A small floor, not a target: enough that a one-line message doesn't
     read as a rendering glitch, small enough that the "unavailable"
     fallback (a couple of lines of text) doesn't leave a large dead area
     now that .eegv-dialog sizes to fit-content (see the comment above). */
  .eegv-dialog__body {
    min-block-size: 48px;
  }
</style>
