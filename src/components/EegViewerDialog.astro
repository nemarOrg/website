---
/**
 * Enlarged host for the EEG/MEG/iEEG/EMG signal viewer.
 *
 * The viewer opens *inline*, in the clicked BIDS tree row's own preview
 * panel; this dialog is where it goes when the user asks for more room via
 * the panel's "Enlarge" control (website#217). Between #199 and #217 this
 * was the entry point — every signal file opened straight into it — which
 * turned a glance at a recording into a page takeover.
 *
 * It receives the *already-mounted* viewer host, moved here from the inline
 * panel and moved back on close; it never hosts a mount of its own. See
 * `enlargeEegViewer` in dataset/[id].astro, where the rest of the
 * file-preview state machine already lives.
 *
 * Deliberately outside `BidsTree.astro`'s `<section data-tree-defer>` — that
 * section's innerHTML is replaced wholesale during hydration, which would
 * destroy a dialog nested inside it.
 *
 * No bottom "Close" button here (unlike ActionBar's dialogs): the viewer
 * fills the available height, so a text button below it would sit below the
 * fold — exactly the discoverability problem the corner X exists to fix. The
 * corner X and Esc are the only exits, and both return the viewer inline.
 *
 * The header row also carries the recording-navigation controls (website#253)
 * — subject and task dropdowns plus prev/next. They live here, and only here,
 * because this is the surface with room for them: the inline panel sits under
 * one specific tree row, where controls that swap the recording would leave
 * the row's own label describing something else. The markup is static (and
 * hidden until populated) so Astro's scoped styles apply to it; the page
 * script fills the options and drives the swap.
 */
import DialogCloseButton from "./DialogCloseButton.astro";
---

<dialog class="eegv-dialog" data-eeg-dialog aria-label="Signal viewer">
  <DialogCloseButton />
  <div class="eegv-dialog__scroll">
    <div class="eegv-dialog__head">
      <h2 class="eegv-dialog__title" data-eegv-title>Signal viewer</h2>
      <div class="eegv-nav" data-eegv-nav hidden>
        <label class="eegv-nav__field" data-eegv-nav-sub-field>
          <span class="eegv-nav__label">Subject</span>
          <select class="eegv-nav__sel" data-eegv-nav-sub></select>
        </label>
        <label class="eegv-nav__field" data-eegv-nav-task-field>
          <span class="eegv-nav__label">Task</span>
          <select class="eegv-nav__sel" data-eegv-nav-task></select>
        </label>
        <div class="eegv-nav__steps">
          <button
            type="button"
            class="eegv-nav__btn"
            data-eegv-nav-prev
            title="Previous recording"
            aria-label="Previous recording">&lsaquo;</button>
          <span class="eegv-nav__pos" data-eegv-nav-pos aria-live="polite"></span>
          <button
            type="button"
            class="eegv-nav__btn"
            data-eegv-nav-next
            title="Next recording"
            aria-label="Next recording">&rsaquo;</button>
        </div>
      </div>
    </div>
    {/* No `aria-live` (dropped in website#217): what lands here is a live
        viewer, whose cursor readout and legend update continuously and would
        otherwise be announced on every pointer move. The "unavailable" and
        mount-failure messages never reach this slot at all — neither path
        renders an Enlarge control — though a mount still in flight when the
        user enlarges does briefly carry its "Loading viewer…" placeholder in
        with it. */}
    <div class="eegv-dialog__body" data-eegv-slot></div>
  </div>
</dialog>

<style>
  .eegv-dialog {
    inset: 0;
    margin: auto;
    /* Wider and taller than the ~70% of #199, because this is no longer the
       default surface: the user got here by explicitly asking for more room
       than the inline panel gives, so the jump should be worth the click.
       Still clamped, so it never overflows a small screen and never balloons
       past a useful size on a huge one. */
    inline-size: min(92vw, 1800px);
    max-inline-size: calc(100vw - 2rem);
    min-inline-size: min(320px, calc(100vw - 2rem));
    /* `block-size: fit-content` is load-bearing, not decorative: a native
       <dialog> centered via `inset: 0` + `margin: auto` with `height: auto`
       (the default) stretches all the way to max-block-size instead of
       shrinking to its content. The viewer derives its height from its width,
       so without this a wide-but-short scope would sit at the top of a mostly
       empty box. `fit-content` sizes to the viewer, still capped by
       max-block-size once it is tall enough to hit it. */
    block-size: fit-content;
    max-block-size: min(90vh, 1100px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    /* Same non-scrolling-shell + inner-scroll-wrapper split as ActionBar's
       dialogs, so the corner close button stays pinned regardless of how
       tall the mounted viewer (or its "unavailable" fallback) ends up. */
    padding: 0;
    overflow: hidden;
  }
  /* `display: flex` must be gated on `[open]`, not live on the bare
     `.eegv-dialog` selector — see ActionBar.astro's `.compute-dialog[open]`
     comment. A bare class-selector `display` value outranks the UA's
     plain-element `dialog { display: none }` and un-hides the dialog while
     closed. */
  .eegv-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .eegv-dialog::backdrop {
    background: rgb(15 23 42 / 55%);
  }
  .eegv-dialog__scroll {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    padding: var(--space-6);
  }
  /* Title left, navigation right, wrapping to two rows on a narrow dialog so
     the controls never squeeze the recording name to an ellipsis. The X
     clearance moves here from the title: the nav controls are now what sits
     closest to the corner button. */
  .eegv-dialog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    padding-inline-end: var(--dialog-x-clearance);
  }
  .eegv-dialog__title {
    font-size: var(--fs-xl);
    margin: 0;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
  /* Recording navigation (website#253). Sized down from the title so it reads
     as chrome, not as a second heading. */
  .eegv-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-xs);
  }
  /* `display: flex` above outranks the `hidden` attribute's UA rule, so both
     the group and the per-entity fields need it restated. */
  .eegv-nav[hidden],
  .eegv-nav__field[hidden] {
    display: none;
  }
  .eegv-nav__field {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-fg-muted);
  }
  .eegv-nav__label {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .eegv-nav__sel {
    max-inline-size: 12rem;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-fg);
    font: inherit;
    font-size: var(--fs-xs);
  }
  .eegv-nav__steps {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .eegv-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 1.75rem;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    font: inherit;
    font-size: var(--fs-sm);
    line-height: 1;
    cursor: pointer;
  }
  .eegv-nav__btn:hover:not(:disabled) {
    color: var(--color-fg);
    border-color: var(--color-link);
  }
  .eegv-nav__btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .eegv-nav__sel:focus-visible,
  .eegv-nav__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* Fixed-ish width so the buttons don't shuffle sideways as the counter goes
     from "9 of 12" to "10 of 12" during a fast next/next/next. */
  .eegv-nav__pos {
    min-inline-size: 5.5rem;
    text-align: center;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }
  /* A floor, not a target: if the host arrives before its first paint (or a
     move races a repaint) the box shouldn't collapse to nothing and read as
     a rendering glitch. Small enough not to leave dead space now that
     .eegv-dialog sizes to fit-content (see the comment above). */
  .eegv-dialog__body {
    min-block-size: 48px;
  }
</style>
