---
/**
 * Enlarged host for the EEG/MEG/iEEG/EMG signal viewer.
 *
 * The viewer opens *inline*, in the clicked BIDS tree row's own preview
 * panel; this dialog is where it goes when the user asks for more room via
 * the panel's "Enlarge" control (website#217). Between #199 and #217 this
 * was the entry point — every signal file opened straight into it — which
 * turned a glance at a recording into a page takeover.
 *
 * It receives the *already-mounted* viewer host, moved here from the inline
 * panel and moved back on close; it never hosts a mount of its own. See
 * `enlargeEegViewer` in dataset/[id].astro, where the rest of the
 * file-preview state machine already lives.
 *
 * Deliberately outside `BidsTree.astro`'s `<section data-tree-defer>` — that
 * section's innerHTML is replaced wholesale during hydration, which would
 * destroy a dialog nested inside it.
 *
 * No bottom "Close" button here (unlike ActionBar's dialogs): the viewer
 * fills the available height, so a text button below it would sit below the
 * fold — exactly the discoverability problem the corner X exists to fix. The
 * corner X and Esc are the only exits, and both return the viewer inline.
 *
 * The header row also carries the recording-navigation controls (website#253)
 * — subject and task dropdowns plus prev/next. On the dataset page they live
 * here, and only here, because this is the surface with room for them: the
 * inline panel sits under one specific tree row, where controls that swap the
 * recording would leave the row's own label describing something else. The
 * markup is `EegViewerNav.astro`, shared with the embed route (website#410);
 * it is static (and hidden until populated) so Astro's scoped styles apply to
 * it, and the page script fills the options and drives the swap.
 */
import DialogCloseButton from "./DialogCloseButton.astro";
import EegViewerNav from "./EegViewerNav.astro";
---

<dialog class="eegv-dialog" data-eeg-dialog aria-label="Signal viewer">
  <DialogCloseButton />
  <div class="eegv-dialog__scroll">
    <div class="eegv-dialog__head">
      <h2 class="eegv-dialog__title" data-eegv-title>Signal viewer</h2>
      <EegViewerNav />
      {/* Copy link (website#326). A SIBLING of `.eegv-nav`, not a child of it:
          the nav group hides itself for a dataset with fewer than two
          recordings, and such a dataset is precisely one whose single recording
          someone might want to link to. Its own visibility follows "a live
          viewer is in the dialog", which is a weaker condition.

          The page keeps `?view=` in the address bar as the user navigates, so
          this control is a convenience rather than the only route to a link —
          which is what makes "the link is in the address bar" an honest
          fallback when the Clipboard API is missing (an insecure context) or
          refuses. The live region is separate from the button's own label so
          the label never changes out from under a screen reader mid-press.

          Embed (website#410) copies an <iframe> snippet for the recording on
          screen, for a partner site. It shares the live region. Unlike the
          link, the snippet is nowhere else on the page, so a refused clipboard
          reveals it in the read-only textarea below, pre-selected for a
          manual copy; the session hides it again on the next navigation. */}
      <div class="eegv-share" data-eegv-share hidden>
        <button
          type="button"
          class="eegv-nav__btn eegv-nav__btn--wide"
          data-eegv-copy-link
          title="Copy a link that opens this recording"
          aria-describedby="eegv-copy-status">Copy link</button>
        <button
          type="button"
          class="eegv-nav__btn eegv-nav__btn--wide"
          data-eegv-copy-embed
          title="Copy code that embeds this recording's viewer in another site"
          aria-describedby="eegv-copy-status">Embed</button>
        <span class="eegv-share__status" id="eegv-copy-status" data-eegv-copy-status role="status"
        ></span>
        <textarea
          class="eegv-share__code"
          data-eegv-embed-code
          aria-label="Embed code"
          readonly
          rows="3"
          spellcheck="false"
          hidden></textarea>
      </div>
    </div>
    {/* No `aria-live` (dropped in website#217): what lands here is a live
        viewer, whose cursor readout and legend update continuously and would
        otherwise be announced on every pointer move. The "unavailable" and
        mount-failure messages never reach this slot at all — neither path
        renders an Enlarge control — though a mount still in flight when the
        user enlarges does briefly carry its "Loading viewer…" placeholder in
        with it. */}
    <div class="eegv-dialog__body" data-eegv-slot></div>
  </div>
</dialog>

<style>
  .eegv-dialog {
    inset: 0;
    margin: auto;
    /* Wider and taller than the ~70% of #199, because this is no longer the
       default surface: the user got here by explicitly asking for more room
       than the inline panel gives, so the jump should be worth the click.
       Still clamped, so it never overflows a small screen and never balloons
       past a useful size on a huge one. */
    inline-size: min(92vw, 1800px);
    max-inline-size: calc(100vw - 2rem);
    min-inline-size: min(320px, calc(100vw - 2rem));
    /* `block-size: fit-content` is load-bearing, not decorative: a native
       <dialog> centered via `inset: 0` + `margin: auto` with `height: auto`
       (the default) stretches all the way to max-block-size instead of
       shrinking to its content. The viewer derives its height from its width,
       so without this a wide-but-short scope would sit at the top of a mostly
       empty box. `fit-content` sizes to the viewer, still capped by
       max-block-size once it is tall enough to hit it. */
    block-size: fit-content;
    max-block-size: min(90vh, 1100px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    /* Same non-scrolling-shell + inner-scroll-wrapper split as ActionBar's
       dialogs, so the corner close button stays pinned regardless of how
       tall the mounted viewer (or its "unavailable" fallback) ends up. */
    padding: 0;
    overflow: hidden;
  }
  /* `display: flex` must be gated on `[open]`, not live on the bare
     `.eegv-dialog` selector — see ActionBar.astro's `.compute-dialog[open]`
     comment. A bare class-selector `display` value outranks the UA's
     plain-element `dialog { display: none }` and un-hides the dialog while
     closed. */
  .eegv-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .eegv-dialog::backdrop {
    background: rgb(15 23 42 / 55%);
  }
  .eegv-dialog__scroll {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    padding: var(--space-6);
  }
  /* Title left, navigation right, wrapping to two rows on a narrow dialog so
     the controls never squeeze the recording name to an ellipsis. The X
     clearance moves here from the title: the nav controls are now what sits
     closest to the corner button. */
  .eegv-dialog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    padding-inline-end: var(--dialog-x-clearance);
  }
  .eegv-dialog__title {
    font-size: var(--fs-xl);
    margin: 0;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
  /* The share buttons below borrow the nav's button look. The nav itself
     (EegViewerNav.astro) carries the same `.eegv-nav__btn` rules for its
     prev/next buttons; keep the two in sync. Scoped styles do not cross
     component boundaries, so each component states its own copy (AGENTS.md,
     "Astro scoped <style> doesn't cross component boundaries"). */
  .eegv-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 1.75rem;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    font: inherit;
    font-size: var(--fs-sm);
    line-height: 1;
    cursor: pointer;
  }
  .eegv-nav__btn:hover:not(:disabled) {
    color: var(--color-fg);
    border-color: var(--color-link);
  }
  .eegv-nav__btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .eegv-nav__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* Copy link (website#326). Matches `.eegv-nav`'s chrome sizing so the head
     reads as one row of controls rather than two tiers. */
  .eegv-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
  }
  /* As with `.eegv-nav`: `display: flex` outranks the UA's `hidden` rule, so
     the hidden state has to be restated. */
  .eegv-share[hidden] {
    display: none;
  }
  /* Wider than the single-glyph step buttons because it holds a word. */
  .eegv-nav__btn--wide {
    padding-inline: var(--space-3);
    font-size: var(--fs-xs);
  }
  .eegv-share__status {
    color: var(--color-fg-muted);
  }
  /* The embed-code fallback takes a line of its own, and the share group the
     whole width of the head while it shows. */
  .eegv-share:has(> .eegv-share__code:not([hidden])) {
    flex-basis: 100%;
  }
  .eegv-share__code {
    flex-basis: 100%;
    inline-size: 100%;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    resize: vertical;
  }
  .eegv-share__code[hidden] {
    display: none;
  }
  /* Our own outline, not reset.css's box-shadow ring, which forced-colors
     mode drops. */
  .eegv-share__code:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* Takes no space while empty, so the button does not shift when a message
     appears and disappears. */
  .eegv-share__status:empty {
    display: none;
  }
  /* A floor, not a target: if the host arrives before its first paint (or a
     move races a repaint) the box shouldn't collapse to nothing and read as
     a rendering glitch. Small enough not to leave dead space now that
     .eegv-dialog sizes to fit-content (see the comment above). */
  .eegv-dialog__body {
    min-block-size: 48px;
  }
</style>
