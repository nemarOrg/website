---
interface Props {
  datasetId: string;
  version: string | null;
}

import { resolveDataBase } from "../lib/data-base";
// The signal viewer's global stylesheet. Imported here because the tree's
// rows are where the dataset page mounts the viewer; the embed route imports
// the same file (website#410). See the file's header for why it is global.
import "../styles/eeg-viewer.css";

const { datasetId, version } = Astro.props;
const dataBase = resolveDataBase();
const dataHost = new URL(dataBase).host;
---

{version ? (
  <section class="tree" aria-label="Dataset file tree" data-tree-defer data-id={datasetId} data-version={version} aria-busy="true">
    <header class="tree__head">
      <h2>Files</h2>
      <span class="tree__meta">Loading file index…</span>
    </header>
    <div class="tree__skeleton" aria-hidden="true">
      <div class="tree__skeleton-row"></div>
      <div class="tree__skeleton-row"></div>
      <div class="tree__skeleton-row"></div>
      <div class="tree__skeleton-row"></div>
      <div class="tree__skeleton-row"></div>
      <div class="tree__skeleton-row"></div>
      <div class="tree__skeleton-row"></div>
    </div>
    <noscript>
      <p style="padding: var(--space-5)">File tree requires JavaScript. <a href={`${dataBase}/${encodeURIComponent(datasetId)}/${encodeURIComponent(version)}/`} rel="external">View on {dataHost}</a>.</p>
    </noscript>
  </section>
) : (
  <section class="tree" aria-label="Dataset file tree">
    <header class="tree__head">
      <h2>Files</h2>
      <span class="tree__meta">No version selected</span>
    </header>
  </section>
)}

<style is:global>
  /* is:global because the tree HTML is rendered client-side from the JSON
     dir listing endpoint (data.nemar.org/<id>/<v>/?format=json) and injected
     into the section, so it doesn't carry Astro's component-scope data
     attribute. .tree__ prefix keeps collision risk low. */
  .tree {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    overflow: hidden;
  }
  .tree__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-block-end: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }
  .tree__head h2 {
    font-size: var(--fs-lg);
    color: var(--color-fg);
    margin: 0;
  }
  .tree__meta {
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .tree__skeleton {
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-5);
  }
  .tree__skeleton-row {
    block-size: 1.25em;
    margin-block: 8px;
    border-radius: var(--radius-sm);
    background: linear-gradient(
      90deg,
      var(--color-bg-subtle) 0%,
      var(--color-bg-elevated) 50%,
      var(--color-bg-subtle) 100%
    );
    background-size: 200% 100%;
    animation: tree-shimmer 1.4s ease-in-out infinite;
  }
  .tree__skeleton-row:nth-child(1) { inline-size: 45%; }
  .tree__skeleton-row:nth-child(2) { inline-size: 80%; }
  .tree__skeleton-row:nth-child(3) { inline-size: 65%; }
  .tree__skeleton-row:nth-child(4) { inline-size: 88%; }
  .tree__skeleton-row:nth-child(5) { inline-size: 55%; }
  .tree__skeleton-row:nth-child(6) { inline-size: 72%; }
  .tree__skeleton-row:nth-child(7) { inline-size: 40%; }
  @keyframes tree-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }
  .tree__list,
  .tree__children {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tree__list--root {
    border-block-end: 1px solid var(--color-border);
  }
  /* Empty placeholder where a subdirectory's children get injected on
     first <details> toggle. No special styling; once filled it contains
     a normal .tree__children ul that picks up the rules above. */
  .tree__lazy {
    /* nothing — content slot */
  }
  .tree__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    min-block-size: 40px;
    font-size: var(--fs-sm);
    border-block-start: 1px solid var(--color-border);
  }
  /* The old `.tree__list--root .tree__row:first-child` no-top-border rule
     was retired in #85: root file rows are now wrapped in a
     `<li class="tree__file-wrap">`, so the `:first-child` selector doesn't
     match the row anymore. The replacement selector below targets the new
     shape (`.tree__list--root > .tree__file-wrap:first-child > .tree__row`). */
  .tree__row--dir {
    cursor: pointer;
    background: var(--color-bg);
    user-select: none;
  }
  .tree__row--dir:hover {
    background: var(--color-bg-elevated);
  }
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  .tree__chevron {
    color: var(--color-fg-subtle);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  details[open] > summary > .tree__chevron {
    transform: rotate(90deg);
  }
  /* Expand toggle on hybrid signal-recording dir rows (website#252). A real
     sibling <button> rather than a <summary> wrapping the viewer button —
     nested interactive content in <summary> is inconsistently exposed to
     assistive technology. Mirrors the summary chevron's look + rotation. */
  .tree__dir-toggle {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .tree__dir-toggle[aria-expanded="true"] > .tree__chevron {
    transform: rotate(90deg);
  }
  .tree__dir-toggle:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .tree__icon {
    flex-shrink: 0;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
  }
  .tree__name {
    font-family: var(--font-mono);
    color: var(--color-fg);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-inline-size: 0;
  }
  a.tree__name:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
  .tree__counts {
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }
  .tree__size {
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    min-inline-size: 4.5rem;
    text-align: end;
  }
  .tree__tag {
    font-size: var(--fs-xs);
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-subtle);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
  }
  .tree__tag--signal {
    background: color-mix(in srgb, var(--color-link) 16%, var(--color-bg-subtle));
    color: var(--color-link);
  }
  /* "Show next N" footer. Rendered by render-dir-listing when the dir count
     exceeds DEFAULT_DIR_CHUNK_SIZE (50). Removed by the click handler after
     the final chunk is revealed. */
  .tree__more {
    padding: var(--space-3) var(--space-5);
    border-block-start: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
    background: var(--color-bg-elevated);
  }
  .tree__more-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    color: var(--color-fg);
    font-size: var(--fs-sm);
    cursor: pointer;
    font-family: inherit;
  }
  .tree__more-btn:hover {
    background: var(--color-bg);
    border-color: color-mix(in srgb, var(--color-fg-subtle) 40%, transparent);
  }
  .tree__more-counter {
    color: var(--color-fg-subtle);
    margin-inline-start: var(--space-2);
    font-variant-numeric: tabular-nums;
  }
  /* Empty-state banner shown when the tree endpoint returns no manifest. */
  .detail__no-manifest {
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-warning) 30%, transparent);
    background: color-mix(in srgb, var(--color-warning) 5%, var(--color-bg));
    border-radius: var(--radius-lg);
  }
  .detail__no-manifest h2 {
    font-size: var(--fs-lg);
    margin-block-end: var(--space-2);
  }
  .detail__no-manifest p {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
  }
  .detail__no-manifest code {
    background: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }
  /* File wrap: structural <li> that contains the row + the lazy preview
     slot. The row inside is a <div class="tree__row">, so the existing
     row-style rules above still apply unchanged. */
  .tree__file-wrap {
    display: flex;
    flex-direction: column;
  }
  /* The first row of the root file list still loses its top border, but
     now the rule has to walk through the new <li> wrapper. */
  .tree__list--root > .tree__file-wrap:first-child > .tree__row {
    border-block-start: none;
  }
  /* Preview-name button. Sized as a flex item that fills the same column
     the old `<a class="tree__name">` did. Earlier drafts used
     `display: contents`, but that breaks the accessibility tree on Safari
     < 17.4 (WebKit bug 230700 — the button becomes invisible to
     VoiceOver). Using `display: inline-flex` + `flex: 1` keeps the button
     in the AX tree everywhere and still preserves the row's flex layout. */
  .tree__preview-btn {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: start;
    display: inline-flex;
    align-items: center;
    flex: 1;
    min-inline-size: 0;
  }
  .tree__preview-btn:hover .tree__name {
    color: var(--color-link);
    text-decoration: underline;
  }
  .tree__preview-btn[data-zarr-available="false"] .tree__name {
    color: var(--color-fg-subtle);
  }
  .tree__preview-btn:focus-visible .tree__name {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  /* Download icon link. Hidden by default; revealed on row hover or when
     the row is keyboard-focused (per the user's preference for the
     quieter visual). Reserves layout width so the row width doesn't jump
     on hover. */
  .tree__dl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 28px;
    block-size: 28px;
    margin-inline-start: var(--space-2);
    color: var(--color-fg-subtle);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.12s ease, background 0.12s ease, color 0.12s ease;
  }
  .tree__file-wrap:hover .tree__dl,
  .tree__file-wrap:focus-within .tree__dl,
  .tree__dl:focus {
    opacity: 1;
  }
  .tree__dl:hover {
    color: var(--color-fg);
    background: var(--color-bg-elevated);
  }
  .tree__dl:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  /* Lazy preview panel. Sits as a sibling <div> under the row inside the
     same <li>. Hidden via the `hidden` attribute until the user clicks. */
  .tree__preview {
    border-block-start: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding: var(--space-4) var(--space-5);
    font-size: var(--fs-sm);
    color: var(--color-fg);
    max-block-size: 480px;
    overflow: auto;
  }
  .tree__preview[hidden] { display: none; }
  /* The signal viewer is the one preview that needs vertical room. Its scope
     height is derived from its width, so at any usable width the plot is
     taller than the 480px cap above and would sit behind a scrollbar inside
     an already-scrolling page. Let the panel grow to the viewer instead; the
     Enlarge control below is the escape hatch when it still isn't enough. */
  .tree__preview--signal {
    max-block-size: none;
    overflow: visible;
    padding: 0;
  }
  /* Inline signal-viewer chrome (website#217): file name on the left, the
     promote-to-dialog control on the right, viewer host underneath. */
  .eegv-inline__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-5);
    border-block-end: 1px solid var(--color-border);
  }
  .eegv-inline__name {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .eegv-inline__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    flex: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    font: inherit;
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  .eegv-inline__btn:hover {
    color: var(--color-fg);
    border-color: var(--color-link);
  }
  .eegv-inline__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .eegv-inline__btn svg {
    inline-size: 12px;
    block-size: 12px;
  }
  /* Stand-in left in the inline panel while the viewer is in the dialog, so
     the panel doesn't read as an empty box and the return has an exact
     position to restore the host into. */
  .eegv-inline__moved {
    margin: 0;
    padding: var(--space-5);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  /* The signal panel has no padding of its own (the viewer is full-bleed
     inside it), so the transient messages the page writes need their own.
     Descendant, not child, selectors: the "unavailable" and error messages
     are written straight into the panel, but the loading one goes inside
     `[data-eegv-host]` — it is the placeholder the mount replaces. The
     mounted viewer's own markup is `.eegv` / `.eegv__*` throughout, so
     nothing here collides. */
  .tree__preview--signal .preview__empty,
  .tree__preview--signal .preview__error,
  .tree__preview--signal .preview__loading {
    padding: var(--space-4) var(--space-5);
  }
  /* Markdown preview prose. Distinct from .readme__ so the dataset-header
     README component's styles don't bleed in. */
  .preview__md {
    line-height: var(--lh-relaxed);
    color: var(--color-fg);
  }
  .preview__md > :first-child { margin-block-start: 0; }
  .preview__md p { margin-block: var(--space-2); color: var(--color-fg-muted); }
  .preview__md h1,
  .preview__md h2,
  .preview__md h3 {
    color: var(--color-fg);
    margin-block: var(--space-3) var(--space-1);
  }
  .preview__md code {
    background: var(--color-bg-subtle);
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    font-size: 0.92em;
  }
  .preview__md pre {
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    overflow-x: auto;
  }
  .preview__md a { color: var(--color-link); }
  .preview__md ul,
  .preview__md ol { padding-inline-start: var(--space-5); }
  /* JSON preview. Pre-formatted; line-by-line color tokens. */
  .preview__json {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.6;
    white-space: pre;
    color: var(--color-fg-muted);
  }
  .preview__json .json-key { color: var(--color-fg); font-weight: var(--fw-medium); }
  .preview__json .json-str { color: var(--brand-teal); }
  .preview__json .json-num { color: var(--brand-purple); }
  .preview__json .json-kw  { color: var(--color-fg-subtle); font-style: italic; }
  /* TSV preview. Sticky-header table that horizontally scrolls when wide. */
  .preview__tsv { overflow-x: auto; }
  .preview__tsv-table {
    border-collapse: collapse;
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    inline-size: max-content;
    min-inline-size: 100%;
  }
  .preview__tsv-table th {
    position: sticky;
    inset-block-start: 0;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 4px var(--space-3);
    text-align: start;
    color: var(--color-fg);
    font-weight: var(--fw-semibold);
    white-space: nowrap;
  }
  .preview__tsv-table td {
    border: 1px solid var(--color-border);
    padding: 4px var(--space-3);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .preview__tsv-table tr:nth-child(even) td { background: var(--color-bg-subtle); }
  .preview__tsv-more {
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
    text-align: center;
  }
  .preview__tsv-more-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    color: var(--color-fg);
    font-size: var(--fs-sm);
    cursor: pointer;
    font-family: inherit;
  }
  .preview__tsv-more-btn:hover {
    background: var(--color-bg);
  }
  /* Shared preview state messages. */
  .preview__empty,
  .preview__loading,
  .preview__soon,
  .preview__too-large {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  .preview__error {
    margin: 0;
    color: var(--color-warning);
    font-size: var(--fs-sm);
  }
  /* Lazy subject-subtree failure state. Distinguishes a transient fetch
     error from regular tree content so the user reads it as a retry
     prompt, not as a file row. Sits inside [data-subject-target]. */
  .tree__error {
    margin: var(--space-2) 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    color: var(--color-fg-muted);
    background: color-mix(in srgb, var(--color-warning) 8%, var(--color-bg));
    border-inline-start: 2px solid color-mix(in srgb, var(--color-warning) 50%, transparent);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
  }

  /* Zarr coverage panel (website#277 decision 2). Rendered client-side by
     render-zarr-coverage.ts into a slot placed just above the file tree, so
     it inherits this file's is:global styling like the tree markup it sits
     beside. */
  .zcov {
    margin-block-end: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    font-size: var(--fs-sm);
  }
  .zcov__summary {
    margin: 0;
    color: var(--color-fg);
  }
  .zcov__summary strong {
    font-variant-numeric: tabular-nums;
  }
  .zcov__note {
    margin: var(--space-2) 0 0;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
  }
  .zcov__group {
    margin-block-start: var(--space-3);
  }
  .zcov__group summary {
    cursor: pointer;
    color: var(--color-fg);
    font-weight: var(--fw-medium);
  }
  .zcov__group summary::marker {
    color: var(--color-fg-subtle);
  }
  .zcov__list {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .zcov__code-head {
    color: var(--color-fg-muted);
  }
  .zcov__code-head code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-bg-subtle);
    padding: 1px 4px;
    border-radius: var(--radius-sm);
  }
  .zcov__entries {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding-inline-start: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .zcov__entries code {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .zcov__path {
    color: var(--color-link);
    text-decoration: none;
  }
  .zcov__path:hover {
    text-decoration: underline;
  }
  .zcov__attempts {
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
  }
  .zcov__detail {
    margin-block-start: 2px;
  }
  .zcov__detail summary {
    cursor: pointer;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
  }
  .zcov__detail pre {
    margin: var(--space-1) 0 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-fg-muted);
  }

  /* Jump-to-recording highlight (website#277 decision 2) — two pulses of the
     row's own border, same treatment as .eegv__annot-pop--flash in
     src/styles/eeg-viewer.css. */
  .tree__row--flash {
    animation: tree-row-flash 0.9s ease-out 1;
  }
  @keyframes tree-row-flash {
    0%,
    100% {
      box-shadow: none;
    }
    25%,
    75% {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-accent) 45%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tree__row--flash {
      animation: none;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-accent) 45%, transparent);
    }
  }
</style>
