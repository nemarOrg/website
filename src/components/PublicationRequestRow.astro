---
import {
  type PublicationRequest,
  deriveAdminBadgeState,
  isAdminActionable,
} from "../lib/admin-api";
import { WEB_PUBLISH_APPROVE_ENABLED } from "../lib/flags";
import { formatRelativeTime, parseBackendTimestamp } from "../lib/format";
import { cliApproveCommand } from "../lib/publication-queue";
import PublishStateBadge from "./PublishStateBadge.astro";

interface Props {
  request: PublicationRequest;
}

const { request } = Astro.props;
const datasetId = request.dataset_id;
// Admin-side badge derivation: status-only (no Dataset row needed). The
// owner-side `derivePublishState` keeps "awaiting_review" until the dataset's
// visibility actually flips; the admin queue surfaces the orchestrator's
// terminal state directly.
const state = deriveAdminBadgeState(request);
const actionable = isAdminActionable(request);
// The web button is withheld while approval needs a caller that drives it to
// completion (see `WEB_PUBLISH_APPROVE_ENABLED`). The terminal is the way
// forward for a request waiting on an admin, and the only way to continue one
// that is already `approving`, which has no web action at all.
const webApprove = actionable && WEB_PUBLISH_APPROVE_ENABLED;
const terminalStep =
  request.status === "approving"
    ? { lead: "Continue from a terminal", command: cliApproveCommand(request) }
    : actionable && !WEB_PUBLISH_APPROVE_ENABLED
      ? { lead: "Approve from a terminal", command: cliApproveCommand(request) }
      : null;

// The backend writes `datetime('now')`: UTC with no zone marker. Show the age,
// and keep the exact UTC instant in the tooltip for an admin who needs it.
function when(raw: string | null): { relative: string; exact: string } | null {
  const date = parseBackendTimestamp(raw);
  if (!date) return null;
  return {
    relative: formatRelativeTime(date) || "—",
    exact: `${date.toISOString().slice(0, 19).replace("T", " ")} UTC`,
  };
}
const requestedAt = when(request.requested_at);
// What happened at the end of the request, when it has ended. `blocked` and
// `approving` have no end time of their own.
const decided =
  request.status === "published"
    ? { label: "Published", at: when(request.approved_at) }
    : request.status === "denied"
      ? { label: "Denied", at: when(request.denied_at) }
      : null;

// `block_reason` is not cleared when a blocked request later moves on, so a
// published or denied row can still carry one. Only a blocked row's counts.
const note =
  request.status === "denied" && request.denied_reason
    ? { label: "Reason", text: request.denied_reason }
    : request.status === "blocked" && request.block_reason
      ? { label: "Reason", text: request.block_reason }
      : request.status === "approving" && request.last_error
        ? {
            label: request.current_step ? `Stopped at ${request.current_step}` : "Last error",
            text: request.last_error,
          }
        : null;
---

<article class="pubreq-row" data-pubreq-row data-dataset-id={datasetId}>
  <div class="pubreq-row__primary">
    <h3 class="pubreq-row__id">{datasetId}</h3>
    <PublishStateBadge state={state} />
  </div>

  <dl class="pubreq-row__meta">
    <div>
      <dt>Requested by</dt>
      <dd>
        <span class="pubreq-row__line">{request.requested_by_username}</span>
        <span class="pubreq-row__line pubreq-row__line--muted">{request.requested_by_email}</span>
      </dd>
    </div>
    <div>
      <dt>Requested</dt>
      <dd title={requestedAt?.exact}>{requestedAt?.relative ?? "—"}</dd>
    </div>
    {decided && (
      <div>
        <dt>{decided.label}</dt>
        <dd title={decided.at?.exact}>{decided.at?.relative ?? "—"}</dd>
      </div>
    )}
    <div>
      <dt>Status</dt>
      <dd>{request.status}</dd>
    </div>
  </dl>

  {note && (
    <p class="pubreq-row__reason" role="note">
      <strong>{note.label}:</strong> {note.text}
    </p>
  )}

  {terminalStep && (
    <p class="pubreq-row__terminal">
      {terminalStep.lead}: <code>{terminalStep.command}</code>
    </p>
  )}

  <footer class="pubreq-row__actions">
    <a class="pubreq-row__btn" href={`/dataset/${encodeURIComponent(datasetId)}`}>
      View dataset
    </a>
    {actionable && (
      <button
        type="button"
        class="pubreq-row__btn pubreq-row__btn--danger-ghost"
        data-pubreq-deny
        data-dataset-id={datasetId}
      >
        Deny
      </button>
    )}
    {webApprove && (
      <button
        type="button"
        class="pubreq-row__btn pubreq-row__btn--primary"
        data-pubreq-approve
        data-dataset-id={datasetId}
      >
        Approve and publish
      </button>
    )}
  </footer>
</article>

<style>
  /* The admin portal's card family; same shapes as UserAdminRow.astro and
     ImportJobRow.astro. Duplicated per the scoped-style convention; keep in
     sync. */
  .pubreq-row {
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--admin-shadow-sm);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }
  .pubreq-row__primary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pubreq-row__id {
    margin: 0;
    min-inline-size: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.005em;
    line-height: var(--lh-snug);
  }
  .pubreq-row__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--admin-surface-2);
  }
  .pubreq-row__meta > div {
    min-inline-size: 0;
  }
  .pubreq-row__meta dt {
    font-size: var(--fs-xs);
    color: var(--admin-text-3);
    margin-block-end: 2px;
  }
  .pubreq-row__meta dd {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pubreq-row__line {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pubreq-row__line--muted {
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
  }
  .pubreq-row__terminal {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  .pubreq-row__terminal code {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm, 4px);
    background: var(--admin-surface-2);
    color: var(--color-fg);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .pubreq-row__reason {
    margin: 0;
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    box-shadow: inset 3px 0 0 var(--admin-error);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .pubreq-row__reason strong {
    color: var(--admin-error-text);
  }
  .pubreq-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .pubreq-row__btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--admin-surface);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .pubreq-row__btn:hover {
    background: var(--admin-surface-2);
    border-color: var(--admin-control-border);
  }
  .pubreq-row__btn--primary {
    background: var(--color-link);
    color: var(--color-bg);
    border-color: var(--color-link);
  }
  .pubreq-row__btn--primary:hover {
    background: var(--color-link-hover);
    border-color: var(--color-link-hover);
  }
  .pubreq-row__btn--danger-ghost {
    color: var(--admin-error-text);
    border-color: color-mix(in srgb, var(--admin-error) 45%, transparent);
  }
  .pubreq-row__btn--danger-ghost:hover {
    background: var(--admin-error-soft);
    border-color: var(--admin-error-text);
  }
  @media (max-width: 640px) {
    .pubreq-row {
      padding: var(--space-4);
    }
    .pubreq-row__actions {
      justify-content: flex-start;
    }
  }
  @media (forced-colors: active) {
    .pubreq-row__reason {
      border-inline-start: 3px solid CanvasText;
    }
  }
</style>
