---
import {
  type PublicationRequest,
  deriveAdminBadgeState,
  isAdminActionable,
} from "../lib/admin-api";
import { formatRelativeTime } from "../lib/format";
import PublishStateBadge from "./PublishStateBadge.astro";

interface Props {
  request: PublicationRequest;
}

const { request } = Astro.props;
const datasetId = request.status.dataset_id;
// Admin-side badge derivation: status-only (no Dataset row needed). The
// owner-side `derivePublishState` keeps "awaiting_review" until the dataset's
// visibility actually flips; the admin queue surfaces the orchestrator's
// terminal state directly.
const state = deriveAdminBadgeState(request.status);
const requestedAt = "requested_at" in request.status ? request.status.requested_at : null;
const actionable = isAdminActionable(request);
const denyReason = request.status.status === "denied" ? request.status.denied_reason : null;
const blockReason = request.status.status === "blocked" ? request.status.block_reason : null;
---

<article class="pubreq-row" data-pubreq-row data-dataset-id={datasetId}>
  <div class="pubreq-row__primary">
    <div class="pubreq-row__heading">
      <span class="pubreq-row__id">{datasetId}</span>
      <h3 class="pubreq-row__name">{request.dataset_name}</h3>
    </div>
    <PublishStateBadge state={state} />
  </div>

  <dl class="pubreq-row__meta">
    <div>
      <dt>Requested by</dt>
      <dd>{request.owner_email}</dd>
    </div>
    <div>
      <dt>Requested</dt>
      <dd>{requestedAt ? formatRelativeTime(requestedAt) || "—" : "—"}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>{request.status.status}</dd>
    </div>
  </dl>

  {(denyReason || blockReason) && (
    <p class="pubreq-row__reason" role="note">
      <strong>Reason:</strong> {denyReason ?? blockReason}
    </p>
  )}

  <footer class="pubreq-row__actions">
    <a class="pubreq-row__btn" href={`/dataset/${encodeURIComponent(datasetId)}`}>
      View dataset
    </a>
    {actionable && (
      <button
        type="button"
        class="pubreq-row__btn pubreq-row__btn--danger-ghost"
        data-pubreq-deny
        data-dataset-id={datasetId}
      >
        Deny
      </button>
    )}
    {actionable && (
      <button
        type="button"
        class="pubreq-row__btn pubreq-row__btn--primary"
        data-pubreq-approve
        data-dataset-id={datasetId}
      >
        Approve and publish
      </button>
    )}
  </footer>
</article>

<style>
  /* The admin portal's card family; same shapes as UserAdminRow.astro and
     ImportJobRow.astro. Duplicated per the scoped-style convention; keep in
     sync. */
  .pubreq-row {
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--admin-shadow-sm);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }
  .pubreq-row__primary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pubreq-row__heading {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }
  .pubreq-row__id {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--admin-text-3);
  }
  .pubreq-row__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.005em;
    line-height: var(--lh-snug);
  }
  .pubreq-row__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--admin-surface-2);
  }
  .pubreq-row__meta > div {
    min-inline-size: 0;
  }
  .pubreq-row__meta dt {
    font-size: var(--fs-xs);
    color: var(--admin-text-3);
    margin-block-end: 2px;
  }
  .pubreq-row__meta dd {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pubreq-row__reason {
    margin: 0;
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    box-shadow: inset 3px 0 0 var(--admin-error);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .pubreq-row__reason strong {
    color: var(--admin-error-text);
  }
  .pubreq-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .pubreq-row__btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--admin-surface);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .pubreq-row__btn:hover {
    background: var(--admin-surface-2);
    border-color: var(--admin-control-border);
  }
  .pubreq-row__btn--primary {
    background: var(--color-link);
    color: var(--color-bg);
    border-color: var(--color-link);
  }
  .pubreq-row__btn--primary:hover {
    background: var(--color-link-hover);
    border-color: var(--color-link-hover);
  }
  .pubreq-row__btn--danger-ghost {
    color: var(--admin-error-text);
    border-color: color-mix(in srgb, var(--admin-error) 45%, transparent);
  }
  .pubreq-row__btn--danger-ghost:hover {
    background: var(--admin-error-soft);
    border-color: var(--admin-error-text);
  }
  @media (max-width: 640px) {
    .pubreq-row {
      padding: var(--space-4);
    }
    .pubreq-row__actions {
      justify-content: flex-start;
    }
  }
  @media (forced-colors: active) {
    .pubreq-row__reason {
      border-inline-start: 3px solid CanvasText;
    }
  }
</style>
