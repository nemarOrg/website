---
import Brand from "./Brand.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/about", label: "About" },
  { href: "/discover", label: "Discover" },
  { href: "/citation-dashboard", label: "Citation Dashboard" },
  { href: "/community", label: "Community" },
  { href: "/docs", label: "Documentation" },
  { href: "/support", label: "Support" },
];

const pathname = new URL(Astro.request.url).pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <Brand size="md" />
    <nav class="primary-nav" aria-label="Primary">
      <ul role="list" class="primary-nav__list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={pathname.startsWith(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <ThemeToggle />
      <button class="login-stub" type="button" data-login-stub>Login</button>
    </div>
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<dialog class="login-dialog" data-login-dialog>
  <h2>Login is moving</h2>
  <p>
    Authentication for nemar.org is migrating from the legacy system to the new
    Cloudflare-backed identity. Until that ships, sign in via the CLI:
  </p>
  <pre><code>npm install -g nemar-cli
nemar login</code></pre>
  <form method="dialog">
    <button type="submit" class="dialog-close">Got it</button>
  </form>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    block-size: var(--header-height);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
  }
  .primary-nav__list {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    align-items: center;
  }
  .primary-nav__list a {
    color: var(--color-fg-muted);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    padding: var(--space-2) var(--space-1);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .primary-nav__list a:hover {
    color: var(--color-fg);
  }
  .primary-nav__list a[aria-current="page"] {
    color: var(--color-fg);
    box-shadow: inset 0 -2px 0 var(--brand-teal);
  }
  .site-header__actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .login-stub {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    background: transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .login-stub:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-fg-muted);
  }
  .nav-toggle {
    display: none;
    color: var(--color-fg);
  }
  @media (max-width: 880px) {
    .primary-nav,
    .site-header__actions {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
      justify-self: end;
    }
    .site-header__inner {
      grid-template-columns: auto 1fr;
    }
    .primary-nav.is-open {
      display: block;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-block-end: 1px solid var(--color-border);
      padding: var(--space-4) var(--space-6);
    }
    .primary-nav.is-open .primary-nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }

  .login-dialog {
    max-inline-size: 36rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    padding: var(--space-6);
  }
  .login-dialog::backdrop {
    background: rgb(15 23 42 / 55%);
  }
  .login-dialog h2 {
    font-size: var(--fs-2xl);
    margin-block-end: var(--space-3);
  }
  .login-dialog p {
    color: var(--color-fg-muted);
    margin-block-end: var(--space-4);
  }
  .login-dialog pre {
    background: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-block-end: var(--space-4);
  }
  .dialog-close {
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-medium);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-nav-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const nav = document.querySelector<HTMLElement>(".primary-nav");
      const open = nav?.classList.toggle("is-open") ?? false;
      btn.setAttribute("aria-expanded", String(open));
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-login-stub]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelector<HTMLDialogElement>("[data-login-dialog]")?.showModal();
    });
  });
</script>
