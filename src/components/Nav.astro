---
import { getSession } from "../lib/auth";
import { SIGN_IN_TITLE } from "../lib/copy";
import { appUrl, hostMode, marketingUrl } from "../lib/host";
import Brand from "./Brand.astro";
import ExternalLink from "./ExternalLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
import UserMenu from "./UserMenu.astro";

const url = new URL(Astro.request.url);
const pathname = url.pathname;
const mode = hostMode(url.hostname);
const session = getSession(Astro.locals);

// "Community" is gone (website#222). It pointed at a placeholder page
// promising a forum that does not exist and was not being built; a nav entry
// for a surface with nothing behind it is worse than no entry. Per-dataset
// discussion is the real need it was standing in for, and that is tracked
// separately against the dataset repositories' GitHub issues.
//
// Citation Dashboard and Documentation are separate deployments
// (`nemarOrg/nemar-citations`, `nemarOrg/docs`), not routes on this site —
// hence the absolute URLs, and hence `isExternal` below.
const marketingLinks = [
  { href: "/about", label: "About" },
  { href: "/discover", label: "Discover" },
  { href: "https://dashboard.nemar.org/citations/", label: "Citation Dashboard" },
  { href: "https://docs.nemar.org", label: "Documentation" },
  { href: "/support", label: "Support" },
];

/** A nav target that leaves this site, and so opens in a new tab. */
const isExternal = (href: string) => href.startsWith("http");

// On the app host the nav depends on whether we can keep the user here.
//
// Signed in: relative links, so the marketing routes render on the app host
// and the session survives the click (website#210). The middleware stops
// redirecting these away once a session cookie is present, so a relative href
// resolves in place rather than bouncing cross-origin. This is the case that
// used to sign people out for using the nav — the single "Explore datasets"
// link below was absolute, so it left the app host by construction and the
// cookie, scoped to `app.nemar.org`, did not follow.
//
// Signed out on the app host (e.g. sitting on /login): the middleware still
// redirects marketing routes away, so relative hrefs would just produce a
// pointless extra hop. Keep the single absolute link back to the public
// surface, which is also the focused shell the authed pages want.
//
// Marketing host and single-host mode (dev, *.pages.dev previews) keep the
// full marketing nav so QA against one URL still sees every link.
const links =
  mode === "app"
    ? session
      ? marketingLinks
      : [{ href: marketingUrl("/discover", url.hostname), label: "Explore datasets" }]
    : marketingLinks;

const showUserMenu = mode !== "marketing";
const signInHref = appUrl("/login", url.hostname);
---

<header class="site-header">
  <div class="container site-header__inner">
    <Brand size="md" />
    <nav class="primary-nav" aria-label="Primary">
      <ul role="list" class="primary-nav__list">
        {
          links.map((link) => (
            <li>
              {isExternal(link.href) ? (
                <ExternalLink href={link.href}>{link.label}</ExternalLink>
              ) : (
                <a
                  href={link.href}
                  aria-current={pathname.startsWith(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <ThemeToggle />
      {
        showUserMenu ? (
          <UserMenu session={session} />
        ) : (
          <a class="site-header__signin" href={signInHref} title={SIGN_IN_TITLE}>Sign in</a>
        )
      }
    </div>
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    block-size: var(--header-height);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
  }
  .primary-nav__list {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    align-items: center;
  }
  /* `:global(a)`, not a bare `a`: the external entries render their anchor
     inside ExternalLink.astro, which carries that component's scope id rather
     than this one's, so a scoped descendant selector would not reach them —
     Citation Dashboard and Documentation fell back to the default link style
     and sat in the nav at the wrong colour and size. The container class keeps
     its own scope, so this stays confined to this nav. */
  .primary-nav__list :global(a) {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--color-fg-muted);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .primary-nav__list :global(a:hover) {
    color: var(--color-fg);
  }
  .primary-nav__list :global(a[aria-current="page"]) {
    color: var(--color-fg);
    box-shadow: inset 0 -2px 0 var(--brand-teal);
  }
  .site-header__actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .site-header__signin {
    min-block-size: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    background: transparent;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .site-header__signin:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-fg-muted);
  }
  .nav-toggle {
    display: none;
    color: var(--color-fg);
  }
  @media (max-width: 880px) {
    .primary-nav,
    .site-header__actions {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
      justify-self: end;
    }
    .site-header__inner {
      grid-template-columns: auto 1fr;
    }
    .primary-nav.is-open {
      display: block;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-block-end: 1px solid var(--color-border);
      padding: var(--space-4) var(--space-6);
    }
    .primary-nav.is-open .primary-nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }

</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-nav-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const nav = document.querySelector<HTMLElement>(".primary-nav");
      const open = nav?.classList.toggle("is-open") ?? false;
      btn.setAttribute("aria-expanded", String(open));
    });
  });
</script>
