---
// Renders hidden by default. A tiny inline script flips the `hidden` attribute
// off when no prior choice is stored. Analytics runs by default; the notice
// and the footer's "Your Privacy Choices" control let visitors opt out at any time.
---

<aside
  id="cookie-notice"
  class="cookie-notice"
  role="region"
  aria-label="Cookie and analytics preferences"
  hidden
  data-cookie-notice
>
  <div class="cookie-notice__inner">
    <p class="cookie-notice__copy">
      We collect anonymous usage data to improve NEMAR, and we never sell your data. Choose
      Strict only to turn analytics off; NEMAR then uses cookies only to keep you signed in and
      remember this choice.
      <a class="cookie-notice__link" href="/privacy">Privacy policy</a>
    </p>
    <div class="cookie-notice__actions">
      <button class="cookie-notice__btn cookie-notice__btn--ghost" type="button" data-cookie-strict>
        Strict only
      </button>
      <button class="cookie-notice__btn" type="button" data-cookie-accept>
        Keep analytics on
      </button>
    </div>
  </div>
</aside>

<style>
  .cookie-notice {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 60;
    padding: var(--space-4);
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  /* `.cookie-notice` is a class selector with higher specificity than the
     default `[hidden] { display: none }` user-agent rule, so without this
     override the JS-set `hidden` attribute would have no visual effect. */
  .cookie-notice[hidden] {
    display: none;
  }
  .cookie-notice__inner {
    pointer-events: auto;
    inline-size: min(48rem, 100%);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-4) var(--space-5);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-5);
    align-items: center;
  }
  .cookie-notice__copy {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    line-height: var(--lh-normal);
  }
  .cookie-notice__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-notice__actions {
    display: inline-flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .cookie-notice__btn {
    min-block-size: 40px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    border: 1px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .cookie-notice__btn:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .cookie-notice__btn--ghost {
    background: transparent;
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }
  .cookie-notice__btn--ghost:hover {
    background: var(--color-bg-subtle);
    border-color: var(--color-fg-muted);
  }
  @media (max-width: 640px) {
    .cookie-notice__inner {
      grid-template-columns: 1fr;
    }
    .cookie-notice__actions {
      justify-content: stretch;
    }
    .cookie-notice__btn {
      flex: 1;
    }
  }
</style>

<script>
  import {
    COOKIE_CONSENT_CHANGED_EVENT,
    readCookieConsent,
    saveCookieConsent,
  } from "../lib/cookie-consent";

  const banner = document.querySelector<HTMLElement>("[data-cookie-notice]");
  if (banner) {
    if (readCookieConsent() === null) banner.hidden = false;
    let returnFocusTo: HTMLElement | null = null;
    let openedForSettings = false;
    const footerTrigger = document.querySelector<HTMLButtonElement>("[data-cookie-open]");
    const closeNotice = () => {
      const activeElement = document.activeElement;
      const shouldRestoreFocus = activeElement instanceof HTMLElement && banner.contains(activeElement);
      banner.hidden = true;
      if (shouldRestoreFocus) {
        (returnFocusTo?.isConnected ? returnFocusTo : footerTrigger)?.focus();
      }
      returnFocusTo = null;
      openedForSettings = false;
    };
    const syncNotice = () => {
      if (readCookieConsent() === null) banner.hidden = false;
      else closeNotice();
    };
    const syncNoticeOnReturn = () => {
      if (!document.hidden && !openedForSettings) syncNotice();
    };
    const set = (value: "accepted" | "strict") => {
      saveCookieConsent(value);
      closeNotice();
    };
    document.addEventListener(COOKIE_CONSENT_CHANGED_EVENT, syncNotice);
    document.addEventListener("visibilitychange", syncNoticeOnReturn);
    window.addEventListener("focus", syncNoticeOnReturn);
    banner.querySelector<HTMLButtonElement>("[data-cookie-accept]")?.addEventListener("click", () => set("accepted"));
    banner.querySelector<HTMLButtonElement>("[data-cookie-strict]")?.addEventListener("click", () => set("strict"));
    document.querySelectorAll<HTMLButtonElement>("[data-cookie-open]").forEach((button) => {
      button.addEventListener("click", () => {
        returnFocusTo = button;
        openedForSettings = true;
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>("[data-cookie-strict]")?.focus();
      });
    });
  }
</script>
