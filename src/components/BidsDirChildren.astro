---
import type { TreeNode } from "../lib/bids-tree";
import { classifyFile } from "../lib/bids-tree";
import { formatBytes } from "../lib/format";

interface Props {
  node: TreeNode;
  basePath: string;
  depth: number;
}

const { node, basePath, depth } = Astro.props;
const indentVar = `--depth: ${depth}`;
// Auto-open is conservative: only the first level when the subject count is
// small. Large BIDS datasets (e.g. nm000104 with 1000+ subjects) stay
// collapsed by default to keep the rendered page navigable.
const MAX_AUTO_OPEN_DEPTH = 1;
const AUTO_OPEN_CHILD_CAP = 6;

function countFilesDeep(n: TreeNode): number {
  let total = n.files.length;
  for (const c of n.children) total += countFilesDeep(c);
  return total;
}
---

<ul class="tree__children" role="list" style={indentVar}>
  {node.children.map((child) => (
    <li>
      <details class="tree__dir" open={depth < MAX_AUTO_OPEN_DEPTH && node.children.length <= AUTO_OPEN_CHILD_CAP}>
        <summary class="tree__row tree__row--dir" style={`padding-inline-start: calc(var(--space-5) + ${depth} * var(--space-5))`}>
          <svg class="tree__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 6 6 6-6 6"/>
          </svg>
          <span class="tree__name">{child.name}/</span>
          <span class="tree__counts">
            {child.children.length > 0 ? `${child.children.length} dirs · ` : ""}{countFilesDeep(child)} files
          </span>
          <span class="tree__size">{formatBytes(child.totalSize)}</span>
        </summary>
        <Astro.self node={child} basePath={basePath} depth={depth + 1} />
      </details>
    </li>
  ))}
  {node.files.map((f) => {
    const cls = classifyFile(f.path.split("/").pop() ?? f.path);
    return (
      <li
        class="tree__row tree__row--file"
        style={`padding-inline-start: calc(var(--space-5) + ${depth} * var(--space-5) + 16px)`}
      >
        <a
          class="tree__name"
          href={`${basePath}/${encodeURI(f.path)}`}
          rel="external"
          download={f.path.split("/").pop()}
          title={`Download ${f.path}`}
        >
          {f.path.split("/").pop()}
        </a>
        <span class="tree__size">{formatBytes(f.size)}</span>
        {cls.isEEG && <span class="tree__tag tree__tag--soon" title="Visualizer ships in Phase 5">Vis · soon</span>}
        {cls.isTSV && <span class="tree__tag tree__tag--soon" title="TSV viewer ships in Phase 5">View · soon</span>}
        {cls.isJSON && <span class="tree__tag">JSON</span>}
      </li>
    );
  })}
</ul>

<style>
  .tree__children {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* Row layout has to be duplicated here because Astro scopes styles
     per-component file. The same row markup exists in BidsTree.astro;
     keep both stylesheets in sync. */
  .tree__row,
  .tree__row--file {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 6px var(--space-5);
    font-size: var(--fs-sm);
    border-block-start: 1px solid var(--color-border);
  }
  .tree__row--dir {
    cursor: pointer;
    background: var(--color-bg);
    user-select: none;
  }
  .tree__row--dir:hover {
    background: var(--color-bg-elevated);
  }
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  .tree__chevron {
    color: var(--color-fg-subtle);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  details[open] > summary > .tree__chevron {
    transform: rotate(90deg);
  }
  .tree__icon {
    flex-shrink: 0;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
  }
  .tree__name {
    font-family: var(--font-mono);
    color: var(--color-fg);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-inline-size: 0;
  }
  a.tree__name:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
  .tree__counts {
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }
  .tree__size {
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    min-inline-size: 4.5rem;
    text-align: end;
  }
  .tree__tag {
    font-size: var(--fs-xs);
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-subtle);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
  }
  .tree__tag--soon {
    color: var(--color-fg-subtle);
    background: var(--color-bg-subtle);
    cursor: help;
  }
</style>
