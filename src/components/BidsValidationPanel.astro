---
// The full BIDS validation panel of /upload (website#161, ADR 0028): the markup and the styles.
// `src/lib/bids-validation/panel.ts` finds its parts by their data-bidsval-* attributes and fills
// them in; the page script decides when it is shown. The panel is hidden until a check starts.
//
// The live region is outside the panel, and always rendered: a region that is hidden when its
// text is set is often not announced, and the panel is hidden whenever nothing is being checked.
// The visible lines are plain paragraphs, so a screen reader hears each change once.
//
// The styles are global, not scoped: the findings are built at runtime with createElement, and an
// element created that way never carries the scoping attribute Astro adds to scoped selectors.
// Every selector starts with `.bidsval`, which is what keeps global safe.
import { PRIVACY_HED_NOTICE, PRIVACY_NOTICE } from "../lib/bids-validation/wording";
---

<div class="bidsval-host" data-bidsval>
  <p class="visually-hidden" role="status" data-bidsval-announce></p>
  <section class="bidsval" data-bidsval-panel aria-labelledby="bidsval-title" hidden>
    <header class="bidsval__header">
      <h2 class="bidsval__title" id="bidsval-title" tabindex="-1" data-bidsval-heading>
        BIDS validation
      </h2>
      <button type="button" class="bidsval__cancel" data-bidsval-cancel hidden>Cancel</button>
    </header>
    <p class="bidsval__privacy">{PRIVACY_NOTICE}</p>
    <p class="bidsval__privacy bidsval__privacy--detail">{PRIVACY_HED_NOTICE}</p>
    <p class="bidsval__status" data-bidsval-status hidden></p>
    <div class="bidsval__bar" data-bidsval-bar aria-hidden="true" hidden>
      <span class="bidsval__bar-fill"></span>
    </div>
    <p class="bidsval__verdict" data-bidsval-verdict hidden></p>
    <p class="bidsval__note" data-bidsval-note hidden></p>
    <div class="bidsval__groups" data-bidsval-groups></div>
    <p class="bidsval__footer" data-bidsval-footer hidden></p>
  </section>
</div>

<style is:global>
  /* The host draws nothing: its two children take part in the form's grid as if it were not there,
     so it adds no row (and no gap) while the panel is hidden. */
  .bidsval-host {
    display: contents;
  }
  /* :not([hidden]) on the grid container: an author `display` beats the UA's
     [hidden]{display:none}, so an unqualified rule would render it while hidden. */
  .bidsval:not([hidden]) {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .bidsval__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .bidsval__title {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
  }
  /* The heading takes focus when a check starts, so keyboard and screen-reader users land in the
     panel; a focus ring on a heading would only look like an error. */
  .bidsval__title:focus {
    outline: none;
  }
  /* Ghost pill: a secondary action (design-language.md). */
  .bidsval__cancel {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .bidsval__cancel:hover {
    background: var(--color-bg-subtle);
  }
  .bidsval__cancel:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .bidsval__privacy,
  .bidsval__status,
  .bidsval__note,
  .bidsval__footer {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    max-inline-size: 70ch;
  }
  /* --color-fg-muted, not --color-fg-subtle: subtle on the panel's ground is 4.48:1 in the light
     theme, under the 4.5:1 that text this small needs. */
  .bidsval__privacy--detail,
  .bidsval__footer {
    font-size: var(--fs-xs);
  }

  /* Indeterminate: the validator reports no progress, so the bar only shows that it is alive. */
  .bidsval__bar:not([hidden]) {
    position: relative;
    block-size: 6px;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .bidsval__bar-fill {
    position: absolute;
    inset-block: 0;
    inline-size: 35%;
    background: var(--brand-teal);
    border-radius: inherit;
    animation: bidsval-slide 1.4s ease-in-out infinite;
  }
  @keyframes bidsval-slide {
    from {
      inset-inline-start: -35%;
    }
    to {
      inset-inline-start: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bidsval__bar-fill {
      animation: none;
      inset-inline-start: 0;
      inline-size: 100%;
      opacity: 0.5;
    }
  }

  .bidsval__verdict {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    color: var(--color-fg);
  }
  .bidsval__verdict[data-tone="blocked"] {
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-danger) 30%, transparent);
  }
  .bidsval__verdict[data-tone="passed"] {
    background: color-mix(in srgb, var(--color-success) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 30%, transparent);
  }
  /* The check could not run, or ran without the HED annotations. Amber, never green: nothing is
     known about the dataset, or something in it was not looked at. */
  .bidsval__verdict[data-tone="unavailable"],
  .bidsval__verdict[data-tone="unchecked"] {
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-warning) 30%, transparent);
  }

  .bidsval__groups {
    display: grid;
    gap: var(--space-2);
  }
  .bidsval__group {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .bidsval__group--error {
    border-color: color-mix(in srgb, var(--color-danger) 35%, var(--color-border));
  }
  .bidsval__group-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .bidsval__group-summary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* Static tag (design-language.md): severity is read, not clicked, and is named in words as
     well as tinted, so it does not rest on hue alone. The text is --color-fg on the tint, not the
     status colour: --color-danger is not lifted for the dark theme (2.8:1 on the tint) and
     --color-warning is 4.25:1 on its tint in the light one; --color-fg is 14:1 or better in both. */
  .bidsval__sev {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .bidsval__sev--error {
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 45%, transparent);
  }
  .bidsval__sev--warning {
    background: color-mix(in srgb, var(--color-warning) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 45%, transparent);
  }
  .bidsval__code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
  .bidsval__count {
    margin-inline-start: auto;
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    font-variant-numeric: tabular-nums;
  }
  .bidsval__desc {
    margin: 0;
    padding: 0 var(--space-3) var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    max-inline-size: 70ch;
  }
  .bidsval__items {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-3) var(--space-3);
    display: grid;
    gap: var(--space-2);
    max-block-size: 18rem;
    overflow-y: auto;
  }
  .bidsval__item {
    display: grid;
    gap: 2px;
    font-size: var(--fs-xs);
  }
  .bidsval__path {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }
  .bidsval__label {
    color: var(--color-fg-muted);
    overflow-wrap: anywhere;
  }
  .bidsval__more {
    margin: 0;
    padding: 0 var(--space-3) var(--space-3);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
</style>
