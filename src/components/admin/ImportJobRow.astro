---
/**
 * One row in the `/admin/imports` triage queue. Layout/CSS intentionally
 * mirrors `UserAdminRow.astro` (`.user-row*` -> `.import-row*`) per the
 * project's scoped-style-duplication convention (AGENTS.md) rather than a
 * shared stylesheet.
 */
import { formatDate, formatRelativeTime } from "../../lib/format";
import {
  type ImportJob,
  canRetry,
  canRollback,
  isBlocklisted,
  isUpstreamInaccessible,
} from "../../lib/imports-admin-api";
import ImportStatusBadge from "../ImportStatusBadge.astro";

interface Props {
  job: ImportJob;
}

const { job } = Astro.props;

const retryable = canRetry(job);
const rollbackable = canRollback(job);
const blocked = isBlocklisted(job);
const upstream = isUpstreamInaccessible(job);

const updatedDate = formatDate(job.updated_at);
const updatedRelative = formatRelativeTime(job.updated_at);
const updatedLabel = updatedDate
  ? updatedRelative
    ? `${updatedDate} (${updatedRelative})`
    : updatedDate
  : "—";
const nextRetryLabel =
  formatRelativeTime(job.next_retry_at) || formatDate(job.next_retry_at) || "—";
const checkedLabel = formatRelativeTime(job.integrity_checked_at) || "never";

// The dataset detail page is the operator's fastest way to see what actually
// landed. A rolled-back import has had its dataset cascade-deleted, so that
// link would 404 — the one status where it's suppressed.
const datasetHref = job.status === "rolled_back" ? null : `/dataset/${job.dataset_id}`;
---

<article class="import-row" data-import-row data-dataset-id={job.dataset_id}>
  <div class="import-row__primary">
    <div class="import-row__heading">
      <span class="import-row__id">{job.dataset_id}</span>
      {job.source_id && <span class="import-row__source">from {job.source_id}</span>}
    </div>
    <div class="import-row__badges">
      <ImportStatusBadge status={job.status} />
      {blocked && <span class="import-row__flag import-row__flag--blocked">Retry blocklisted</span>}
      {upstream && <span class="import-row__flag import-row__flag--upstream">Upstream inaccessible</span>}
    </div>
  </div>

  {
    upstream && (
      <p class="import-row__notice" role="note">
        OpenNeuro's objects for this dataset aren't anonymously readable, so NEMAR can't mirror the
        data. This is an upstream problem, not a failed NEMAR step &mdash; retrying won't clear it
        until the object permissions change upstream (
        <a href="https://github.com/nemarOrg/nemar-cli/issues/827" target="_blank" rel="noopener noreferrer">
          nemar-cli#827
        </a>
        ).
      </p>
    )
  }

  {
    blocked && job.blocklist_reason && (
      <p class="import-row__notice" role="note">
        Parked by the retry engine: {job.blocklist_reason}. Retrying here un-parks it.
      </p>
    )
  }

  {job.last_error && <pre class="import-row__error">{job.last_error}</pre>}

  <dl class="import-row__meta">
    <div>
      <dt>Stage</dt>
      <dd>{job.stage ?? "—"}</dd>
    </div>
    <div>
      <dt>Retry attempts</dt>
      <dd>{job.recovery_attempts ?? 0}</dd>
    </div>
    <div>
      <dt>Next retry</dt>
      <dd>{nextRetryLabel}</dd>
    </div>
    <div>
      <dt>Integrity checked</dt>
      <dd>{checkedLabel}</dd>
    </div>
    <div>
      <dt>Updated</dt>
      <dd>{updatedLabel}</dd>
    </div>
  </dl>

  <p class="import-row__result" data-import-result hidden></p>

  <footer class="import-row__actions">
    {
      datasetHref && (
        <a class="import-row__btn" href={datasetHref}>
          Dataset
        </a>
      )
    }
    {
      job.workflow_run_url && (
        <a class="import-row__btn" href={job.workflow_run_url} target="_blank" rel="noopener noreferrer">
          Workflow run
        </a>
      )
    }
    <button
      type="button"
      class="import-row__btn"
      data-import-verify
      data-dataset-id={job.dataset_id}
    >
      Verify
    </button>
    {
      retryable && (
        <button
          type="button"
          class="import-row__btn import-row__btn--primary"
          data-import-retry
          data-dataset-id={job.dataset_id}
        >
          Retry
        </button>
      )
    }
    {
      rollbackable && (
        <button
          type="button"
          class="import-row__btn import-row__btn--danger"
          data-import-rollback
          data-dataset-id={job.dataset_id}
        >
          Roll back
        </button>
      )
    }
  </footer>
</article>

<style>
  .import-row {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .import-row__primary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .import-row__heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    min-inline-size: 0;
  }
  .import-row__id {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .import-row__source {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .import-row__badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .import-row__flag {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    white-space: nowrap;
  }
  .import-row__flag--blocked {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
  }
  .import-row__flag--upstream {
    color: var(--color-info);
    background: color-mix(in srgb, var(--color-info) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-info) 35%, transparent);
  }
  .import-row__notice {
    margin: 0;
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .import-row__notice a {
    color: inherit;
    text-decoration: underline;
  }
  .import-row__error {
    margin: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.6;
    /* Import errors are long single-line strings (stack traces, S3 keys):
       wrap rather than force the card into a horizontal scroller. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-block-size: 12rem;
    overflow-y: auto;
  }
  .import-row__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .import-row__meta > div {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
  }
  .import-row__meta dt {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-block-end: 2px;
  }
  .import-row__meta dd {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .import-row__result {
    margin: 0;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    background: color-mix(in srgb, var(--color-info) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-info) 35%, transparent);
    color: var(--color-fg);
  }
  .import-row__result[data-tone="success"] {
    background: color-mix(in srgb, var(--color-success) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
  }
  .import-row__result[data-tone="danger"] {
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-danger) 35%, transparent);
  }
  .import-row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .import-row__btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .import-row__btn:hover {
    background: var(--color-bg-subtle);
  }
  .import-row__btn[disabled] {
    opacity: 0.55;
    cursor: progress;
  }
  .import-row__btn--primary {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .import-row__btn--primary:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .import-row__btn--danger {
    background: var(--color-danger);
    color: var(--color-bg);
    border-color: var(--color-danger);
  }
  .import-row__btn--danger:hover {
    background: color-mix(in srgb, var(--color-danger) 82%, #000);
  }
</style>
