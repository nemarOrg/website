---
/**
 * A status pill for the admin Compute tab: an icon and the words, never color alone. The tone is
 * a `data-tone` attribute (not a class) so the decide flow can change a row's pill in place
 * (`compute-row-dom.ts`) and the CSS follows. Same shape as `UserStatusBadge.astro` and
 * `admin/StatusBadge.astro`, duplicated per the scoped-style convention; keep them in sync.
 */
import type { BadgeTone } from "../../lib/admin-badges";
import { type IconName, iconPaths } from "../../lib/status-icons";

interface Props {
  tone: BadgeTone;
  icon: IconName;
  label: string;
}

const { tone, icon, label } = Astro.props;
const paths = iconPaths(icon);
---

<span class="compute-pill" data-tone={tone} data-compute-pill>
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
    {paths.map((d) => <path d={d} />)}
  </svg>
  <span data-compute-pill-label>{label}</span>
</span>

<style>
  .compute-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    min-block-size: 1.5rem;
    padding: 0 var(--space-2) 0 7px;
    border-radius: var(--radius-pill);
    background: var(--admin-neutral-soft);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    white-space: nowrap;
  }
  .compute-pill svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .compute-pill[data-tone="info"] {
    background: var(--admin-accent-soft);
    color: var(--color-link);
  }
  .compute-pill[data-tone="warning"] {
    background: var(--admin-warn-soft);
    color: var(--admin-warn-text);
  }
  .compute-pill[data-tone="success"] {
    background: var(--admin-ok-soft);
    color: var(--admin-ok-text);
  }
  .compute-pill[data-tone="danger"] {
    background: var(--admin-error-soft);
    color: var(--admin-error-text);
  }
  @media (forced-colors: active) {
    .compute-pill {
      border: 1px solid CanvasText;
    }
  }
</style>
