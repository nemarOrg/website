---
/**
 * A metric's `breakdown[]`, drawn as the public dashboard draws it: labeled
 * horizontal bars in one accent hue for a distribution, or a numbered list
 * for a ranking (`breakdown_style: "ranked"`, and `access.top`). Rows past
 * the first few sit behind a native disclosure. Labels, values, bar lengths,
 * and shares come from `breakdownView` (admin-overview.ts); every bar's
 * value is printed beside it, so the bars never carry a number alone.
 * Dataset-id rows link to the dataset page, as before.
 */
import { breakdownView } from "../../lib/admin-overview";
import { type Metric, formatMetricValue } from "../../lib/observability";

interface Props {
  metric: Metric;
  /** Rows shown before "Show all". */
  visible?: number;
  /** Heading level for the metric label inside its card. */
  headingLevel?: 3 | 4;
}

const { metric, visible = 6, headingLevel = 4 } = Astro.props;
const view = breakdownView(metric, visible);
const Heading = headingLevel === 3 ? "h3" : "h4";
const total = view.visible.length + view.hidden.length;
// The tile's own figure, as the dashboard prints it; a ranked top-N with a
// total says how much of that total it covers.
const headline =
  metric.breakdown_style === "ranked" && metric.total
    ? `${formatMetricValue(metric)} of ${formatMetricValue({ ...metric, value: metric.total })}`
    : formatMetricValue(metric);
---

<div class="mbreak">
  <div class="mbreak__head">
    <Heading class="mbreak__title">{metric.label}</Heading>
    {headline && <span class="mbreak__total">{headline}</span>}
  </div>
  {metric.hint && <p class="mbreak__hint">{metric.hint}</p>}
  {
    total === 0 ? (
      <p class="mbreak__empty">No entries reported. Unknown is not zero.</p>
    ) : view.style === "ranked" ? (
      <>
        <ol class="mbreak__ranked" role="list">
          {view.visible.map((row, i) => (
            <li class="mbreak__rank-row">
              <span class="mbreak__rank">{i + 1}</span>
              <span class="mbreak__rank-label">
                {row.href ? <a href={row.href}>{row.label}</a> : row.label}
              </span>
              <span class="mbreak__rank-value">
                {row.value}
                {row.share && <span class="mbreak__share">{row.share}</span>}
              </span>
            </li>
          ))}
        </ol>
        {view.hidden.length > 0 && (
          <details class="mbreak__more">
            <summary>Show all {total}</summary>
            <ol class="mbreak__ranked" role="list" start={view.visible.length + 1}>
              {view.hidden.map((row, i) => (
                <li class="mbreak__rank-row">
                  <span class="mbreak__rank">{view.visible.length + i + 1}</span>
                  <span class="mbreak__rank-label">
                    {row.href ? <a href={row.href}>{row.label}</a> : row.label}
                  </span>
                  <span class="mbreak__rank-value">
                    {row.value}
                    {row.share && <span class="mbreak__share">{row.share}</span>}
                  </span>
                </li>
              ))}
            </ol>
          </details>
        )}
      </>
    ) : (
      <>
        <ul class="mbreak__bars" role="list">
          {view.visible.map((row) => (
            <li class="mbreak__bar">
              <span class="mbreak__bar-label" title={row.label}>
                {row.href ? <a href={row.href}>{row.label}</a> : row.label}
              </span>
              <span class="mbreak__track" aria-hidden="true">
                <span class="mbreak__fill" style={`inline-size:${row.widthPct}%`} />
              </span>
              <span class="mbreak__bar-value">
                {row.value}
                {row.share && <span class="mbreak__share">{row.share}</span>}
              </span>
            </li>
          ))}
        </ul>
        {view.hidden.length > 0 && (
          <details class="mbreak__more">
            <summary>Show all {total}</summary>
            <ul class="mbreak__bars" role="list">
              {view.hidden.map((row) => (
                <li class="mbreak__bar">
                  <span class="mbreak__bar-label" title={row.label}>
                    {row.href ? <a href={row.href}>{row.label}</a> : row.label}
                  </span>
                  <span class="mbreak__track" aria-hidden="true">
                    <span class="mbreak__fill" style={`inline-size:${row.widthPct}%`} />
                  </span>
                  <span class="mbreak__bar-value">
                    {row.value}
                    {row.share && <span class="mbreak__share">{row.share}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )
  }
</div>

<style>
  .mbreak {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
  }
  .mbreak__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .mbreak__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
    line-height: var(--lh-snug);
    color: var(--color-fg);
  }
  .mbreak__total {
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .mbreak__hint {
    margin: 0;
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    line-height: 1.45;
  }
  .mbreak__empty {
    margin: 0;
    padding: var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  .mbreak__bars,
  .mbreak__ranked {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .mbreak__bars {
    gap: 2px;
  }
  .mbreak__bar {
    display: grid;
    grid-template-columns: minmax(5.25rem, 36%) minmax(2.5rem, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 26px;
    font-size: var(--fs-sm);
  }
  .mbreak__bar-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-fg);
  }
  .mbreak__track {
    display: block;
    block-size: 8px;
    border-radius: 0 4px 4px 0;
    overflow: hidden;
  }
  .mbreak__fill {
    display: block;
    block-size: 100%;
    background: var(--admin-accent);
    border-radius: 0 4px 4px 0;
  }
  .mbreak__bar-value,
  .mbreak__rank-value {
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    text-align: end;
    white-space: nowrap;
  }
  .mbreak__share {
    display: inline-block;
    min-inline-size: 3.2em;
    margin-inline-start: 6px;
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    font-weight: var(--fw-regular);
    text-align: end;
  }
  .mbreak__rank-row {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 32px;
    border-block-start: 1px solid var(--color-border);
    font-size: var(--fs-sm);
  }
  .mbreak__rank-row:first-child {
    border-block-start: 0;
  }
  .mbreak__rank {
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
  .mbreak__rank-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .mbreak a {
    color: var(--color-link);
    text-underline-offset: 2px;
  }
  .mbreak__more > summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    list-style: none;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    border-radius: var(--radius-sm);
    padding: 2px 0;
  }
  .mbreak__more > summary::-webkit-details-marker {
    display: none;
  }
  .mbreak__more > summary::before {
    content: "";
    inline-size: 6px;
    block-size: 6px;
    margin: 0 2px;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 140ms ease;
  }
  .mbreak__more[open] > summary::before {
    transform: rotate(45deg);
  }
  .mbreak__more > summary:hover {
    color: var(--color-fg);
  }
  .mbreak__more[open] > :not(summary) {
    margin-block-start: var(--space-2);
  }
  @media (max-width: 640px) {
    .mbreak__bars {
      gap: var(--space-2);
    }
    .mbreak__bar {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "label value" "track track";
      row-gap: 3px;
      min-block-size: 0;
    }
    .mbreak__bar-label {
      grid-area: label;
    }
    .mbreak__bar-value {
      grid-area: value;
    }
    .mbreak__track {
      grid-area: track;
    }
  }
  @media (forced-colors: active) {
    .mbreak__fill {
      forced-color-adjust: none;
    }
  }
</style>
