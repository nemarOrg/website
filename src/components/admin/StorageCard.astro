---
/**
 * How much the `nemar` S3 bucket holds: the figure admins are responsible
 * for keeping an eye on. Bucket size, object count, growth over the stored
 * history, and a comparison with the public catalog's own size, framed so a
 * gap between the two never reads as waste. CloudWatch storage metrics
 * update once a day, so the card names the day measured when the collector
 * reports it, and otherwise only the day the figure was received.
 *
 * The pushed `storage` section may not be in the snapshot yet, or its latest
 * run may have failed; the card then says so with the reason, never zero. Every decision is in
 * `storageView` (admin-overview.ts), unit-tested there.
 */
import { STORAGE_SECTION_KEY, type StorageView, sectionAnchor } from "../../lib/admin-overview";
import MetricBreakdown from "./MetricBreakdown.astro";
import MetricSparkline from "./MetricSparkline.astro";
import StatusBadge from "./StatusBadge.astro";
import StatusIcon from "./StatusIcon.astro";

interface Props {
  view: StorageView;
}

const { view } = Astro.props;
const anchor = sectionAnchor(STORAGE_SECTION_KEY);
---

<article
  class:list={["storage", `storage--${view.badge.tone}`]}
  id={anchor}
  aria-labelledby={`${anchor}-title`}
>
  <header class="storage__head">
    <div class="storage__titles">
      <h3 class="storage__title" id={`${anchor}-title`}>{view.title}</h3>
      <p class="storage__sub">
        {view.source
          ? `The nemar S3 bucket. ${view.source}`
          : "The nemar S3 bucket, from daily S3 CloudWatch metrics"}
      </p>
    </div>
    <StatusBadge tone={view.badge.tone} text={view.badge.text} />
  </header>

  <div class="storage__body">
    <div class="storage__figure">
      <p class="storage__label">Bucket size</p>
      <p class:list={["storage__value", { "storage__value--muted": !view.collected }]}>{view.bucket}</p>
      {view.objects && <p class="storage__objects">{view.objects}</p>}
      {
        view.delta && (
          <p class:list={["storage__delta", { "storage__delta--none": view.delta.direction === "none" }]}>
            {view.delta.direction !== "none" && <StatusIcon name={view.delta.direction} size={13} />}
            <span>{view.delta.text}</span>
          </p>
        )
      }
      {
        view.collected && (
          <p class="storage__fine">
            {view.dateLine ? `${view.dateLine} ` : ""}CloudWatch reports bucket size once a day.
          </p>
        )
      }
      {!view.collected && <p class="storage__fine">{view.note}</p>}
      {
        view.points && (
          <div class="storage__spark">
            <MetricSparkline points={view.points} label="Bucket size" format="bytes" />
            <p class="storage__fine">Bucket size, hourly snapshots</p>
          </div>
        )
      }
    </div>

    <div class="storage__compare">
      {view.comparison && <p class="storage__sentence">{view.comparison}</p>}
      {
        view.bars.length > 0 && (
          <ul class="storage__bars" role="list">
            {view.bars.map((bar) => (
              <li class="storage__bar">
                <span class="storage__bar-label">{bar.label}</span>
                <span class="storage__track" aria-hidden="true">
                  <span class="storage__fill" style={`inline-size:${bar.widthPct}%`} />
                </span>
                <span class="storage__bar-value">{bar.value}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        view.collected ? (
          <p class="storage__fine">{view.note}</p>
        ) : (
          <p class="storage__fine">The bucket size will sit beside this once it is collected.</p>
        )
      }
      {
        view.byClass && (
          <div class="storage__classes">
            <MetricBreakdown metric={view.byClass} visible={6} />
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .storage {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--admin-shadow-sm);
    scroll-margin-block-start: calc(var(--header-height) + var(--space-4));
  }
  .storage--error {
    box-shadow:
      inset 3px 0 0 var(--admin-error),
      var(--admin-shadow-sm);
  }
  .storage--warn {
    box-shadow:
      inset 3px 0 0 var(--admin-warn),
      var(--admin-shadow-sm);
  }
  .storage:target {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .storage__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .storage__titles {
    min-inline-size: 0;
  }
  .storage__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    letter-spacing: -0.005em;
  }
  .storage__sub {
    margin: 2px 0 0;
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
  }
  .storage__body {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }
  .storage__figure,
  .storage__compare {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    min-inline-size: 0;
  }
  .storage__compare {
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--admin-surface-2);
  }
  .storage__label {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }
  .storage__value {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-3xl);
    font-weight: var(--fw-semibold);
    line-height: 1.1;
    letter-spacing: -0.024em;
    font-variant-numeric: tabular-nums;
  }
  .storage__value--muted {
    font-size: var(--fs-xl);
    font-weight: var(--fw-medium);
    color: var(--admin-text-3);
    letter-spacing: -0.01em;
  }
  .storage__objects {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .storage__delta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
  .storage__delta--none {
    color: var(--admin-text-3);
    font-weight: var(--fw-regular);
  }
  .storage__fine {
    margin: 0;
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    line-height: 1.5;
    max-inline-size: 70ch;
  }
  .storage__spark {
    margin-block-start: var(--space-2);
  }
  .storage__sentence {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .storage__bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .storage__bar {
    display: grid;
    grid-template-columns: 7.5rem minmax(3rem, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
  }
  .storage__bar-label {
    color: var(--color-fg);
  }
  .storage__track {
    display: block;
    block-size: 10px;
    border-radius: 0 5px 5px 0;
    background: var(--admin-accent-track);
    overflow: hidden;
  }
  .storage__fill {
    display: block;
    block-size: 100%;
    background: var(--admin-accent);
    border-radius: 0 5px 5px 0;
  }
  .storage__bar-value {
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    text-align: end;
    white-space: nowrap;
  }
  .storage__classes {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .storage__body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }
  @media (max-width: 640px) {
    .storage {
      padding: var(--space-4);
    }
    .storage__value {
      font-size: var(--fs-2xl);
    }
    .storage__bar {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "label value" "track track";
      row-gap: 3px;
    }
    .storage__bar-label {
      grid-area: label;
    }
    .storage__bar-value {
      grid-area: value;
    }
    .storage__track {
      grid-area: track;
    }
  }
  @media (forced-colors: active) {
    .storage__fill {
      forced-color-adjust: none;
    }
    .storage--error,
    .storage--warn {
      border-inline-start: 3px solid CanvasText;
    }
  }
</style>
