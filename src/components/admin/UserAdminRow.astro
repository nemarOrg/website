---
/**
 * One row in the `/admin/users` queue. Layout/CSS intentionally mirrors
 * `PublicationRequestRow.astro` (`.pubreq-row*` -> `.user-row*`) per the
 * project's scoped-style-duplication convention (AGENTS.md) rather than a
 * shared stylesheet.
 */
import { ACCOUNT_COPY, fillCopy } from "../../lib/account-copy";
import { fullName, isValidOrcid } from "../../lib/auth";
import { formatDate, formatRelativeTime } from "../../lib/format";
import { describeGapBlocks, profileGaps } from "../../lib/profile-gaps";
import {
  ADMIN_TIER_LABELS,
  type AdminUserDetail,
  type AdminUserListRow,
  type AdminUserRole,
  adminTier,
  canApproveUser,
  gapAccountFromDetail,
  isActionable,
  isAwaitingUploadApproval,
  isSelf,
} from "../../lib/users-admin-api";
import UserStatusBadge from "../UserStatusBadge.astro";

interface Props {
  user: AdminUserListRow;
  /** `GET /admin/users/:username`, fetched by the page for rows with an open
   *  upload-access request. Null when there is none to fetch or when the
   *  fetch failed — the review card then renders only what the listing
   *  carries, which still includes everything the Approve decision is
   *  formally about except location and the request text. */
  detail?: AdminUserDetail | null;
  /** `session.user.backend_role === "owner"` — gates role-change + delete. */
  isOwner: boolean;
  /** `session.user.id` — compared via {@link isSelf} to suppress revoke,
   *  role-change, and delete on the signed-in admin's own row (the backend
   *  rejects all three to prevent lockout; approve is intentionally NOT
   *  gated here since the backend doesn't block self-approve). */
  sessionUserId: string;
}

const { user, detail = null, isOwner, sessionUserId } = Astro.props;
const actionable = isActionable(user);
const self = isSelf(user.id, sessionUserId);
// Approval is by numeric id (`POST /admin/approve/by-id/:id`), so unlike
// revoke and role-change it does NOT need a username — which is the point:
// a web/ORCID row has none, and under nemar-cli ADR 0040 approval is the
// only way it ever gets upload access. Self-approve is not blocked
// server-side, so `self` deliberately does not gate this either.
// `canApproveUser` carries the status rules and why two backend conditions
// are left to the backend.
const canApprove = canApproveUser(user);
const canRevoke = actionable && user.status === "approved" && !self;
// Role change requires status === "approved" server-side too (400 otherwise).
const canChangeRole = isOwner && actionable && user.status === "approved" && !self;
const canDelete = isOwner && !self;
const currentRole: AdminUserRole = user.role ?? "member";
const ROLE_OPTIONS: readonly AdminUserRole[] = ["member", "admin", "owner"];
const createdDate = formatDate(user.created_at);
const createdRelative = formatRelativeTime(user.created_at);
const tier = adminTier(user);

// The review card: what an admin is actually deciding on. Rendered only for
// an OPEN request, because that is the only moment the person's details are
// the question in front of them.
const awaiting = isAwaitingUploadApproval(user);
const requestedDate = formatDate(user.upload_access_requested_at ?? null);
const requestedRelative = formatRelativeTime(user.upload_access_requested_at ?? null);
const researcherName = fullName({
  given_name: user.given_name ?? undefined,
  family_name: user.family_name ?? undefined,
});
const orcid = (user.orcid ?? "").trim();
// The four fields only the detail fetch carries.
const city = (detail?.city ?? "").trim();
const country = (detail?.country ?? "").trim();
const affiliation = (detail?.affiliation ?? "").trim();
const whyText = (detail?.description ?? "").trim();
const emailVerified = user.email_verified === 1;

// What the requester is still missing, from the same module their own
// dashboard reads (website#309), so an admin sees the refusal before making
// it rather than after. `null` means the detail fetch did not land — the
// listing carries no city or country, and a field nobody asked for is not a
// field the user left blank.
//
// Approval stays available either way. The backend owns that decision (it
// refuses an unverified email with a sentence saying so), and an admin
// granting access to an account with an outstanding field is a judgement
// this card informs rather than one it should block.
const reviewGaps = detail ? profileGaps(gapAccountFromDetail(detail)) : null;
---

<article class="user-row" data-user-row data-username={user.username ?? ""}>
  <div class="user-row__primary">
    <div class="user-row__heading">
      <span class="user-row__email">{user.email}</span>
      {
        user.username ? (
          <span class="user-row__username">@{user.username}</span>
        ) : (
          <span class="user-row__username user-row__username--missing">no username</span>
        )
      }
      {self && <span class="user-row__self-marker">This is you</span>}
    </div>
    <UserStatusBadge status={user.status} />
  </div>

  {
    !actionable && (
      <p class="user-row__notice" role="note">
        No username yet. Approving this account by id still works, but it can't be revoked or
        role-changed until it picks one (
        <a href="https://github.com/nemarOrg/nemar-cli/issues/1012" target="_blank" rel="noopener noreferrer">
          nemar-cli#1012
        </a>
        ).{canDelete ? " It can also be deleted below." : ""}
      </p>
    )
  }

  <dl class="user-row__meta">
    <div>
      <dt>Tier</dt>
      <dd>{ADMIN_TIER_LABELS[tier]}</dd>
    </div>
    <div>
      <dt>Role</dt>
      <dd>{currentRole}</dd>
    </div>
    <div>
      <dt>GitHub</dt>
      <dd>{user.github_username ?? "—"}</dd>
    </div>
    <div>
      <dt>Signed up</dt>
      <dd>{createdDate ? (createdRelative ? `${createdDate} (${createdRelative})` : createdDate) : "—"}</dd>
    </div>
  </dl>

  {
    awaiting && (
      <section class="user-row__review" data-user-review>
        <header class="user-row__review-head">
          <h3 class="user-row__review-title">Upload-access request</h3>
          <span class="user-row__review-date">
            {requestedDate
              ? requestedRelative
                ? `Asked ${requestedDate} (${requestedRelative})`
                : `Asked ${requestedDate}`
              : "Asked (date unavailable)"}
          </span>
        </header>

        {!emailVerified && (
          <p class="user-row__notice" role="note">
            This account hasn't verified its email address, so approval will be refused
            until it does &mdash; the whole review happens over email. Ask them to enter the
            code on their dashboard.
          </p>
        )}

        <dl class="user-row__meta user-row__meta--review">
          <div>
            <dt>Name</dt>
            <dd>{researcherName || "—"}</dd>
          </div>
          <div>
            <dt>Username</dt>
            <dd>{user.username ?? "—"}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              {user.email}
              {emailVerified ? (
                <span class="user-row__verified"> verified</span>
              ) : (
                <span class="user-row__unverified"> unverified</span>
              )}
            </dd>
          </div>
          <div>
            <dt>ORCID</dt>
            <dd>
              {orcid && isValidOrcid(orcid) ? (
                <a href={`https://orcid.org/${orcid}`} rel="external noopener" target="_blank">
                  {orcid}
                </a>
              ) : (
                orcid || "—"
              )}
            </dd>
          </div>
          <div>
            <dt>GitHub</dt>
            <dd>
              {user.github_username ? (
                <a
                  href={`https://github.com/${user.github_username}`}
                  rel="external noopener"
                  target="_blank"
                >
                  {user.github_username}
                </a>
              ) : (
                "—"
              )}
            </dd>
          </div>
          <div>
            <dt>City</dt>
            <dd>{city || (detail ? "—" : "not loaded")}</dd>
          </div>
          <div>
            <dt>Country</dt>
            <dd>{country || (detail ? "—" : "not loaded")}</dd>
          </div>
          <div>
            <dt>Affiliation</dt>
            <dd>{affiliation || (detail ? "—" : "not loaded")}</dd>
          </div>
        </dl>

        <div class="user-row__gaps" data-user-gaps>
          <p class="user-row__gaps-label">{ACCOUNT_COPY["gaps.admin.title"]}</p>
          {reviewGaps === null ? (
            <p class="user-row__gaps-empty">{ACCOUNT_COPY["gaps.admin.not_loaded"]}</p>
          ) : reviewGaps.length === 0 ? (
            <p class="user-row__gaps-empty">{ACCOUNT_COPY["gaps.admin.none"]}</p>
          ) : (
            <ul class="user-row__gaps-list" role="list">
              {reviewGaps.map((gap) => (
                <li>
                  {fillCopy(ACCOUNT_COPY["gaps.admin.item"], {
                    label: gap.label,
                    blocks: describeGapBlocks(gap),
                  })}
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="user-row__why">
          <p class="user-row__why-label">What they intend to upload</p>
          {/* The requester's own prose, rendered as text. Never parsed and
              never linkified: it is untrusted user input on an admin page. */}
          <p class="user-row__why-text">
            {whyText || (detail ? "They left this blank." : "Not loaded — open the user page to read it.")}
          </p>
        </div>
      </section>
    )
  }

  <footer class="user-row__actions">
    {
      actionable && (
        <a class="user-row__btn" href={`/admin/users/${encodeURIComponent(user.username as string)}`}>
          View
        </a>
      )
    }
    {
      canApprove && (
        <button
          type="button"
          class="user-row__btn user-row__btn--primary"
          data-user-approve
          data-user-id={user.id}
        >
          {awaiting ? "Approve upload access" : "Approve"}
        </button>
      )
    }
    {
      canRevoke && (
        <button
          type="button"
          class="user-row__btn user-row__btn--danger-ghost"
          data-user-revoke
          data-username={user.username}
        >
          Revoke
        </button>
      )
    }
    {
      canChangeRole && (
        <span class="user-row__role-change">
          <label class="user-row__role-select-label" for={`role-select-${user.id}`}>
            Role
          </label>
          <select
            id={`role-select-${user.id}`}
            class="user-row__role-select"
            data-role-select
            data-username={user.username}
          >
            {ROLE_OPTIONS.map((r) => (
              <option value={r} selected={r === currentRole}>
                {r}
              </option>
            ))}
          </select>
          <button
            type="button"
            class="user-row__btn"
            data-user-change-role
            data-username={user.username}
            data-role-select-id={`role-select-${user.id}`}
          >
            Change role
          </button>
        </span>
      )
    }
    {
      canDelete && (
        <button type="button" class="user-row__btn user-row__btn--danger" data-user-delete data-user-id={user.id}>
          Delete
        </button>
      )
    }
  </footer>
</article>

<style>
  .user-row {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .user-row__primary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .user-row__heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    min-inline-size: 0;
  }
  .user-row__email {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .user-row__username {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .user-row__username--missing {
    color: var(--color-warning);
    font-style: italic;
  }
  .user-row__self-marker {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--color-info) 40%, transparent);
    background: color-mix(in srgb, var(--color-info) 12%, transparent);
    color: var(--color-fg);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
  }
  .user-row__notice {
    margin: 0;
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .user-row__notice a {
    color: inherit;
    text-decoration: underline;
  }
  .user-row__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .user-row__meta > div {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
  }
  .user-row__meta dt {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-block-end: 2px;
  }
  .user-row__meta dd {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user-row__meta dd a {
    color: var(--color-link);
  }

  /* ---------- Upload-access review card ---------- */
  .user-row__review {
    border: 1px solid var(--color-border-strong);
    border-inline-start: 3px solid var(--brand-teal);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .user-row__review-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .user-row__review-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
  }
  .user-row__review-date {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  /* The review grid holds full email addresses and affiliations, so it drops
     the single-line ellipsis the summary meta row uses. */
  .user-row__meta--review dd {
    overflow: visible;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .user-row__verified {
    color: var(--color-success);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
  }
  .user-row__unverified {
    color: var(--color-warning);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
  }
  /* The gap list on the review card: what the account is still missing, and
     what each one blocks. Reports, never instructs — the admin is not the
     person who can fill these in. */
  .user-row__gaps {
    display: grid;
    gap: var(--space-2);
  }
  .user-row__gaps-label {
    margin: 0;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
  }
  .user-row__gaps-empty {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .user-row__gaps-list {
    margin: 0;
    padding: 0 0 0 var(--space-4);
    display: grid;
    gap: var(--space-1);
    list-style: disc;
    font-size: var(--fs-sm);
    color: var(--color-warning);
    overflow-wrap: anywhere;
  }
  .user-row__why {
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }
  .user-row__why-label {
    margin: 0 0 var(--space-1);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .user-row__why-text {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--color-fg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .user-row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .user-row__role-change {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .user-row__role-select-label {
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
  }
  .user-row__role-select {
    min-block-size: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
  }
  .user-row__btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .user-row__btn:hover {
    background: var(--color-bg-subtle);
  }
  .user-row__btn--primary {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .user-row__btn--primary:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .user-row__btn--danger-ghost {
    color: var(--color-danger);
    border-color: color-mix(in srgb, var(--color-danger) 40%, transparent);
  }
  .user-row__btn--danger-ghost:hover {
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    border-color: var(--color-danger);
  }
  .user-row__btn--danger {
    background: var(--color-danger);
    color: var(--color-bg);
    border-color: var(--color-danger);
  }
  .user-row__btn--danger:hover {
    background: color-mix(in srgb, var(--color-danger) 82%, #000);
  }
</style>
