---
/**
 * One row in the `/admin/users` queue. Layout/CSS intentionally mirrors
 * `PublicationRequestRow.astro` (`.pubreq-row*` -> `.user-row*`) per the
 * project's scoped-style-duplication convention (AGENTS.md) rather than a
 * shared stylesheet.
 */
import { formatDate, formatRelativeTime } from "../../lib/format";
import { type AdminUserListRow, type AdminUserRole, isActionable } from "../../lib/users-admin-api";
import UserStatusBadge from "../UserStatusBadge.astro";

interface Props {
  user: AdminUserListRow;
  /** `session.user.backend_role === "owner"` — gates role-change + delete. */
  isOwner: boolean;
}

const { user, isOwner } = Astro.props;
const actionable = isActionable(user);
// Backend allows approving a "verified" user OR re-approving a "revoked"
// one (see admin/users.ts POST /approve/:username); revoked_iam_pending is
// the same DB-level "revoked" family for approval purposes.
const canApprove =
  actionable &&
  (user.status === "verified" ||
    user.status === "revoked" ||
    user.status === "revoked_iam_pending");
const canRevoke = actionable && user.status === "approved";
// Role change requires status === "approved" server-side too (400 otherwise).
const canChangeRole = isOwner && actionable && user.status === "approved";
const currentRole: AdminUserRole = user.role ?? "member";
const ROLE_OPTIONS: readonly AdminUserRole[] = ["member", "admin", "owner"];
const createdDate = formatDate(user.created_at);
const createdRelative = formatRelativeTime(user.created_at);
---

<article class="user-row" data-user-row data-username={user.username ?? ""}>
  <div class="user-row__primary">
    <div class="user-row__heading">
      <span class="user-row__email">{user.email}</span>
      {
        user.username ? (
          <span class="user-row__username">@{user.username}</span>
        ) : (
          <span class="user-row__username user-row__username--missing">no username</span>
        )
      }
    </div>
    <UserStatusBadge status={user.status} />
  </div>

  {
    !actionable && (
      <p class="user-row__notice" role="note">
        No username yet, so this account can't be approved, revoked, or role-changed here (
        <a href="https://github.com/nemarOrg/nemar-cli/issues/1012" target="_blank" rel="noopener noreferrer">
          nemar-cli#1012
        </a>
        ).{isOwner ? " It can still be deleted below." : ""}
      </p>
    )
  }

  <dl class="user-row__meta">
    <div>
      <dt>Role</dt>
      <dd>{currentRole}</dd>
    </div>
    <div>
      <dt>GitHub</dt>
      <dd>{user.github_username ?? "—"}</dd>
    </div>
    <div>
      <dt>Signed up</dt>
      <dd>{createdDate ? (createdRelative ? `${createdDate} (${createdRelative})` : createdDate) : "—"}</dd>
    </div>
  </dl>

  <footer class="user-row__actions">
    {
      actionable && (
        <a class="user-row__btn" href={`/admin/users/${encodeURIComponent(user.username as string)}`}>
          View
        </a>
      )
    }
    {
      canApprove && (
        <button
          type="button"
          class="user-row__btn user-row__btn--primary"
          data-user-approve
          data-username={user.username}
        >
          Approve
        </button>
      )
    }
    {
      canRevoke && (
        <button
          type="button"
          class="user-row__btn user-row__btn--danger-ghost"
          data-user-revoke
          data-username={user.username}
        >
          Revoke
        </button>
      )
    }
    {
      canChangeRole && (
        <span class="user-row__role-change">
          <label class="user-row__role-select-label" for={`role-select-${user.id}`}>
            Role
          </label>
          <select
            id={`role-select-${user.id}`}
            class="user-row__role-select"
            data-role-select
            data-username={user.username}
          >
            {ROLE_OPTIONS.map((r) => (
              <option value={r} selected={r === currentRole}>
                {r}
              </option>
            ))}
          </select>
          <button
            type="button"
            class="user-row__btn"
            data-user-change-role
            data-username={user.username}
            data-role-select-id={`role-select-${user.id}`}
          >
            Change role
          </button>
        </span>
      )
    }
    {
      isOwner && (
        <button
          type="button"
          class="user-row__btn user-row__btn--danger"
          data-user-delete
          data-user-id={user.id}
          data-user-label={user.username ?? user.email}
        >
          Delete
        </button>
      )
    }
  </footer>
</article>

<style>
  .user-row {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .user-row__primary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .user-row__heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    min-inline-size: 0;
  }
  .user-row__email {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .user-row__username {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .user-row__username--missing {
    color: var(--color-warning);
    font-style: italic;
  }
  .user-row__notice {
    margin: 0;
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .user-row__notice a {
    color: inherit;
    text-decoration: underline;
  }
  .user-row__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .user-row__meta > div {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
  }
  .user-row__meta dt {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-block-end: 2px;
  }
  .user-row__meta dd {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user-row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .user-row__role-change {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .user-row__role-select-label {
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
  }
  .user-row__role-select {
    min-block-size: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
  }
  .user-row__btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .user-row__btn:hover {
    background: var(--color-bg-subtle);
  }
  .user-row__btn--primary {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .user-row__btn--primary:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .user-row__btn--danger-ghost {
    color: var(--color-danger);
    border-color: color-mix(in srgb, var(--color-danger) 40%, transparent);
  }
  .user-row__btn--danger-ghost:hover {
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    border-color: var(--color-danger);
  }
  .user-row__btn--danger {
    background: var(--color-danger);
    color: var(--color-bg);
    border-color: var(--color-danger);
  }
  .user-row__btn--danger:hover {
    background: color-mix(in srgb, var(--color-danger) 82%, #000);
  }
</style>
