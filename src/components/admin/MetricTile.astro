---
/**
 * One headline KPI card on the admin Overview, in the public dashboard's
 * `.kpi` shape: label, value, the change over the history window (an arrow
 * and words, never color), context lines, and a sparkline at the foot. The
 * spec comes from `kpiSpecs` (admin-overview.ts), which decides every word;
 * an unknown figure arrives as a muted "Unavailable", never as zero.
 */
import type { KpiSpec } from "../../lib/admin-overview";
import MetricSparkline from "./MetricSparkline.astro";
import StatusIcon from "./StatusIcon.astro";

interface Props {
  spec: KpiSpec;
}

const { spec } = Astro.props;
const deltaIcon = spec.delta && spec.delta.direction !== "none" ? spec.delta.direction : null;
---

<article class="kpi">
  <div class="kpi__head">
    <h3 class="kpi__label">{spec.label}</h3>
    {
      spec.anchor && (
        <a class="kpi__more" href={`#${spec.anchor}`}>
          Details
          <StatusIcon name="chevron" size={13} />
        </a>
      )
    }
  </div>
  <p class:list={["kpi__value", { "kpi__value--muted": spec.muted }]}>{spec.value}</p>
  {
    spec.delta && (
      <p class:list={["kpi__delta", { "kpi__delta--none": spec.delta.direction === "none" }]}>
        {deltaIcon && <StatusIcon name={deltaIcon} size={13} />}
        <span>{spec.delta.text}</span>
      </p>
    )
  }
  {spec.context.map((line) => <p class="kpi__context">{line}</p>)}
  {
    spec.spark && (
      <div class="kpi__foot">
        <MetricSparkline points={spec.spark.points} label={spec.spark.label} format={spec.spark.format} />
        <p class="kpi__spark-label">{spec.spark.label}, {spec.spark.cadence ?? "hourly"}</p>
      </div>
    )
  }
</article>

<style>
  .kpi {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-inline-size: 0;
    padding: var(--space-4) var(--space-5);
    background: var(--admin-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--admin-shadow-sm);
  }
  .kpi__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px var(--space-2);
  }
  .kpi__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    line-height: var(--lh-snug);
    color: var(--color-fg-muted);
  }
  .kpi__more {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    white-space: nowrap;
    overflow-wrap: normal;
    color: var(--color-link);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .kpi__more:hover {
    text-decoration: underline;
  }
  .kpi__value {
    margin: var(--space-1) 0 0;
    font-family: var(--font-sans);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-semibold);
    line-height: 1.1;
    letter-spacing: -0.024em;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg);
  }
  .kpi__value--muted {
    font-size: var(--fs-xl);
    font-weight: var(--fw-medium);
    color: var(--admin-text-3);
    letter-spacing: -0.01em;
  }
  .kpi__delta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
  .kpi__delta--none {
    color: var(--admin-text-3);
    font-weight: var(--fw-regular);
  }
  .kpi__context {
    margin: 0;
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
    line-height: 1.45;
  }
  .kpi__foot {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }
  .kpi__spark-label {
    margin: 2px 0 0;
    color: var(--admin-text-3);
    font-size: var(--fs-xs);
  }
  @media (max-width: 640px) {
    .kpi {
      padding: var(--space-3) var(--space-4);
    }
    .kpi__value {
      font-size: var(--fs-2xl);
    }
  }
</style>
