---
interface Props {
  label: string;
  tone?: "neutral" | "accent" | "warning";
  size?: "sm" | "md";
  href?: string;
}

const { label, tone = "neutral", size = "sm", href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  class:list={["chip", `chip--${tone}`, `chip--${size}`]}
  href={href}
  rel={href?.startsWith("http") ? "external" : undefined}
>
  {label}
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    text-decoration: none;
    line-height: 1.5;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  a.chip:hover {
    color: var(--color-fg);
    border-color: var(--color-border-strong);
    background: var(--color-bg-elevated);
    text-decoration: none;
  }
  .chip--md {
    padding: 4px 12px;
    font-size: var(--fs-sm);
  }
  .chip--accent {
    color: var(--brand-teal);
    border-color: color-mix(in srgb, var(--brand-teal) 40%, transparent);
    background: color-mix(in srgb, var(--brand-teal) 8%, transparent);
  }
  .chip--warning {
    color: var(--color-warning);
    border-color: color-mix(in srgb, var(--color-warning) 40%, transparent);
    background: color-mix(in srgb, var(--color-warning) 8%, transparent);
  }
</style>
