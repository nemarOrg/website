---
import type { Collaborator } from "../lib/collaborators-api";
import { formatRelativeTime } from "../lib/format";

interface Props {
  collaborators: readonly Collaborator[];
  ownerUsername: string;
}

const { collaborators, ownerUsername } = Astro.props;
---

<table class="collab-list">
  <thead>
    <tr>
      <th scope="col">Username</th>
      <th scope="col">Access</th>
      <th scope="col">Added</th>
      <th scope="col">Invited by</th>
    </tr>
  </thead>
  <tbody>
    <tr class="collab-list__row collab-list__row--owner">
      <td>
        <a href={`https://github.com/${ownerUsername}`} rel="external noopener">{ownerUsername}</a>
      </td>
      <td>Owner</td>
      <td>—</td>
      <td>—</td>
    </tr>
    {collaborators.length === 0 ? (
      <tr class="collab-list__row collab-list__row--empty">
        <td colspan="4">No collaborators yet. Invite someone with the form above.</td>
      </tr>
    ) : (
      collaborators.map((c) => (
        <tr class="collab-list__row">
          <td>
            <a href={`https://github.com/${c.github_username}`} rel="external noopener">
              {c.username}
            </a>
          </td>
          <td>{c.access_type === "invited" ? "Collaborator" : "Requested access"}</td>
          <td>{formatRelativeTime(c.granted_at) || "—"}</td>
          <td>{c.granted_by_username}</td>
        </tr>
      ))
    )}
  </tbody>
</table>

<style>
  .collab-list {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .collab-list thead th {
    text-align: start;
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: var(--space-2) var(--space-3);
    border-block-end: 1px solid var(--color-border);
  }
  .collab-list__row td {
    padding: var(--space-3);
    border-block-end: 1px solid var(--color-border);
    color: var(--color-fg);
  }
  .collab-list__row--owner td {
    color: var(--color-fg-muted);
    background: var(--color-bg-subtle);
  }
  .collab-list__row--empty td {
    text-align: center;
    color: var(--color-fg-subtle);
    padding-block: var(--space-5);
  }
  .collab-list a {
    color: var(--color-link);
    text-decoration: none;
  }
  .collab-list a:hover {
    text-decoration: underline;
  }
</style>
