---
/**
 * Status pill for an `import_jobs` row. Mirrors `UserStatusBadge.astro`'s
 * structure (the admin portal's icon-plus-words badge) adapted to the import
 * lifecycle.
 *
 * Tone choices worth stating, because they aren't all obvious:
 * - `incomplete` reads warning, not danger: the import did reach `complete`
 *   once and the retry engine is actively working it back. It needs
 *   watching, not a decision.
 * - `rolled_back` reads neutral, not danger: it is the *resolved* end of a
 *   failed import, i.e. an operator already dealt with it.
 * - The three in-flight stages share one "info" tone with a clock icon; the
 *   stage itself is rendered separately on the row.
 *
 * A status this build has no entry for renders as a neutral pill with the
 * raw value rather than failing the page; see `lib/admin-badges.ts`.
 */
import { badgeIcon, badgeLabel, badgeTone } from "../lib/admin-badges";
import type { ImportStatus } from "../lib/imports-admin-api";
import StatusIcon from "./admin/StatusIcon.astro";

interface Props {
  status: ImportStatus;
}

const { status } = Astro.props;

const LABELS: Record<ImportStatus, string> = {
  preparing: "Preparing",
  copying: "Copying",
  finalizing: "Finalizing",
  complete: "Complete",
  incomplete: "Incomplete",
  failed: "Failed",
  quarantined: "Quarantined",
  rolled_back: "Rolled back",
};
const TONES: Record<ImportStatus, "neutral" | "info" | "warning" | "success" | "danger"> = {
  preparing: "info",
  copying: "info",
  finalizing: "info",
  complete: "success",
  incomplete: "warning",
  failed: "danger",
  quarantined: "danger",
  rolled_back: "neutral",
};
const label = badgeLabel(status, LABELS);
const tone = badgeTone(status, TONES);
---

<span class:list={["import-status-badge", `import-status-badge--${tone}`]}>
  <StatusIcon name={badgeIcon(tone)} size={14} />
  <span>{label}</span>
</span>

<style>
  /* Same shape as UserStatusBadge.astro and admin/StatusBadge.astro,
     duplicated per the scoped-style convention; keep them in sync. */
  .import-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    min-block-size: 1.5rem;
    padding: 0 var(--space-2) 0 7px;
    border-radius: var(--radius-pill);
    background: var(--admin-neutral-soft);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    white-space: nowrap;
  }
  .import-status-badge--info {
    background: var(--admin-accent-soft);
    color: var(--color-link);
  }
  .import-status-badge--warning {
    background: var(--admin-warn-soft);
    color: var(--admin-warn-text);
  }
  .import-status-badge--success {
    background: var(--admin-ok-soft);
    color: var(--admin-ok-text);
  }
  .import-status-badge--danger {
    background: var(--admin-error-soft);
    color: var(--admin-error-text);
  }
  @media (forced-colors: active) {
    .import-status-badge {
      border: 1px solid CanvasText;
    }
  }
</style>
