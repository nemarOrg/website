---
import { apiBase } from "../lib/api-base";
import { APP_VERSION, BUILD_REF } from "../lib/build-info";
import { resolveDataBase } from "../lib/data-base";
import { resolveDocsBase } from "../lib/docs-base";
import ExternalLink from "./ExternalLink.astro";

const year = new Date().getFullYear();

// All three Data-column hosts resolve through their own resolver rather than
// being written out here (website#220). Before, only the data host did, so
// staging advertised `data-test.nemar.org` alongside a production `api.nemar.org`
// and `docs.nemar.org` — a footer describing two environments at once, and the
// api link in particular pointed somewhere the rest of that page was not
// talking to. The label is derived from the URL, so it can never drift from it.
const dataHost = new URL(resolveDataBase()).host;
const apiHost = new URL(apiBase()).host;
const docsHost = new URL(resolveDocsBase()).host;

const REPO_URL = "https://github.com/nemarOrg/website";

// `BUILD_REF` is "dev" for a local `astro dev` run, where there is no commit
// to point at — link only when it is a real SHA (website#214).
const hasCommit = BUILD_REF !== "dev";
const commitUrl = `${REPO_URL}/commit/${BUILD_REF}`;

// Clean versions have a matching `vX.Y.Z` tag and GitHub Release; `-devN`
// pre-releases do not, so those link to the release list instead of a 404.
const isRelease = !APP_VERSION.includes("-");
const versionUrl = isRelease ? `${REPO_URL}/releases/tag/v${APP_VERSION}` : `${REPO_URL}/releases`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <h2 class="site-footer__heading">NEMAR</h2>
      <p>
        The Neuroelectromagnetic Data Archive and Tools Resource. Funded by the
        National Institutes of Health under award number NIMH R24MH120037.
      </p>
      <p class="site-footer__caveat">
        Opinions, findings, and conclusions are those of the authors and do not
        necessarily reflect the views of the National Institutes of Health or
        any other sponsor.
      </p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      <div>
        <h3>Explore</h3>
        <ul role="list">
          <li><a href="/discover">Discover</a></li>
          <li><ExternalLink href="https://dashboard.nemar.org/citations/">Citations</ExternalLink></li>
          <li><ExternalLink href="https://docs.nemar.org">Documentation</ExternalLink></li>
        </ul>
      </div>
      <div>
        {/* Was "Community", with a "Forum" link to a placeholder page
            promising a forum that does not exist (website#222). Both are gone.
            The heading is now "Project", which describes what is actually
            under it — About and Support — rather than a community surface
            NEMAR does not run. */}
        <h3>Project</h3>
        <ul role="list">
          <li><a href="/about">About</a></li>
          <li><a href="/support">Support</a></li>
          {/* Local routes that 301 to the canonical policy pages on the docs
              site (website#242): the footer never hardcodes the docs host,
              and the policy URLs can move without touching this file. */}
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms &amp; Policies</a></li>
        </ul>
      </div>
      <div>
        <h3>Data</h3>
        <ul role="list">
          <li><ExternalLink href={`https://${dataHost}/`}>{dataHost}</ExternalLink></li>
          <li><ExternalLink href={`https://${apiHost}/`}>{apiHost}</ExternalLink></li>
          <li><ExternalLink href={`https://${docsHost}/`}>{docsHost}</ExternalLink></li>
          {/* Same-origin, unlike the three hosts above -- a plain anchor, not
              ExternalLink. Its only job is auditability: a human can read the
              same index a crawler would fetch (website#284 phase 6, issue #289). */}
          <li><a href="/llms.txt">llms.txt</a></li>
        </ul>
      </div>
      <div>
        {/* "GitHub", not "Open source": NEMAR's code is source-available, and
            the two are not interchangeable — an open-source claim asserts an
            OSI-style licence this project does not grant. The heading only
            needs to say where the code is, which "GitHub" does without
            claiming anything about its terms. */}
        <h3>GitHub</h3>
        <ul role="list">
          {/* Two separate GitHub organizations, deliberately: nemarOrg holds
              the code, nemarDatasets holds one repository per dataset. Both
              are public and worth surfacing — people looking for the data
              repos never find them under nemarOrg. */}
          <li><ExternalLink href="https://github.com/nemarOrg">nemarOrg</ExternalLink></li>
          <li><ExternalLink href="https://github.com/nemarDatasets">nemarDatasets</ExternalLink></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container site-footer__credits">
    <div class="site-footer__maker">
      <span class="site-footer__credits-label">A project of</span>
      <div class="site-footer__chips">
        <a
          class="logo-chip logo-chip--maker"
          href="https://sccn.ucsd.edu"
          rel="external"
          aria-label="Swartz Center for Computational Neuroscience"
        >
          <img src="/logos/sccn.svg" alt="SCCN" loading="lazy" />
        </a>
        <a
          class="logo-chip logo-chip--maker logo-chip--sdsc"
          href="https://www.sdsc.edu"
          rel="external"
          aria-label="San Diego Supercomputer Center"
        >
          <img src="/logos/sdsc.svg" alt="SDSC" loading="lazy" />
        </a>
      </div>
    </div>

    <div class="site-footer__partners">
      <span class="site-footer__credits-label">Sponsors and partners</span>
      <div class="site-footer__chips">
        <a
          class="logo-chip logo-chip--asis"
          href="https://www.nih.gov"
          rel="external"
          aria-label="National Institutes of Health"
        >
          <img src="/logos/nih.svg" alt="National Institutes of Health" loading="lazy" />
        </a>
        <a
          class="logo-chip"
          href="https://aws.amazon.com/opendata/"
          rel="external"
          aria-label="Powered by AWS — AWS Open Data Sponsorship Program"
        >
          <img src="/logos/powered-by-aws.png" alt="Powered by AWS" loading="lazy" />
        </a>
        <a class="logo-chip" href="https://openneuro.org" rel="external" aria-label="OpenNeuro">
          <img src="/logos/openneuro.png" alt="OpenNeuro" loading="lazy" />
        </a>
        <a
          class="logo-chip"
          href="https://bids.neuroimaging.io"
          rel="external"
          aria-label="Brain Imaging Data Structure (BIDS)"
        >
          <img src="/logos/bids.svg" alt="BIDS" loading="lazy" />
        </a>
        <a
          class="logo-chip"
          href="https://www.hedtags.org"
          rel="external"
          aria-label="Hierarchical Event Descriptors (HED)"
        >
          <img src="/logos/HED.svg" alt="HED" loading="lazy" />
        </a>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} The Regents of the University of California</p>
    <span class="site-footer__sep" aria-hidden="true">&middot;</span>
    <p class="site-footer__build">
      <a href={versionUrl} rel="external">v{APP_VERSION}</a>
      {hasCommit && (
        <>
          <span aria-hidden="true">&middot;</span>
          <a href={commitUrl} rel="external"><code>{BUILD_REF}</code></a>
        </>
      )}
    </p>
    <span class="site-footer__sep" aria-hidden="true">&middot;</span>
    <p>
      {/* Marked like every other outbound link. Two arrows in one short line
          is busier than leaving them bare, but a marker applied only to the
          links someone judged important stops being a reliable signal. */}
      Built with <ExternalLink href="https://astro.build">Astro</ExternalLink> on
      <ExternalLink href="https://pages.cloudflare.com">Cloudflare Pages</ExternalLink>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-24);
    padding-block: var(--space-16);
    background: var(--color-bg-elevated);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-fg-muted);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) 2fr;
    gap: var(--space-12);
  }
  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
  .site-footer__heading {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    color: var(--color-fg);
    margin-block-end: var(--space-3);
  }
  .site-footer__caveat {
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
    margin-block-start: var(--space-3);
  }
  /* auto-fit rather than a fixed count: the fourth column (GitHub,
     website#214) makes four too tight to hardcode at every width, and
     auto-fit reflows to 2x2 on narrow viewports without a extra breakpoint. */
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-8);
  }
  .site-footer__nav h3 {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg);
    margin-block-end: var(--space-3);
    font-weight: var(--fw-semibold);
  }
  .site-footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* `:global(a)` for the same reason as Nav.astro: the outbound entries render
     their anchor inside ExternalLink.astro, which carries that component's
     scope id, so a scoped descendant selector misses them and they fall back
     to the default link colour and size. Scoping stays on the container. */
  .site-footer__nav :global(a) {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  .site-footer__nav :global(a:hover) {
    color: var(--color-fg);
  }
  /* Credits band: SCCN + SDSC as the makers, then sponsors and partners. Logos
     are boxless and normalized to a single tone per theme (see `.logo-chip`
     below); the NIH mark is exempted and kept in full color. */
  .site-footer__credits {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-10);
    border-block-start: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-8) var(--space-16);
    align-items: center;
  }
  @media (max-width: 720px) {
    .site-footer__credits {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  .site-footer__credits-label {
    display: block;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: var(--fw-semibold);
    color: var(--color-fg-subtle);
    margin-block-end: var(--space-4);
  }
  .site-footer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
  }
  /* Boxless logos: the marks sit directly on the footer and link out. They're
     normalized to a single tone per theme (dark ink on the light footer, white
     on the dark footer) so wildly different source files — some light, some
     colored — all stay legible at a common size without a backing chip. */
  .logo-chip {
    display: inline-flex;
    align-items: center;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .logo-chip:hover {
    transform: translateY(-1px);
  }
  .logo-chip img {
    block-size: 34px;
    inline-size: auto;
    max-inline-size: 160px;
    object-fit: contain;
    display: block;
    filter: brightness(0);
    opacity: 0.72;
  }
  .logo-chip:hover img {
    opacity: 1;
  }
  .logo-chip--maker img {
    block-size: 50px;
    max-inline-size: 180px;
  }
  .logo-chip--sdsc img {
    block-size: 30px;
  }
  .site-footer__maker .site-footer__credits-label {
    margin-block-end: var(--space-2);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo-chip img {
      filter: brightness(0) invert(1);
      opacity: 0.82;
    }
  }
  :global(:root[data-theme="dark"]) .logo-chip img {
    filter: brightness(0) invert(1);
    opacity: 0.82;
  }
  /* NIH is the federal funder: its official mark carries its own contrast and
     brand guidelines discourage recoloring, so it's exempt from the monochrome
     normalization above and shown in full color on both themes. */
  .logo-chip--asis img,
  :global(:root[data-theme="dark"]) .logo-chip--asis img {
    filter: none;
    opacity: 1;
    block-size: 40px;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo-chip--asis img {
      filter: none;
      opacity: 1;
    }
  }
  /* One continuous line reading left to right, flush with the left edge the
     rest of the footer already uses ("A project of", the nav headings) —
     rather than three items pushed to the far corners by space-between, which
     stranded the build identity in the middle of an otherwise empty row and
     left nothing sharing an alignment with anything above it. */
  .site-footer__bottom {
    margin-block-start: var(--space-12);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-fg-subtle);
    font-size: var(--fs-sm);
  }
  /* Separators between the three groups, so the line reads as one statement
     instead of three phrases that happen to be adjacent. Explicit elements
     rather than ::before, to match how the version/commit separator above is
     already done, and so they can be dropped outright in the stacked layout. */
  .site-footer__sep {
    color: var(--color-fg-subtle);
  }
  /* Deployed build identity. Same information as the `x-nemar-version`
     header, put where someone reporting a bug can read it off the page
     without opening devtools. */
  .site-footer__build {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-footer__build code {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  @media (max-width: 600px) {
    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    /* Stacked, the separators would sit alone on their own rows. */
    .site-footer__sep {
      display: none;
    }
  }
</style>
