---
/**
 * Dismissible dashboard banner for an unfinished profile (#226, rebuilt for
 * website#309).
 *
 * A nudge, not a gate — it never blocks anything on this page. The hard
 * requirements are enforced where they matter: the upload-access request
 * endpoint refuses a request missing any of these fields, so dismissing this
 * cannot buy anyone past it.
 *
 * What changed in #309 is what it says. It used to name the missing fields
 * and guess at one consequence for the set ("City and country are required
 * before you can upload"); now it renders ONE LINE PER GAP from
 * `profileGaps`, each saying what that field blocks and where to set it, in
 * the exact sentence the CLI prints and the upload-access refusal repeats.
 * A user who reads this line, then hits the refusal, then runs `nemar auth
 * status` now sees the same words three times instead of three paraphrases.
 *
 * Dismissal is client-side and per-browser on purpose: it is a UI
 * preference, not account state, and storing it server-side would mean a
 * write endpoint and a migration for something a user can undo by filling in
 * the form. It re-appears if the set of gaps changes, because the storage key
 * is derived from that set.
 */
import { ACCOUNT_COPY } from "../lib/account-copy";
import { type ProfileGap, gapTail } from "../lib/profile-gaps";

interface Props {
  /** Outstanding gaps, in prompt order. Renders nothing when empty. */
  gaps: readonly ProfileGap[];
  /**
   * Session user id. Scopes the dismissal so one account's choice cannot
   * suppress another's on a shared browser — reachable on test.nemar.org,
   * where QA switches between the shared `test@nemar.org` account and the
   * `@nemar.test` fixtures without clearing storage (nothing clears it on
   * logout).
   */
  userId: string;
}

const { gaps, userId } = Astro.props;
// Keyed on the user AND on the actual gap set, so filling in one field
// re-surfaces the banner for whatever is still outstanding rather than
// staying dismissed.
const dismissKey = `nemar:profile-nudge:${userId}:${gaps
  .map((gap) => gap.field)
  .sort()
  .join(",")}`;
---

{gaps.length > 0 && (
  <aside
    class="nudge"
    role="status"
    data-profile-nudge
    data-dismiss-key={dismissKey}
    hidden
  >
    <div class="nudge__body">
      <p class="nudge__title">{ACCOUNT_COPY["gaps.nudge.title"]}</p>
      <ul class="nudge__list" role="list">
        {gaps.map((gap) => (
          <li class="nudge__item">
            {/* The label links at the field; the tail is the rest of the one
                sentence `describeGap` composes, so the linked and the plain
                renderings are word-for-word the same. */}
            {gap.href ? (
              <a class="nudge__field" href={gap.href}>{gap.label}</a>
            ) : (
              <span class="nudge__field">{gap.label}</span>
            )}{" "}{gapTail(gap)}
          </li>
        ))}
      </ul>
      <a class="nudge__link" href="/settings">{ACCOUNT_COPY["gaps.nudge.cta"]}</a>
    </div>
    <button
      type="button"
      class="nudge__dismiss"
      data-profile-nudge-dismiss
      aria-label="Dismiss this notice"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          d="M4 4l8 8M12 4l-8 8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </aside>
)}

<style>
  .nudge {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    color: var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
  }
  .nudge[hidden] {
    display: none;
  }
  .nudge__body {
    display: grid;
    gap: var(--space-2);
    flex: 1;
    min-inline-size: 0;
  }
  .nudge__title {
    margin: 0;
    font-weight: var(--fw-semibold);
  }
  .nudge__list {
    margin: 0;
    padding: 0 0 0 var(--space-4);
    display: grid;
    gap: var(--space-1);
    list-style: disc;
  }
  .nudge__item {
    /* Long sentences with a backticked command in them; let them wrap
       anywhere rather than pushing the card wide on a narrow screen. */
    overflow-wrap: anywhere;
    line-height: var(--lh-normal);
  }
  .nudge__field {
    font-weight: var(--fw-semibold);
  }
  a.nudge__field {
    color: var(--color-link);
  }
  .nudge__link {
    color: var(--color-link);
    font-weight: var(--fw-semibold);
    justify-self: start;
  }
  .nudge__dismiss {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-fg-subtle);
    cursor: pointer;
  }
  .nudge__dismiss:hover {
    color: var(--color-fg);
    background: color-mix(in srgb, var(--color-fg) 8%, transparent);
  }
  .nudge__dismiss:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>

<script>
  // Rendered hidden and revealed here, so a previously-dismissed banner
  // never flashes before the script runs.
  for (const el of document.querySelectorAll<HTMLElement>("[data-profile-nudge]")) {
    const key = el.dataset.dismissKey;
    if (!key) continue;
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(key) === "1";
    } catch {
      // Private mode / storage disabled: show the banner. Failing open is
      // right for a nudge — the worst case is it reappears next visit.
    }
    if (dismissed) continue;
    el.hidden = false;
    el.querySelector("[data-profile-nudge-dismiss]")?.addEventListener("click", () => {
      // Hiding the element the user just activated strands keyboard focus on
      // a hidden node, which drops it to <body> and loses the reader's place.
      // Hand focus to the page heading before removing the banner.
      const heading = document.querySelector<HTMLElement>("h1");
      if (heading) {
        if (!heading.hasAttribute("tabindex")) heading.setAttribute("tabindex", "-1");
        heading.focus();
      }
      el.hidden = true;
      try {
        localStorage.setItem(key, "1");
      } catch {
        // Nothing to do: the banner is closed for this page view either way.
      }
    });
  }
</script>
