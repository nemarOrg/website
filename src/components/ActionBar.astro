---
import { resolveDataBase } from "../lib/data-base";
import type { LandingArchive } from "../lib/neuroschema";
import DialogCloseButton from "./DialogCloseButton.astro";

interface Props {
  datasetId: string;
  version: string | null;
  archiveUrl: string | null;
  archive?: LandingArchive | null;
  issuesUrl: string;
  githubUrl: string | null;
  openneuroId: string | null;
}

const { datasetId, version, archiveUrl, archive, issuesUrl, githubUrl, openneuroId } = Astro.props;
const ds = datasetId;
const versionSuffix = version ?? "latest";

// Download methods (#752): one "Download" modal, like the compute modal, listing
// every route. The zip is offered ONLY when the archive is confirmed ready —
// large (>100 GB) datasets skip the zip (archive.skip_reason set) and datasets
// whose zip isn't built yet (status null/pending) don't show a broken button.
const DOCS = "https://docs.nemar.org";
const installUrl = `${DOCS}/cli/getting-started/installation/`;
const downloadGuideUrl = `${DOCS}/cli/guides/downloading/`;
const archiveReady = archive?.status === "ready";
const archiveSkipReason = archive?.skip_reason ?? null;
const archiveSizeGb =
  typeof archive?.size === "number" ? (archive.size / 1_000_000_000).toFixed(1) : null;
const ghCloneUrl = githubUrl ?? `https://github.com/nemarDatasets/${ds}`;

// Resolve the data-plane host per environment (data.nemar.org on prod,
// data-test.nemar.org on staging) so the copyable commands and direct link
// point at the plane this site actually reads from.
const dataBase = resolveDataBase();
const dataHost = new URL(dataBase).host;

// Per-method commands, each separately copyable in the modal.
const cliCmd = `nemar dataset download ${ds}`;
const dataladCmd = `datalad clone ${ghCloneUrl} ${ds}\ncd ${ds} && datalad get .`;
const annexCmd = `git clone ${ghCloneUrl} ${ds}\ncd ${ds} && git annex get .`;
const directCmd = `curl -s ${dataBase}/${ds}/${versionSuffix}/manifest.json | jq -r '.[].bytes_url' > urls.txt\nwget -xc -i urls.txt`;
---

<div class="actions">
  <button class="action action--primary" type="button" data-download-stub>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
    </svg>
    Download
  </button>
  {/* Hidden by default (website#260): whether this dataset has any viewable
      recording is only known once the client fetches the Zarr index, and
      that fetch (and the recording-nav state it needs to pick a "first"
      recording) lives in the dataset page's own hydration script, not here
      — see `hydrateTree`/`annotateZarrRows` and the click handling in
      dataset/[id].astro. Revealed there once the index resolves with at
      least one store; stays hidden for a dataset with none (pre-backfill,
      e.g. on004696) so it never advertises a dead button. */}
  <button class="action action--ghost" type="button" data-view-data-btn aria-haspopup="dialog" hidden>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>
    View data
  </button>
  <button class="action action--ghost" type="button" data-compute-stub>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4h16v16H4zM9 9h6v6H9z"/>
    </svg>
    Compute instructions
  </button>
  {/* Revealed by the script once the citations API confirms count > 0. */}
  <button class="action action--ghost" type="button" data-citations-open hidden>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
    </svg>
    <span data-citations-label>Citations</span>
  </button>
  <a class="action action--ghost" href={issuesUrl} rel="external">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12" y2="16"/>
    </svg>
    Issues
  </a>
  {githubUrl && (
    <a class="action action--ghost" href={githubUrl} rel="external">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.9 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>
      </svg>
      GitHub
    </a>
  )}
  {openneuroId && (
    <a class="action action--ghost" href={`https://openneuro.org/datasets/${openneuroId}`} rel="external">
      OpenNeuro {openneuroId}
    </a>
  )}
</div>

<dialog class="compute-dialog" data-download-dialog>
  <DialogCloseButton />
  <div class="compute-dialog__scroll">
  <h2>Download this dataset</h2>
  <p class="compute-dialog__intro">
    {archiveSkipReason
      ? `${archiveSkipReason}. Use one of the streaming methods below — all resumable.`
      : "Pick a method. Large datasets skip the zip and use the streaming methods below — all resumable."}
    {" "}<a href={downloadGuideUrl} rel="external">Full download guide →</a>
  </p>

  <ol class="compute-dialog__steps">
    {archiveReady && archiveUrl && (
      <li>
        <strong>Download archive (.zip){archiveSizeGb ? ` — ${archiveSizeGb} GB` : ""}</strong>
        <p>A single zip of the published version. Best for small/medium datasets.</p>
        <p>
          <a class="action action--primary action--sm" href={archiveUrl} download={`${ds}-${versionSuffix}.zip`} rel="external">
            Download zip
          </a>
        </p>
      </li>
    )}

    <li>
      <strong>NEMAR CLI <span class="rec-badge">recommended</span></strong>
      <p>
        Pulls the pinned version + annexed data and resumes cleanly.
        <a href={installUrl} rel="external">Install nemar-cli →</a>
      </p>
      <div class="dl-cmd">
        <pre><code>{cliCmd}</code></pre>
        <button class="dl-cmd__copy" type="button" data-copy-text={cliCmd} aria-label="Copy nemar-cli command">Copy</button>
      </div>
    </li>

    <li>
      <strong>DataLad</strong>
      <p>
        Clone the dataset repo and fetch file content on demand.
        <a href={`${downloadGuideUrl}#datalad`} rel="external">Docs →</a>
      </p>
      <div class="dl-cmd">
        <pre><code>{dataladCmd}</code></pre>
        <button class="dl-cmd__copy" type="button" data-copy-text={dataladCmd} aria-label="Copy DataLad commands">Copy</button>
      </div>
    </li>

    <li>
      <strong>git-annex</strong>
      <p>
        Plain git + git-annex against the dataset repo.
        <a href={`${downloadGuideUrl}#git-annex`} rel="external">Docs →</a>
      </p>
      <div class="dl-cmd">
        <pre><code>{annexCmd}</code></pre>
        <button class="dl-cmd__copy" type="button" data-copy-text={annexCmd} aria-label="Copy git-annex commands">Copy</button>
      </div>
    </li>

    <li>
      <strong>Direct files (wget / curl / rclone)</strong>
      <p>
        Every file with a stable, range-resumable URL from the manifest. Needs
        <code>curl</code>, <code>jq</code>, <code>wget</code> (or rclone/aria2c).
        <a href={`${downloadGuideUrl}#direct-download`} rel="external">Docs →</a>
      </p>
      <div class="dl-cmd">
        <pre><code>{directCmd}</code></pre>
        <button class="dl-cmd__copy" type="button" data-copy-text={directCmd} aria-label="Copy direct-download commands">Copy</button>
      </div>
    </li>
  </ol>

  <form method="dialog">
    <button type="submit" class="dialog-close">Close</button>
  </form>
  </div>
</dialog>

<dialog class="compute-dialog" data-compute-dialog>
  <DialogCloseButton />
  <div class="compute-dialog__scroll">
  <h2>Compute on this dataset</h2>
  <p class="compute-dialog__intro">
    Two routes today, with a third (in-browser one-click submission)
    landing soon.
  </p>

  <ol class="compute-dialog__steps">
    <li>
      <strong>NeuroScience Gateway (NSG) portal.</strong>
      <p>
        NSG runs EEGLAB / Brainstorm / MNE pipelines on supercomputing
        time donated by SDSC. Create an account, point a job at this
        dataset's S3 prefix (<code>s3://nemar/{datasetId}</code>), and
        submit.
        <br />
        <a href="https://nsgportal.org" rel="external">nsgportal.org →</a>
      </p>
    </li>
    <li>
      <strong>Local processing with <code>nemar-cli</code>.</strong>
      <p>
        Pull the dataset to your machine and run any toolbox locally.
        Honors the published version pinning.
      </p>
      <pre><code>npm install -g nemar-cli
nemar dataset clone {datasetId}
cd {datasetId} && nemar dataset get</code></pre>
    </li>
    <li>
      <strong>Just the files.</strong>
      <p>
        <code>rclone</code>, <code>aria2c</code>, or any HTTPS client
        works against <a href={`${dataBase}/${datasetId}/`} rel="external">{dataHost}/{datasetId}/</a>
        — the manifest carries presigned S3 URLs.
      </p>
    </li>
  </ol>

  <div class="compute-dialog__soon" role="note">
    <strong>Direct compute access is coming soon.</strong>
    <span>
      One-click NSG submission from this page is scoped for a follow-up
      phase. Tracked on
      <a href="https://github.com/nemarOrg/website/issues/6" rel="external">nemarOrg/website#6</a>.
    </span>
  </div>

  <form method="dialog">
    <button type="submit" class="dialog-close">Close</button>
  </form>
  </div>
</dialog>

<dialog
  class="cite-dialog"
  data-citations-dialog
  data-dataset-id={ds}
  aria-labelledby="citations-dialog-heading"
>
  <DialogCloseButton />
  <div class="cite-dialog__scroll">
  <header class="cite-dialog__head">
    <h2 id="citations-dialog-heading" data-citations-heading>Citations</h2>
    <div class="cite-filter" role="group" aria-label="Filter citations by what they reference">
      <button type="button" class="cite-filter__btn is-active" data-cite-filter="all" aria-pressed="true">All</button>
      <button type="button" class="cite-filter__btn" data-cite-filter="dataset" aria-pressed="false">Cites dataset</button>
      <button type="button" class="cite-filter__btn" data-cite-filter="paper" aria-pressed="false">Cites a paper</button>
    </div>
  </header>
  <ol class="cite-list" data-citations-list></ol>
  <p class="cite-empty" data-citations-empty hidden>No citations of that kind.</p>
  <form method="dialog">
    <button type="submit" class="dialog-close">Close</button>
  </form>
  </div>
</dialog>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 var(--space-4);
    min-block-size: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.05s ease;
  }
  .action:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-fg-muted);
    color: var(--color-fg);
    text-decoration: none;
  }
  .action:active {
    transform: translateY(1px);
  }
  /* The citations pill ships [hidden] and is revealed by the script only when
     the API confirms count > 0. Without this, .action's display rule overrides
     the UA [hidden] rule (equal specificity, author wins) and the pill leaks
     onto every dataset. */
  .action[hidden] {
    display: none;
  }
  .action--primary {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .action--primary:hover {
    background: color-mix(in srgb, var(--color-fg) 88%, var(--brand-teal));
    color: var(--color-bg);
    border-color: transparent;
  }
  /* Copyable command row inside the download modal (one per method). */
  .dl-cmd {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }
  .dl-cmd pre {
    flex: 1;
    margin: 0;
    background: var(--color-bg-subtle);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: var(--fs-xs);
    line-height: 1.5;
  }
  .dl-cmd code {
    background: transparent;
    padding: 0;
    white-space: pre;
  }
  .dl-cmd__copy {
    flex: none;
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  .dl-cmd__copy.is-copied {
    background: var(--brand-teal);
    color: var(--brand-navy);
    border-color: transparent;
  }
  .rec-badge {
    margin-inline-start: 6px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--brand-teal);
    color: var(--brand-navy);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    vertical-align: middle;
  }
  .action--sm {
    min-block-size: 36px;
    padding: 0 var(--space-3);
    font-size: var(--fs-xs);
  }
  .compute-dialog {
    /* Native <dialog> uses position: fixed + inset: 0 + margin: auto for
       auto-centering. Some browsers respect that only when no explicit
       inset/margin/position is set. We were inheriting top-left placement
       from the second declaration overriding the first — collapsed both
       into one and re-asserted margin: auto so centering kicks in. */
    inset: 0;
    margin: auto;
    max-inline-size: 44rem;
    inline-size: calc(100vw - 4rem);
    max-block-size: 90vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    /* The dialog itself no longer scrolls (padding: 0) — .compute-dialog__scroll
       below does, so the corner close button (a direct child, sitting outside
       that inner scroll region) stays pinned in view instead of scrolling away
       with long content. This is the same "Close button below the fold" bug
       the corner X exists to fix (website#199) — it would just move to the top
       corner if the whole dialog stayed the scroll container. */
    padding: 0;
    overflow: hidden;
  }
  /* `display: flex` MUST be gated on `[open]` rather than living on the bare
     `.compute-dialog` selector. The browser hides a closed <dialog> with a
     plain-element UA rule (`dialog { display: none }`), which a bare class
     selector like `.compute-dialog { display: flex }` outranks on
     specificity — that silently un-hides the closed dialog underneath
     whatever else is open, exactly the "Compute on this dataset" text
     bleeding through behind a screenshot that caught us during review. */
  .compute-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .compute-dialog::backdrop {
    background: rgb(15 23 42 / 55%);
  }
  .compute-dialog__scroll {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    padding: var(--space-6);
  }
  .compute-dialog h2 {
    font-size: var(--fs-2xl);
    margin-block-end: var(--space-3);
    /* Clears the corner close button, which floats above this scrolling
       content rather than participating in its layout. */
    padding-inline-end: var(--dialog-x-clearance);
  }
  .compute-dialog__intro {
    color: var(--color-fg-muted);
    margin-block-end: var(--space-5);
  }
  .compute-dialog__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-block-end: var(--space-5);
    padding-inline-start: 0;
    list-style: none;
    counter-reset: compute-step;
  }
  .compute-dialog__steps > li {
    position: relative;
    padding-inline-start: var(--space-10);
    counter-increment: compute-step;
  }
  .compute-dialog__steps > li::before {
    content: counter(compute-step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 2px;
    inline-size: 28px;
    block-size: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--brand-teal);
    color: var(--brand-navy);
    font-family: var(--font-mono);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
  }
  .compute-dialog__steps strong {
    color: var(--color-fg);
    display: block;
    margin-block-end: 4px;
  }
  .compute-dialog__steps p {
    color: var(--color-fg-muted);
    margin: 0;
    line-height: var(--lh-relaxed);
    font-size: var(--fs-sm);
  }
  .compute-dialog pre {
    background: var(--color-bg-subtle);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    margin-block-start: var(--space-2);
    overflow-x: auto;
    font-size: var(--fs-xs);
    line-height: 1.5;
  }
  .compute-dialog code {
    background: var(--color-bg-subtle);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .compute-dialog pre code {
    background: transparent;
    padding: 0;
  }
  .compute-dialog__soon {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    margin-block-end: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--brand-purple) 30%, transparent);
    background: color-mix(in srgb, var(--brand-purple) 6%, transparent);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
  }
  .compute-dialog__soon strong {
    color: var(--color-fg);
  }
  .compute-dialog__soon span {
    color: var(--color-fg-muted);
  }
  .dialog-close {
    padding: 0 var(--space-5);
    min-block-size: 44px;
    border-radius: var(--radius-pill);
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: var(--fw-medium);
  }

  /* Citations modal */
  .cite-dialog {
    inset: 0;
    margin: auto;
    max-inline-size: 46rem;
    inline-size: calc(100vw - 4rem);
    max-block-size: 90vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    /* See .compute-dialog above: the dialog itself doesn't scroll so the
       corner close button, a direct child sitting outside .cite-dialog__scroll,
       stays pinned in view while the citation list scrolls under it. */
    padding: 0;
    overflow: hidden;
  }
  /* Gated on [open] — see the .compute-dialog[open] comment above for why a
     bare `.cite-dialog { display: flex }` would un-hide the closed dialog. */
  .cite-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .cite-dialog::backdrop {
    background: rgb(15 23 42 / 55%);
  }
  .cite-dialog__scroll {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    padding: var(--space-6);
  }
  .cite-dialog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    /* Clears the corner close button floating above this row. */
    padding-inline-end: var(--dialog-x-clearance);
  }
  .cite-dialog__head h2 {
    font-size: var(--fs-2xl);
  }
  .cite-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cite-filter__btn {
    font-size: var(--fs-sm);
    padding: 4px var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    cursor: pointer;
  }
  .cite-filter__btn:hover {
    color: var(--color-fg);
  }
  .cite-filter__btn.is-active {
    color: var(--color-fg);
    border-color: var(--brand-teal);
    background: color-mix(in srgb, var(--brand-teal) 12%, transparent);
  }
  .cite-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--color-border);
  }
  .cite-item {
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--color-border);
  }
  .cite-item__title {
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  a.cite-item__title:hover {
    color: var(--brand-teal);
  }
  .cite-item__meta {
    margin-block-start: 2px;
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .cite-item__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-2);
  }
  .cite-flag {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
  }
  .cite-flag--paper {
    color: var(--color-fg-muted);
    background: var(--color-bg-subtle);
    border-color: var(--color-border);
  }
  .cite-flag--dataset {
    color: var(--brand-teal);
    background: color-mix(in srgb, var(--brand-teal) 12%, transparent);
    border-color: color-mix(in srgb, var(--brand-teal) 35%, transparent);
  }
  .cite-item__by {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .cite-empty {
    padding-block: var(--space-5);
    color: var(--color-fg-muted);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-compute-stub]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelector<HTMLDialogElement>("[data-compute-dialog]")?.showModal();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-download-stub]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelector<HTMLDialogElement>("[data-download-dialog]")?.showModal();
    });
  });

  // Copy a per-method command from the download modal (#752). Delegated over
  // [data-copy-text]. Same pattern as DoiBadge: writeText + brief is-copied
  // feedback; degrades gracefully (the command stays visible to copy manually).
  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    const btn = target?.closest<HTMLButtonElement>("[data-copy-text]");
    if (!btn) return;
    const value = btn.dataset.copyText ?? "";
    if (!value) return;
    navigator.clipboard?.writeText(value).then(
      () => {
        const label = btn.textContent;
        btn.classList.add("is-copied");
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.classList.remove("is-copied");
          if (label !== null) btn.textContent = label;
        }, 1200);
      },
      () => {
        /* Clipboard API unavailable; the command is still visible to copy manually. */
      },
    );
  });

  // Citations pill + modal. The detail page has no citation count server-side,
  // so fetch it from the citations dashboard API (CORS *), reveal the pill with
  // the count, and render the per-paper list (filterable by bucket) lazily.
  interface Citation {
    title?: string;
    authors?: string;
    year?: number | null;
    venue?: string;
    url?: string | null;
    doi?: string | null;
    cited_by?: number;
    kind?: string;
  }

  (async () => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-citations-dialog]");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-citations-open]");
    if (!dialog || !openBtn) return;
    const id = dialog.dataset.datasetId;
    if (!id) return;

    let payload: { num_citations?: number; citations?: Citation[] } = {};
    try {
      const res = await fetch(
        `https://dashboard.nemar.org/citations/api/dataset/${encodeURIComponent(id)}.json`,
      );
      if (!res.ok) return;
      payload = await res.json();
    } catch {
      return;
    }

    const citations = Array.isArray(payload.citations) ? payload.citations : [];
    const count =
      typeof payload.num_citations === "number" ? payload.num_citations : citations.length;
    if (count <= 0) return;

    const fmt = (n: number) => n.toLocaleString("en-US");
    const label = openBtn.querySelector<HTMLElement>("[data-citations-label]");
    if (label) label.textContent = `Citations: ${fmt(count)}`;
    openBtn.hidden = false;

    const list = dialog.querySelector<HTMLOListElement>("[data-citations-list]");
    const empty = dialog.querySelector<HTMLElement>("[data-citations-empty]");
    const heading = dialog.querySelector<HTMLElement>("[data-citations-heading]");
    if (heading) heading.textContent = `Citations (${fmt(count)})`;

    const render = (filter: string): void => {
      if (!list) return;
      list.replaceChildren();
      let shown = 0;
      for (const c of citations) {
        const kind = c.kind === "dataset" ? "dataset" : "paper";
        if (filter !== "all" && kind !== filter) continue;
        shown += 1;
        const li = document.createElement("li");
        li.className = "cite-item";

        const href = c.url || (c.doi ? `https://doi.org/${c.doi}` : null);
        const title = document.createElement(href ? "a" : "span");
        title.className = "cite-item__title";
        title.textContent = c.title || "Untitled";
        if (href && title instanceof HTMLAnchorElement) {
          title.href = href;
          title.target = "_blank";
          title.rel = "noopener noreferrer";
        }
        li.appendChild(title);

        const meta = [c.authors, c.year ? String(c.year) : "", c.venue]
          .filter(Boolean)
          .join(" · ");
        if (meta) {
          const p = document.createElement("p");
          p.className = "cite-item__meta";
          p.textContent = meta;
          li.appendChild(p);
        }

        const tags = document.createElement("p");
        tags.className = "cite-item__tags";
        const flag = document.createElement("span");
        flag.className = `cite-flag cite-flag--${kind}`;
        flag.textContent = kind === "dataset" ? "Cites dataset" : "Cites a paper";
        tags.appendChild(flag);
        if (typeof c.cited_by === "number" && c.cited_by > 0) {
          const by = document.createElement("span");
          by.className = "cite-item__by";
          by.textContent = `${fmt(c.cited_by)} citations`;
          tags.appendChild(by);
        }
        li.appendChild(tags);
        list.appendChild(li);
      }
      if (empty) empty.hidden = shown !== 0;
    };

    render("all");

    const filterBtns = dialog.querySelectorAll<HTMLButtonElement>("[data-cite-filter]");
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        for (const b of filterBtns) {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-pressed", String(b === btn));
        }
        render(btn.dataset.citeFilter || "all");
      });
    });

    openBtn.addEventListener("click", () => dialog.showModal());
  })();
</script>
