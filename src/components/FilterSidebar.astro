---
import type { FilterState } from "../lib/filters";
import { LICENSE_TIER_BLURB, LICENSE_TIER_LABELS, modalityVariant } from "../lib/tags";
import {
  DENSITY_BUCKETS,
  ELECTRODE_SYSTEMS,
  LICENSE_TIERS,
  MODALITY_CODES,
  MODALITY_LABELS,
} from "../lib/types";
import TagSeparator from "./TagSeparator.astro";

// Density presets in display order (insertion order of the record literal).
const DENSITY_OPTIONS = Object.entries(DENSITY_BUCKETS);

interface Props {
  state: FilterState;
  /**
   * When a freetext query is active, results come from the hybrid search
   * endpoint, which can't filter by license, channels, or Zarr, so those
   * controls are disabled with a hint rather than letting them silently no-op.
   */
  searchActive?: boolean;
}

const { state, searchActive = false } = Astro.props;
---

{/* `id` is the target of the results toolbar's `<select form=...>`: the
    Sort by control lives above the list (website#346) but submits with this
    form, so a re-sort carries any filter edit not yet applied, and Apply
    keeps the chosen order. */}
<form
  id="discover-filters"
  class="filters"
  method="get"
  action="/discover"
  data-filter-form
  aria-label="Dataset filters"
>
  <div class="filters__group">
    <h3>Modality</h3>
    <div class="filters__op">
      <label>
        <input
          type="radio"
          name="modality_op"
          value="OR"
          checked={state.modalityOp === "OR"}
        />
        OR
      </label>
      <label>
        <input
          type="radio"
          name="modality_op"
          value="AND"
          checked={state.modalityOp === "AND"}
        />
        AND
      </label>
    </div>
    <div class="filters__chips">
      {MODALITY_CODES.map((mod) => {
        const selected = state.modalities.includes(mod);
        return (
          <label class:list={["chip", `chip--mod-${modalityVariant(mod)}`, selected && "chip--on"]}>
            <input
              type="checkbox"
              name="modality"
              value={mod}
              checked={selected}
            />
            <span>{MODALITY_LABELS[mod]}</span>
          </label>
        );
      })}
      {/* Zarr is a converted data format, not a modality, but it matters as
          much when choosing a dataset, so it sits in this row behind a "|".
          It filters on its own and is never part of the OR/AND above. */}
      <TagSeparator>
        <label
          class:list={[
            "chip",
            "chip--zarr",
            state.hasZarr && "chip--on",
            searchActive && "chip--disabled",
          ]}
          title="Only datasets with a converted Zarr copy of their recordings."
        >
          <input
            type="checkbox"
            name="has_zarr"
            value="1"
            checked={state.hasZarr}
            disabled={searchActive}
          />
          <span>Zarr</span>
        </label>
      </TagSeparator>
    </div>
  </div>

  <div class="filters__group">
    <h3>License</h3>
    <div class="filters__chips">
      {LICENSE_TIERS.map((tier) => {
        const selected = state.licenseTiers.includes(tier);
        return (
          <label
            class:list={[
              "chip",
              "chip--lic",
              `chip--lic-${tier}`,
              selected && "chip--on",
              searchActive && "chip--disabled",
            ]}
            title={LICENSE_TIER_BLURB[tier]}
          >
            <input
              type="checkbox"
              name="license"
              value={tier}
              checked={selected}
              disabled={searchActive}
            />
            <span class="chip__dot" aria-hidden="true"></span>
            <span>{LICENSE_TIER_LABELS[tier]}</span>
          </label>
        );
      })}
    </div>
    <p class="filters__note">
      {searchActive
        ? "License filtering isn't available while searching — clear the search box to filter by license."
        : "Green is most permissive, red most restrictive."}
    </p>
  </div>

  <div class="filters__group">
    <h3>Participants</h3>
    <div class="filters__range">
      <input
        type="number"
        name="p_min"
        min="0"
        placeholder="Min"
        value={state.participants.min ?? ""}
      />
      <span aria-hidden="true">to</span>
      <input
        type="number"
        name="p_max"
        min="0"
        placeholder="Max"
        value={state.participants.max ?? ""}
      />
    </div>
  </div>

  <div class="filters__group">
    <h3>Features</h3>
    <ul class="filters__flags" role="list">
      <li>
        <label>
          <input
            type="checkbox"
            name="has_hed"
            value="1"
            checked={state.hasHed}
          />
          Has HED annotation
        </label>
      </li>
      <li>
        <label
          class:list={[searchActive && "flag--disabled"]}
          title="Recordings open in the in-browser signal viewer."
        >
          <input
            type="checkbox"
            name="has_viewer"
            value="1"
            checked={state.hasViewer}
            disabled={searchActive}
          />
          Has viewer
        </label>
      </li>
      <li>
        <label class="flag--soon">
          <input
            type="checkbox"
            name="has_qa"
            value="1"
            checked={state.hasDataQuality}
            disabled
          />
          Has data quality
          <span class="soon-pill">Phase 3</span>
        </label>
      </li>
    </ul>
    {searchActive && (
      <p class="filters__note">
        The viewer and Zarr filters aren't available while searching — clear the search box to use them.
      </p>
    )}
  </div>

  <div class="filters__group">
    <h3>Channels &amp; montage</h3>
    <label class="filters__field">
      <span class="filters__field-label">Channel density</span>
      <select name="density" disabled={searchActive}>
        <option value="" selected={!state.density}>Any density</option>
        {DENSITY_OPTIONS.map(([value, bucket]) => (
          <option value={value} selected={state.density === value}>{bucket.label}</option>
        ))}
      </select>
    </label>
    <label class="filters__field">
      <span class="filters__field-label">Electrode system</span>
      <select name="es" disabled={searchActive}>
        <option value="" selected={!state.electrodeSystem}>Any system</option>
        {ELECTRODE_SYSTEMS.map((sys) => (
          <option value={sys.value} selected={state.electrodeSystem === sys.value}>{sys.label}</option>
        ))}
      </select>
    </label>
    <p class="filters__note">
      {searchActive
        ? "Channel and montage filters apply while browsing — clear the search box to use them."
        : "Counts come from each dataset's channels.tsv / EEG sidecar; datasets without a resolvable montage are excluded."}
    </p>
  </div>

  <div class="filters__actions">
    <button type="submit" class="filters__apply">Apply</button>
    <a href="/discover" class="filters__reset">Reset</a>
  </div>
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }
  .filters__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .filters__group h3 {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
    font-weight: var(--fw-semibold);
    margin: 0;
  }
  .filters__op {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    overflow: hidden;
    padding: 2px;
    background: var(--color-bg);
    inline-size: fit-content;
  }
  .filters__op label {
    padding: 4px 14px;
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
    cursor: pointer;
    border-radius: var(--radius-pill);
  }
  .filters__op input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .filters__op label:has(input:checked) {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  .filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
    color: var(--color-fg-muted);
    background: var(--color-bg);
  }
  .chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  /* Disabled while a search query is active (the hybrid search endpoint can't
     filter by license or Zarr). Mirrors the selects' disabled treatment. */
  .chip--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  /* A previously-selected chip must read as suspended, not active, while
     disabled — strip the tier tint so it doesn't look like a live filter. */
  .chip--disabled.chip--on,
  .chip--disabled:has(input:checked) {
    background: var(--color-bg);
    border-color: var(--color-border-strong);
    color: var(--color-fg-muted);
  }
  /* Selected chips tint with their own tag color (modality / license tier),
     falling back to brand-teal for any chip without one. Keeps the sidebar
     color language in lockstep with the tags it filters — see the tag color
     bible in .rules/design-language.md. */
  .chip--on,
  .chip:has(input:checked) {
    background: color-mix(in srgb, var(--chip-color, var(--brand-teal)) 15%, transparent);
    border-color: var(--chip-color, var(--brand-teal));
    color: var(--color-fg);
  }
  .chip--mod-eeg { --chip-color: var(--modality-eeg); }
  .chip--mod-meg { --chip-color: var(--modality-meg); }
  .chip--mod-ieeg { --chip-color: var(--modality-ieeg); }
  .chip--mod-emg { --chip-color: var(--modality-emg); }
  .chip--mod-nirs { --chip-color: var(--modality-nirs); }
  .chip--mod-motion { --chip-color: var(--modality-motion); }
  .chip--mod-other { --chip-color: var(--modality-other); }
  /* Same green as the Zarr tag on cards (Tag.astro's `positive` kind). */
  .chip--zarr { --chip-color: var(--color-success); }
  .chip--lic-public { --chip-color: var(--license-public); }
  .chip--lic-attribution { --chip-color: var(--license-attribution); }
  .chip--lic-sharealike { --chip-color: var(--license-sharealike); }
  .chip--lic-noncommercial { --chip-color: var(--license-noncommercial); }
  .chip--lic-noderiv { --chip-color: var(--license-noderiv); }
  .chip--lic-unknown { --chip-color: var(--license-unknown); }
  /* License tier dot — always shows its tier color so the gradient reads
     even before a chip is selected. */
  .chip__dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--chip-color, var(--color-fg-subtle));
    flex-shrink: 0;
    margin-inline-end: 2px;
  }
  .filters__note {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    line-height: var(--lh-normal);
  }
  .filters__note a {
    color: var(--color-link);
  }
  .filters__range {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .filters__range input {
    inline-size: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
  }
  .filters__range span {
    color: var(--color-fg-subtle);
    font-size: var(--fs-sm);
  }
  .filters__flags {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .filters__flags label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-fg);
    cursor: pointer;
  }
  .filters__flags label.flag--soon {
    color: var(--color-fg-subtle);
    cursor: not-allowed;
  }
  /* Temporarily disabled while a search query is active (the viewer filter
     isn't wired for the hybrid search endpoint yet, website#280). Distinct
     from .flag--soon (a not-yet-shipped feature): same muted treatment,
     different reason, so it doesn't read as "coming later" when it's
     really "clear the search box". */
  .filters__flags label.flag--disabled {
    color: var(--color-fg-subtle);
    cursor: not-allowed;
  }
  .soon-pill {
    margin-inline-start: auto;
    font-size: var(--fs-xs);
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-subtle);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
  }
  .filters select {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
    font-size: var(--fs-sm);
  }
  .filters select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .filters__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .filters__field select {
    inline-size: 100%;
  }
  .filters__field-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-fg);
  }
  .filters__field--soon .filters__field-label {
    color: var(--color-fg-subtle);
  }
  .filters__field--soon .soon-pill {
    margin-inline-start: auto;
  }
  .filters__actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .filters__apply {
    flex: 1;
    padding: var(--space-2) var(--space-4);
    background: var(--color-fg);
    color: var(--color-bg);
    border-radius: var(--radius-pill);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
  }
  .filters__reset {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    text-decoration: underline;
  }
  .filters__reset:hover {
    color: var(--color-fg);
  }
</style>
