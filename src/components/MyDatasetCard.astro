---
import {
  type PublicationStatus,
  derivePublishState,
  isDeletable,
  isPublishRequestable,
} from "../lib/dashboard-api";
import { formatBytes, formatRelativeTime, splitModalities } from "../lib/format";
import { blockIsAccountFixable } from "../lib/publication-block";
import type { Dataset } from "../lib/types";
import PublishStateBadge from "./PublishStateBadge.astro";
import Tag from "./Tag.astro";

interface Props {
  dataset: Dataset;
  publishStatus: PublicationStatus | null;
  /** True when the viewer is the dataset owner or an admin. Drives the Collaborators link. */
  canManage?: boolean;
}

const { dataset, publishStatus, canManage = false } = Astro.props;
const state = derivePublishState(dataset, publishStatus);
const showDelete = isDeletable(dataset, publishStatus);
const showRequest = isPublishRequestable(dataset, publishStatus);
const modalities = splitModalities(dataset.modalities);
const description = (dataset.description ?? "").trim();
const githubUrl = dataset.github_repo ? `https://github.com/${dataset.github_repo}` : null;

// Why a publication request is blocked, in the owner's own view (website#304).
// Until now only the admin queue rendered anything about a block, so the
// person who could actually fix it got a red badge and no sentence.
//
// **Gated on the STATUS, not on the reason.** `block_reason` is a nullable
// free-TEXT column (nemar-cli migration 0015), so a row that predates it — or
// a status payload that omitted it — is genuinely blocked with nothing to
// quote. Keying the panel on the reason meant exactly those rows got the
// "Blocked" badge with no explanation under it at all, which is the failure
// this whole change exists to fix. `blockBadgeState` already answers
// "blocked" for a null reason; the panel now agrees with it.
//
// The text is the BACKEND's (`blockMessage` in nemar-cli
// `routes/datasets/publication.ts`), not a local re-derivation from the reason
// code: it is the one place the fix is spelled out, it changes with the
// backend rather than with a deploy of this site, and for `owner_name_missing`
// it names both routes to a name depending on whether the account has a
// verified ORCID link — a distinction this card cannot see.
const isBlocked = publishStatus?.status === "blocked";
const blockReason = isBlocked ? (publishStatus.block_reason ?? "").trim() : "";
const blockMessage = isBlocked ? (publishStatus.message ?? "").trim() : "";
// A CI link only exists for the reasons that are about the repository; the
// backend already withholds `ci_url` when there is no repo.
const blockCiUrl = isBlocked ? publishStatus.ci_url : undefined;
const blockFixInSettings = blockIsAccountFixable(blockReason);
---

<article class="my-dataset-card" data-dataset-id={dataset.dataset_id}>
  <header class="my-dataset-card__header">
    <div class="my-dataset-card__heading">
      <span class="my-dataset-card__id">{dataset.dataset_id}</span>
      <h3 class="my-dataset-card__name">{dataset.name}</h3>
    </div>
    <div class="my-dataset-card__badges">
      <PublishStateBadge state={state} />
      {/* Non-clickable: this is a dashboard management card, not a discovery
          surface — modality filter links belong on Discover + the public
          detail page, not here. */}
      {modalities.map((m) => <Tag kind="modality" value={m} />)}
    </div>
  </header>

  {description && <p class="my-dataset-card__description">{description}</p>}

  {isBlocked && (
    <div class="my-dataset-card__block" role="note">
      {blockMessage ? (
        <p class="my-dataset-card__block-text">{blockMessage}</p>
      ) : blockReason ? (
        /* An older backend sent no message. Show the raw code rather than
           inventing a sentence for it — the admin queue has always done the
           same, and a wrong explanation is worse than a bare reason. */
        <p class="my-dataset-card__block-text">
          Publication is blocked (<code>{blockReason}</code>). Contact an admin if this is
          unexpected.
        </p>
      ) : (
        /* Neither a message nor a reason: the row is blocked and nothing on
           the wire says why. Still say so — an owner who can see the badge
           and nothing else has no way to know it is not their mistake. */
        <p class="my-dataset-card__block-text">
          Publication is blocked. Contact an admin if this is unexpected.
        </p>
      )}
      <p class="my-dataset-card__block-links">
        {blockFixInSettings && (
          <a class="my-dataset-card__block-link" href="/settings#account-given-name">
            Set your name in Settings
          </a>
        )}
        {blockCiUrl && (
          <a class="my-dataset-card__block-link" href={blockCiUrl} rel="external noopener">
            View the validation run
          </a>
        )}
      </p>
    </div>
  )}

  <dl class="my-dataset-card__facts">
    <div>
      <dt>Subjects</dt>
      <dd>{dataset.participants > 0 ? dataset.participants.toLocaleString() : "—"}</dd>
    </div>
    <div>
      <dt>Size</dt>
      <dd>{dataset.file_size > 0 ? formatBytes(dataset.file_size) : (dataset.file_size_formatted || "—")}</dd>
    </div>
    <div>
      <dt>Version</dt>
      <dd>{dataset.latest_version ?? "—"}</dd>
    </div>
    <div>
      <dt>DOI</dt>
      <dd>{dataset.concept_doi ?? "—"}</dd>
    </div>
    <div>
      <dt>Last updated</dt>
      <dd>{formatRelativeTime(dataset.updated_at) || "—"}</dd>
    </div>
  </dl>

  <footer class="my-dataset-card__actions">
    <a class="my-dataset-card__btn" href={`/dataset/${encodeURIComponent(dataset.dataset_id)}`}>
      View
    </a>
    {canManage && (
      <a
        class="my-dataset-card__btn"
        href={`/dataset/${encodeURIComponent(dataset.dataset_id)}/collaborators`}
      >
        Collaborators
      </a>
    )}
    {githubUrl && (
      <a class="my-dataset-card__btn" href={githubUrl} rel="external noopener">
        GitHub
      </a>
    )}
    {showRequest && (
      <button
        type="button"
        class="my-dataset-card__btn my-dataset-card__btn--primary"
        data-request-publication
        data-dataset-id={dataset.dataset_id}
      >
        Request publication
      </button>
    )}
    {showDelete && (
      <button
        type="button"
        class="my-dataset-card__btn my-dataset-card__btn--danger-ghost"
        data-delete-dataset
        data-dataset-id={dataset.dataset_id}
        data-dataset-name={dataset.name}
      >
        Delete
      </button>
    )}
  </footer>
</article>

<style>
  .my-dataset-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .my-dataset-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .my-dataset-card__heading {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }
  .my-dataset-card__id {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
  .my-dataset-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .my-dataset-card__badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: flex-end;
  }
  .my-dataset-card__description {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: var(--lh-normal);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  /* Amber rather than red: every block is fixable by the owner, and the
     panel exists to say how. --color-warning is theme-tuned in tokens.css,
     so the color-mix tints track light and dark automatically. */
  .my-dataset-card__block {
    background: color-mix(in srgb, var(--color-warning) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .my-dataset-card__block-text {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    overflow-wrap: anywhere;
  }
  .my-dataset-card__block-text code {
    font-family: var(--font-mono);
    background: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.92em;
  }
  .my-dataset-card__block-links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .my-dataset-card__block-links:empty {
    display: none;
  }
  .my-dataset-card__block-link {
    color: var(--color-link);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .my-dataset-card__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .my-dataset-card__facts > div {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
  }
  .my-dataset-card__facts dt {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-block-end: 2px;
  }
  .my-dataset-card__facts dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .my-dataset-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: flex-end;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-3);
  }
  .my-dataset-card__btn {
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-fg);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .my-dataset-card__btn:hover {
    background: var(--color-bg-subtle);
  }
  .my-dataset-card__btn--primary {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .my-dataset-card__btn--primary:hover {
    background: color-mix(in srgb, var(--color-fg) 82%, var(--brand-teal));
  }
  .my-dataset-card__btn--danger-ghost {
    color: var(--color-danger);
    border-color: color-mix(in srgb, var(--color-danger) 40%, transparent);
  }
  .my-dataset-card__btn--danger-ghost:hover {
    background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    border-color: var(--color-danger);
  }
</style>
