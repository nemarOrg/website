---
// Theme toggle: cycles system -> dark -> light; the icon reflects the current
// choice (monitor = follow device). Persists the choice to localStorage.
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <svg
    class="theme-icon icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    class="theme-icon icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    class="theme-icon icon-system"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
    <path d="M8 21h8M12 17v4"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    inline-size: 44px;
    block-size: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-fg-muted);
    border-radius: var(--radius-md);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--color-fg);
    background: var(--color-bg-elevated);
  }
  .theme-icon {
    inline-size: 20px;
    block-size: 20px;
  }
  /* The visible icon reflects the CHOICE, not the resolved theme: system mode
     (no data-theme) shows the monitor, so you can always tell you're on
     "follow device"; explicit light/dark show the sun/moon. */
  .icon-sun,
  .icon-moon {
    display: none;
  }
  .icon-system {
    display: block;
  }
  :global(:root[data-theme="light"]) .icon-sun {
    display: block;
  }
  :global(:root[data-theme="light"]) .icon-moon,
  :global(:root[data-theme="light"]) .icon-system {
    display: none;
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    display: block;
  }
  :global(:root[data-theme="dark"]) .icon-sun,
  :global(:root[data-theme="dark"]) .icon-system {
    display: none;
  }
</style>

<script>
  type ThemeChoice = "light" | "dark" | "system";
  const STORAGE_KEY = "nemar:theme";
  const root = document.documentElement;

  // Hints match the cycle order (system -> dark -> light) so the tooltip says
  // where the next click lands.
  const LABELS: Record<ThemeChoice, string> = {
    system: "Theme: follows your device — click for dark",
    dark: "Theme: dark — click for light",
    light: "Theme: light — click to follow your device",
  };

  function applyTheme(value: ThemeChoice): void {
    if (value === "system") {
      root.removeAttribute("data-theme");
    } else {
      root.setAttribute("data-theme", value);
    }
  }

  function nextTheme(current: ThemeChoice): ThemeChoice {
    if (current === "system") return "dark";
    if (current === "dark") return "light";
    return "system";
  }

  // Effective choice from the DOM (system == no attribute). The attribute is
  // the shared source of truth: the FOUC bootstrap in Base.astro and the
  // Settings page's Appearance picker both set it directly, so reading it keeps
  // this button in sync with theme changes from any source.
  function choiceFromDom(): ThemeChoice {
    const dt = root.getAttribute("data-theme");
    return dt === "light" || dt === "dark" ? dt : "system";
  }

  // The icon swaps via CSS on [data-theme]; the label carries the current mode
  // and the next step, so refresh it whenever the attribute changes.
  function updateLabels(choice: ThemeChoice): void {
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      btn.title = LABELS[choice];
      btn.setAttribute("aria-label", LABELS[choice]);
    }
  }

  updateLabels(choiceFromDom());

  // Catch data-theme changes from any source — notably the Settings picker,
  // which sets the attribute directly, bypassing the click handler below.
  // Label-only (never writes data-theme) so it can't loop with its own observer.
  new MutationObserver(() => updateLabels(choiceFromDom())).observe(root, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = nextTheme(choiceFromDom());
      if (next === "system") {
        localStorage.removeItem(STORAGE_KEY);
      } else {
        localStorage.setItem(STORAGE_KEY, next);
      }
      applyTheme(next);
    });
  });
</script>
