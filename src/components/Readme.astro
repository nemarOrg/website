---
import { renderMarkdown } from "../lib/markdown";

interface Props {
  source: string | null;
}

const { source } = Astro.props;
const html = source ? renderMarkdown(source) : null;
---

<article class="readme">
  {html ? (
    <div class="readme__body" set:html={html} />
  ) : (
    <div class="readme__empty">
      <h2>README not available</h2>
      <p>
        This dataset doesn't ship a README. Check the BIDS file tree and the
        right rail for dataset metadata, or visit the GitHub repository for
        the latest curation notes.
      </p>
    </div>
  )}
</article>

<style>
  .readme {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
  }
  @media (max-width: 540px) {
    .readme {
      padding: var(--space-5);
    }
  }
  .readme__body {
    max-inline-size: 72ch;
  }
  .readme__body :global(h1),
  .readme__body :global(h2),
  .readme__body :global(h3),
  .readme__body :global(h4) {
    font-family: var(--font-display);
    color: var(--color-fg);
    margin-block-start: var(--space-6);
    margin-block-end: var(--space-3);
    line-height: var(--lh-tight);
  }
  .readme__body :global(h1) {
    font-size: var(--fs-3xl);
    margin-block-start: 0;
  }
  .readme__body :global(h2) {
    font-size: var(--fs-2xl);
  }
  .readme__body :global(h3) {
    font-size: var(--fs-xl);
  }
  .readme__body :global(h4) {
    font-size: var(--fs-lg);
  }
  .readme__body :global(p),
  .readme__body :global(li) {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
  }
  .readme__body :global(p) {
    margin-block-end: var(--space-4);
  }
  .readme__body :global(ul),
  .readme__body :global(ol) {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-5);
  }
  .readme__body :global(li) {
    margin-block-end: var(--space-1);
  }
  .readme__body :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .readme__body :global(a:hover) {
    color: var(--color-link-hover);
  }
  .readme__body :global(code) {
    background: var(--color-bg-subtle);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }
  .readme__body :global(pre) {
    background: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-block-end: var(--space-4);
  }
  .readme__body :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .readme__body :global(hr) {
    border: 0;
    border-block-start: 1px solid var(--color-border);
    margin-block: var(--space-6);
  }
  .readme__body :global(strong) {
    color: var(--color-fg);
  }
  .readme__empty h2 {
    font-size: var(--fs-xl);
    margin-block-end: var(--space-2);
  }
  .readme__empty p {
    color: var(--color-fg-muted);
    line-height: var(--lh-relaxed);
  }
</style>
