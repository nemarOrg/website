---
import type { Author } from "../lib/neuroschema";

interface Props {
  authors: Author[];
  limit?: number;
}

const { authors, limit = 6 } = Astro.props;
const safeAuthors = (authors ?? []).map((a) => ({
  ...a,
  affiliations: a.affiliations ?? [],
}));
const visible = safeAuthors.slice(0, limit);
const hidden = safeAuthors.slice(limit);
---

{safeAuthors.length > 0 && (
  <section class="author-list">
    <h3>Authors</h3>
    <ol role="list" class="author-list__list">
      {visible.map((a) => (
        <li class="author-list__item">
          <span class="author-list__name">{a.name}</span>
          {a.orcid && (
            <a class="author-list__orcid" href={`https://orcid.org/${a.orcid}`} rel="external" title={`ORCID ${a.orcid}`}>
              <svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true">
                <path fill="#A6CE39" d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0z"/>
                <path fill="#fff" d="M86.3 186.2H70.9V79.1h15.4v107.1zM78.6 56.8c-5.1 0-9.2-4.1-9.2-9.2 0-5.1 4.1-9.2 9.2-9.2s9.2 4.1 9.2 9.2c0 5.1-4.1 9.2-9.2 9.2zm17.6 22.3h41.6c39.6 0 57 28.3 57 53.5 0 27.4-21.4 53.5-56.8 53.5H96.2V79.1zm15.3 92.2h24.6c35 0 43-26.5 43-38.6 0-19.7-12.5-38.6-43.8-38.6h-23.8v77.2z"/>
              </svg>
            </a>
          )}
          {a.affiliations.length > 0 && (
            <span class="author-list__aff" title={a.affiliations.map((af) => af.name).join("; ")}>
              {a.affiliations[0]!.name}
              {a.affiliations.length > 1 && ` +${a.affiliations.length - 1}`}
            </span>
          )}
        </li>
      ))}
    </ol>
    {hidden.length > 0 && (
      <details class="author-list__more">
        <summary>+ {hidden.length} more</summary>
        <ol role="list" class="author-list__list">
          {hidden.map((a) => (
            <li class="author-list__item">
              <span class="author-list__name">{a.name}</span>
              {a.orcid && <a class="author-list__orcid-text" href={`https://orcid.org/${a.orcid}`} rel="external">{a.orcid}</a>}
            </li>
          ))}
        </ol>
      </details>
    )}
  </section>
)}

<style>
  .author-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .author-list h3 {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    font-weight: var(--fw-semibold);
    margin: 0;
  }
  .author-list__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .author-list__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: var(--fs-sm);
  }
  .author-list__name {
    color: var(--color-fg);
  }
  .author-list__orcid {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    text-decoration: none;
  }
  .author-list__orcid-text {
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .author-list__aff {
    color: var(--color-fg-subtle);
    font-size: var(--fs-xs);
    flex-basis: 100%;
  }
  .author-list__more summary {
    cursor: pointer;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    user-select: none;
  }
  .author-list__more[open] summary {
    color: var(--color-fg);
  }
</style>
