---
import CookieNotice from "../components/CookieNotice.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SiteNotices from "../components/SiteNotices.astro";
import { resolveDataBase } from "../lib/data-base";
import { APP_HOST, MARKETING_BASE_URL, hostMode } from "../lib/host";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Path or absolute URL to the OG/Twitter card image for this page.
   * Defaults to the brand-wide `/og-image.png`.
   */
  image?: string;
  /** MIME type for the social preview image. */
  imageType?: string;
  /** Optional second OG image for clients that reject the primary format. */
  fallbackImage?: string;
  fallbackImageType?: string;
  /** Social preview image dimensions. Defaults match the site-wide fallback. */
  imageWidth?: number;
  imageHeight?: number;
  /** Alt text for the social preview image. */
  imageAlt?: string;
  /** Override the OpenGraph `type`. Default "website"; detail pages use "article". */
  ogType?: "website" | "article";
  /** When true, suppresses the standard Nav (used for fullscreen marketing pages). */
  bareLayout?: boolean;
}

const {
  title,
  description = "NEMAR (Neuroelectromagnetic Data Archive and Tools Resource): search, visualize, analyze, and download EEG, MEG, iEEG, and EMG datasets.",
  image = "/og-image.png",
  imageType = "image/png",
  fallbackImage,
  fallbackImageType = "image/png",
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = "NEMAR - open neuroscience data, ready to use.",
  ogType = "website",
  bareLayout = false,
} = Astro.props;

const titleSuffix = title === "NEMAR" ? "" : " - NEMAR";
const fullTitle = `${title}${titleSuffix}`;

// Preconnect to the data plane this build actually reads (data-test on staging).
const dataBase = resolveDataBase();

// Build absolute URLs for OG / canonical against the host actually serving
// this request. The same build runs on `ww2.nemar.org` (marketing today)
// and `app.nemar.org`, so a static `Astro.site` value would lie. Falling
// back to `MARKETING_BASE_URL` covers single-host preview deploys where
// hostMode() returns "single".
const reqHost = Astro.url.hostname;
const siteOrigin = hostMode(reqHost) === "app" ? `https://${APP_HOST}` : MARKETING_BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImage = image.startsWith("http") ? image : new URL(image, siteOrigin).toString();
const absoluteFallbackImage = fallbackImage
  ? fallbackImage.startsWith("http")
    ? fallbackImage
    : new URL(fallbackImage, siteOrigin).toString()
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1a3a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="preconnect" href="https://api.nemar.org" crossorigin />
    <link rel="preconnect" href={dataBase} crossorigin />
    <title>{fullTitle}</title>

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NEMAR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {absoluteFallbackImage && (
      <>
        <meta property="og:image" content={absoluteFallbackImage} />
        <meta property="og:image:type" content={fallbackImageType} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline>
      // Prevent FOUC by applying the stored theme before paint.
      (() => {
        try {
          const stored = localStorage.getItem("nemar:theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch {
          /* localStorage may be unavailable; fall back to prefers-color-scheme. */
        }
      })();
    </script>
  </head>
  <body>
    {/* Above the nav so a maintenance or outage notice is the first thing
        read, and so it never overlaps the sticky header. Gated on
        `bareLayout` alongside Nav/Footer for consistency — note that no
        route currently passes it, so this renders everywhere Base does,
        sign-in pages included. That's intended: an outage notice matters
        just as much to someone trying to log in. (OG card routes never
        reach here at all; they're APIRoutes emitting image bytes, not
        pages.) */}
    {!bareLayout && <SiteNotices />}
    {!bareLayout && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!bareLayout && <Footer />}
    <CookieNotice />
  </body>
</html>

<style is:global>
  main {
    min-block-size: calc(100dvh - var(--header-height));
  }
</style>
