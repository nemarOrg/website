---
import CookieNotice from "../components/CookieNotice.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { APP_HOST, MARKETING_BASE_URL, hostMode } from "../lib/host";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Path or absolute URL to the OG/Twitter card image for this page.
   * Defaults to the brand-wide `/og-image.png`.
   */
  image?: string;
  /** Override the OpenGraph `type`. Default "website"; detail pages use "article". */
  ogType?: "website" | "article";
  /** When true, suppresses the standard Nav (used for fullscreen marketing pages). */
  bareLayout?: boolean;
}

const {
  title,
  description = "NEMAR (Neuroelectromagnetic Data Archive and Tools Resource): search, visualize, analyze, and download EEG, MEG, iEEG, and EMG datasets.",
  image = "/og-image.png",
  ogType = "website",
  bareLayout = false,
} = Astro.props;

const titleSuffix = title === "NEMAR" ? "" : " - NEMAR";
const fullTitle = `${title}${titleSuffix}`;

// Build absolute URLs for OG / canonical against the host actually serving
// this request. The same build runs on `ww2.nemar.org` (marketing today)
// and `app.nemar.org`, so a static `Astro.site` value would lie. Falling
// back to `MARKETING_BASE_URL` covers single-host preview deploys where
// hostMode() returns "single".
const reqHost = Astro.url.hostname;
const siteOrigin = hostMode(reqHost) === "app" ? `https://${APP_HOST}` : MARKETING_BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImage = image.startsWith("http") ? image : new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1a3a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="preconnect" href="https://api.nemar.org" crossorigin />
    <link rel="preconnect" href="https://data.nemar.org" crossorigin />
    <title>{fullTitle}</title>

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NEMAR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NEMAR — open neuroscience data, ready to use." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content="NEMAR — open neuroscience data, ready to use." />

    <script is:inline>
      // Prevent FOUC by applying the stored theme before paint.
      (() => {
        try {
          const stored = localStorage.getItem("nemar:theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch {
          /* localStorage may be unavailable; fall back to prefers-color-scheme. */
        }
      })();
    </script>
  </head>
  <body>
    {!bareLayout && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!bareLayout && <Footer />}
    <CookieNotice />
  </body>
</html>

<style is:global>
  main {
    min-block-size: calc(100dvh - var(--header-height));
  }
</style>
