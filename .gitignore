# build output
dist/
# generated types
.astro/
# generated OG cards — rebuilt from the live catalog on every deploy by
# `generate:og` (chained into `bun run build`) and refreshed out-of-band by the
# nemar-og-rebuild-cron Pages deploy hook. Never hand-authored; tracking them
# only produces churn and drift, so they are build artifacts like dist/.
public/og/dataset-card/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# environment variables
.env
.env.local
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Cloudflare Wrangler
.wrangler/

# Claude / gstack local state
.claude/*.local.md
# Agent subtasks get their own git worktree, created *inside* the repo here.
# Each one is a full checkout, so an unguarded `git add -A` would commit
# several copies of the tree. They are also visible to test globs — vitest
# picks up their `src/lib/*.test.ts` and reruns the whole suite once per
# worktree, which is why a local `bun run test` can report several times the
# real file count. CI clones fresh and never sees them.
.claude/worktrees/
.gstack/

# Playwright artifacts
test-results/
playwright-report/
